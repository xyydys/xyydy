+private func albumMorphTitleImage(_ title: String) -> UIImage? {
+    let font = UIFont.systemFont(ofSize: 15.0, weight: .medium)
+    let attributes: [NSAttributedString.Key: Any] = [
+        .font: font,
+        .foregroundColor: UIColor.black
+    ]
+    let measured = (title as NSString).size(withAttributes: attributes)
+    let size = CGSize(width: ceil(measured.width) + 8.0,
+                      height: max(24.0, ceil(measured.height) + 4.0))
+    let renderer = UIGraphicsImageRenderer(size: size)
+    let image = renderer.image { _ in
+        let rect = CGRect(x: (size.width - measured.width) * 0.5,
+                          y: (size.height - measured.height) * 0.5,
+                          width: measured.width, height: measured.height)
+        (title as NSString).draw(in: rect, withAttributes: attributes)
+    }
+    return image.withRenderingMode(.alwaysTemplate)
+}
