+static UIImage *AWECreateLowResolutionBackdropSnapshot(void) {
+    UIWindow *window = AWEActiveMainWindow();
+    if (!window || !window.windowScene) return nil;
+    CGSize size = window.bounds.size;
+    if (size.width < 100.0 || size.height < 200.0) return nil;
+    UIGraphicsImageRendererFormat *format = [UIGraphicsImageRendererFormat defaultFormat];
+    format.opaque = YES;
+    /* ~0.16x keeps a 390x844 screen near 62x135 pixels. */
+    format.scale = 0.16;
+    UIGraphicsImageRenderer *renderer = [[UIGraphicsImageRenderer alloc]
+        initWithSize:size format:format];
+    return [renderer imageWithActions:^(UIGraphicsImageRendererContext *context) {
+        (void)context;
+        [window drawViewHierarchyInRect:window.bounds afterScreenUpdates:NO];
+    }];
+}
+
+static void AWEApplyEventDrivenTransparentContrast(CGFloat luma,
+                                                     NSString *reason) {
+    if (luma < 0.0) return;
+    BOOL previous = gAWETransparentBackdropForegroundLight;
+    BOOL next = previous;
+    if (!gAWETransparentBackdropContrastValid) {
+        next = luma < 0.50;
+    } else if (previous) {
+        if (luma > 0.60) next = NO;
+    } else if (luma < 0.40) {
+        next = YES;
+    }
+    gAWETransparentBackdropLastLuma = luma;
+    gAWETransparentBackdropContrastValid = YES;
+    gAWETransparentBackdropForegroundLight = next;
+
+    UIColor *foreground = next ? UIColor.whiteColor : UIColor.blackColor;
+    for (UIButton *button in AWEAdaptiveGlassButtonRegistry().allObjects) {
+        if ([objc_getAssociatedObject(button, &kAWEAdaptiveGlassAutomaticContrastKey) boolValue]) {
+            AWEApplyAutomaticContrastForeground(button, next);
+        }
+    }
+    if (AWEIOS27WantsClearBottomMaterial()) {
+        UITabBar *bar = gAWEAlbumMorphController.tabBar;
+        if (bar) {
+            bar.tintColor = foreground;
+            bar.unselectedItemTintColor = foreground;
+        }
+    }
+    AWEScheduleHomeChromeRecovery(AWEActiveMainWindow());
+    if (AWEInteractionDiagnosticsEnabled()) {
+        AWEInteractionDiagnosticWrite(@"CLEAR_CONTRAST_V19 reason=%@ luma=%.3f light=%d changed=%d",
+            reason ?: @"unknown", luma, next, next != previous);
+    }
+}
+
+static void AWEPerformEventDrivenTransparentContrastSample(NSString *reason) {
+    if (!(AWEHomeTransparentGlassEnabled() || AWEIOS27WantsClearBottomMaterial())) return;
+    if (!AWEIndexUsesHomeVisualPolicy(AWECurrentMainTabIndex())) return;
+    CFTimeInterval now = CACurrentMediaTime();
+    if (now - gAWETransparentBackdropLastSampleTime < 0.16) return;
+    gAWETransparentBackdropLastSampleTime = now;
+    UIImage *image = AWECreateLowResolutionBackdropSnapshot();
+    if (!image) return;
+    CGSize screen = UIScreen.mainScreen.bounds.size;
+    const CGPoint points[] = {
+        {screen.width * 0.20, screen.height * 0.18},
+        {screen.width * 0.50, screen.height * 0.18},
+        {screen.width * 0.78, screen.height * 0.32},
+        {screen.width * 0.78, screen.height * 0.52},
+        {screen.width * 0.22, screen.height * 0.78},
+        {screen.width * 0.52, screen.height * 0.78}
+    };
+    CGFloat values[6]; NSUInteger count = 0;
+    for (NSUInteger i = 0; i < 6; i++) {
+        CGFloat value = AWEIOS27AverageLumaInPatch(image, points[i], 34.0);
+        if (value >= 0.0) values[count++] = value;
+    }
+    if (count < 3) return;
+    CGFloat sorted[6]; memcpy(sorted, values, sizeof(CGFloat) * count);
+    AWEApplyEventDrivenTransparentContrast(AWEIOS27MedianLuma(sorted, count), reason);
+}
+
+static void AWEScheduleEventDrivenTransparentContrast(NSString *reason) {
+    if (!(AWEHomeTransparentGlassEnabled() || AWEIOS27WantsClearBottomMaterial())) return;
+    NSUInteger generation = ++gAWETransparentBackdropSampleGeneration;
+    for (NSNumber *delay in @[@0.10, @0.34]) {
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW,
+            (int64_t)(delay.doubleValue * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+            if (generation != gAWETransparentBackdropSampleGeneration) return;
+            AWEPerformEventDrivenTransparentContrastSample(reason);
+        });
+    }
+}
