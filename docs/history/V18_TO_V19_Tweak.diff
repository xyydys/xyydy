+static void AWERefreshAvatarMenuIfNeeded(AWEHomeProfileGlassView *slot,
+                                         UIView *stack,
+                                         UIView *profileHost) {
+    if (!slot.menuButton || !stack || !profileHost) return;
+    NSString *signature = AWEAvatarMenuSignatureForStack(stack, profileHost);
+    NSString *previous = objc_getAssociatedObject(
+        slot.menuButton, &kAWEAvatarMenuSignatureKey);
+    if (slot.menuButton.menu && [previous isEqualToString:signature]) return;
+
+    /* Resolve appearance once for this menu generation, before UIMenu is
+       assigned. Crucially, do not mutate style/menu on every feed layout pass:
+       UIKit's live context-menu selection tracking must remain uninterrupted. */
+    UIUserInterfaceStyle menuStyle = AWEAdaptiveButtonResolvedLocalStyle(slot.glassButton);
+    if (menuStyle != UIUserInterfaceStyleLight && menuStyle != UIUserInterfaceStyleDark) {
+        menuStyle = AWEAppResolvedAppearanceStyle(stack.window);
+    }
+    if (menuStyle != UIUserInterfaceStyleLight && menuStyle != UIUserInterfaceStyleDark) {
+        menuStyle = AWESystemInterfaceStyle();
+    }
+    NSNumber *oldStyle = objc_getAssociatedObject(slot.menuButton, &kAWEAvatarMenuStyleKey);
+    if (!oldStyle || oldStyle.integerValue != menuStyle) {
+        slot.menuButton.overrideUserInterfaceStyle = menuStyle;
+        objc_setAssociatedObject(slot.menuButton, &kAWEAvatarMenuStyleKey,
+                                 @(menuStyle), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    }
+    slot.menuButton.menu = AWEAvatarBaseMenuForStack(stack, profileHost);
+    slot.menuButton.showsMenuAsPrimaryAction = YES;
+    objc_setAssociatedObject(slot.menuButton, &kAWEAvatarMenuSignatureKey,
+                             signature, OBJC_ASSOCIATION_COPY_NONATOMIC);
+}
