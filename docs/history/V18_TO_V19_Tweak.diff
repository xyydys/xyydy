+static BOOL AWEClassNameLooksLikeShareForwardDestinationV19(NSString *className) {
+    NSString *lower = className.lowercaseString;
+    return [lower containsString:@"share"] || [lower containsString:@"forward"] ||
+           [lower containsString:@"transpond"] || [lower containsString:@"sendpanel"];
+}
+
+static UIVisualEffect *AWEShareGlassEffectV19(void) {
+    if (AWEShareGlassMode() == 0) return AWECreateHomeAdaptiveGlassEffect();
+    Class glassClass = NSClassFromString(@"UIGlassEffect");
+    SEL maker = NSSelectorFromString(@"effectWithStyle:");
+    id effect = (glassClass && [glassClass respondsToSelector:maker])
+        ? ((id (*)(id, SEL, NSInteger))objc_msgSend)(glassClass, maker, 1) : nil;
+    if ([effect respondsToSelector:NSSelectorFromString(@"setInteractive:")])
+        ((void (*)(id, SEL, BOOL))objc_msgSend)(effect,
+            NSSelectorFromString(@"setInteractive:"), NO);
+    if ([effect respondsToSelector:NSSelectorFromString(@"setTintColor:")])
+        ((void (*)(id, SEL, id))objc_msgSend)(effect,
+            NSSelectorFromString(@"setTintColor:"), nil);
+    return [effect isKindOfClass:UIVisualEffect.class]
+        ? (UIVisualEffect *)effect : AWECreateHomeAdaptiveGlassEffect();
+}
+
+static BOOL AWEShareCandidateLooksLikeAvatarV19(UIView *view) {
+    if (![view isKindOfClass:UIImageView.class]) return NO;
+    CGFloat w = CGRectGetWidth(view.bounds), h = CGRectGetHeight(view.bounds);
+    if (w < 32.0 || w > 86.0 || h < 32.0 || h > 86.0) return NO;
+    CGFloat ratio = MIN(w,h) / MAX(MAX(w,h), 1.0);
+    return ratio > 0.82 && (view.layer.cornerRadius >= MIN(w,h) * 0.28 || view.clipsToBounds);
+}
+
+static BOOL AWEShareCandidateLooksLikeActionV19(UIView *view) {
+    CGFloat w = CGRectGetWidth(view.bounds), h = CGRectGetHeight(view.bounds);
+    if (w < 34.0 || w > 110.0 || h < 34.0 || h > 100.0) return NO;
+    if ([view isKindOfClass:UIControl.class]) return YES;
+    NSString *lower = NSStringFromClass(view.class).lowercaseString;
+    return [lower containsString:@"button"] || [lower containsString:@"action"] ||
+           [lower containsString:@"item"];
+}
+
+static void AWEInstallShareGlassPlateV19(UIView *candidate, BOOL circle) {
+    if (!candidate.superview || candidate.hidden || candidate.alpha < 0.01) return;
+    UIVisualEffectView *plate = objc_getAssociatedObject(candidate, &kAWEShareGlassPlateKey);
+    if (!plate) {
+        plate = [[UIVisualEffectView alloc] initWithEffect:AWEShareGlassEffectV19()];
+        plate.userInteractionEnabled = NO;
+        plate.clipsToBounds = YES;
+        objc_setAssociatedObject(candidate, &kAWEShareGlassPlateKey, plate,
+                                 OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        [candidate.superview insertSubview:plate belowSubview:candidate];
+    } else if (plate.superview != candidate.superview) {
+        [plate removeFromSuperview];
+        [candidate.superview insertSubview:plate belowSubview:candidate];
+    }
+    plate.effect = AWEShareGlassEffectV19();
+    CGRect frame = candidate.frame;
+    CGFloat pad = circle ? 3.0 : 2.0;
+    frame = CGRectInset(frame, -pad, -pad);
+    plate.frame = frame;
+    plate.layer.cornerCurve = kCACornerCurveContinuous;
+    plate.layer.cornerRadius = circle ? CGRectGetHeight(frame) * 0.5
+                                      : MIN(18.0, CGRectGetHeight(frame) * 0.42);
+}
+
+static void AWEApplyShareSheetGlassV19(UIViewController *controller,
+                                       NSString *reason) {
+    if (!controller || !controller.viewIfLoaded.window || !AWEShareGlassEnabled() ||
+        AWEOperatingSystemMajorVersion() < 26) return;
+    UIView *root = controller.view;
+    root.backgroundColor = UIColor.clearColor;
+    UIVisualEffectView *background = objc_getAssociatedObject(
+        controller, &kAWEShareGlassBackgroundKey);
+    if (!background) {
+        background = [[UIVisualEffectView alloc] initWithEffect:AWEShareGlassEffectV19()];
+        background.userInteractionEnabled = NO;
+        background.autoresizingMask = UIViewAutoresizingFlexibleWidth |
+                                      UIViewAutoresizingFlexibleHeight;
+        background.frame = root.bounds;
+        [root insertSubview:background atIndex:0];
+        objc_setAssociatedObject(controller, &kAWEShareGlassBackgroundKey,
+                                 background, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    }
+    background.effect = AWEShareGlassEffectV19();
+    background.frame = root.bounds;
+    [root sendSubviewToBack:background];
+
+    NSMutableArray<NSArray *> *queue = [NSMutableArray arrayWithObject:@[root,@0]];
+    NSUInteger index = 0, buttons = 0, avatars = 0;
+    while (index < queue.count && index < 520) {
+        NSArray *entry = queue[index++]; UIView *view = entry[0];
+        NSUInteger depth = [entry[1] unsignedIntegerValue];
+        if (depth < 12) for (UIView *child in view.subviews)
+            if (child != background) [queue addObject:@[child,@(depth+1)]];
+        if (view == root || view == background) continue;
+        CGRect frame = [view convertRect:view.bounds toView:root];
+        BOOL largeBackdrop = CGRectGetWidth(frame) >= CGRectGetWidth(root.bounds) * 0.86 &&
+                             CGRectGetHeight(frame) >= CGRectGetHeight(root.bounds) * 0.30;
+        if (largeBackdrop && ![view isKindOfClass:UIControl.class] &&
+            ![view isKindOfClass:UILabel.class] && ![view isKindOfClass:UIImageView.class]) {
+            view.backgroundColor = UIColor.clearColor;
+            view.layer.backgroundColor = UIColor.clearColor.CGColor;
+            view.opaque = NO;
+        }
+        if (AWEShareCandidateLooksLikeAvatarV19(view)) {
+            AWEInstallShareGlassPlateV19(view, YES); avatars++;
+        } else if (AWEShareCandidateLooksLikeActionV19(view)) {
+            AWEInstallShareGlassPlateV19(view, NO); buttons++;
+        }
+    }
+    if (AWEInteractionDiagnosticsEnabled()) {
+        AWEInteractionDiagnosticWrite(@"SHARE_GLASS_V19 reason=%@ class=%@ buttons=%lu avatars=%lu mode=%ld",
+            reason ?: @"unknown", NSStringFromClass(controller.class),
+            (unsigned long)buttons, (unsigned long)avatars, (long)AWEShareGlassMode());
+    }
+}
+
+static void AWEScheduleShareSheetGlassV19(UIViewController *controller,
+                                          NSString *reason) {
+    if (!AWEShareGlassEnabled() || !controller) return;
+    __weak UIViewController *weakController = controller;
+    for (NSNumber *delay in @[@0.0,@0.08,@0.24]) {
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW,
+            (int64_t)(delay.doubleValue*NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+            UIViewController *live = weakController;
+            if (live.viewIfLoaded.window) AWEApplyShareSheetGlassV19(live, reason);
+        });
+    }
+}
