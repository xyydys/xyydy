+static BOOL AWEForwardHomeActionKindFromStack(UIView *stack,
+                                               AWEHomeActionKind kind,
+                                               UIView **ownerInOut) {
+    if (!stack || kind == AWEHomeActionKindUnknown) return NO;
+    NSArray<UIView *> *ordered = AWESortedVisibleHomeActionButtons(stack);
+    UIView *owner = ownerInOut ? *ownerInOut : nil;
+    NSString *context = [NSString stringWithFormat:@"RIGHT_KIND_%ld", (long)kind];
+    if (owner && owner.window && AWEViewIsDescendantOfView(owner, stack) &&
+        AWEHomeActionKindForButton(owner, ordered) == kind) {
+        if (AWEForwardExactNativeTapFromView(owner, context)) return YES;
+    }
+    for (UIView *candidate in ordered) {
+        if (candidate == owner) continue;
+        if (AWEHomeActionKindForButton(candidate, ordered) != kind) continue;
+        if (ownerInOut) *ownerInOut = candidate;
+        if (AWEForwardExactNativeTapFromView(candidate, context)) return YES;
+    }
+    return NO;
+}
