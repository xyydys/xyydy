+/*
+ Exact native-action forwarding for the visible Liquid Glass controls.
+
+ The glass UIButton stays the real touch owner, so UIKit keeps its genuine
+ Liquid Glass press/stretch behavior.  We do not clone/reparent Douyin's
+ recognizer and we do not synthesize a foreign UITouch.  On TouchUpInside we
+ locate the original tap recognizer on the original Douyin source hierarchy
+ and invoke its original target/action with THAT recognizer as sender.
+
+ This distinction matters for private recognizers such as AWEAlphaTapGesture:
+ handlers can inspect recognizer.view/state/private metadata, so a cloned
+ recognizer may make UIApplication report a successful send while the business
+ action itself silently ignores it.
+*/
+static NSInteger AWEExactTapRecognizerScore(UIGestureRecognizer *recognizer,
+                                             UIView *sourceView,
+                                             NSUInteger depth) {
+    if (!recognizer || !recognizer.enabled) return NSIntegerMin;
+    NSString *name = NSStringFromClass(recognizer.class).lowercaseString;
+    if ([name containsString:@"long"] || [name containsString:@"pan"] ||
+        [name containsString:@"swipe"] || [name containsString:@"pinch"] ||
+        [name containsString:@"rotation"]) return NSIntegerMin;
+    BOOL tapLike = [recognizer isKindOfClass:UITapGestureRecognizer.class] ||
+        [name containsString:@"tap"] || [name containsString:@"click"];
+    if (!tapLike) return NSIntegerMin;
+
+    NSInteger score = 100 - (NSInteger)MIN(depth, 12u) * 5;
+    if (recognizer.view == sourceView) score += 55;
+    if ([name containsString:@"alphatap"]) score += 120;
+    if ([name containsString:@"touchup"]) score += 75;
+    if ([name containsString:@"click"]) score += 45;
+
+    id containers = AWEObjectIvar(recognizer, "_targets");
+    if (![containers isKindOfClass:NSArray.class]) {
+        @try { containers = [recognizer valueForKey:@"_targets"]; }
+        @catch (__unused NSException *exception) { containers = nil; }
+    }
+    if ([containers isKindOfClass:NSArray.class]) {
+        for (id container in (NSArray *)containers) {
+            SEL action = AWESelectorIvar(container, "_action");
+            NSString *actionName = action ? NSStringFromSelector(action).lowercaseString : @"";
+            if ([actionName containsString:@"touchup"] ||
+                [actionName containsString:@"tap"] ||
+                [actionName containsString:@"click"]) score += 70;
+            if ([actionName containsString:@"long"] ||
+                [actionName containsString:@"double"]) score -= 120;
+        }
+    }
+    return score;
+}
+
+static BOOL AWEInvokeExactNativeRecognizer(UIGestureRecognizer *recognizer,
+                                           NSString *context) {
+    if (!recognizer || !recognizer.enabled || !recognizer.view) return NO;
+    id targetContainers = AWEObjectIvar(recognizer, "_targets");
+    if (![targetContainers isKindOfClass:NSArray.class]) {
+        @try { targetContainers = [recognizer valueForKey:@"_targets"]; }
+        @catch (__unused NSException *exception) { targetContainers = nil; }
+    }
+    if (![targetContainers isKindOfClass:NSArray.class] ||
+        [(NSArray *)targetContainers count] == 0) {
+        AWEInteractionDiagnosticWrite(
+            @"EXACT_NATIVE_FORWARD context=%@ stage=no-targets recognizer=%@ view=%@",
+            context ?: @"unknown", NSStringFromClass(recognizer.class),
+            AWEInteractionObjectSummary(recognizer.view));
+        return NO;
+    }
+
+    NSInteger oldState = recognizer.state;
+    BOOL changedState = AWESetIntegerIvar(
+        recognizer, "_state_DO_NOT_USE_DIRECTLY",
+        UIGestureRecognizerStateEnded, &oldState);
+    BOOL dispatched = NO;
+    NSUInteger validTargets = 0;
+    for (id container in [(NSArray *)targetContainers copy]) {
+        id target = AWEObjectIvar(container, "_target");
+        SEL action = AWESelectorIvar(container, "_action");
+        if (!target || !action || ![target respondsToSelector:action]) continue;
+        validTargets++;
+        BOOL sent = NO;
+        @try {
+            sent = [[UIApplication sharedApplication] sendAction:action
+                                                              to:target
+                                                            from:recognizer
+                                                        forEvent:nil];
+        } @catch (__unused NSException *exception) {
+            sent = NO;
+        }
+        dispatched = dispatched || sent;
+        AWEInteractionDiagnosticWrite(
+            @"EXACT_NATIVE_FORWARD context=%@ recognizer=%@ sourceView=%@ target=%@ action=%@ state=%ld dispatched=%d",
+            context ?: @"unknown", NSStringFromClass(recognizer.class),
+            AWEInteractionObjectSummary(recognizer.view),
+            NSStringFromClass([target class]), NSStringFromSelector(action),
+            (long)recognizer.state, sent);
+    }
+    if (changedState) {
+        AWESetIntegerIvar(recognizer, "_state_DO_NOT_USE_DIRECTLY", oldState, NULL);
+    }
+    if (validTargets == 0) {
+        AWEInteractionDiagnosticWrite(
+            @"EXACT_NATIVE_FORWARD context=%@ stage=no-valid-target recognizer=%@",
+            context ?: @"unknown", NSStringFromClass(recognizer.class));
+    }
+    return dispatched;
+}
+
+static BOOL AWEForwardExactNativeTapFromView(UIView *sourceView,
+                                              NSString *context) {
+    if (!sourceView || !sourceView.window) {
+        AWEInteractionDiagnosticWrite(
+            @"EXACT_NATIVE_FORWARD context=%@ stage=source-not-live source=%@",
+            context ?: @"unknown", AWEInteractionObjectSummary(sourceView));
+        return NO;
+    }
+
+    NSMutableArray<NSDictionary *> *candidates = [NSMutableArray array];
+    NSMutableArray<NSDictionary *> *queue = [NSMutableArray arrayWithObject:
+        @{@"view": sourceView, @"depth": @0}];
+    NSUInteger visited = 0;
+    while (queue.count > 0 && visited < 64) {
+        NSDictionary *entry = queue.firstObject;
+        [queue removeObjectAtIndex:0];
+        UIView *view = entry[@"view"];
+        NSUInteger depth = [entry[@"depth"] unsignedIntegerValue];
+        if (!view) continue;
+        visited++;
+        for (UIGestureRecognizer *recognizer in view.gestureRecognizers) {
+            NSInteger score = AWEExactTapRecognizerScore(recognizer, sourceView, depth);
+            if (score == NSIntegerMin) continue;
+            [candidates addObject:@{@"recognizer": recognizer, @"score": @(score)}];
+        }
+        if (depth < 7) {
+            for (UIView *child in view.subviews) {
+                [queue addObject:@{@"view": child, @"depth": @(depth + 1)}];
+            }
+        }
+    }
+    [candidates sortUsingComparator:^NSComparisonResult(NSDictionary *lhs,
+                                                         NSDictionary *rhs) {
+        NSInteger a = [lhs[@"score"] integerValue];
+        NSInteger b = [rhs[@"score"] integerValue];
+        if (a > b) return NSOrderedAscending;
+        if (a < b) return NSOrderedDescending;
+        return NSOrderedSame;
+    }];
+
+    for (NSDictionary *entry in candidates) {
+        UIGestureRecognizer *recognizer = entry[@"recognizer"];
+        AWEInteractionDiagnosticWrite(
+            @"EXACT_NATIVE_CANDIDATE context=%@ score=%ld recognizer=%@ recognizerView=%@ source=%@",
+            context ?: @"unknown", (long)[entry[@"score"] integerValue],
+            NSStringFromClass(recognizer.class),
+            AWEInteractionObjectSummary(recognizer.view),
+            AWEInteractionObjectSummary(sourceView));
+        if (AWEInvokeExactNativeRecognizer(recognizer, context)) return YES;
+    }
+
+    /* UIControl is a conservative fallback only after every real tap
+       recognizer has been tried.  This prevents a decorative internal control
+       from producing the false-positive result seen in the v15 log. */
+    NSMutableArray<UIView *> *controlQueue = [NSMutableArray arrayWithObject:sourceView];
+    visited = 0;
+    while (controlQueue.count > 0 && visited < 48) {
+        UIView *view = controlQueue.firstObject;
+        [controlQueue removeObjectAtIndex:0];
+        visited++;
+        if ([view isKindOfClass:UIControl.class]) {
+            UIControl *control = (UIControl *)view;
+            UIControlEvents chosen = 0;
+            for (id target in control.allTargets) {
+                if ([control actionsForTarget:target
+                              forControlEvent:UIControlEventTouchUpInside].count) {
+                    chosen = UIControlEventTouchUpInside;
+                    break;
+                }
+                if ([control actionsForTarget:target
+                              forControlEvent:UIControlEventPrimaryActionTriggered].count) {
+                    chosen = UIControlEventPrimaryActionTriggered;
+                }
+            }
+            if (chosen) {
+                [control sendActionsForControlEvents:chosen];
+                AWEInteractionDiagnosticWrite(
+                    @"EXACT_NATIVE_FORWARD context=%@ path=control-fallback control=%@ event=%llu",
+                    context ?: @"unknown", AWEInteractionObjectSummary(control),
+                    (unsigned long long)chosen);
+                return YES;
+            }
+        }
+        for (UIView *child in view.subviews) [controlQueue addObject:child];
+    }
+
+    BOOL activated = NO;
+    @try { activated = [sourceView accessibilityActivate]; }
+    @catch (__unused NSException *exception) { activated = NO; }
+    AWEInteractionDiagnosticWrite(
+        @"EXACT_NATIVE_FORWARD context=%@ path=accessibility result=%d source=%@ candidates=%lu",
+        context ?: @"unknown", activated, AWEInteractionObjectSummary(sourceView),
+        (unsigned long)candidates.count);
+    return activated;
+}
