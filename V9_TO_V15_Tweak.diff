+static CGFloat AWESettingsResponsiveScaleForWidth(CGFloat width) {
+    if (width <= 350.0) return 0.76;
+    if (width <= 360.0) return 0.78;
+    if (width <= 375.0) return 0.82;
+    if (width <= 390.0) return 0.86;
+    if (width <= 402.0) return 0.90;
+    if (width <= 414.0) return 0.94;
+    return 1.0;
+}
+
+static void AWEApplyResponsiveSettingsTypography(UIView *root, CGFloat scale) {
+    if (!root) return;
+    if ([root isKindOfClass:UILabel.class]) {
+        UILabel *label = (UILabel *)root;
+        UIFont *base = objc_getAssociatedObject(label, &kAWESettingsOriginalFontKey);
+        if (!base && label.font) {
+            base = label.font;
+            objc_setAssociatedObject(label, &kAWESettingsOriginalFontKey, base,
+                                     OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        }
+        if (base) {
+            CGFloat point = MAX(9.0, base.pointSize * scale);
+            label.font = [base fontWithSize:point];
+        }
+        if (label.numberOfLines == 1) {
+            label.adjustsFontSizeToFitWidth = YES;
+            label.minimumScaleFactor = 0.68;
+            label.lineBreakMode = NSLineBreakByTruncatingTail;
+        }
+        [label setContentCompressionResistancePriority:UILayoutPriorityDefaultLow
+                                                   forAxis:UILayoutConstraintAxisHorizontal];
+        [label setContentHuggingPriority:UILayoutPriorityDefaultLow
+                                 forAxis:UILayoutConstraintAxisHorizontal];
+    } else if ([root isKindOfClass:UISwitch.class]) {
+        [root setContentCompressionResistancePriority:UILayoutPriorityRequired
+                                              forAxis:UILayoutConstraintAxisHorizontal];
+        [root setContentHuggingPriority:UILayoutPriorityRequired
+                                forAxis:UILayoutConstraintAxisHorizontal];
+    } else if ([root isKindOfClass:UIButton.class]) {
+        UIButton *button = (UIButton *)root;
+        if (button.titleLabel) {
+            button.titleLabel.adjustsFontSizeToFitWidth = YES;
+            button.titleLabel.minimumScaleFactor = 0.72;
+        }
+    }
+    for (UIView *child in root.subviews) {
+        AWEApplyResponsiveSettingsTypography(child, scale);
+    }
+}
