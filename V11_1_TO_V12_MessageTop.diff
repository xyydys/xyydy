+/* Same verified rule as the supplied VVebo solution: anything expected to
+   stretch with native Liquid Glass must sit inside UIButtonConfiguration's
+   content hierarchy, not beside the glass as an ordinary sibling/subview. */
+static UIView *AWEMessageGlassNativeContentContainer(UIButton *button) {
+    if (!button) return nil;
+    [button layoutIfNeeded];
+    UIView *p = button.titleLabel.superview;
+    if (p && p != button) return p;
+    p = button.imageView.superview;
+    if (p && p != button) return p;
+    UIButtonConfiguration *cfg = button.configuration;
+    if (cfg) {
+        UIButtonConfiguration *copy = [cfg copy];
+        copy.title = @" ";
+        copy.baseForegroundColor = UIColor.clearColor;
+        button.configuration = copy;
+        [button layoutIfNeeded];
+        p = button.titleLabel.superview;
+        if (p && p != button) return p;
+        p = button.imageView.superview;
+        if (p && p != button) return p;
+    }
+    return button;
+}
