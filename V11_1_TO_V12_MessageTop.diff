+static UIImage *AWEMessageLiveOrSavedImage(UIImageView *imageView) {
+    if (!imageView) return nil;
+    if (imageView.image) return imageView.image;
+    id saved = objc_getAssociatedObject(imageView, &kAWEMessageSavedImageKey);
+    return [saved isKindOfClass:UIImage.class] ? (UIImage *)saved : nil;
+}
+
+static UIImageView *AWEMessageBestIconImageView(UIView *source) {
+    if (!source) return nil;
+    if ([source isKindOfClass:UIImageView.class] &&
+        AWEMessageLiveOrSavedImage((UIImageView *)source))
+        return (UIImageView *)source;
+    UIImageView *best = nil;
+    CGFloat bestScore = -CGFLOAT_MAX;
+    for (UIView *v in AWEMessageSubviews(source, 100)) {
+        if (![v isKindOfClass:UIImageView.class]) continue;
+        UIImageView *iv = (UIImageView *)v;
+        if (!AWEMessageLiveOrSavedImage(iv) || iv.hidden || iv.alpha <= 0.01) continue;
+        CGRect r = [iv convertRect:iv.bounds toView:source];
+        CGFloat w = CGRectGetWidth(r), h = CGRectGetHeight(r);
+        if (w < 10.0 || h < 10.0 || w > 42.0 || h > 42.0) continue;
+        CGFloat score = MIN(w,h) * 10.0 - fabs(w-h) * 4.0;
+        if (score > bestScore) { bestScore = score; best = iv; }
+    }
+    return best;
+}
