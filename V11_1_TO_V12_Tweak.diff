+/* v12: passive-native tracking bridge. The user touches Douyin's real
+   control, so its business action is never synthesized or intercepted. We
+   mirror that *same UITouch/UIEvent* into the visual Glass UIButton's public
+   UIControl tracking lifecycle. UIKit therefore owns highlighted state,
+   touch-location distortion and release spring, while the glass button itself
+   remains outside hit testing. This is materially different from the older
+   scale-only long-press imitation. */
+#ifdef __cplusplus
+extern "C"
+#endif
+void AWERegisterNativeGlassTrackingMirror(UIView *touchOwner,
+                                          UIButton *glassButton) {
+    if (!touchOwner || !glassButton) return;
+    if (!gAWEGlassNativeTrackingMirrors) {
+        gAWEGlassNativeTrackingMirrors = [NSMapTable weakToWeakObjectsMapTable];
+    }
+    UIView *oldOwner = objc_getAssociatedObject(
+        glassButton, &kAWEGlassNativeTrackingOwnerKey);
+    if (oldOwner && oldOwner != touchOwner) {
+        [gAWEGlassNativeTrackingMirrors removeObjectForKey:oldOwner];
+    }
+    objc_setAssociatedObject(glassButton, &kAWEGlassNativeTrackingOwnerKey,
+                             touchOwner, OBJC_ASSOCIATION_ASSIGN);
+    [gAWEGlassNativeTrackingMirrors setObject:glassButton forKey:touchOwner];
+}
+
+static BOOL AWEGlassTouchBelongsToOwner(UITouch *touch, UIView *owner) {
+    if (!touch || !owner || !owner.window) return NO;
+    UIView *view = touch.view;
+    if (view == owner || [view isDescendantOfView:owner]) return YES;
+    /* Some private Douyin controls put their tap recognizer on a compact
+       ancestor while UIKit reports the visual child as touch.view. Geometry
+       is a safe secondary check only when both are in the same window. */
+    if (view.window != owner.window) return NO;
+    CGPoint p = [touch locationInView:owner];
+    CGRect hit = CGRectInset(owner.bounds, -3.0, -3.0);
+    return CGRectContainsPoint(hit, p) && owner.userInteractionEnabled;
+}
+
+static void AWEGlassMirrorNativeTrackingEvent(UIEvent *event) {
+    if (!event || !gAWEGlassNativeTrackingMirrors ||
+        gAWEGlassNativeTrackingMirrors.count == 0) return;
