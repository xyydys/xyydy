+static void AWEPlaceForegroundInsideGlassContent(UIButton *button,
+                                                  UIView *foreground,
+                                                  CGRect frameInButton) {
+    if (!button || !foreground) return;
+    UIView *content = AWEGlassNativeContentContainer(button) ?: button;
+    if (foreground.superview != content) {
+        [foreground removeFromSuperview];
+        [content addSubview:foreground];
+    }
+    CGRect converted = content == button
+        ? frameInButton
+        : [button convertRect:frameInButton toView:content];
+    foreground.frame = converted;
+    [content bringSubviewToFront:foreground];
+}
