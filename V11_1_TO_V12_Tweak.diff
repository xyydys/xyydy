+                        [glass setNeedsUpdateConfiguration];
+                    }
+                    objc_setAssociatedObject(glass, &kAWEGlassNativeTrackingTouchKey,
+                                             nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+                    objc_setAssociatedObject(glass, &kAWEGlassNativeTrackingAcceptedKey,
+                                             nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+                    active = nil;
+                } else if (phase == UITouchPhaseCancelled) {
+                    if (accepted) [glass cancelTrackingWithEvent:event];
