+/* v12 / VVebo verified content-warp rule: foreground content that must deform
+   with Liquid Glass belongs inside UIKit's UIButtonConfiguration content
+   container, not as a normal UIButton subview. A single blank configuration
+   title forces UIKit to materialise that container without rendering visible
+   text. */
+static UIView *AWEGlassNativeContentContainer(UIButton *button) {
+    if (!button) return nil;
+    [button layoutIfNeeded];
+    UIView *titleParent = button.titleLabel.superview;
+    if (titleParent && titleParent != button) return titleParent;
+    UIView *imageParent = button.imageView.superview;
+    if (imageParent && imageParent != button) return imageParent;
+
+    UIButtonConfiguration *cfg = button.configuration;
+    if (cfg) {
+        UIButtonConfiguration *copy = [cfg copy];
+        copy.title = @" ";
+        copy.baseForegroundColor = UIColor.clearColor;
+        button.configuration = copy;
+        [button layoutIfNeeded];
+        titleParent = button.titleLabel.superview;
+        if (titleParent && titleParent != button) return titleParent;
+        imageParent = button.imageView.superview;
+        if (imageParent && imageParent != button) return imageParent;
+    }
+    return button;
+}
