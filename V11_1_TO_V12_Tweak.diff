+    NSArray<UIView *> *owners = gAWEGlassNativeTrackingMirrors.keyEnumerator.allObjects;
+    for (UIView *owner in owners) {
+        UIButton *glass = [gAWEGlassNativeTrackingMirrors objectForKey:owner];
+        if (!owner || !glass || !owner.window || !glass.window || glass.hidden || glass.alpha < 0.01)
+            continue;
+
+        UITouch *active = nil;
+        NSValue *activeValue = objc_getAssociatedObject(glass, &kAWEGlassNativeTrackingTouchKey);
+        if ([activeValue isKindOfClass:NSValue.class]) active = activeValue.nonretainedObjectValue;
+
+        for (UITouch *touch in touches) {
+            UITouchPhase phase = touch.phase;
+            if (phase == UITouchPhaseBegan) {
+                if (active || !AWEGlassTouchBelongsToOwner(touch, owner)) continue;
+                objc_setAssociatedObject(glass, &kAWEGlassNativeTrackingTouchKey,
+                    [NSValue valueWithNonretainedObject:touch], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+                BOOL accepted = [glass beginTracking:touch withEvent:event];
+                objc_setAssociatedObject(glass, &kAWEGlassNativeTrackingAcceptedKey,
+                                         @(accepted), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
