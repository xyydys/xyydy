%hook AWENormalModeTabBar

- (void)layoutSubviews {
    %orig;
    AWEAttachNativeBar((UIView *)self);
    AWEInstallDelegateIfNeeded((UIView *)self);
    AWEInternalFSTabBarUpdate((UIView *)self);
    AWEClearOriginalTabBarBackdropTree((UIView *)self, 0);
    if (((UIView *)self).window && AWECurrentMainTabIndex() == 1 && AWESecondTabIsShop()) {
        AWEBottomV22ClearShopNativeBarFast((UIView *)self, @"native-tabbar");
    }
    if (((UIView *)self).window) {
        AWEProbeBottomBackdropCandidates(((UIView *)self).window, 0);
        AWEScheduleBottomWindowRefresh(((UIView *)self).window, @"tabbar");
    }
    if (gAWEStableCleanScreenEnabled) AWEStableCleanEnforceBottomBarSuppression();
}

- (void)didMoveToWindow {
    %orig;
    gAWELastTabBar = self;
    AWEAttachNativeBar((UIView *)self);
    AWEInstallDelegateIfNeeded((UIView *)self);
    AWEInternalFSTabBarUpdate((UIView *)self);
    AWEClearOriginalTabBarBackdropTree((UIView *)self, 0);
    if (((UIView *)self).window && AWECurrentMainTabIndex() == 1 && AWESecondTabIsShop()) {
        AWEBottomV22ClearShopNativeBarFast((UIView *)self, @"native-tabbar");
    }
    if (((UIView *)self).window) {
        AWEProbeBottomBackdropCandidates(((UIView *)self).window, 0);
        AWEScheduleBottomWindowRefresh(((UIView *)self).window, @"tabbar");
    }
    if (gAWEStableCleanScreenEnabled) AWEStableCleanEnforceBottomBarSuppression();
    AWELogBarSnapshot(@"original.didMoveToWindow", nil, YES);
    AWEScheduleTransitionRecovery();
}

- (void)didMoveToSuperview {
    %orig;
    gAWELastTabBar = self;
    AWEAttachNativeBar((UIView *)self);
    AWEInstallDelegateIfNeeded((UIView *)self);
    AWEInternalFSTabBarUpdate((UIView *)self);
    AWEClearOriginalTabBarBackdropTree((UIView *)self, 0);
    if (((UIView *)self).window && AWECurrentMainTabIndex() == 1 && AWESecondTabIsShop()) {
        AWEBottomV22ClearShopNativeBarFast((UIView *)self, @"native-tabbar");
    }
    if (((UIView *)self).window) {
        AWEProbeBottomBackdropCandidates(((UIView *)self).window, 0);
