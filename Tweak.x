    [NSUserDefaults.standardUserDefaults setInteger:style forKey:ALB5Key(@"bottom.style")];
    AWEShowDownloadToast(style == (NSInteger)ALBDockModeActive() ? @"底栏样式未变" : @"底栏样式已保存，重启抖音后生效");
}
- (void)nowPlayingChanged:(UISwitch *)sender {
    [NSUserDefaults.standardUserDefaults setBool:sender.on forKey:ALB5Key(@"playback.hideNowPlaying")];
    if(sender.on) ALB9ClearNowPlaying();
}
- (void)refreshOwnProfileCard {
    self.profileAvatar.image=ALB8OwnAvatar() ?: [UIImage systemImageNamed:@"person.crop.square.fill"];
    self.profileAvatar.layer.cornerRadius=78*ALB5Number(@"profile.avatarRadius",.26,0,.5);
    self.profileNameLabel.text=ALB8OwnName();
    NSString *signature=[NSUserDefaults.standardUserDefaults stringForKey:ALB5Key(@"profile.signature")];
    [self.profileSignatureButton setTitle:signature.length?signature:@"点击编辑签名" forState:UIControlStateNormal];
}
- (void)editProfileAvatarRadius:(UIButton *)sender {
    UIAlertController *sheet=[UIAlertController alertControllerWithTitle:@"头像圆角" message:nil preferredStyle:UIAlertControllerStyleActionSheet];
    NSArray *values=@[@0,@.15,@.26,@.38,@.5],*titles=@[@"方形",@"小圆角",@"圆角",@"大圆角",@"圆形"];
    for(NSUInteger i=0;i<values.count;i++)[sheet addAction:[UIAlertAction actionWithTitle:titles[i] style:UIAlertActionStyleDefault handler:^(__unused UIAlertAction *action) {
        [NSUserDefaults.standardUserDefaults setObject:values[i] forKey:ALB5Key(@"profile.avatarRadius")];[self refreshOwnProfileCard];
    }]];
    [sheet addAction:[UIAlertAction actionWithTitle:@"取消" style:UIAlertActionStyleCancel handler:nil]];
    sheet.popoverPresentationController.sourceView=sender;sheet.popoverPresentationController.sourceRect=sender.bounds;
    [self presentViewController:sheet animated:YES completion:nil];
}
- (void)editProfileSignature:(id)sender {
    UIAlertController *alert=[UIAlertController alertControllerWithTitle:@"个人签名" message:@"仅显示在 LiquidBar 设置页" preferredStyle:UIAlertControllerStyleAlert];
    [alert addTextFieldWithConfigurationHandler:^(UITextField *field) { field.placeholder=@"写下一句签名";field.text=[NSUserDefaults.standardUserDefaults stringForKey:ALB5Key(@"profile.signature")]; }];
    __weak typeof(self) weakSelf=self;
    [alert addAction:[UIAlertAction actionWithTitle:@"保存" style:UIAlertActionStyleDefault handler:^(__unused UIAlertAction *action) {
        NSString *text=alert.textFields.firstObject.text?:@"";if(text.length>80)text=[text substringWithRange:[text rangeOfComposedCharacterSequencesForRange:NSMakeRange(0,80)]];
        [NSUserDefaults.standardUserDefaults setObject:text forKey:ALB5Key(@"profile.signature")];[weakSelf refreshOwnProfileCard];
    }]];
    [alert addAction:[UIAlertAction actionWithTitle:@"取消" style:UIAlertActionStyleCancel handler:nil]];[self presentViewController:alert animated:YES completion:nil];
}
- (void)nativeMinimizeChanged:(UISwitch *)sender {
    [NSUserDefaults.standardUserDefaults setBool:sender.on forKey:kAWEAlbumMorphCollapseEnabledDefaultsKey];
    AWEInstallAlbumMorphCollapseGesture(AWEActiveMainWindow());
    [gAWEAlbumMorphController setNativeMinimizeEnabled:sender.on];
}

- (void)verticalOffsetSliderChanged:(UISlider *)sender {
    CGFloat snapped = round(sender.value * 2.0) / 2.0;
    sender.value = snapped;

    [[NSUserDefaults standardUserDefaults]
        setDouble:snapped
           forKey:kAWEVerticalOffsetDefaultsKey];
    [[NSUserDefaults standardUserDefaults] synchronize];
    [self updateVerticalOffsetLabel];
    // 3.11: the collapsing dock uses the same offset.
    [NSNotificationCenter.defaultCenter postNotificationName:@"ALBDock.VerticalOffsetChanged" object:nil];

    if (gAWEAlbumMorphController) {
        [gAWEAlbumMorphController setVerticalOffset:snapped];
        AWEAlbumMorphProbeWrite(
            @"HEIGHT_SLIDER_FIXED value=%.2f tabBar=%@",
            snapped,
            NSStringFromCGRect(gAWEAlbumMorphController.tabBar.frame));
        return;
    }

    /* The original five-button style keeps its existing carrier-frame path. */
    AWERefreshCurrentBarLayout();
}

- (void)doubleTapSplitSliderChanged:(UISlider *)sender {
    [[NSUserDefaults standardUserDefaults]
        setDouble:sender.value
           forKey:kAWEDoubleTapLikeFractionDefaultsKey];
    [self updateDoubleTapSplitLabel];
}

