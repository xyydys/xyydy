        %orig(YES);
        AWEScheduleHomeActionRefreshForButton(owner);
        return;
    }
    %orig(hidden);
}

- (void)setAlpha:(CGFloat)alpha {
    UIView *owner = AWEHomeActionSourceOwner((UIImageView *)self);
    if (owner) {
        %orig(0.0);
