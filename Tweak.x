@implementation AWELiquidSettingsController

- (void)viewDidLoad {
    [super viewDidLoad];
    self.title = @"LiquidBar · 3.11.53";
    self.pendingAccentColor = AWEStoredAccentColor();

    BOOL nativeSettingsPush =
        [objc_getAssociatedObject(self, &kAWELiquidSettingsNativePushKey) boolValue];
    self.view.opaque = NO;
    self.view.backgroundColor = UIColor.clearColor;
    if (!nativeSettingsPush) {
        self.navigationItem.rightBarButtonItem = [[UIBarButtonItem alloc]
            initWithBarButtonSystemItem:UIBarButtonSystemItemDone target:self action:@selector(closeSettings)];
    }
    ALBInstallSettingsGlass(self);

    UIColor *accent = self.pendingAccentColor ?: AWEStoredAccentColor();

    /* Personal card: one avatar, compact identity/accent controls, master switch. */
    UISwitch *masterSwitch = [UISwitch new];
    masterSwitch.on = AWEAuthorizationValid() && AWEMasterEnabledStored();
    masterSwitch.onTintColor = accent;
    [masterSwitch addTarget:self action:@selector(masterSwitchChanged:) forControlEvents:UIControlEventValueChanged];
    self.masterSwitch = masterSwitch;
    UIButton *avatarButton=[UIButton buttonWithType:UIButtonTypeCustom];
    avatarButton.translatesAutoresizingMaskIntoConstraints=NO;
    avatarButton.accessibilityLabel=@"调整自己头像的圆角";
    [avatarButton addTarget:self action:@selector(editProfileAvatarRadius:) forControlEvents:UIControlEventTouchUpInside];
    self.profileAvatarButton=avatarButton;
    UIImageView *avatar=[UIImageView new];avatar.translatesAutoresizingMaskIntoConstraints=NO;
    avatar.contentMode=UIViewContentModeScaleAspectFill;avatar.clipsToBounds=YES;
    avatar.layer.cornerCurve=kCACornerCurveContinuous;avatar.backgroundColor=UIColor.tertiarySystemFillColor;
    [avatarButton addSubview:avatar];self.profileAvatar=avatar;
    [NSLayoutConstraint activateConstraints:@[
        [avatarButton.widthAnchor constraintEqualToConstant:78], [avatarButton.heightAnchor constraintEqualToConstant:78],
        [avatar.leadingAnchor constraintEqualToAnchor:avatarButton.leadingAnchor], [avatar.trailingAnchor constraintEqualToAnchor:avatarButton.trailingAnchor],
        [avatar.topAnchor constraintEqualToAnchor:avatarButton.topAnchor], [avatar.bottomAnchor constraintEqualToAnchor:avatarButton.bottomAnchor]]];
    UILabel *name=[UILabel new];name.font=[UIFont systemFontOfSize:17 weight:UIFontWeightSemibold];
    name.textColor=UIColor.labelColor;name.numberOfLines=1;name.adjustsFontSizeToFitWidth=YES;name.minimumScaleFactor=.72;
    [name setContentCompressionResistancePriority:UILayoutPriorityDefaultLow forAxis:UILayoutConstraintAxisHorizontal];self.profileNameLabel=name;
    UIButton *signature=[UIButton buttonWithType:UIButtonTypeSystem];signature.contentHorizontalAlignment=UIControlContentHorizontalAlignmentLeft;
    signature.titleLabel.font=[UIFont systemFontOfSize:12];signature.titleLabel.lineBreakMode=NSLineBreakByTruncatingTail;
    [signature setTitleColor:UIColor.secondaryLabelColor forState:UIControlStateNormal];
    [signature setContentCompressionResistancePriority:UILayoutPriorityDefaultLow forAxis:UILayoutConstraintAxisHorizontal];
    [signature addTarget:self action:@selector(editProfileSignature:) forControlEvents:UIControlEventTouchUpInside];self.profileSignatureButton=signature;
    UIStackView *identity=[[UIStackView alloc]initWithArrangedSubviews:@[name,signature]];identity.axis=UILayoutConstraintAxisVertical;identity.spacing=1;
    UIButton *palette=AWECreateGlassTextButton(@"",accent,NO);self.profilePaletteButton=palette;
    UIButtonConfiguration *paletteConfig=palette.configuration;paletteConfig.image=[UIImage systemImageNamed:@"paintpalette.fill"];paletteConfig.title=nil;
    paletteConfig.contentInsets=NSDirectionalEdgeInsetsZero;palette.configuration=paletteConfig;palette.accessibilityLabel=@"全局强调色";
    [palette.widthAnchor constraintEqualToConstant:40].active=YES;
    [palette addTarget:self action:@selector(openAccentPicker:) forControlEvents:UIControlEventTouchUpInside];
    UIStackView *identityRow=[[UIStackView alloc]initWithArrangedSubviews:@[identity,palette]];identityRow.axis=UILayoutConstraintAxisHorizontal;identityRow.alignment=UIStackViewAlignmentCenter;identityRow.spacing=4;
    UILabel *enabledLabel=AWESettingsMakeLabel(@"LiquidBar",12,UIFontWeightMedium);
    UIStackView *switchRow=[[UIStackView alloc]initWithArrangedSubviews:@[enabledLabel,masterSwitch]];switchRow.axis=UILayoutConstraintAxisHorizontal;switchRow.alignment=UIStackViewAlignmentCenter;switchRow.spacing=8;
    [masterSwitch setContentHuggingPriority:UILayoutPriorityRequired forAxis:UILayoutConstraintAxisHorizontal];
    UIStackView *right=[[UIStackView alloc]initWithArrangedSubviews:@[identityRow,switchRow]];right.axis=UILayoutConstraintAxisVertical;right.spacing=6;
    UIStackView *profile=[[UIStackView alloc]initWithArrangedSubviews:@[avatarButton,right]];profile.axis=UILayoutConstraintAxisHorizontal;profile.alignment=UIStackViewAlignmentCenter;profile.spacing=12;
    UIView *basicCard=AWESettingsCard(nil,@[profile]);
    [NSNotificationCenter.defaultCenter addObserver:self selector:@selector(refreshOwnProfileCard) name:ALB8ProfileDidChange object:nil];
    [self refreshOwnProfileCard];ALB8RefreshOwnProfile();
    UIButton *albumButtonsButton=AWECreateGlassTextButton(@"液态底栏按钮",accent,YES);
    [albumButtonsButton addTarget:self action:@selector(openAlbumMorphButtonSettings:) forControlEvents:UIControlEventTouchUpInside];

    /* 底栏 */
    UILabel *positionValue = [UILabel new];
    positionValue.font = [UIFont monospacedDigitSystemFontOfSize:12.5 weight:UIFontWeightMedium];
    self.verticalOffsetValueLabel = positionValue;
    UISlider *positionSlider = [UISlider new];
    positionSlider.minimumValue = -24.0;
    positionSlider.maximumValue = 80.0;
    positionSlider.value = AWEStoredVerticalOffset();
    positionSlider.minimumTrackTintColor = accent;
    [positionSlider addTarget:self action:@selector(verticalOffsetSliderChanged:) forControlEvents:UIControlEventValueChanged];
    self.verticalOffsetSlider = positionSlider;
    UIStackView *positionRow = AWESettingsSliderRow(@"垂直位置", positionValue, positionSlider);

    /* 3.11: which bottom bar (needs a relaunch) and the collapsing dock's own page. */
    UISegmentedControl *bottomStyle = [[UISegmentedControl alloc] initWithItems:@[@"液态底栏", @"三段式底栏"]];
    bottomStyle.selectedSegmentIndex = ALBDockStyleStored();
    bottomStyle.selectedSegmentTintColor = accent;
    [bottomStyle addTarget:self action:@selector(bottomStyleChanged:) forControlEvents:UIControlEventValueChanged];
    self.bottomStyleControl = bottomStyle;
    UIButton *dockOptions = AWECreateGlassTextButton(@"三段式底栏",accent,YES);
    [dockOptions addTarget:self action:@selector(openDockOptions:) forControlEvents:UIControlEventTouchUpInside];
    NSMutableArray<UIView *> *bottomItems = [NSMutableArray arrayWithArray:@[
        AWESettingsSegmentedRow(@"底栏样式", bottomStyle), dockOptions, albumButtonsButton, positionRow]];
    if (AWECustomBottomBarReleaseAllowed()) {
        UISwitch *displaySwitch = [UISwitch new];
        displaySwitch.on = AWEBottomBarDisplayEnabled();
        displaySwitch.onTintColor = accent;
        [displaySwitch addTarget:self action:@selector(bottomBarDisplaySwitchChanged:) forControlEvents:UIControlEventValueChanged];
        self.bottomBarDisplaySwitch = displaySwitch;
        [bottomItems addObject:AWESettingsSwitchRow(@"显示液态底栏", displaySwitch)];
    }
    UISwitch *fullscreenSwitch = [UISwitch new];
    fullscreenSwitch.on = AWEInternalFullscreenEnabled();
    fullscreenSwitch.onTintColor = accent;
    [fullscreenSwitch addTarget:self action:@selector(internalFullscreenSwitchChanged:) forControlEvents:UIControlEventValueChanged];
    self.internalFullscreenSwitch = fullscreenSwitch;

    UISwitch *hideTitlesSwitch = [UISwitch new];
    hideTitlesSwitch.on = AWEHideBottomTitlesEnabled();
    hideTitlesSwitch.onTintColor = accent;
    [hideTitlesSwitch addTarget:self action:@selector(hideBottomTitlesSwitchChanged:) forControlEvents:UIControlEventValueChanged];
    self.hideBottomTitlesSwitch = hideTitlesSwitch;
    [bottomItems addObject:AWESettingsSwitchRow(@"隐藏底栏标题", hideTitlesSwitch)];

    UISwitch *badgeSwitch = [UISwitch new];
    badgeSwitch.on = AWEMessageBadgeEnabled();
    badgeSwitch.onTintColor = accent;
    [badgeSwitch addTarget:self action:@selector(messageBadgeSwitchChanged:) forControlEvents:UIControlEventValueChanged];
    self.messageBadgeSwitch = badgeSwitch;
    [bottomItems addObject:AWESettingsSwitchRow(@"未读角标", badgeSwitch)];

    UISwitch *minimize = [UISwitch new];
    minimize.on = AWEAlbumMorphCollapseEnabled();
    [minimize addTarget:self action:@selector(nativeMinimizeChanged:) forControlEvents:UIControlEventValueChanged];
    UIButton *collapseOptions=[UIButton buttonWithType:UIButtonTypeSystem];
    [collapseOptions setTitle:@"底栏收缩  ›" forState:UIControlStateNormal];
    collapseOptions.titleLabel.font=[UIFont systemFontOfSize:14 weight:UIFontWeightMedium];
    collapseOptions.contentHorizontalAlignment=UIControlContentHorizontalAlignmentLeft;
    collapseOptions.accessibilityLabel=@"底栏收缩，模式与选项";
    [collapseOptions addTarget:self action:@selector(alb5OpenOptions:) forControlEvents:UIControlEventTouchUpInside];
    UIStackView *collapseRow=[[UIStackView alloc] initWithArrangedSubviews:@[collapseOptions,minimize]];
    collapseRow.axis=UILayoutConstraintAxisHorizontal; collapseRow.alignment=UIStackViewAlignmentCenter;
    collapseRow.spacing=10;
    [minimize setContentHuggingPriority:UILayoutPriorityRequired forAxis:UILayoutConstraintAxisHorizontal];
    [bottomItems addObject:collapseRow];
    UIView *bottomCard = AWESettingsCard(@"底栏", bottomItems);

    /* 手势 */
    UISegmentedControl *tapMode = [[UISegmentedControl alloc] initWithItems:@[@"原生", @"分区", @"评 / 赞", @"面板", @"面板 / 评"]];
    tapMode.selectedSegmentIndex = AWEStoredTapGestureMode();
    [tapMode addTarget:self action:@selector(tapGestureModeChanged:) forControlEvents:UIControlEventValueChanged];
    self.tapGestureModeControl = tapMode;
    UIStackView *tapModeRow = [[UIStackView alloc] initWithArrangedSubviews:@[tapMode]];
    tapModeRow.axis = UILayoutConstraintAxisVertical;

    UILabel *splitValue = [UILabel new];
    splitValue.font = [UIFont monospacedDigitSystemFontOfSize:12.5 weight:UIFontWeightMedium];
    self.doubleTapSplitValueLabel = splitValue;
    UISlider *splitSlider = [UISlider new];
    splitSlider.minimumValue = 0.20;
    splitSlider.maximumValue = 0.80;
    splitSlider.value = AWEStoredDoubleTapLikeFraction();
    splitSlider.minimumTrackTintColor = accent;
    [splitSlider addTarget:self action:@selector(doubleTapSplitSliderChanged:) forControlEvents:UIControlEventValueChanged];
    self.doubleTapSplitSlider = splitSlider;
    UIStackView *splitRow = AWESettingsSliderRow(@"分区比例", splitValue, splitSlider);

    UISwitch *mineOnly = [UISwitch new];
    mineOnly.on = AWESettingsGestureMineOnlyEnabled();
    mineOnly.onTintColor = accent;
    [mineOnly addTarget:self action:@selector(settingsGestureMineOnlySwitchChanged:) forControlEvents:UIControlEventValueChanged];
    self.settingsGestureMineOnlySwitch = mineOnly;
    UIStackView *mineOnlyRow = AWESettingsSwitchRow(@"双指长按只在“我”页", mineOnly);
    UIView *gestureCard = AWESettingsCard(@"手势", @[tapModeRow, splitRow, mineOnlyRow]);
    UIButton *paletteOptions=AWECreateGlassTextButton(@"外观",accent,YES);
    [paletteOptions addTarget:self action:@selector(openPaletteOptions:) forControlEvents:UIControlEventTouchUpInside];
    UIButton *paletteActions=AWECreateGlassTextButton(@"功能与排序",accent,YES);
    [paletteActions addTarget:self action:@selector(openPaletteActions:) forControlEvents:UIControlEventTouchUpInside];
    UIView *paletteCard=AWESettingsCard(@"双击面板",@[paletteActions,paletteOptions]);
    /* 长按面板（选项第 8 节）、分享面板（第 9 节）、点赞特效（第 7 节） */
    UIButton *sheetOptions=AWECreateGlassTextButton(@"长按面板",accent,YES);
    [sheetOptions addTarget:self action:@selector(openSheetOptions:) forControlEvents:UIControlEventTouchUpInside];
    UIButton *bindOptions=AWECreateGlassTextButton(@"分享面板",accent,YES);
    [bindOptions addTarget:self action:@selector(openBindOptions:) forControlEvents:UIControlEventTouchUpInside];
    UIButton *fxOptions=AWECreateGlassTextButton(@"点赞特效",accent,YES);
    [fxOptions addTarget:self action:@selector(openFXOptions:) forControlEvents:UIControlEventTouchUpInside];
    UIView *panelsCard=AWESettingsCard(@"面板与特效",@[sheetOptions,bindOptions,fxOptions]);

    /* 顶部 */
    UISwitch *topGlass = [UISwitch new];
    topGlass.on = AWETopGlassEnabled();
    topGlass.onTintColor = accent;
    [topGlass addTarget:self action:@selector(topGlassSwitchChanged:) forControlEvents:UIControlEventValueChanged];
    self.topGlassSwitch = topGlass;
    UISwitch *categoryGroup = [UISwitch new];
    categoryGroup.on = AWETopTelegramSwitcherEnabled();
    categoryGroup.onTintColor = accent;
    [categoryGroup addTarget:self action:@selector(topCategoryGroupSwitchChanged:) forControlEvents:UIControlEventValueChanged];
    self.topCategoryGroupSwitch = categoryGroup;
    UISegmentedControl *categoryCount = [[UISegmentedControl alloc] initWithItems:@[@"1", @"2", @"3", @"4"]];
    categoryCount.selectedSegmentIndex = AWETopTelegramVisibleCount() - 1;
    [categoryCount addTarget:self action:@selector(topCategoryVisibleCountChanged:) forControlEvents:UIControlEventValueChanged];
    self.topCategoryVisibleCountControl = categoryCount;
    UISwitch *singleSelection = [UISwitch new];
    singleSelection.on = ALBTopSingleSelectionEnabled();
    singleSelection.onTintColor = accent;
    [singleSelection addTarget:self action:@selector(topSingleSelectionChanged:) forControlEvents:UIControlEventValueChanged];

    UISwitch *hideLeft = [UISwitch new];
    hideLeft.on = AWEHideTopLeftButtonEnabled();
    hideLeft.onTintColor = accent;
    [hideLeft addTarget:self action:@selector(hideTopLeftButtonSwitchChanged:) forControlEvents:UIControlEventValueChanged];
    self.hideTopLeftButtonSwitch = hideLeft;
    UISwitch *hideSearch = [UISwitch new];
    hideSearch.on = AWEHideTopSearchButtonEnabled();
    hideSearch.onTintColor = accent;
    [hideSearch addTarget:self action:@selector(hideTopSearchButtonSwitchChanged:) forControlEvents:UIControlEventValueChanged];
    self.hideTopSearchButtonSwitch = hideSearch;

    UISwitch *download = [UISwitch new];
    download.on = AWEAvatarMenuDownloadEnabled();
    download.onTintColor = accent;
    [download addTarget:self action:@selector(avatarMenuDownloadSwitchChanged:) forControlEvents:UIControlEventValueChanged];
    self.avatarMenuDownloadSwitch = download;

    NSMutableArray<UIView *> *topItems = [NSMutableArray arrayWithArray:@[
        AWESettingsSwitchRow(@"顶栏玻璃", topGlass),
        AWESettingsSwitchRow(@"分类分组", categoryGroup),
        AWESettingsSegmentedRow(@"分类数量", categoryCount),
        AWESettingsSwitchRow(@"单个分类保留选中胶囊", singleSelection),
        AWESettingsSwitchRow(@"隐藏左上角按钮", hideLeft),
        AWESettingsSwitchRow(@"隐藏搜索按钮", hideSearch)
    ]];
    UIButton *topOptions=AWECreateGlassTextButton(@"更多",accent,YES);
    [topOptions addTarget:self action:@selector(openTopOptions:) forControlEvents:UIControlEventTouchUpInside];
    [topItems addObject:topOptions];
    UIView *topCard=AWESettingsCard(@"顶栏",topItems);
    UIButton *rightOptions=AWECreateGlassTextButton(@"布局",accent,YES);
    [rightOptions addTarget:self action:@selector(openRightOptions:) forControlEvents:UIControlEventTouchUpInside];
    UISwitch *cleanAction = [UISwitch new];
    cleanAction.on = ALB5Bool(@"avatar.cleanScreen", YES);
    cleanAction.onTintColor = accent;
    cleanAction.accessibilityIdentifier = @"avatar.cleanScreen";
    [cleanAction addTarget:self action:@selector(extraOptionChanged:) forControlEvents:UIControlEventValueChanged];
    UISwitch *avatarMenu = [UISwitch new];
    avatarMenu.on = ALB5Bool(@"avatar.menu", YES);
    avatarMenu.onTintColor = accent;
    avatarMenu.accessibilityIdentifier = @"avatar.menu";
    [avatarMenu addTarget:self action:@selector(extraOptionChanged:) forControlEvents:UIControlEventValueChanged];
    UISwitch *danmaku = [UISwitch new];
    danmaku.on = ALB5Bool(@"danmaku.glass", NO);
    danmaku.onTintColor = accent;
    danmaku.accessibilityIdentifier = @"danmaku.glass";
    [danmaku addTarget:self action:@selector(extraOptionChanged:) forControlEvents:UIControlEventValueChanged];
    UIView *rightCard=AWESettingsCard(@"右侧按钮",@[rightOptions,
        AWESettingsSwitchRow(@"头像展开菜单",avatarMenu),
        AWESettingsSwitchRow(@"头像菜单：下载",download),
        AWESettingsSwitchRow(@"头像菜单：一键清屏",cleanAction),
        AWESettingsSwitchRow(@"弹幕按钮玻璃",danmaku)]);
    /* 3.2-3.10: what the top chrome and the message page's top buttons still
       use (the right column and the panel no longer read any of these). */
    UISwitch *registeredGlass = [UISwitch new];
    registeredGlass.on = ALB25MaterialRegisteredGlassEnabled();
    registeredGlass.onTintColor = accent;
    registeredGlass.accessibilityIdentifier = @"right.registeredGlass";
    [registeredGlass addTarget:self action:@selector(extraOptionChanged:) forControlEvents:UIControlEventValueChanged];
    self.registeredGlassSwitch = registeredGlass;
    UISegmentedControl *glassSource = [[UISegmentedControl alloc] initWithItems:@[@"底栏", @"顶栏", @"常规"]];
    glassSource.selectedSegmentIndex = ALB25MaterialRegisteredGlassSource();
    glassSource.selectedSegmentTintColor = accent;
    [glassSource addTarget:self action:@selector(glassSourceChanged:) forControlEvents:UIControlEventValueChanged];
    self.glassSourceControl = glassSource;
    /* 消息与评论 */
    UILabel *topBlurValue = [UILabel new];
    topBlurValue.font = [UIFont monospacedDigitSystemFontOfSize:12.5 weight:UIFontWeightMedium];
    self.messageTopBlurDistanceValueLabel = topBlurValue;
    UISlider *topBlurSlider = [UISlider new];
    topBlurSlider.minimumValue = 40.0; topBlurSlider.maximumValue = 188.0;
    topBlurSlider.value = AWEMessageTopEdgeBlurDistance();
    topBlurSlider.minimumTrackTintColor = accent;
    [topBlurSlider addTarget:self action:@selector(messageTopBlurDistanceChanged:) forControlEvents:UIControlEventValueChanged];
    self.messageTopBlurDistanceSlider = topBlurSlider;
    UILabel *bottomBlurValue = [UILabel new];
    bottomBlurValue.font = [UIFont monospacedDigitSystemFontOfSize:12.5 weight:UIFontWeightMedium];
    self.messageBottomBlurDistanceValueLabel = bottomBlurValue;
    UISlider *bottomBlurSlider = [UISlider new];
    bottomBlurSlider.minimumValue = 40.0; bottomBlurSlider.maximumValue = 188.0;
    bottomBlurSlider.value = AWEMessageBottomEdgeBlurDistance();
    bottomBlurSlider.minimumTrackTintColor = accent;
    [bottomBlurSlider addTarget:self action:@selector(messageBottomBlurDistanceChanged:) forControlEvents:UIControlEventValueChanged];
    self.messageBottomBlurDistanceSlider = bottomBlurSlider;

    UILabel *messageInsetValue = [UILabel new];
    messageInsetValue.font = [UIFont monospacedDigitSystemFontOfSize:12.5 weight:UIFontWeightMedium];
    self.messageButtonInsetValueLabel = messageInsetValue;
    UISlider *messageInset = [UISlider new];
    messageInset.minimumValue = 0; messageInset.maximumValue = 32;
    messageInset.value = ALB5Number(@"message.buttonInset", 0, 0, 32);
    messageInset.minimumTrackTintColor = accent;
    [messageInset addTarget:self action:@selector(messageButtonInsetChanged:) forControlEvents:UIControlEventValueChanged];
    [messageInset addTarget:self action:@selector(messageButtonInsetCommitted:) forControlEvents:UIControlEventTouchUpInside | UIControlEventTouchUpOutside | UIControlEventTouchCancel];
    self.messageButtonInsetSlider = messageInset;

    UISwitch *commentSwitch = [UISwitch new];
    commentSwitch.on = AWECommentGlassEnabledSetting();
    commentSwitch.onTintColor = accent;
    [commentSwitch addTarget:self action:@selector(commentGlassSwitchChanged:) forControlEvents:UIControlEventValueChanged];
    self.commentGlassSwitch = commentSwitch;
    /* 材质：色调（浓度 0＝系统玻璃，大于 0＝Clear＋染色）／磨砂 */
    UISegmentedControl *commentMode = [[UISegmentedControl alloc] initWithItems:@[@"色调", @"磨砂"]];
    commentMode.selectedSegmentIndex = AWECommentGlassModeSetting() == 2 ? 1 : 0;
    commentMode.enabled = commentSwitch.isOn;
    [commentMode addTarget:self action:@selector(commentGlassModeChanged:) forControlEvents:UIControlEventValueChanged];
    self.commentGlassModeControl = commentMode;
    UILabel *cornerValue = [UILabel new];
    cornerValue.font = [UIFont monospacedDigitSystemFontOfSize:12.5 weight:UIFontWeightMedium];
    self.commentGlassCornerValueLabel = cornerValue;
    UISlider *cornerSlider = [UISlider new];
    cornerSlider.minimumValue = 16.0; cornerSlider.maximumValue = 40.0;
    cornerSlider.value = AWECommentGlassCornerRadiusSetting();
    cornerSlider.minimumTrackTintColor = accent;
    cornerSlider.enabled = commentSwitch.isOn;
    [cornerSlider addTarget:self action:@selector(commentGlassCornerRadiusChanged:) forControlEvents:UIControlEventValueChanged];
    self.commentGlassCornerSlider = cornerSlider;
    /* 3.11.44: tint strength (light mode white, dark mode black; 0 = the system glass as is). */
    UILabel *tintValue = [UILabel new];
    tintValue.font = [UIFont monospacedDigitSystemFontOfSize:12.5 weight:UIFontWeightMedium];
    self.commentGlassTintValueLabel = tintValue;
    UISlider *tintSlider = [UISlider new];
    tintSlider.minimumValue = 0.0; tintSlider.maximumValue = 0.8;
    tintSlider.value = AWECommentGlassTintAlphaSetting();
    tintSlider.minimumTrackTintColor = accent;
    tintSlider.enabled = commentSwitch.isOn;
    [tintSlider addTarget:self action:@selector(commentGlassTintChanged:) forControlEvents:UIControlEventValueChanged];
    self.commentGlassTintSlider = tintSlider;
    UIView *messageCard = AWESettingsCard(@"消息页", @[
        AWESettingsSliderRow(@"顶部按钮内移", messageInsetValue, messageInset),
        AWESettingsSliderRow(@"顶部模糊距离", topBlurValue, topBlurSlider),
        AWESettingsSliderRow(@"底部模糊距离", bottomBlurValue, bottomBlurSlider)
    ]);
    UISwitch *freezeSwitch = [UISwitch new];
    {
        id stored = [NSUserDefaults.standardUserDefaults objectForKey:@"AwemeLiquidBarCommentFreezeV1"];
        freezeSwitch.on = [stored isKindOfClass:NSNumber.class] ? [stored boolValue] : YES;
    }
    freezeSwitch.onTintColor = accent;
    [freezeSwitch addTarget:self action:@selector(commentFreezeChanged:) forControlEvents:UIControlEventValueChanged];
    UIView *commentCard = AWESettingsCard(@"评论区", @[
        AWESettingsSwitchRow(@"评论区玻璃", commentSwitch),
        AWESettingsSegmentedRow(@"材质", commentMode),
        AWESettingsSliderRow(@"色调浓度", tintValue, tintSlider),
        AWESettingsSliderRow(@"面板圆角", cornerValue, cornerSlider),
        AWESettingsSwitchRow(@"作品不缩小", freezeSwitch)
    ]);

    /* 图标：唯一入口 */
    AWEEnsureHomeCustomIconsDirectory();
    UISwitch *pngSwitch = [UISwitch new];
    pngSwitch.on = AWEHomeCustomPNGModeEnabled();
    pngSwitch.onTintColor = accent;
    [pngSwitch addTarget:self action:@selector(customPNGModeSwitchChanged:) forControlEvents:UIControlEventValueChanged];
    self.customPNGModeSwitch = pngSwitch;
    UIButton *reloadPNG = AWECreateGlassTextButton(@"重新读取 PNG", UIColor.systemGrayColor, NO);
    [reloadPNG addTarget:self action:@selector(reloadCustomPNGIcons:) forControlEvents:UIControlEventTouchUpInside];
    UIButton *iconCenter = AWECreateGlassTextButton(@"图标中心", accent, YES);
    [iconCenter addTarget:self action:@selector(openIconCenter:) forControlEvents:UIControlEventTouchUpInside];
    UIView *iconCard = AWESettingsCard(@"图标", @[
        AWESettingsSwitchRow(@"自定义 PNG 图标", pngSwitch), reloadPNG, iconCenter
    ]);

    /* 其他 */
    UISwitch *wanSwitch = [UISwitch new];
    wanSwitch.on = AWEWanToWEnabled();
    wanSwitch.onTintColor = accent;
    [wanSwitch addTarget:self action:@selector(wanToWSwitchChanged:) forControlEvents:UIControlEventValueChanged];
    self.wanToWSwitch = wanSwitch;
    UISwitch *nowPlaying=[UISwitch new];nowPlaying.on=ALB5Bool(@"playback.hideNowPlaying",NO);
    [nowPlaying addTarget:self action:@selector(nowPlayingChanged:) forControlEvents:UIControlEventValueChanged];
    UISwitch *halfSheet = [UISwitch new];
    halfSheet.on = ALB5Bool(@"settings.halfSheet", YES);
    halfSheet.onTintColor = accent;
    halfSheet.accessibilityIdentifier = @"settings.halfSheet";
    [halfSheet addTarget:self action:@selector(extraOptionChanged:) forControlEvents:UIControlEventValueChanged];
    UISwitch *highest = [UISwitch new];
    highest.on = ALB5Bool(@"playback.highestQuality", YES);
    highest.onTintColor = accent;
    highest.accessibilityIdentifier = @"playback.highestQuality";
    [highest addTarget:self action:@selector(extraOptionChanged:) forControlEvents:UIControlEventValueChanged];
    UISwitch *hideStatus = [UISwitch new];
    hideStatus.on = ALB5Bool(@"statusBar.hide", NO);
    hideStatus.onTintColor = accent;
    hideStatus.accessibilityIdentifier = @"statusBar.hide";
    [hideStatus addTarget:self action:@selector(extraOptionChanged:) forControlEvents:UIControlEventValueChanged];
    UIView *playbackCard = AWESettingsCard(@"播放", @[
        AWESettingsSwitchRow(@"全屏播放", fullscreenSwitch),
        AWESettingsSwitchRow(@"默认最高画质", highest),
        AWESettingsSwitchRow(@"隐藏状态栏", hideStatus),
        AWESettingsSwitchRow(@"不在灵动岛显示播放信息",nowPlaying)]);
    UIView *otherCard = AWESettingsCard(@"其他", @[
        AWESettingsSwitchRow(@"设置半屏打开",halfSheet),
        AWESettingsSwitchRow(@"万 → W", wanSwitch)]);

    /* 诊断 */
    UISwitch *diagSwitch = [UISwitch new];
    diagSwitch.on = AWEInteractionDiagnosticsEnabled();
    diagSwitch.onTintColor = accent;
    [diagSwitch addTarget:self action:@selector(interactionDiagnosticSwitchChanged:) forControlEvents:UIControlEventValueChanged];
    self.interactionDiagnosticSwitch = diagSwitch;
    UIButton *snapshot = AWECreateGlassTextButton(@"采集当前状态", UIColor.systemGrayColor, NO);
    [snapshot addTarget:self action:@selector(writeInteractionSnapshot:) forControlEvents:UIControlEventTouchUpInside];
    UIButton *clear = AWECreateGlassTextButton(@"清空全部日志", UIColor.systemGrayColor, NO);
    [clear addTarget:self action:@selector(clearInteractionDiagnosticLog:) forControlEvents:UIControlEventTouchUpInside];
    UIStackView *diagButtons = [[UIStackView alloc] initWithArrangedSubviews:@[snapshot, clear]];
    diagButtons.axis = UILayoutConstraintAxisHorizontal;
    diagButtons.distribution = UIStackViewDistributionFillEqually;
    diagButtons.spacing = 8.0;
    UIButton *exportLog = AWECreateGlassTextButton(@"导出日志", accent, YES);
    [exportLog addTarget:self action:@selector(exportProbeLogs:) forControlEvents:UIControlEventTouchUpInside];
    UIView *diagCard = AWESettingsCard(@"诊断", @[
        AWESettingsSwitchRow(@"交互日志", diagSwitch), diagButtons, exportLog,
        ALBProbeSettingsEntryButton(self, accent)
    ]);

    UIButton *authorizationCheck = AWECreateGlassTextButton(@"重新检测授权", UIColor.systemGrayColor, NO);
    [authorizationCheck addTarget:self action:@selector(manualAuthorizationCheck:) forControlEvents:UIControlEventTouchUpInside];
    UILabel *authorizationFooter = [UILabel new];
    authorizationFooter.font = [UIFont systemFontOfSize:11.5 weight:UIFontWeightRegular];
    authorizationFooter.textColor = UIColor.tertiaryLabelColor;
    authorizationFooter.textAlignment = NSTextAlignmentCenter;
    self.authorizationFooter = authorizationFooter;

    UILabel *usageNotice=AWESettingsMakeLabel(@"本插件仅供个人测试使用，无论以任何渠道获得并使用插件以及因为插件使用而带来的纠纷问题与原作者无关，请勿私自传播，使用插件即视为已同意本条",11.5,UIFontWeightRegular);
    usageNotice.numberOfLines=0;usageNotice.textColor=UIColor.secondaryLabelColor;
    UIStackView *stack = [[UIStackView alloc] initWithArrangedSubviews:@[
        basicCard, bottomCard, topCard, rightCard, gestureCard, paletteCard,
        commentCard, messageCard, panelsCard, iconCard, playbackCard, otherCard, diagCard,
        authorizationCheck, authorizationFooter, usageNotice
    ]];
    stack.translatesAutoresizingMaskIntoConstraints = NO;
    stack.axis = UILayoutConstraintAxisVertical;
    stack.spacing = 14.0;
    stack.alignment = UIStackViewAlignmentFill;

    UIScrollView *scroll = [UIScrollView new];
    scroll.translatesAutoresizingMaskIntoConstraints = NO;
    scroll.alwaysBounceVertical = YES;
    scroll.keyboardDismissMode = UIScrollViewKeyboardDismissModeInteractive;
    scroll.backgroundColor = UIColor.clearColor;
    scroll.opaque = NO;
    self.settingsScrollView = scroll;
    [self.view addSubview:scroll];
    [scroll addSubview:stack];
    ALBSettingsObserveScroll(scroll, stack.arrangedSubviews);
    UILayoutGuide *guide = self.view.layoutMarginsGuide;
    scroll.contentInsetAdjustmentBehavior = UIScrollViewContentInsetAdjustmentAutomatic;
    [self setContentScrollView:scroll forEdge:NSDirectionalRectEdgeTop];
    [NSLayoutConstraint activateConstraints:@[
        [scroll.leadingAnchor constraintEqualToAnchor:self.view.leadingAnchor],
        [scroll.trailingAnchor constraintEqualToAnchor:self.view.trailingAnchor],
        [scroll.topAnchor constraintEqualToAnchor:self.view.topAnchor],
        [scroll.bottomAnchor constraintEqualToAnchor:self.view.bottomAnchor],
        [stack.leadingAnchor constraintEqualToAnchor:scroll.contentLayoutGuide.leadingAnchor constant:18.0],
        [stack.trailingAnchor constraintEqualToAnchor:scroll.contentLayoutGuide.trailingAnchor constant:-18.0],
        [stack.topAnchor constraintEqualToAnchor:scroll.contentLayoutGuide.topAnchor constant:18.0],
        [stack.bottomAnchor constraintEqualToAnchor:scroll.contentLayoutGuide.bottomAnchor constant:-18.0],
        [stack.widthAnchor constraintEqualToAnchor:scroll.frameLayoutGuide.widthAnchor constant:-36.0]
    ]];

    [[NSNotificationCenter defaultCenter] addObserver:self
        selector:@selector(authorizationStateChanged:)
        name:AWEAuthorizationNotificationName() object:nil];
    [self updateVerticalOffsetLabel];
    [self updateDoubleTapSplitLabel];
    [self updateTapGestureModeUI];
    self.messageTopBlurDistanceValueLabel.text = [NSString stringWithFormat:@"%.0f pt", AWEMessageTopEdgeBlurDistance()];
    self.messageBottomBlurDistanceValueLabel.text = [NSString stringWithFormat:@"%.0f pt", AWEMessageBottomEdgeBlurDistance()];
    self.messageButtonInsetValueLabel.text = [NSString stringWithFormat:@"%.0f pt", ALB5Number(@"message.buttonInset", 0, 0, 32)];
    self.commentGlassCornerValueLabel.text = [NSString stringWithFormat:@"%.0f pt", AWECommentGlassCornerRadiusSetting()];
    self.commentGlassTintValueLabel.text = [NSString stringWithFormat:@"%.0f%%", AWECommentGlassTintAlphaSetting() * 100.0];
    [self refreshAuthorizationUI];
    [self applyCurrentTheme];
}

- (void)viewDidLayoutSubviews {
    [super viewDidLayoutSubviews];
    ALBSettingsUpdateScrollVisibility(self.settingsScrollView);
    CGFloat width = CGRectGetWidth(self.view.safeAreaLayoutGuide.layoutFrame);
    if (width <= 1.0) width = CGRectGetWidth(self.view.bounds);
    if (fabs(width - self.lastResponsiveWidth) <= 0.5) return;
    self.lastResponsiveWidth = width;
    AWEApplyResponsiveSettingsTypography(self.view, AWESettingsResponsiveScaleForWidth(width));
}

- (void)viewDidAppear:(BOOL)animated {
    [super viewDidAppear:animated];
}

- (void)viewWillAppear:(BOOL)animated {
    [super viewWillAppear:animated];
    gAWESettingsVisible = YES;
    AWETrySilentAuthorization(self);
    [self refreshAuthorizationUI];
    [self updateVerticalOffsetLabel];
    [self updateTapGestureModeUI];
    [self applyCurrentTheme];
    // 3.5: the option pages change the same keys.
    self.glassSourceControl.selectedSegmentIndex = ALB25MaterialRegisteredGlassSource();
    self.registeredGlassSwitch.on = ALB25MaterialRegisteredGlassEnabled();

    self.bottomStyleControl.selectedSegmentIndex = ALBDockStyleStored();
}

- (void)viewWillDisappear:(BOOL)animated {
    /* Restore the invisible native bar's layout footprint before the settings
       dismissal snapshot. Without this, the Home feed can perform one layout
       pass with a zero bottom reserve and its caption briefly touches the
       screen edge underneath the resident LiquidBar. */
    BOOL nativeSettingsPush =
        [objc_getAssociatedObject(self, &kAWELiquidSettingsNativePushKey) boolValue];
    if (!nativeSettingsPush && gAWELastTabBar) {
        UIView *bar = (UIView *)gAWELastTabBar;
        AWESetApplying(bar, YES);
        [UIView performWithoutAnimation:^{
            bar.hidden = NO;
            bar.alpha = 1.0;
        }];
        AWESetApplying(bar, NO);
        AWEApplyAlbumMorphOriginalSuppression(bar, YES);
        [bar.superview setNeedsLayout];
        [bar.superview layoutIfNeeded];
    }
    [super viewWillDisappear:animated];
    BOOL floating = [objc_getAssociatedObject(self.navigationController, &kALBSettingsFloatingKey) boolValue];
    if (!floating || self.navigationController.parentViewController.isBeingDismissed)
        gAWESettingsVisible = NO;

    dispatch_async(dispatch_get_main_queue(), ^{
        AWERefreshAllConfiguredIcons();
        if (gAWELastTabBar) {
            AWEInstallOrUpdateAlbumMorphBar((UIView *)gAWELastTabBar, NO);
        }
    });
}

- (void)traitCollectionDidChange:(UITraitCollection *)previousTraitCollection {
    [super traitCollectionDidChange:previousTraitCollection];
    if (@available(iOS 13.0, *)) {
        if ([self.traitCollection hasDifferentColorAppearanceComparedToTraitCollection:previousTraitCollection]) {
            [self applyCurrentTheme];
        }
    }
}

- (void)applyCurrentTheme {
    ALBInstallSettingsGlass(self);
    self.settingsScrollView.opaque = NO;
    self.settingsScrollView.backgroundColor = UIColor.clearColor;
    self.settingsScrollView.layer.backgroundColor = UIColor.clearColor.CGColor;
    UIColor *card = ALBSettingsSectionColor();
    AWEApplySettingsCardBackground(self.view, card);
    UIColor *accent = self.pendingAccentColor ?: AWEStoredAccentColor();
    self.previewView.backgroundColor = accent;
    self.settingsGestureMineOnlySwitch.onTintColor = accent;
    self.verticalOffsetSlider.minimumTrackTintColor = accent;
    self.doubleTapSplitSlider.minimumTrackTintColor = accent;
    self.wanToWSwitch.onTintColor = accent;
    self.customPNGModeSwitch.onTintColor = accent;
    self.topGlassSwitch.onTintColor = accent;
    self.hideTopLeftButtonSwitch.onTintColor = accent;
    self.hideTopSearchButtonSwitch.onTintColor = accent;
    self.topCategoryGroupSwitch.onTintColor = accent;
    self.messageTopBlurDistanceSlider.minimumTrackTintColor = accent;
    self.messageButtonInsetSlider.minimumTrackTintColor = accent;
    self.messageBottomBlurDistanceSlider.minimumTrackTintColor = accent;
    self.commentGlassCornerSlider.minimumTrackTintColor = accent;
    self.commentGlassTintSlider.minimumTrackTintColor = accent;
    self.hideBottomTitlesSwitch.onTintColor = accent;
    self.messageBadgeSwitch.onTintColor = accent;
    self.avatarMenuDownloadSwitch.onTintColor = accent;
    self.bottomBarDisplaySwitch.onTintColor = accent;
    self.internalFullscreenSwitch.onTintColor = accent;
    self.masterSwitch.onTintColor = accent;
    self.interactionDiagnosticSwitch.onTintColor = accent;
    self.commentGlassSwitch.onTintColor = accent;
    [self updateApplyButtonTint:accent];
}

- (void)updateApplyButtonTint:(UIColor *)colour {
    self.profilePaletteButton.tintColor=colour ?: AWEStoredAccentColor();
    UIButtonConfiguration *configuration=self.profilePaletteButton.configuration;
    configuration.baseForegroundColor=colour ?: AWEStoredAccentColor();self.profilePaletteButton.configuration=configuration;
}

- (void)manualAuthorizationCheck:(UIButton *)sender {
    sender.enabled = NO;
    self.authorizationFooter.text = @"正在检测授权…";

    UIViewController *sourceController = self.presentingViewController ?: self;
    BOOL authorized = AWEAttemptAuthorizationFromVisiblePage(sourceController);

    if (!authorized) {
        UIWindow *window = AWEActiveMainWindow();
        UIViewController *top = AWETopViewControllerFrom(window.rootViewController);
        authorized = AWEAttemptAuthorizationFromVisiblePage(top ?: sourceController);
    }

    [self refreshAuthorizationUI];
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.35 * NSEC_PER_SEC)),
                   dispatch_get_main_queue(), ^{
        sender.enabled = YES;
        [self refreshAuthorizationUI];
    });
}

- (void)authorizationStateChanged:(NSNotification *)notification {
    (void)notification;
    [self refreshAuthorizationUI];
}

- (void)refreshAuthorizationUI {
    BOOL authorized = AWEAuthorizationValid();
    self.masterSwitch.enabled = authorized;
    self.masterSwitch.on = authorized && AWEMasterEnabledStored();
    self.authorizationFooter.text = authorized ? @"● 已授权" : @"○ 未授权";
}

- (void)masterSwitchChanged:(UISwitch *)sender {
    BOOL authorized = AWEAuthorizationValid();
    if (!authorized) {
        sender.on = NO;
        sender.enabled = NO;
        return;
    }
    [NSUserDefaults.standardUserDefaults setBool:sender.isOn
        forKey:AWEAuthorizationDefaultsKey(3)];
    [NSUserDefaults.standardUserDefaults synchronize];
    [self refreshAuthorizationUI];
    [NSNotificationCenter.defaultCenter postNotificationName:@"ALB5.OptionsChanged" object:nil];
}

- (void)dealloc {
    [[NSNotificationCenter defaultCenter] removeObserver:self];
}

- (void)closeSettings {
    BOOL nativeSettingsPush =
        [objc_getAssociatedObject(self, &kAWELiquidSettingsNativePushKey) boolValue];
    if (nativeSettingsPush && self.navigationController &&
        self.navigationController.topViewController == self) {
        [self.navigationController popViewControllerAnimated:YES];
        return;
    }
    [self dismissViewControllerAnimated:YES completion:nil];
}

- (void)openAccentPicker:(UIButton *)sender {
    (void)sender;
    UIColorPickerViewController *picker = [UIColorPickerViewController new];
    picker.delegate = self;
    picker.supportsAlpha = NO;
    picker.selectedColor = self.pendingAccentColor ?: AWEStoredAccentColor();
    picker.title = @"选择强调色";
    [self presentViewController:picker animated:YES completion:nil];
}

- (void)colorPickerViewControllerDidSelectColor:(UIColorPickerViewController *)viewController {
    self.pendingAccentColor = viewController.selectedColor ?: AWEStoredAccentColor();
    self.previewView.backgroundColor = self.pendingAccentColor;
    [self updateApplyButtonTint:self.pendingAccentColor];
    [self confirmAccentColor:nil];
}

- (void)colorPickerViewControllerDidFinish:(UIColorPickerViewController *)viewController {
    self.pendingAccentColor = viewController.selectedColor ?: self.pendingAccentColor;
    self.previewView.backgroundColor = self.pendingAccentColor;
    [self updateApplyButtonTint:self.pendingAccentColor];
    [self confirmAccentColor:nil];
}

- (void)confirmAccentColor:(UIButton *)sender {
    (void)sender;
    UIColor *colour = self.pendingAccentColor ?: AWEStoredAccentColor();
    CGFloat r=0,g=0,b=0,a=1;
    UIColor *resolved = colour;
    if (@available(iOS 13.0, *)) resolved = [colour resolvedColorWithTraitCollection:[UITraitCollection traitCollectionWithUserInterfaceStyle:UIUserInterfaceStyleLight]];
    if (![resolved getRed:&r green:&g blue:&b alpha:&a]) return;
    NSString *hex = [NSString stringWithFormat:@"#%02X%02X%02X", (int)lround(r*255.0), (int)lround(g*255.0), (int)lround(b*255.0)];
    [NSUserDefaults.standardUserDefaults setObject:hex forKey:kAWEAccentHexDefaultsKey];
    [NSUserDefaults.standardUserDefaults synchronize];
    AWEApplyStoredAccentToCurrentBar();
    AWERefreshAllConfiguredIcons();
    [self applyCurrentTheme];
}

- (void)updateVerticalOffsetLabel {
    CGFloat value = self.verticalOffsetSlider.value;
    if (fabs(value) < 0.01) {
        self.verticalOffsetValueLabel.text = @"默认位置";
    } else if (value < 0.0) {
        self.verticalOffsetValueLabel.text =
            [NSString stringWithFormat:@"向上 %.1f pt", fabs(value)];
    } else {
        self.verticalOffsetValueLabel.text =
            [NSString stringWithFormat:@"向下 %.1f pt", value];
    }
}


- (void)updateDoubleTapSplitLabel {
    NSInteger likePercent =
        (NSInteger)lround(self.doubleTapSplitSlider.value * 100.0);
    NSInteger commentPercent = 100 - likePercent;
    BOOL panelZone = (self.tapGestureModeControl ? self.tapGestureModeControl.selectedSegmentIndex
                                                 : AWEStoredTapGestureMode()) == 4;
    self.doubleTapSplitValueLabel.text =
        [NSString stringWithFormat:@"%@ %ld%% · 评论区域 %ld%%", panelZone ? @"双击面板区域" : @"点赞区域",
                                   (long)likePercent,
                                   (long)commentPercent];
}

- (void)updateTapGestureModeUI {
    NSInteger mode = self.tapGestureModeControl ? self.tapGestureModeControl.selectedSegmentIndex
                                                 : AWEStoredTapGestureMode();
    BOOL split = mode == 1 || mode == 4;
    [self updateDoubleTapSplitLabel];
    self.doubleTapSplitSlider.enabled = split;
    self.doubleTapSplitSlider.hidden = !split;
    self.doubleTapSplitValueLabel.hidden = !split;
}

- (void)tapGestureModeChanged:(UISegmentedControl *)sender {
    NSInteger mode = MIN(4, MAX(0, sender.selectedSegmentIndex));
    [NSUserDefaults.standardUserDefaults setBool:mode == 3 forKey:@"AwemeLiquidBarNativePaletteTapModeV1"];
    [NSUserDefaults.standardUserDefaults setInteger:mode forKey:kAWETapGestureModeDefaultsKey];
    /* Keep the legacy boolean coherent for downgrade/migration only. */
    [NSUserDefaults.standardUserDefaults setBool:(mode == 1) forKey:kAWELowerHalfDoubleTapCommentDefaultsKey];
    [NSUserDefaults.standardUserDefaults synchronize];
    [self updateTapGestureModeUI];
    [[[UISelectionFeedbackGenerator alloc] init] selectionChanged];
}


- (void)alb5OpenOptions:(id)sender {
    NSIndexSet *sections=[NSIndexSet indexSetWithIndex:0];
    [self.navigationController pushViewController:[[ALB5OptionsController alloc]initWithSections:sections title:@"底栏收缩"] animated:YES];
}
/* 3.11.51：玻璃那一节（第 6 节）的开关删了，不再接在各页下面 */
static NSIndexSet *ALB311OptionPages(NSUInteger section) {
    return [NSIndexSet indexSetWithIndex:section];
}
- (void)openTopOptions:(id)sender { [self.navigationController pushViewController:[[ALB5OptionsController alloc]initWithSections:ALB311OptionPages(1) title:@"顶栏"] animated:YES]; }
- (void)openPaletteOptions:(id)sender { [self.navigationController pushViewController:[[ALB5OptionsController alloc]initWithSections:ALB311OptionPages(2) title:@"双击面板"] animated:YES]; }
