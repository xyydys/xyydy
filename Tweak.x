// Read-only, small metadata for explicit capture events. No hierarchy search,
// image contents, titles, authorization data, or synthetic hit testing.
static NSDictionary *ALB30ReproView(UIView *view) {
    if (!view) return @{};
    return @{@"class":NSStringFromClass(view.class),
        @"id":[NSString stringWithFormat:@"%p",view],
        @"parent":view.superview ? NSStringFromClass(view.superview.class) : @"nil",
        @"window":view.window ? NSStringFromClass(view.window.class) : @"nil",
        @"frame":NSStringFromCGRect(view.frame), @"bounds":NSStringFromCGRect(view.bounds),
        @"center":NSStringFromCGPoint(view.center), @"transform":NSStringFromCGAffineTransform(view.transform),
        @"hidden":@(view.hidden), @"alpha":@(view.alpha), @"opacity":@(view.layer.opacity),
        @"interaction":@(view.userInteractionEnabled)};
}
static NSInteger gALB30LastEvaluatedRoute = -1;

/*
 AwemeLiquidBar 3.11.53 —— 抖音 39.9 液态玻璃插件（iOS 26，rootless）。逐版本记录见 HANDOFF.md。

 文件分工
   Tweak.x                 主体：液态底栏（AwemeAlbumMorphBar.swift）、顶栏、右侧按钮、全屏、下载、设置页、各处挂钩
   ALBDock*.m / .h         三段式底栏（收缩成球、✦ 悬浮面板、↑ 快捷跳转面板、角标、头像）
   ALB25Material*、ALBGlass*、ALBUnifiedMaterial  玻璃材质、透明度、深浅
   CommentGlass.xm         评论区玻璃、输入框模糊、作品不缩小
   ALBMoreGlass.h、ALBChatFace.h   分享面板、评论长按面板、图文页评论框的玻璃与胶囊按钮
   ALBSheetGlass.xm        长按面板背景
   ALBSidePalette.h        双击面板；ALBFloatPanel.h 悬浮面板；ALBOutsidePress.h 点面板外关闭
   ALBQuickJump.h          快捷跳转（记页面、跳转）
   ALBMediaSave.h          保存视频（最高画质）与实况
   ALBAmbience.xm          点赞特效
   MessageTopGlassV3.xm    消息页顶部 / 底部模糊与按钮
   ALB5Settings.h          选项页（ALB5OptionSections）；主设置页在本文件 AWELiquidSettingsController
   ALB45Diagnostics.h      专项诊断
*/

