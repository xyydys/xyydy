@interface AWEVideoVariant : NSObject
@property(nonatomic, strong) id sourceModel;
@property(nonatomic, copy) NSString *urlString;
@property(nonatomic, assign) NSInteger sourceIndex;
@property(nonatomic, assign) NSInteger width;
@property(nonatomic, assign) NSInteger height;
@property(nonatomic, assign) NSInteger fps;
@property(nonatomic, assign) long long bitrate;
@property(nonatomic, assign) BOOL h265;
@property(nonatomic, assign) BOOL hdr;
@end
@implementation AWEVideoVariant
@end

static __weak UIView *gAWEDownloadToastView = nil;
static NSUInteger gAWEDownloadToastGeneration = 0;
#include "ALBDownloadJob.h"

static id AWESafeValueForKey(id object, NSString *key) {
    if (!object || key.length == 0) return nil;
    if ([object isKindOfClass:NSDictionary.class]) {
        id value = ((NSDictionary *)object)[key];
        return value == NSNull.null ? nil : value;
    }
    @try {
        id value = [object valueForKey:key];
        return value == NSNull.null ? nil : value;
    } @catch (__unused NSException *exception) {
        return nil;
    }
}

static id AWEFirstSafeValue(id object, NSArray<NSString *> *keys) {
    for (NSString *key in keys) {
        id value = AWESafeValueForKey(object, key);
        if (value) return value;
    }
    return nil;
}

static NSArray *AWEArrayFromValue(id value) {
    if ([value isKindOfClass:NSArray.class]) return value;
    if ([value isKindOfClass:NSSet.class]) return ((NSSet *)value).allObjects;
    if ([value isKindOfClass:NSOrderedSet.class]) return ((NSOrderedSet *)value).array;
    return nil;
}

static long long AWEInteger64FromValue(id value) {
    if ([value respondsToSelector:@selector(longLongValue)]) {
        return [value longLongValue];
    }
    return 0;
}

static BOOL AWEBoolFromValue(id value) {
    if ([value respondsToSelector:@selector(boolValue)]) return [value boolValue];
    return NO;
}

static NSString *AWEStringFromValue(id value) {
    if ([value isKindOfClass:NSString.class]) return value;
    if ([value isKindOfClass:NSURL.class]) return ((NSURL *)value).absoluteString;
    if ([value respondsToSelector:@selector(stringValue)]) return [value stringValue];
    return nil;
}

static BOOL AWEStringLooksLikeRemoteURL(NSString *string) {
    if (string.length < 8) return NO;
    NSString *lower = string.lowercaseString;
    return [lower hasPrefix:@"http://"] || [lower hasPrefix:@"https://"];
}

static NSString *AWEFirstRemoteURLString(id value, NSUInteger depth) {
    if (!value || depth > 6) return nil;
    if ([value isKindOfClass:NSURL.class]) {
        NSString *string = ((NSURL *)value).absoluteString;
        return AWEStringLooksLikeRemoteURL(string) ? string : nil;
    }
    if ([value isKindOfClass:NSString.class]) {
        NSString *string = (NSString *)value;
        return AWEStringLooksLikeRemoteURL(string) ? string : nil;
    }
    if ([value isKindOfClass:NSArray.class] ||
        [value isKindOfClass:NSOrderedSet.class] ||
        [value isKindOfClass:NSSet.class]) {
        for (id child in AWEArrayFromValue(value)) {
            NSString *string = AWEFirstRemoteURLString(child, depth + 1);
            if (string.length) return string;
        }
        return nil;
    }
    NSArray<NSString *> *keys = @[
        @"originURLList", @"urlList", @"URLList", @"urls",
        @"playURL", @"playAddr", @"downloadURL", @"downloadAddr",
        @"mainURL", @"url", @"URL"
    ];
    for (NSString *key in keys) {
        id child = AWESafeValueForKey(value, key);
        if (!child || child == value) continue;
        NSString *string = AWEFirstRemoteURLString(child, depth + 1);
        if (string.length) return string;
    }
    return nil;
}

static NSString *AWEJoinedVariantMetadata(id model) {
    NSMutableArray<NSString *> *parts = [NSMutableArray array];
    for (NSString *key in @[@"gearName", @"qualityType", @"videoResolution",
                            @"codecType", @"codec", @"format", @"definition"]) {
        NSString *value = AWEStringFromValue(AWESafeValueForKey(model, key));
        if (value.length) [parts addObject:value];
    }
    return [[parts componentsJoinedByString:@" "] lowercaseString];
}

static NSInteger AWEParseFPSFromMetadata(NSString *metadata) {
    if (metadata.length == 0) return 0;
    NSRegularExpression *regex = [NSRegularExpression
        regularExpressionWithPattern:@"([0-9]{2,3})\\s*fps"
        options:NSRegularExpressionCaseInsensitive error:nil];
    NSTextCheckingResult *match = [regex firstMatchInString:metadata
        options:0 range:NSMakeRange(0, metadata.length)];
    if (match.numberOfRanges >= 2) {
        return [[metadata substringWithRange:[match rangeAtIndex:1]] integerValue];
    }
    if ([metadata containsString:@"120fps"] || [metadata containsString:@"120p"]) return 120;
    if ([metadata containsString:@"60fps"] || [metadata containsString:@"60p"]) return 60;
    if ([metadata containsString:@"30fps"] || [metadata containsString:@"30p"]) return 30;
    return 0;
}

static NSInteger AWEParseHeightFromMetadata(NSString *metadata) {
    if (metadata.length == 0) return 0;
    if ([metadata containsString:@"2160"] || [metadata containsString:@"4k"]) return 2160;
    if ([metadata containsString:@"1440"] || [metadata containsString:@"2k"]) return 1440;
    if ([metadata containsString:@"1080"]) return 1080;
    if ([metadata containsString:@"720"]) return 720;
    if ([metadata containsString:@"540"]) return 540;
    if ([metadata containsString:@"480"]) return 480;
    return 0;
}

static AWEVideoVariant *AWEVideoVariantFromModel(id model,
                                                  id fallbackVideo,
                                                  NSInteger index) {
    if (!model) return nil;
    id address = AWEFirstSafeValue(model, @[@"playAddr", @"playURL", @"downloadAddr"]);
    NSString *urlString = AWEFirstRemoteURLString(address ?: model, 0);
    if (urlString.length == 0) return nil;

    AWEVideoVariant *variant = [AWEVideoVariant new];
    variant.sourceModel = model;
    variant.urlString = urlString;
    variant.sourceIndex = index;

    variant.width = (NSInteger)AWEInteger64FromValue(
        AWEFirstSafeValue(model, @[@"width", @"videoWidth", @"w"]));
    variant.height = (NSInteger)AWEInteger64FromValue(
        AWEFirstSafeValue(model, @[@"height", @"videoHeight", @"h"]));
    variant.fps = (NSInteger)AWEInteger64FromValue(
        AWEFirstSafeValue(model, @[@"fps", @"frameRate", @"videoFPS", @"videoFps"]));
    variant.bitrate = AWEInteger64FromValue(
        AWEFirstSafeValue(model, @[@"bitrate", @"bitRate", @"videoBitrate",
                                   @"avgBitrate", @"bitrateInBps", @"bitRateInBps"]));

    if (variant.width <= 0) {
        variant.width = (NSInteger)AWEInteger64FromValue(
            AWEFirstSafeValue(address, @[@"width", @"videoWidth", @"w"]));
    }
    if (variant.height <= 0) {
        variant.height = (NSInteger)AWEInteger64FromValue(
            AWEFirstSafeValue(address, @[@"height", @"videoHeight", @"h"]));
    }
    if (variant.fps <= 0) {
        variant.fps = (NSInteger)AWEInteger64FromValue(
            AWEFirstSafeValue(address, @[@"fps", @"frameRate", @"videoFPS"]));
    }
    if (variant.bitrate <= 0) {
        variant.bitrate = AWEInteger64FromValue(
            AWEFirstSafeValue(address, @[@"bitrate", @"bitRate", @"videoBitrate"]));
    }

    if (fallbackVideo) {
        if (variant.width <= 0) {
            variant.width = (NSInteger)AWEInteger64FromValue(
                AWEFirstSafeValue(fallbackVideo, @[@"width", @"videoWidth"]));
        }
        if (variant.height <= 0) {
            variant.height = (NSInteger)AWEInteger64FromValue(
                AWEFirstSafeValue(fallbackVideo, @[@"height", @"videoHeight"]));
        }
        if (variant.fps <= 0) {
            variant.fps = (NSInteger)AWEInteger64FromValue(
                AWEFirstSafeValue(fallbackVideo, @[@"fps", @"frameRate", @"videoFPS"]));
        }
    }

    NSString *metadata = AWEJoinedVariantMetadata(model);
    if (variant.height <= 0) variant.height = AWEParseHeightFromMetadata(metadata);
    if (variant.width <= 0 && variant.height > 0) {
        variant.width = (NSInteger)llround((double)variant.height * 9.0 / 16.0);
    }
    if (variant.fps <= 0) variant.fps = AWEParseFPSFromMetadata(metadata);
    variant.h265 = AWEBoolFromValue(AWESafeValueForKey(model, @"isH265")) ||
        [metadata containsString:@"h265"] ||
        [metadata containsString:@"hevc"] ||
        [metadata containsString:@"bytevc1"] ||
        [metadata containsString:@"bytevc2"];
    variant.hdr = AWEBoolFromValue(AWESafeValueForKey(model, @"isHDR")) ||
        AWEInteger64FromValue(AWESafeValueForKey(model, @"hdrType")) > 0 ||
        AWEInteger64FromValue(AWESafeValueForKey(model, @"hdrBit")) > 0 ||
        [metadata containsString:@"hdr"];
    return variant;
}

static NSArray<AWEVideoVariant *> *AWEVideoVariantsForVideo(id video,
                                                             BOOL allowFallback) {
    if (!video) return @[];
    gALBHQBypass++;
    NSArray *models = AWEArrayFromValue(AWESafeValueForKey(video, @"bitrateModels_origin"));
    if (models.count == 0) {
        models = AWEArrayFromValue(AWESafeValueForKey(video, @"bitrateModels"));
    }
    gALBHQBypass--;
    NSMutableArray<AWEVideoVariant *> *variants = [NSMutableArray array];
    NSMutableSet<NSString *> *seen = [NSMutableSet set];
    NSInteger index = 0;
    for (id model in models) {
        AWEVideoVariant *variant = AWEVideoVariantFromModel(model, video, index++);
        if (!variant || [seen containsObject:variant.urlString]) continue;
        [seen addObject:variant.urlString];
        [variants addObject:variant];
    }
    if (variants.count == 0 && allowFallback) {
        for (NSString *key in @[@"playAddr", @"playURL"]) {
            id model = AWESafeValueForKey(video, key);
            AWEVideoVariant *variant = AWEVideoVariantFromModel(model ?: video, video, 0);
            if (!variant || [seen containsObject:variant.urlString]) continue;
            [seen addObject:variant.urlString];
            [variants addObject:variant];
        }
    }
    return variants;
}

static id AWECurrentAwemeModelForStack(UIView *stack) {
    SEL contextSelector = NSSelectorFromString(@"awelistkit_cellContext");
    for (UIView *view = stack; view; view = view.superview) {
        if ([view respondsToSelector:contextSelector]) {
            @try {
                id context = ((id (*)(id, SEL))objc_msgSend)(view, contextSelector);
                id model = AWEFirstSafeValue(context, @[@"model", @"awemeModel", @"itemModel"]);
                if (model) return model;
            } @catch (__unused NSException *exception) {}
        }
        id direct = AWEFirstSafeValue(view, @[@"awemeModel", @"itemModel"]);
        if (direct) return direct;
    }

    UIResponder *responder = stack;
    while (responder) {
        if ([responder isKindOfClass:UIViewController.class]) {
            id model = AWEFirstSafeValue(responder,
                @[@"awemeModel", @"currentAwemeModel", @"currentAweme", @"itemModel"]);
            if (model) return model;
        }
        responder = responder.nextResponder;
    }
    UIWindow *window = stack.window ?: AWEActiveMainWindow();
    UIViewController *top = window ? AWETopViewControllerFrom(window.rootViewController) : nil;
    return AWEFirstSafeValue(top,
        @[@"awemeModel", @"currentAwemeModel", @"currentAweme", @"itemModel"]);
}

static NSString *AWEAwemeIdentity(id aweme) {
    NSString *identity = AWEStringFromValue(AWEFirstSafeValue(aweme,
        @[@"awemeId", @"awemeID", @"itemId", @"itemID", @"groupId", @"aid"]));
    if (identity.length) return identity;
    return [NSString stringWithFormat:@"%p", aweme];
}

/* 点赞特效（ALBAmbience.xm）认“哪一条作品变成已赞”：作品 ID，以及手指碰到的那个视图属于哪一条（只往上找格子 / 控制器，
   不退到最上面那一页） */
NSString *ALBFXAwemeIDForModel(id model) {
    if (!model) return nil;
    NSString *identity = AWEStringFromValue(AWEFirstSafeValue(model, @[@"awemeId", @"awemeID", @"itemId", @"itemID", @"groupId", @"aid"]));
    return identity.length ? identity : nil;
}
NSString *ALBFXAwemeIDForView(UIView *view) {
    if (!view) return nil;
    SEL contextSelector = NSSelectorFromString(@"awelistkit_cellContext");
    NSUInteger steps = 0;
    for (UIView *v = view; v && steps < 40; v = v.superview, steps++) {
        if ([v respondsToSelector:contextSelector]) {
            @try {
                id context = ((id (*)(id, SEL))objc_msgSend)(v, contextSelector);
                id model = AWEFirstSafeValue(context, @[@"model", @"awemeModel", @"itemModel"]);
                if (model) return ALBFXAwemeIDForModel(model);
            } @catch (__unused NSException *exception) {}
        }
    }
    steps = 0;
    for (UIResponder *r = view; r && steps < 80; r = r.nextResponder, steps++) {
        if (![r isKindOfClass:UIViewController.class]) continue;
        id model = AWEFirstSafeValue(r, @[@"awemeModel", @"currentAwemeModel", @"model", @"itemModel"]);
        NSString *identity = ALBFXAwemeIDForModel(model);
        if (identity.length) return identity;
    }
    return nil;
}
extern void ALBFXArmLike(id model);

static BOOL AWEToastTextIndicatesLoading(NSString *text) {
    return [text containsString:@"正在"] || [text containsString:@"下载中"] ||
           [text containsString:@"准备中"];
}

static BOOL AWEToastTextIndicatesFailure(NSString *text) {
    NSArray<NSString *> *tokens = @[@"失败", @"未找到", @"没有解析", @"无效",
        @"无法", @"请允许", @"未识别", @"没有可复制"];
    for (NSString *token in tokens) if ([text containsString:token]) return YES;
    return NO;
}

static BOOL AWEToastTextIndicatesSuccess(NSString *text) {
    if (AWEToastTextIndicatesFailure(text) || AWEToastTextIndicatesLoading(text)) return NO;
    return [text containsString:@"已保存"] || [text containsString:@"保存完成"] ||
           [text containsString:@"已复制"] || [text containsString:@"完成"];
}

/* 3.11.46: the toast's text turns black / white with what is behind it (ALBLumaProbe.h); its glass stays Clear. */
#include "ALBLumaProbe.h"
static void AWEShowDownloadToastForJob(NSString *text, ALBDownloadJob *job) {
    if (text.length == 0) return;
    dispatch_async(dispatch_get_main_queue(), ^{
        if (job && !ALB8JobOwnsToast(job)) return;
        // An informational/copy/error toast must not remove the only cancel
        // target of an ongoing download. Keep its progress visible until the
        // exact job finishes; generic feedback is optional while busy.
        if (!job) {
            ALBDownloadJob *active=nil;
            @synchronized(ALBDownloadJob.class) { active=gALB8DownloadToastJob; }
            ALBDownloadState state=active.downloadState;
            if (active && (state==ALBDownloadActive || state==ALBDownloadCommitting)) return;
        }
        BOOL loading = AWEToastTextIndicatesLoading(text);
        if (loading && job && (job.downloadState == ALBDownloadCancelled ||
            job.downloadState == ALBDownloadFinished)) return;
        UIWindow *window = AWEActiveMainWindow();
        if (!window) return;

        NSUInteger generation = ++gAWEDownloadToastGeneration;
        UIView *old = gAWEDownloadToastView;
        [old removeFromSuperview];

        BOOL failure = AWEToastTextIndicatesFailure(text);
        BOOL success = AWEToastTextIndicatesSuccess(text);

        UIControl *host = [UIControl new];
        host.translatesAutoresizingMaskIntoConstraints = NO;
        host.backgroundColor = UIColor.clearColor;
        BOOL cancellable = loading && job && job.downloadState == ALBDownloadActive;
        host.userInteractionEnabled = cancellable;
        if (cancellable) {
            host.accessibilityLabel = [text stringByAppendingString:@"，轻点取消本次下载"];
            host.accessibilityTraits = UIAccessibilityTraitButton;
            [host addAction:[UIAction actionWithHandler:^(__unused UIAction *action) {
                if ([job cancel]) {
                    AWEShowDownloadToastForJob(@"已取消本次下载，并清理临时文件", job);
                }
            }] forControlEvents:UIControlEventTouchUpInside];
        }
        host.alpha = 0.0;
        host.transform = CGAffineTransformMakeScale(0.92, 0.92);
        host.layer.shadowColor = UIColor.blackColor.CGColor;
        host.layer.shadowOpacity = 0.12;
        host.layer.shadowRadius = 18.0;
        host.layer.shadowOffset = CGSizeMake(0.0, 7.0);

        // 3.10.5: the download toast is the Clear recipe (Clear + 28 % black),
        // not the dark Regular glass. 3.11.9 ("glass.followBar", the user's
        // choice): the right column's and panel's glass, light or dark by
        // what is behind it when it appears (below).
        /* 3.11.46 (user: "the plug-in's toast keeps switching back and forth; just use a plain clear button and make
           sure its text adapts black / white to the background"): the glass is always the system Clear glass, never
           restyled; the text and the plain icon turn black over a bright backdrop and white over a dark one
           (ALBLumaProbe, the same luma reading the dock uses, with hysteresis). */
        BOOL followToast = NO;
        UIVisualEffect *toastEffect = nil;
        if (@available(iOS 26.0, *)) {
            UIGlassEffect *clear = [UIGlassEffect effectWithStyle:UIGlassEffectStyleClear];
            clear.interactive = NO;
            toastEffect = clear;
        } else {
            toastEffect = [UIBlurEffect effectWithStyle:UIBlurEffectStyleSystemThinMaterial];
        }
        UIVisualEffectView *glass = [[UIVisualEffectView alloc] initWithEffect:toastEffect];
        glass.translatesAutoresizingMaskIntoConstraints = NO;
        glass.userInteractionEnabled = NO;
        glass.clipsToBounds = YES;
        glass.layer.cornerRadius = 28.0;
        glass.layer.cornerCurve = kCACornerCurveContinuous;
        // 3.11.12: always a capsule (a two-line text, the "轻点取消" while
        // loading, made the toast taller than 56 pt and its fixed 28 pt
        // corners a rounded rectangle; user report).
        if (@available(iOS 26.0, *)) glass.cornerConfiguration = [UICornerConfiguration capsuleConfiguration];
        [host addSubview:glass];
        ALBLumaProbe *probe = [[ALBLumaProbe alloc] initWithFrame:CGRectZero];
        probe.translatesAutoresizingMaskIntoConstraints = NO;
        [host insertSubview:probe atIndex:0];

        UIView *content = glass.contentView;
        UIStackView *row = [UIStackView new];
        row.translatesAutoresizingMaskIntoConstraints = NO;
        row.axis = UILayoutConstraintAxisHorizontal;
        row.alignment = UIStackViewAlignmentCenter;
        row.spacing = 10.0;
        [content addSubview:row];

        if (loading) {
            UIActivityIndicatorView *spinner = [[UIActivityIndicatorView alloc]
                initWithActivityIndicatorStyle:UIActivityIndicatorViewStyleMedium];
            spinner.color = UIColor.whiteColor;
            spinner.tag = 26082046;
            [spinner startAnimating];
            [row addArrangedSubview:spinner];
        } else {
            NSString *symbol = failure ? @"exclamationmark.triangle.fill" :
                (success ? @"checkmark.circle.fill" : @"arrow.down.circle.fill");
            UIImageView *icon = [[UIImageView alloc]
                initWithImage:[UIImage systemImageNamed:symbol]];
            icon.translatesAutoresizingMaskIntoConstraints = NO;
            icon.contentMode = UIViewContentModeScaleAspectFit;
            icon.tintColor = failure ? UIColor.systemOrangeColor :
                (success ? UIColor.systemGreenColor : UIColor.whiteColor);
            if (!failure && !success) icon.tag = 26082046;
            [NSLayoutConstraint activateConstraints:@[
                [icon.widthAnchor constraintEqualToConstant:22.0],
                [icon.heightAnchor constraintEqualToConstant:22.0]
            ]];
            [row addArrangedSubview:icon];
        }

        UILabel *label = [UILabel new];
        label.text = cancellable ? [text stringByAppendingString:@" · 轻点取消"] : text;
        label.textColor = UIColor.whiteColor;
        __weak UILabel *weakLabel = label;
        __weak UIStackView *weakRow = row;
        probe.onDark = ^(BOOL darkInk) {
            UIColor *ink = darkInk ? UIColor.blackColor : UIColor.whiteColor;
            [UIView transitionWithView:weakLabel duration:0.18 options:UIViewAnimationOptionTransitionCrossDissolve
                            animations:^{ weakLabel.textColor = ink; } completion:nil];
            for (UIView *item in weakRow.arrangedSubviews) {
                if (item.tag != 26082046) continue;
                if ([item isKindOfClass:UIActivityIndicatorView.class]) ((UIActivityIndicatorView *)item).color = ink;
                else item.tintColor = ink;
            }
        };
        label.font = [UIFont systemFontOfSize:15.0 weight:UIFontWeightSemibold];
        label.textAlignment = NSTextAlignmentCenter;
        label.numberOfLines = 2;
        label.adjustsFontSizeToFitWidth = YES;
        label.minimumScaleFactor = 0.86;
        [row addArrangedSubview:label];

        [NSLayoutConstraint activateConstraints:@[
            [glass.leadingAnchor constraintEqualToAnchor:host.leadingAnchor],
            [glass.trailingAnchor constraintEqualToAnchor:host.trailingAnchor],
            [glass.topAnchor constraintEqualToAnchor:host.topAnchor],
            [glass.bottomAnchor constraintEqualToAnchor:host.bottomAnchor],
            [row.leadingAnchor constraintEqualToAnchor:content.leadingAnchor constant:18.0],
            [row.trailingAnchor constraintEqualToAnchor:content.trailingAnchor constant:-18.0],
            [row.topAnchor constraintEqualToAnchor:content.topAnchor constant:13.0],
            [row.bottomAnchor constraintEqualToAnchor:content.bottomAnchor constant:-13.0],
            [probe.leadingAnchor constraintEqualToAnchor:host.leadingAnchor constant:10.0],
            [probe.trailingAnchor constraintEqualToAnchor:host.trailingAnchor constant:-10.0],
            [probe.topAnchor constraintEqualToAnchor:host.topAnchor constant:6.0],
            [probe.bottomAnchor constraintEqualToAnchor:host.bottomAnchor constant:-6.0]
        ]];

        [window addSubview:host];
        NSLayoutConstraint *maxWidth = [host.widthAnchor
            constraintLessThanOrEqualToAnchor:window.widthAnchor multiplier:0.78];
        maxWidth.priority = UILayoutPriorityRequired;
        [NSLayoutConstraint activateConstraints:@[
            [host.centerXAnchor constraintEqualToAnchor:window.centerXAnchor],
            [host.centerYAnchor constraintEqualToAnchor:window.centerYAnchor constant:4.0],
            [host.heightAnchor constraintGreaterThanOrEqualToConstant:56.0],
            [host.widthAnchor constraintGreaterThanOrEqualToConstant:150.0],
            maxWidth
        ]];

        gAWEDownloadToastView = host;
        [window layoutIfNeeded];
        glass.layer.cornerRadius = CGRectGetHeight(glass.bounds) * 0.5;
        if (followToast) {
            // 3.11.10: the panel's rule: Dark on its own Dark edge, UIKit turns it.
            glass.overrideUserInterfaceStyle = UIUserInterfaceStyleDark;
            ALBFollowSyncEdge(glass);
        }
        [UIView animateWithDuration:0.28
                              delay:0.0
             usingSpringWithDamping:0.78
              initialSpringVelocity:0.35
                            options:UIViewAnimationOptionAllowUserInteraction |
                                    UIViewAnimationOptionBeginFromCurrentState
                         animations:^{
            host.alpha = 1.0;
            host.transform = CGAffineTransformIdentity;
        } completion:nil];

        // A running job stays reachable until completion/cancellation. The old
        // twelve-second timeout left long downloads with no cancel target.
        if (loading && job) return;
        NSTimeInterval lifetime = loading ? 12.0 : 1.65;
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW,
            (int64_t)(lifetime * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            if (generation != gAWEDownloadToastGeneration ||
                gAWEDownloadToastView != host) return;
            [UIView animateWithDuration:0.20 animations:^{
                host.alpha = 0.0;
                host.transform = CGAffineTransformMakeScale(0.96, 0.96);
            } completion:^(__unused BOOL finished) {
                if (gAWEDownloadToastView == host) gAWEDownloadToastView = nil;
                [host removeFromSuperview];
            }];
        });
    });
}

static void AWEShowDownloadToast(NSString *text) {
    AWEShowDownloadToastForJob(text, nil);
}

static void ALB8FinishDownload(ALBDownloadJob *job, NSString *message) {
    if ([job finishKeepingFiles:NO]) AWEShowDownloadToastForJob(message, job);
}

static NSMutableURLRequest *AWEMediaRequest(NSString *urlString) {
    if (!urlString.length) return nil;
    NSURL *url = [NSURL URLWithString:urlString ?: @""];
    if (!url) return nil;
    NSMutableURLRequest *request = [NSMutableURLRequest requestWithURL:url
        cachePolicy:NSURLRequestReloadIgnoringLocalCacheData timeoutInterval:75.0];
    request.HTTPShouldHandleCookies = YES;
    [request setValue:@"*/*" forHTTPHeaderField:@"Accept"];
    [request setValue:@"identity" forHTTPHeaderField:@"Accept-Encoding"];
    [request setValue:@"https://www.douyin.com/" forHTTPHeaderField:@"Referer"];
    NSString *userAgent = [NSUserDefaults.standardUserDefaults stringForKey:@"UserAgent"];
    if (userAgent.length == 0) {
        userAgent = @"Mozilla/5.0 (iPhone; CPU iPhone OS 26_0 like Mac OS X) AppleWebKit/605.1.15 Mobile/15E148 aweme";
    }
    [request setValue:userAgent forHTTPHeaderField:@"User-Agent"];
    return request;
}

static void AWERequestPhotoAddPermission(void (^completion)(BOOL granted)) {
    if (!completion) return;
    if (@available(iOS 14.0, *)) {
        PHAuthorizationStatus status = [PHPhotoLibrary authorizationStatusForAccessLevel:PHAccessLevelAddOnly];
        if (status == PHAuthorizationStatusAuthorized || status == PHAuthorizationStatusLimited) {
            completion(YES); return;
        }
        if (status == PHAuthorizationStatusDenied || status == PHAuthorizationStatusRestricted) {
            completion(NO); return;
        }
        [PHPhotoLibrary requestAuthorizationForAccessLevel:PHAccessLevelAddOnly
            handler:^(PHAuthorizationStatus newStatus) {
                completion(newStatus == PHAuthorizationStatusAuthorized ||
                           newStatus == PHAuthorizationStatusLimited);
            }];
        return;
    }
    [PHPhotoLibrary requestAuthorization:^(PHAuthorizationStatus status) {
        completion(status == PHAuthorizationStatusAuthorized);
    }];
}

static void ALB8SaveDownloadedFiles(ALBDownloadJob *job, NSArray<NSURL *> *files,
    BOOL video, NSString *successMessage) {
    if (job.downloadState != ALBDownloadActive) return;
    AWERequestPhotoAddPermission(^(BOOL granted) {
        if (job.downloadState != ALBDownloadActive) return;
        if (!granted) { ALB8FinishDownload(job, @"请允许添加照片后重试"); return; }
        if (!files.count) { ALB8FinishDownload(job, @"没有可保存的资源"); return; }
        // PHPhotoLibrary transactions cannot be cancelled after submission.
        // The synchronized transition closes the cancel target before commit;
        // a cancellation that won this race never reaches performChanges.
        if (![job beginCommit]) return;
        AWEShowDownloadToastForJob(@"正在写入相册", job);
        [[PHPhotoLibrary sharedPhotoLibrary] performChanges:^{
            for (NSURL *url in files) {
                if (video) [PHAssetChangeRequest creationRequestForAssetFromVideoAtFileURL:url];
                else [PHAssetChangeRequest creationRequestForAssetFromImageAtFileURL:url];
            }
        } completionHandler:^(BOOL success, __unused NSError *error) {
            ALB8FinishDownload(job, success ? successMessage : @"无法写入相册，请检查照片权限");
        }];
    });
}

static BOOL ALB8ValidDownloadedImage(NSURL *url) {
    if (!url) return NO;
    CGImageSourceRef source = CGImageSourceCreateWithURL((__bridge CFURLRef)url, NULL);
    BOOL valid = source && CGImageSourceGetCount(source) > 0;
    if (source) CFRelease(source);
    return valid;
}

static NSURL *AWEMoveDownloadedFile(ALBDownloadJob *job, NSURL *location, NSString *extension) {
    return [job moveDownloadedFile:location extension:extension];
}

static NSString *AWERobustVideoURLForAweme(id aweme) {
    id video = AWESafeValueForKey(aweme, @"video");
    if (!video) return nil;

    /* DYYY's stable path on current Douyin builds starts from h264URL's
       originURLList. Prefer that simple platform-provided stream before any
       bitrate/DASH heuristics; the goal of 1.0.55a is reliable saving first. */
    id h264 = AWESafeValueForKey(video, @"h264URL");
    NSString *url = AWEFirstRemoteURLString(
        AWESafeValueForKey(h264, @"originURLList") ?: h264, 0);
    if (url.length) return url;

    for (NSString *key in @[@"playURL", @"playAddr", @"downloadURL", @"downloadAddr"]) {
        id value = AWESafeValueForKey(video, key);
        url = AWEFirstRemoteURLString(value, 0);
        if (url.length) return url;
    }

    NSArray<AWEVideoVariant *> *variants = AWEVideoVariantsForVideo(video, YES);
    return variants.firstObject.urlString;
}

static void AWEDownloadSmartVideoForAweme(id aweme) {
    NSString *urlString = AWERobustVideoURLForAweme(aweme);
    if (!urlString.length) {
        AWEShowDownloadToast(@"未找到可下载的视频资源");
        AWEInteractionDiagnosticWrite(@"DOWNLOAD_VIDEO model=%@ result=no-url", AWEAwemeIdentity(aweme));
        return;
    }
    AWEInteractionDiagnosticWrite(@"DOWNLOAD_VIDEO model=%@ mode=robust-h264 url=%@", AWEAwemeIdentity(aweme), urlString);
    NSMutableURLRequest *request = AWEMediaRequest(urlString);
    if (!request) { AWEShowDownloadToast(@"视频地址无效"); return; }
    ALBDownloadJob *job = ALB8BeginDownloadJob();
    AWEShowDownloadToastForJob(@"正在下载视频", job);
    NSURLSessionDownloadTask *task = [job downloadTaskWithRequest:request
        completion:^(NSURL *location, NSURLResponse *response, NSError *error) {
            if (job.downloadState != ALBDownloadActive) return;
            NSInteger status = [response isKindOfClass:NSHTTPURLResponse.class] ? ((NSHTTPURLResponse *)response).statusCode : 0;
            AWEInteractionDiagnosticWrite(@"DOWNLOAD_VIDEO_HTTP status=%ld bytes=%lld error=%@",
                (long)status, response.expectedContentLength, error.localizedDescription ?: @"none");
            if (error || !location || status >= 400) {
                ALB8FinishDownload(job, [NSString stringWithFormat:@"视频下载失败%@",
                    status > 0 ? [NSString stringWithFormat:@"（HTTP %ld）", (long)status] : @""]);
                return;
            }
            NSString *ext = response.suggestedFilename.pathExtension.lowercaseString;
            if (!ext.length || ext.length > 6) ext = @"mp4";
            NSURL *fileURL = AWEMoveDownloadedFile(job, location, ext);
            if (!fileURL) { ALB8FinishDownload(job, @"视频临时文件保存失败"); return; }
            ALB8SaveDownloadedFiles(job, @[fileURL], YES, @"视频已保存");
        }];
    [job startTask:task];
}

static NSArray *AWEAlbumImagesForAweme(id aweme) {
    NSArray *images = AWEArrayFromValue(AWESafeValueForKey(aweme, @"albumImages"));
    if (images.count == 0) images = AWEArrayFromValue(AWESafeValueForKey(aweme, @"imageList"));
    return images ?: @[];
}

static NSString *AWEImageURLForModel(id imageModel) {
    NSArray *urlList = AWEArrayFromValue(AWESafeValueForKey(imageModel, @"urlList"));
    NSString *fallback = nil;
    for (id value in urlList) {
        NSString *candidate = AWEStringFromValue(value);
        if (!AWEStringLooksLikeRemoteURL(candidate)) continue;
        if (!fallback.length) fallback = candidate;
        NSURL *url = [NSURL URLWithString:candidate];
        if (![[url.pathExtension lowercaseString] isEqualToString:@"image"]) {
            return candidate;
        }
    }
    if (fallback.length) return fallback;
    id address = AWEFirstSafeValue(imageModel,
        @[@"originURLList", @"imageList", @"displayImage", @"url"]);
    return AWEFirstRemoteURLString(address ?: imageModel, 0);
}

static id AWECurrentAlbumImageModelForAweme(id aweme) {
    NSArray *images = AWEAlbumImagesForAweme(aweme);
    if (images.count == 0) return nil;
    NSInteger index = (NSInteger)AWEInteger64FromValue(AWESafeValueForKey(aweme, @"currentImageIndex"));
    if (index > 0 && index <= (NSInteger)images.count) return images[index - 1];
    if (index >= 0 && index < (NSInteger)images.count) return images[index];
    return images.firstObject;
}

static void AWEDownloadCurrentImageForAweme(id aweme) {
    NSString *urlString = AWEImageURLForModel(AWECurrentAlbumImageModelForAweme(aweme));
    if (!urlString.length) { AWEShowDownloadToast(@"没有解析到当前图片"); return; }
    NSMutableURLRequest *request = AWEMediaRequest(urlString);
    if (!request) { AWEShowDownloadToast(@"图片地址无效"); return; }
    ALBDownloadJob *job = ALB8BeginDownloadJob();
    AWEShowDownloadToastForJob(@"正在下载图片", job);
    NSURLSessionDownloadTask *task = [job downloadTaskWithRequest:request
        completion:^(NSURL *location, NSURLResponse *response, NSError *error) {
            if (job.downloadState != ALBDownloadActive) return;
            NSInteger status = [response isKindOfClass:NSHTTPURLResponse.class] ? ((NSHTTPURLResponse *)response).statusCode : 0;
            if (error || !location || status >= 400) { ALB8FinishDownload(job, @"当前图片下载失败"); return; }
            NSString *ext = response.suggestedFilename.pathExtension;
            NSURL *fileURL = AWEMoveDownloadedFile(job, location, ext.length ? ext : @"jpg");
            if (!ALB8ValidDownloadedImage(fileURL)) { ALB8FinishDownload(job, @"当前图片读取失败"); return; }
            ALB8SaveDownloadedFiles(job, @[fileURL], NO, @"图片已保存");
        }];
    [job startTask:task];
}

static void AWEDownloadAllImagesForAweme(id aweme) {
    NSArray *images = AWEAlbumImagesForAweme(aweme);
    if (!images.count) { AWEShowDownloadToast(@"当前作品没有图集"); return; }
    ALBDownloadJob *job = ALB8BeginDownloadJob();
    AWEShowDownloadToastForJob([NSString stringWithFormat:@"正在下载 %lu 张图片", (unsigned long)images.count], job);
    dispatch_group_t group = dispatch_group_create();
    // Keep original album order; collect files first and commit one photo
    // transaction so a cancellation does not leave a half-saved album.
    NSMutableDictionary<NSNumber *, NSURL *> *downloaded = [NSMutableDictionary dictionary];
    [images enumerateObjectsUsingBlock:^(id imageModel, NSUInteger index, __unused BOOL *stop) {
        NSMutableURLRequest *request = AWEMediaRequest(AWEImageURLForModel(imageModel));
        if (!request || job.downloadState != ALBDownloadActive) return;
        dispatch_group_enter(group);
        NSURLSessionDownloadTask *task = [job downloadTaskWithRequest:request
            completion:^(NSURL *location, NSURLResponse *response, NSError *error) {
                if (job.downloadState == ALBDownloadActive) {
                    NSInteger status = [response isKindOfClass:NSHTTPURLResponse.class] ? ((NSHTTPURLResponse *)response).statusCode : 0;
                    if (!error && location && status < 400) {
                        NSString *ext = response.suggestedFilename.pathExtension;
                        NSURL *fileURL = AWEMoveDownloadedFile(job, location, ext.length ? ext : @"jpg");
                        if (ALB8ValidDownloadedImage(fileURL)) @synchronized(downloaded) { downloaded[@(index)] = fileURL; }
                    }
                }
                dispatch_group_leave(group);
            }];
        if (task) [job startTask:task];
        else dispatch_group_leave(group); // cancelled before task creation
    }];
    dispatch_group_notify(group, dispatch_get_main_queue(), ^{
        if (job.downloadState != ALBDownloadActive) return;
        NSMutableArray<NSURL *> *files = [NSMutableArray array];
        @synchronized(downloaded) {
            for (NSNumber *key in [downloaded.allKeys sortedArrayUsingSelector:@selector(compare:)]) [files addObject:downloaded[key]];
        }
        if (!files.count) { ALB8FinishDownload(job, @"图集图片下载失败"); return; }
        NSString *message = [NSString stringWithFormat:@"已保存 %lu/%lu 张图片", (unsigned long)files.count, (unsigned long)images.count];
        ALB8SaveDownloadedFiles(job, files, NO, message);
    });
}

static NSString *AWEAudioURLForAweme(id aweme) {
    id music = AWESafeValueForKey(aweme, @"music");
    id address = AWEFirstSafeValue(music,
        @[@"playURL", @"playAddr", @"urlList", @"originURLList", @"url"]);
    return AWEFirstRemoteURLString(address ?: music, 0);
}

static UIViewController *AWECurrentPresenter(void) {
    UIWindow *window = AWEActiveMainWindow();
    return window ? AWETopViewControllerFrom(window.rootViewController) : nil;
}

/* The exported file stays alive for the complete share-controller lifetime.
   UIKit may refuse a presentation without invoking its activity completion;
   deallocation is an independent, idempotent cleanup path in that case. */
@interface ALB8AudioActivityController : UIActivityViewController
@property(nonatomic,strong) ALBDownloadJob *downloadJob;
@property(nonatomic) BOOL presentedAtLeastOnce;
@end
@implementation ALB8AudioActivityController
- (void)viewDidAppear:(BOOL)animated { [super viewDidAppear:animated]; self.presentedAtLeastOnce=YES; }
- (void)dealloc { [self.downloadJob cleanTemporaryFiles]; }
@end

static void AWEDownloadAudioForAweme(id aweme) {
    NSString *urlString = AWEAudioURLForAweme(aweme);
    if (!urlString.length) { AWEShowDownloadToast(@"未找到音频资源"); return; }
    NSMutableURLRequest *request = AWEMediaRequest(urlString);
    if (!request) { AWEShowDownloadToast(@"音频地址无效"); return; }
    ALBDownloadJob *job = ALB8BeginDownloadJob();
    AWEShowDownloadToastForJob(@"正在下载音频", job);
    NSURLSessionDownloadTask *task = [job downloadTaskWithRequest:request
        completion:^(NSURL *location, NSURLResponse *response, NSError *error) {
            if (job.downloadState != ALBDownloadActive) return;
            NSInteger status = [response isKindOfClass:NSHTTPURLResponse.class] ? ((NSHTTPURLResponse *)response).statusCode : 0;
            if (error || !location || status >= 400) { ALB8FinishDownload(job, @"音频下载失败"); return; }
            NSString *ext = response.suggestedFilename.pathExtension.lowercaseString;
            if (!ext.length || ext.length > 6) ext = [NSURL URLWithString:urlString].pathExtension.lowercaseString;
            if (!ext.length || ext.length > 6) ext = @"m4a";
            NSURL *fileURL = AWEMoveDownloadedFile(job, location, ext);
            if (!fileURL) { ALB8FinishDownload(job, @"音频临时文件保存失败"); return; }
            dispatch_async(dispatch_get_main_queue(), ^{
                if (job.downloadState != ALBDownloadActive) return;
                UIViewController *presenter = AWECurrentPresenter();
                if (!presenter || !presenter.viewIfLoaded.window ||
                    presenter.isBeingPresented || presenter.isBeingDismissed ||
                    presenter.presentedViewController || presenter.transitionCoordinator) {
                    ALB8FinishDownload(job, @"当前页面正在切换，无法打开音频导出面板，请重试"); return;
                }
                if (![job finishKeepingFiles:YES]) return;
                AWEShowDownloadToastForJob(@"音频已下载", job);
                ALB8AudioActivityController *activity = [[ALB8AudioActivityController alloc] initWithActivityItems:@[fileURL] applicationActivities:nil];
                activity.downloadJob=job;
                if (activity.popoverPresentationController) {
                    activity.popoverPresentationController.sourceView = presenter.view;
                    activity.popoverPresentationController.sourceRect = CGRectMake(CGRectGetMidX(presenter.view.bounds), CGRectGetMidY(presenter.view.bounds), 1, 1);
                }
                activity.completionWithItemsHandler = ^(__unused UIActivityType type, __unused BOOL completed,
                    __unused NSArray *items, __unused NSError *activityError) { [job cleanTemporaryFiles]; };
                [presenter presentViewController:activity animated:YES completion:nil];
                __weak ALB8AudioActivityController *weakActivity=activity;
                dispatch_after(dispatch_time(DISPATCH_TIME_NOW,(int64_t)(1.0*NSEC_PER_SEC)),dispatch_get_main_queue(), ^{
                    ALB8AudioActivityController *live=weakActivity;
                    // Never remove a file while a share extension is using it:
                    // an accepted presentation has either a presenting owner,
                    // a visible window, or has already appeared at least once.
                    if (!live || (!live.presentedAtLeastOnce && !live.presentingViewController && !live.viewIfLoaded.window)) {
                        [job cleanTemporaryFiles];
                        if (live) AWEShowDownloadToastForJob(@"无法打开音频导出面板，临时文件已清理",job);
                    }
                });
            });
        }];
    [job startTask:task];
}

static void AWECopyCompleteTextForAweme(id aweme) {
    NSString *text = AWEStringFromValue(AWEFirstSafeValue(aweme,
        @[@"descriptionString", @"desc", @"text", @"caption"]));
    if (text.length == 0) { AWEShowDownloadToast(@"当前作品没有可复制文案"); return; }
    dispatch_async(dispatch_get_main_queue(), ^{
        UIPasteboard.generalPasteboard.string = text;
        AWEShowDownloadToast(@"完整文案已复制");
    });
}

/* 3.11.45: video at the highest quality and live photos (ALBMediaSave.h). */
#include "ALBMediaSave.h"

/* Video-variant metadata above is retained only by the downloader.
   The former highest-quality playback preference and bitrate-list mutation
   hook are removed in 2.0. */

typedef NS_ENUM(NSInteger, AWEHomeTopActionKind) {
    AWEHomeTopActionKindMenu = 1,
    AWEHomeTopActionKindSearch = 2
};

static BOOL AWEForwardTopActionOwner(UIView *owner, AWEHomeTopActionKind kind);
static UIView *AWEFindTopOwnerCandidate(UIView *root, BOOL search);

static NSString *AWEHomeActionSymbolKey(AWEHomeActionKind kind, BOOL selected) {
    NSString *name = nil;
    BOOL supportsSelectedVariant = NO;
    switch (kind) {
        case AWEHomeActionKindLike:
            name = @"like"; supportsSelectedVariant = YES; break;
        case AWEHomeActionKindComment:
            name = @"comment"; break;
        case AWEHomeActionKindFavorite:
            name = @"favorite"; supportsSelectedVariant = YES; break;
        case AWEHomeActionKindShare:
            name = @"share"; break;
        default: return nil;
    }
    NSString *state = (selected && supportsSelectedVariant) ? @"selected" : @"normal";
    return [NSString stringWithFormat:@"right.%@.%@", name, state];
}

static BOOL AWEHomeViewEffectivelyVisible(UIView *view) {
    if (!view || !view.window || view.hidden || view.alpha < 0.01) return NO;

    for (UIView *current = view.superview;
         current && current != view.window;
         current = current.superview) {
        if (current.hidden || current.alpha < 0.01) return NO;
    }

    CGRect frame = [view convertRect:view.bounds toView:view.window];
    if (CGRectIsEmpty(frame) || CGRectIsNull(frame)) return NO;
    return CGRectIntersectsRect(CGRectInset(view.window.bounds, -8.0, -8.0), frame);
}

static NSString *AWEHomeActionEvidence(UIView *view) {
    if (!view) return @"";

    NSMutableArray<NSString *> *parts = [NSMutableArray array];
    NSArray *direct = @[
        view.accessibilityLabel ?: @"",
        view.accessibilityValue ?: @"",
        view.accessibilityIdentifier ?: @"",
        NSStringFromClass(view.class) ?: @""
    ];
    for (NSString *value in direct) {
        if (value.length > 0) [parts addObject:value];
    }

    NSUInteger visited = 0;
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:view];
    while (queue.count > 0 && visited < 42) {
        UIView *current = queue.firstObject;
        [queue removeObjectAtIndex:0];
        visited++;

        if (current != view) {
            NSString *label = current.accessibilityLabel;
            NSString *identifier = current.accessibilityIdentifier;
            if (label.length > 0) [parts addObject:label];
            if (identifier.length > 0) [parts addObject:identifier];
            if ([current isKindOfClass:UILabel.class]) {
                NSString *value = ((UILabel *)current).text;
                if (value.length > 0 && value.length <= 16) [parts addObject:value];
            }
        }
        for (UIView *child in current.subviews) [queue addObject:child];
    }
    return [[parts componentsJoinedByString:@"|"] lowercaseString];
}

static AWEHomeActionKind AWEHomeActionKindFromEvidence(UIView *view) {
    NSString *evidence = AWEHomeActionEvidence(view);
    if ([evidence containsString:@"评论"] ||
        [evidence containsString:@"comment"] ||
        [evidence containsString:@"回复"]) {
        return AWEHomeActionKindComment;
    }
    if ([evidence containsString:@"收藏"] ||
        [evidence containsString:@"favorite"] ||
        [evidence containsString:@"favourite"] ||
        [evidence containsString:@"collect"] ||
        [evidence containsString:@"bookmark"]) {
        return AWEHomeActionKindFavorite;
    }
    if ([evidence containsString:@"分享"] ||
        [evidence containsString:@"share"] ||
        [evidence containsString:@"转发"]) {
        return AWEHomeActionKindShare;
    }
    if ([evidence containsString:@"点赞"] ||
        [evidence containsString:@"喜欢"] ||
        [evidence containsString:@"like"] ||
        [evidence containsString:@"digg"]) {
        return AWEHomeActionKindLike;
    }
    return AWEHomeActionKindUnknown;
}

static void AWECollectFeedActionButtons(UIView *root,
                                        NSMutableArray<UIView *> *result,
                                        NSUInteger depth) {
    if (!root || !result || depth > 12) return;
    if ([root isKindOfClass:NSClassFromString(@"AWEFeedVideoButton")]) {
        [result addObject:root];
        return;
    }
    for (UIView *child in root.subviews) {
        if ([child isKindOfClass:AWEHomeActionSlotView.class]) continue;
        AWECollectFeedActionButtons(child, result, depth + 1);
    }
}

static UIView *AWEHomeActionStackForView(UIView *view) {
    for (UIView *current = view; current; current = current.superview) {
        if ([NSStringFromClass(current.class) containsString:@"AWEElementStackView"]) {
            return current;
        }
        if (current == view.window) break;
    }
    return nil;
}


static BOOL AWEHomeActionButtonLocallyUsable(UIView *button, UIView *stack) {
    if (!button || !stack || !button.window || button.hidden || ALB7RightNativeAlpha(button) < 0.01) {
        return NO;
    }
    BOOL reachedStack = NO;
    for (UIView *cursor = button; cursor; cursor = cursor.superview) {
        if (cursor.hidden || ALB7RightNativeAlpha(cursor) < 0.01) return NO;
        if (cursor == stack) { reachedStack = YES; break; }
        if (cursor == button.window) break;
    }
    if (!reachedStack) return NO;
    CGRect frame = [button convertRect:button.bounds toView:stack];
    if (CGRectIsNull(frame) || CGRectIsEmpty(frame) ||
        CGRectGetWidth(frame) < 8.0 || CGRectGetHeight(frame) < 8.0) return NO;
    /* Paging may place the whole stack outside the window for part of a drag.
       Judge buttons in the stack's own coordinate space so bindings survive
       the trip out and back instead of being permanently hidden on one pass. */
    return CGRectIntersectsRect(CGRectInset(stack.bounds, -80.0, -160.0), frame);
}

/* TEST42 FIX6: Douyin's right-column AWEFeedVideoButtons carry no
   accessibility text, and their labels are only counts, so text evidence
   never identifies Favorite/Share. Device snapshots show the owning element
   types instead (e.g. AWEPlayInteractionShareElement, the comment button's
   AWECommentInteractionElementTouchGesture). Classify from those runtime
   identities: tap targets, gesture classes, the owning element views and
   their object references. Read-only; ambiguous evidence stays unknown. */
static AWEHomeActionKind ALB44KindFromRuntimeName(NSString *name) {
    if (name.length == 0) return AWEHomeActionKindUnknown;
    BOOL semantic = [name containsString:@"Element"] || [name containsString:@"Component"] ||
        [name containsString:@"Gesture"] || [name containsString:@"Interactor"] ||
        [name containsString:@"ViewModel"] || [name containsString:@"Button"];
    if (!semantic) return AWEHomeActionKindUnknown;
    if ([name containsString:@"Share"]) return AWEHomeActionKindShare;
    if ([name containsString:@"Comment"]) return AWEHomeActionKindComment;
    if ([name containsString:@"Collect"] || [name containsString:@"Favorite"] ||
        [name containsString:@"Favourite"]) return AWEHomeActionKindFavorite;
    if ([name containsString:@"Digg"] || [name containsString:@"Like"]) return AWEHomeActionKindLike;
    return AWEHomeActionKindUnknown;
}
static void ALB44CollectRuntimeKinds(id object, NSMutableSet<NSNumber *> *kinds) {
    if (!object) return;
    AWEHomeActionKind kind = ALB44KindFromRuntimeName(NSStringFromClass(object_getClass(object)));
    if (kind != AWEHomeActionKindUnknown) [kinds addObject:@(kind)];
}
static AWEHomeActionKind ALB44HomeActionKindFromRuntime(UIView *button) {
    if (!button) return AWEHomeActionKindUnknown;
    NSMutableSet<NSNumber *> *kinds = [NSMutableSet set];
    NSUInteger depth = 0;
    for (UIView *view = button; view && depth < 4; view = view.superview, depth++) {
        NSString *name = NSStringFromClass(object_getClass(view));
        if ([name containsString:@"ElementStackView"]) break; // shared by every row
        if (view != button) ALB44CollectRuntimeKinds(view, kinds);
        for (UIGestureRecognizer *recognizer in view.gestureRecognizers) {
            ALB44CollectRuntimeKinds(recognizer, kinds);
            id containers = AWEObjectIvar(recognizer, "_targets");
            if (![containers isKindOfClass:NSArray.class]) continue;
            for (id container in (NSArray *)containers)
                ALB44CollectRuntimeKinds(AWEObjectIvar(container, "_target"), kinds);
        }
        if ([view isKindOfClass:UIControl.class])
            for (id target in ((UIControl *)view).allTargets) ALB44CollectRuntimeKinds(target, kinds);
        unsigned count = 0;
        Ivar *ivars = class_copyIvarList(object_getClass(view), &count);
        for (unsigned i = 0; i < count && i < 48; i++) {
            const char *type = ivar_getTypeEncoding(ivars[i]);
            if (!type || type[0] != '@') continue;
            id value = nil;
            @try { value = object_getIvar(view, ivars[i]); } @catch (__unused NSException *e) { value = nil; }
            if (value && value != view && ![value isKindOfClass:UIView.class]) ALB44CollectRuntimeKinds(value, kinds);
        }
        free(ivars);
        if (kinds.count) break; // nearest owner wins
    }
    return kinds.count == 1 ? (AWEHomeActionKind)kinds.anyObject.integerValue : AWEHomeActionKindUnknown;
}
static CGFloat ALB44NativeMidY(UIView *button, UIView *stack) {
    return CGRectGetMidY(ALB19RightConvertRect(button, button.bounds, stack, stack));
}

static NSArray<UIView *> *AWESortedVisibleHomeActionButtons(UIView *stack) {
    NSMutableArray<UIView *> *buttons = [NSMutableArray array];
    AWECollectFeedActionButtons(stack, buttons, 0);
    NSIndexSet *hiddenIndexes = [buttons indexesOfObjectsPassingTest:
        ^BOOL(UIView *button, NSUInteger idx, BOOL *stop) {
            (void)idx; (void)stop;
            return !AWEHomeActionButtonLocallyUsable(button, stack);
        }];
    [buttons removeObjectsAtIndexes:hiddenIndexes];
    [buttons sortUsingComparator:^NSComparisonResult(UIView *lhs, UIView *rhs) {
        CGFloat ly = ALB44NativeMidY(lhs, stack);
        CGFloat ry = ALB44NativeMidY(rhs, stack);
        if (ly < ry) return NSOrderedAscending;
        if (ly > ry) return NSOrderedDescending;
        return NSOrderedSame;
    }];
    return buttons;
}

static AWEHomeActionKind AWEHomeActionKindForButton(UIView *button,
                                                     NSArray<UIView *> *ordered) {
    AWEHomeActionKind kind = ALB44HomeActionKindFromRuntime(button);
    if (kind == AWEHomeActionKindUnknown) kind = AWEHomeActionKindFromEvidence(button);
    if (kind == AWEHomeActionKindUnknown) {
        NSNumber *stored = objc_getAssociatedObject(button, &kAWEHomeActionKindKey);
        if (stored) kind = (AWEHomeActionKind)stored.integerValue;
    }
    if (kind == AWEHomeActionKindUnknown) {
        NSUInteger index = [ordered indexOfObjectIdenticalTo:button];
        switch (index) {
            case 0: kind = AWEHomeActionKindLike; break;
            case 1: kind = AWEHomeActionKindComment; break;
            case 2: kind = AWEHomeActionKindFavorite; break;
            case 3: kind = AWEHomeActionKindShare; break;
            default: break;
        }
    }
    if (kind != AWEHomeActionKindUnknown) {
        objc_setAssociatedObject(button, &kAWEHomeActionKindKey, @(kind),
                                 OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    return kind;
}

/*
 Exact native-action forwarding for the visible Liquid Glass controls.

 The glass UIButton stays the real touch owner, so UIKit keeps its genuine
 Liquid Glass press/stretch behavior.  We do not clone/reparent Douyin's
 recognizer and we do not synthesize a foreign UITouch.  On TouchUpInside we
 locate the original tap recognizer on the original Douyin source hierarchy
 and invoke its original target/action with THAT recognizer as sender.

 This distinction matters for private recognizers such as AWEAlphaTapGesture:
 handlers can inspect recognizer.view/state/private metadata, so a cloned
 recognizer may make UIApplication report a successful send while the business
 action itself silently ignores it.
*/
static NSInteger AWEExactTapRecognizerScore(UIGestureRecognizer *recognizer,
                                             UIView *sourceView,
                                             NSUInteger depth) {
    if (!recognizer || !recognizer.enabled) return NSIntegerMin;
    NSString *name = NSStringFromClass(recognizer.class).lowercaseString;
    if ([name containsString:@"long"] || [name containsString:@"pan"] ||
        [name containsString:@"swipe"] || [name containsString:@"pinch"] ||
        [name containsString:@"rotation"]) return NSIntegerMin;
    BOOL tapLike = [recognizer isKindOfClass:UITapGestureRecognizer.class] ||
        [name containsString:@"tap"] || [name containsString:@"click"];
    if (!tapLike) return NSIntegerMin;

    NSInteger score = 100 - (NSInteger)MIN(depth, 12u) * 5;
    if (recognizer.view == sourceView) score += 55;
    if ([name containsString:@"alphatap"]) score += 120;
    if ([name containsString:@"touchup"]) score += 75;
    if ([name containsString:@"click"]) score += 45;

    id containers = AWEObjectIvar(recognizer, "_targets");
    if (![containers isKindOfClass:NSArray.class]) {
        @try { containers = [recognizer valueForKey:@"_targets"]; }
        @catch (__unused NSException *exception) { containers = nil; }
    }
    if ([containers isKindOfClass:NSArray.class]) {
        for (id container in (NSArray *)containers) {
            SEL action = AWESelectorIvar(container, "_action");
            NSString *actionName = action ? NSStringFromSelector(action).lowercaseString : @"";
            if ([actionName containsString:@"touchup"] ||
                [actionName containsString:@"tap"] ||
                [actionName containsString:@"click"]) score += 70;
            if ([actionName containsString:@"long"] ||
                [actionName containsString:@"double"]) score -= 120;
        }
    }
    return score;
}

static BOOL AWEExactNativeTargetIsTelemetry(id target, SEL action) {
    NSString *targetName = target ? NSStringFromClass([target class]).lowercaseString : @"";
    NSString *actionName = action ? NSStringFromSelector(action).lowercaseString : @"";
    if ([targetName containsString:@"bstuigesturerecognizerobserver"] ||
        [targetName containsString:@"uiselectioninteraction"] ||
        [actionName containsString:@"bsthandlegesture"] ||
        [actionName containsString:@"selectgesturehandler"] ||
        [actionName containsString:@"awe_uitracker"] ||
        [actionName containsString:@"tracker"] ||
        [actionName containsString:@"analytics"] ||
        [actionName containsString:@"statistics"]) {
        return YES;
    }
    return NO;
}

static BOOL AWEInvokeExactNativeRecognizer(UIGestureRecognizer *recognizer,
                                           NSString *context) {
    if (!recognizer || !recognizer.enabled || !recognizer.view) return NO;
    id targetContainers = AWEObjectIvar(recognizer, "_targets");
    if (![targetContainers isKindOfClass:NSArray.class]) {
        @try { targetContainers = [recognizer valueForKey:@"_targets"]; }
        @catch (__unused NSException *exception) { targetContainers = nil; }
    }
    if (![targetContainers isKindOfClass:NSArray.class] ||
        [(NSArray *)targetContainers count] == 0) return NO;

    NSInteger oldState = recognizer.state;
    NSString *stateStorage = nil;
    BOOL forced = AWEForceRecognizerState(recognizer, UIGestureRecognizerStateEnded,
                                          &oldState, &stateStorage);
    AWEInteractionDiagnosticWrite(
        @"NATIVE_STATE_FORCE context=%@ recognizer=%@ before=%ld during=%ld forced=%d storage=%@",
        context ?: @"unknown", NSStringFromClass(recognizer.class),
        (long)oldState, (long)recognizer.state, forced, stateStorage ?: @"none");

    BOOL businessDispatched = NO;
    NSUInteger businessTargets = 0;
    for (id container in [(NSArray *)targetContainers copy]) {
        id target = AWEObjectIvar(container, "_target");
        SEL action = AWESelectorIvar(container, "_action");
        if (!target || !action || ![target respondsToSelector:action]) continue;
        BOOL telemetry = AWEExactNativeTargetIsTelemetry(target, action);
        if (telemetry) {
            AWEInteractionDiagnosticWrite(
                @"EXACT_NATIVE_SKIP context=%@ target=%@ action=%@ reason=telemetry",
                context ?: @"unknown", NSStringFromClass([target class]),
                NSStringFromSelector(action));
            continue;
        }
        businessTargets++;
        BOOL sent = NO;
        @try {
            sent = [UIApplication.sharedApplication sendAction:action
                                                            to:target
                                                          from:recognizer
                                                      forEvent:nil];
        } @catch (__unused NSException *exception) { sent = NO; }
        AWEInteractionDiagnosticWrite(
            @"EXACT_NATIVE_BUSINESS context=%@ recognizer=%@ target=%@ action=%@ state=%ld dispatched=%d",
            context ?: @"unknown", NSStringFromClass(recognizer.class),
            NSStringFromClass([target class]), NSStringFromSelector(action),
            (long)recognizer.state, sent);
        if (sent) businessDispatched = YES;
    }

    if (forced) AWERestoreRecognizerState(recognizer, stateStorage, oldState);
    if (businessTargets == 0) {
        AWEInteractionDiagnosticWrite(
            @"EXACT_NATIVE_FORWARD context=%@ stage=no-business-target recognizer=%@",
            context ?: @"unknown", NSStringFromClass(recognizer.class));
    }
    return businessDispatched;
}

/* TEST42 FIX8: device log (FIX7) shows AWEFeedVideoButton has no control
   handler at all (handlers=0) but overrides touchesEnded:withEvent:. Douyin
   fires Favorite/Share from its own touch handling, which is also why the
   physical tap works: ALBRightGlassButton mirrors the real UITouch into it.
   The panel therefore delivers one tap to the same touch methods, located at
   the button's centre. The touch only answers the public UITouch getters. */
@interface ALB47PanelTouch : UITouch
@property(nonatomic, weak) UIView *alb_view;
@property(nonatomic, weak) UIWindow *alb_window;
@property(nonatomic) CGPoint alb_windowPoint;
@property(nonatomic) UITouchPhase alb_phase;
@property(nonatomic) NSTimeInterval alb_timestamp;
@end
@implementation ALB47PanelTouch
- (UIView *)view { return self.alb_view; }
- (UIWindow *)window { return self.alb_window; }
- (UITouchPhase)phase { return self.alb_phase; }
- (NSUInteger)tapCount { return 1; }
- (NSTimeInterval)timestamp { return self.alb_timestamp; }
- (UITouchType)type { return UITouchTypeDirect; }
- (CGPoint)locationInView:(UIView *)view {
    return view ? [view convertPoint:self.alb_windowPoint fromView:nil] : self.alb_windowPoint;
}
- (CGPoint)previousLocationInView:(UIView *)view { return [self locationInView:view]; }
@end

static BOOL ALB47OverridesTouchesEnded(UIView *view) {
    return view && class_getMethodImplementation(object_getClass(view), @selector(touchesEnded:withEvent:)) !=
        class_getMethodImplementation(UIButton.class, @selector(touchesEnded:withEvent:));
}
/* Once per class: the button's own methods and block/object ivars, so a
   still-failing route can be traced to Douyin's real click entry. */
static void ALB47RecordTouchOwnerShape(UIView *view) {
    static NSMutableSet<NSString *> *seen;
    if (!seen) seen = [NSMutableSet set];
    NSString *name = NSStringFromClass(object_getClass(view));
    if (!name || [seen containsObject:name]) return;
    [seen addObject:name];
    NSMutableArray *methods = [NSMutableArray array], *ivars = [NSMutableArray array];
    for (Class c = object_getClass(view); c && c != UIButton.class && c != UIControl.class &&
         c != UIView.class && methods.count < 80; c = class_getSuperclass(c)) {
        unsigned int count = 0;
        Method *list = class_copyMethodList(c, &count);
        for (unsigned int k = 0; k < count && methods.count < 80; k++)
            [methods addObject:NSStringFromSelector(method_getName(list[k]))];
        free(list);
        Ivar *vars = class_copyIvarList(c, &count);
        for (unsigned int k = 0; k < count && ivars.count < 40; k++) {
            const char *type = ivar_getTypeEncoding(vars[k]);
            if (!type || type[0] != '@') continue;
            // Type encoding only (it names the declared class); never read a
            // possibly unretained ivar value.
            [ivars addObject:[NSString stringWithFormat:@"%s(%s)", ivar_getName(vars[k]), type]];
        }
        free(vars);
    }
    AWEInteractionDiagnosticWrite(@"RIGHT_TOUCH_OWNER class=%@ methods=%@ ivars=%@", name,
        [methods componentsJoinedByString:@","], [ivars componentsJoinedByString:@" "]);
}
static BOOL ALB47DeliverPanelTap(UIView *button, NSString *context) {
    if (!button.window || button.hidden || !button.userInteractionEnabled ||
        !ALB47OverridesTouchesEnded(button)) return NO;
    ALB47RecordTouchOwnerShape(button);
    ALB47PanelTouch *touch = [ALB47PanelTouch new];
    touch.alb_view = button; touch.alb_window = button.window;
    touch.alb_windowPoint = [button convertPoint:CGPointMake(CGRectGetMidX(button.bounds),
                                                             CGRectGetMidY(button.bounds)) toView:nil];
    touch.alb_timestamp = NSProcessInfo.processInfo.systemUptime;
    touch.alb_phase = UITouchPhaseBegan;
    NSSet<UITouch *> *touches = [NSSet setWithObject:touch];
    BOOL delivered = NO;
    @try {
        [button touchesBegan:touches withEvent:nil];
        touch.alb_phase = UITouchPhaseEnded;
        touch.alb_timestamp = NSProcessInfo.processInfo.systemUptime;
        [button touchesEnded:touches withEvent:nil];
        delivered = YES;
    } @catch (NSException *exception) {
        AWEInteractionDiagnosticWrite(@"RIGHT_PANEL_TOUCH context=%@ exception=%@ %@",
            context ?: @"unknown", exception.name, exception.reason);
        @try { [button touchesCancelled:touches withEvent:nil]; } @catch (__unused NSException *e) {}
    }
    AWEInteractionDiagnosticWrite(@"RIGHT_PANEL_TOUCH context=%@ button=%@ delivered=%d",
        context ?: @"unknown", AWEInteractionObjectSummary(button), delivered);
    return delivered;
}

/* TEST42 FIX7: every non-telemetry handler a UIControl registered, including
   UIAction handlers and nil-target actions that allTargets cannot list. */
static UIControlEvents ALB46ControlHandlerEvents(UIControl *control, NSUInteger *countOut) {
    __block UIControlEvents events = 0;
    __block NSUInteger count = 0;
    if (@available(iOS 14.0, *)) {
        [control enumerateEventHandlers:^(UIAction *actionHandler, id target, SEL action,
                                          UIControlEvents controlEvents, BOOL *stop) {
            (void)stop;
            if (!actionHandler && target && AWEExactNativeTargetIsTelemetry(target, action)) return;
            count++;
            events |= controlEvents;
        }];
    }
    if (countOut) *countOut = count;
    return events;
}
static BOOL ALB46SendControlEventHandlers(UIView *sourceView, NSString *context) {
    if (![sourceView isKindOfClass:UIControl.class] || !sourceView.window) return NO;
    UIControl *control = (UIControl *)sourceView;
    if (!control.enabled) return NO;
    NSUInteger handlers = 0;
    UIControlEvents events = ALB46ControlHandlerEvents(control, &handlers);
    UIControlEvents chosen = (events & UIControlEventTouchUpInside) ? UIControlEventTouchUpInside :
        ((events & UIControlEventPrimaryActionTriggered) ? UIControlEventPrimaryActionTriggered : 0);
    AWEInteractionDiagnosticWrite(
        @"RIGHT_CONTROL_HANDLERS context=%@ control=%@ handlers=%lu events=0x%llx chosen=0x%llx",
        context ?: @"unknown", AWEInteractionObjectSummary(control), (unsigned long)handlers,
        (unsigned long long)events, (unsigned long long)chosen);
    if (!chosen) return NO;
    @try { [control sendActionsForControlEvents:chosen]; }
    @catch (__unused NSException *exception) { return NO; }
    return YES;
}

static BOOL AWEForwardExactNativeTapFromView(UIView *sourceView,
                                              NSString *context) {
    if (!sourceView || !sourceView.window || ALBIsOwnedView(sourceView)) {
        AWEInteractionDiagnosticWrite(
            @"EXACT_NATIVE_FORWARD context=%@ stage=source-not-live source=%@",
            context ?: @"unknown", AWEInteractionObjectSummary(sourceView));
        return NO;
    }

    NSMutableArray<NSDictionary *> *candidates = [NSMutableArray array];
    NSMutableArray<NSDictionary *> *queue = [NSMutableArray arrayWithObject:
        @{@"view": sourceView, @"depth": @0}];
    NSUInteger visited = 0;
    while (queue.count > 0 && visited < 64) {
        NSDictionary *entry = queue.firstObject;
        [queue removeObjectAtIndex:0];
        UIView *view = entry[@"view"];
        NSUInteger depth = [entry[@"depth"] unsignedIntegerValue];
        if (!view || ALBIsOwnedView(view)) continue;
        visited++;
        for (UIGestureRecognizer *recognizer in view.gestureRecognizers) {
            NSInteger score = AWEExactTapRecognizerScore(recognizer, sourceView, depth);
            if (score == NSIntegerMin) continue;
            [candidates addObject:@{@"recognizer": recognizer, @"score": @(score)}];
        }
        if (depth < 7) {
            for (UIView *child in view.subviews) {
                [queue addObject:@{@"view": child, @"depth": @(depth + 1)}];
            }
        }
    }
    [candidates sortUsingComparator:^NSComparisonResult(NSDictionary *lhs,
                                                         NSDictionary *rhs) {
        NSInteger a = [lhs[@"score"] integerValue];
        NSInteger b = [rhs[@"score"] integerValue];
        if (a > b) return NSOrderedAscending;
        if (a < b) return NSOrderedDescending;
        return NSOrderedSame;
    }];

    for (NSDictionary *entry in candidates) {
        UIGestureRecognizer *recognizer = entry[@"recognizer"];
        AWEInteractionDiagnosticWrite(
            @"EXACT_NATIVE_CANDIDATE context=%@ score=%ld recognizer=%@ recognizerView=%@ source=%@",
            context ?: @"unknown", (long)[entry[@"score"] integerValue],
            NSStringFromClass(recognizer.class),
            AWEInteractionObjectSummary(recognizer.view),
            AWEInteractionObjectSummary(sourceView));
        if (AWEInvokeExactNativeRecognizer(recognizer, context)) return YES;
    }

    /* UIControl is a conservative fallback only after every real tap
       recognizer has been tried.  This prevents a decorative internal control
       from producing the false-positive result seen in the v15 log. */
    NSMutableArray<UIView *> *controlQueue = [NSMutableArray arrayWithObject:sourceView];
    visited = 0;
    while (controlQueue.count > 0 && visited < 48) {
        UIView *view = controlQueue.firstObject;
        [controlQueue removeObjectAtIndex:0];
        visited++;
        if (ALBIsOwnedView(view)) continue;
        if ([view isKindOfClass:UIControl.class]) {
            UIControl *control = (UIControl *)view;
            UIControlEvents chosen = 0;
            for (id target in control.allTargets) {
                if ([control actionsForTarget:target
                              forControlEvent:UIControlEventTouchUpInside].count) {
                    chosen = UIControlEventTouchUpInside;
                    break;
                }
                if ([control actionsForTarget:target
                              forControlEvent:UIControlEventPrimaryActionTriggered].count) {
                    chosen = UIControlEventPrimaryActionTriggered;
                }
            }
            if (chosen) {
                BOOL anySent = NO;
                for (id target in control.allTargets) {
                    NSArray<NSString *> *actions = [control actionsForTarget:target
                                                              forControlEvent:chosen];
                    for (NSString *actionName in actions) {
                        SEL action = NSSelectorFromString(actionName);
                        if (!action || ![target respondsToSelector:action]) continue;
                        BOOL sent = NO;
                        @try {
                            sent = [UIApplication.sharedApplication sendAction:action
                                                                            to:target
                                                                          from:control
                                                                      forEvent:nil];
                        } @catch (__unused NSException *exception) { sent = NO; }
                        AWEInteractionDiagnosticWrite(
                            @"RIGHT_CONTROL_FORWARD context=%@ control=%@ target=%@ action=%@ event=%llu dispatched=%d",
                            context ?: @"unknown", AWEInteractionObjectSummary(control),
                            NSStringFromClass([target class]), actionName,
                            (unsigned long long)chosen, sent);
                        anySent = anySent || sent;
                    }
                }
                if (anySent) return YES;
            }
        }
        for (UIView *child in view.subviews) [controlQueue addObject:child];
    }

    /* TEST42 FIX7: device log shows the Favorite/Share AWEFeedVideoButton tap
       recognizer carries only telemetry targets and allTargets has no
       TouchUpInside target, yet the physical tap works. The business action
       is a UIAction or nil-target (responder chain) control handler, which
       allTargets does not expose. UIControl's own dispatcher reaches both. */
    if (ALB46SendControlEventHandlers(sourceView, context)) return YES;
    /* Last native route: a tap recognizer on the owning element view (bounded
       ancestors, never past the action column). */
    NSUInteger ancestorDepth = 0;
    for (UIView *ancestor = [context hasPrefix:@"RIGHT_"] ? sourceView.superview : nil;
         ancestor && ancestorDepth < 4;
         ancestor = ancestor.superview, ancestorDepth++) {
        NSString *ancestorName = NSStringFromClass(ancestor.class);
        if ([ancestorName containsString:@"ElementStackView"] || ALBIsOwnedView(ancestor)) break;
        for (UIGestureRecognizer *recognizer in ancestor.gestureRecognizers) {
            if (AWEExactTapRecognizerScore(recognizer, sourceView, ancestorDepth + 1) == NSIntegerMin) continue;
            AWEInteractionDiagnosticWrite(
                @"EXACT_NATIVE_CANDIDATE context=%@ ancestor=%@ recognizer=%@",
                context ?: @"unknown", AWEInteractionObjectSummary(ancestor),
                NSStringFromClass(recognizer.class));
            if (AWEInvokeExactNativeRecognizer(recognizer, context)) return YES;
        }
    }

    // TEST42 FIX8: Douyin's right action lives in the button's touch handling.
    if ([context hasPrefix:@"RIGHT_"] && ALB47DeliverPanelTap(sourceView, context)) return YES;

    BOOL activated = NO;
    @try { activated = [sourceView accessibilityActivate]; }
    @catch (__unused NSException *exception) { activated = NO; }
    AWEInteractionDiagnosticWrite(
        @"EXACT_NATIVE_FORWARD context=%@ path=accessibility result=%d source=%@ candidates=%lu",
        context ?: @"unknown", activated, AWEInteractionObjectSummary(sourceView),
        (unsigned long)candidates.count);
    return activated;
}

static NSArray<UIView *> *ALB33AllHomeActionButtons(UIView *stack) {
    if (!stack.window) return @[];
    NSMutableArray<UIView *> *ordered = [NSMutableArray array];
    AWECollectFeedActionButtons(stack, ordered, 0);
    [ordered sortUsingComparator:^NSComparisonResult(UIView *a, UIView *b) {
        CGFloat ay=ALB44NativeMidY(a, stack);
        CGFloat by=ALB44NativeMidY(b, stack);
        return ay < by ? NSOrderedAscending : (ay > by ? NSOrderedDescending : NSOrderedSame);
    }];
    return ordered;
}

static AWEHomeActionKind ALB33PanelActionKind(UIView *view, NSArray<UIView *> *ordered) {
    // A runtime identity outranks any stored (possibly position-derived) kind.
    AWEHomeActionKind runtime=ALB44HomeActionKindFromRuntime(view);
    if (runtime!=AWEHomeActionKindUnknown) return runtime;
    NSNumber *bound=objc_getAssociatedObject(view,&kAWEHomeActionKindKey);
    if (bound) return (AWEHomeActionKind)bound.integerValue;
    AWEHomeActionKind known=AWEHomeActionKindFromEvidence(view);
    if (known!=AWEHomeActionKindUnknown) return known;
    // Position is evidence only for a complete four-action native column.
    return ordered.count==4 ? AWEHomeActionKindForButton(view,ordered) : AWEHomeActionKindUnknown;
}

static BOOL AWEForwardHomeActionKindFromStack(UIView *stack,
                                               AWEHomeActionKind kind,
                                               UIView **ownerInOut) {
    if (!stack || kind == AWEHomeActionKindUnknown) return NO;
    NSArray<UIView *> *ordered=ALB33AllHomeActionButtons(stack);
    UIView *owner = ownerInOut ? *ownerInOut : nil;
    NSString *context = [NSString stringWithFormat:@"RIGHT_KIND_%ld", (long)kind];
    if (owner && owner.window && AWEViewIsDescendantOfView(owner, stack) &&
        ALB33PanelActionKind(owner, ordered) == kind) {
        if (ALB33ForwardLeasedActionFromSource(owner, context) ||
            AWEForwardExactNativeTapFromView(owner, context)) return YES;
    }
    for (UIView *candidate in ordered) {
        if (candidate == owner) continue;
        if (ALB33PanelActionKind(candidate, ordered) != kind) continue;
        if (ownerInOut) *ownerInOut = candidate;
        if (ALB33ForwardLeasedActionFromSource(candidate, context) ||
            AWEForwardExactNativeTapFromView(candidate, context)) return YES;
    }
    return NO;
}

/* TEST43 panel-only diagnostic (bounded, read-only). Runs once per failed
   double-tap-panel forward. Records what the current Douyin right column is
   actually made of, so Favorite/Share can be matched on a stable runtime
   identity (class, recognizer/control selector, accessibility identifier)
   instead of display text. It never changes matching, touches or state. */
static NSArray *ALB43PanelTargets(UIView *view) {
    NSMutableArray *out = [NSMutableArray array];
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:view];
    for (NSUInteger i = 0; i < queue.count && i < 12 && out.count < 8; i++) {
        UIView *current = queue[i];
        for (UIGestureRecognizer *recognizer in current.gestureRecognizers) {
            id containers = AWEObjectIvar(recognizer, "_targets");
            if (![containers isKindOfClass:NSArray.class]) continue;
            for (id container in (NSArray *)containers) {
                id target = AWEObjectIvar(container, "_target");
                SEL action = AWESelectorIvar(container, "_action");
                if (!target || !action || out.count >= 8) continue;
                [out addObject:[NSString stringWithFormat:@"%@:%@>%@.%@",
                    NSStringFromClass(current.class), NSStringFromClass(recognizer.class),
                    NSStringFromClass([target class]), NSStringFromSelector(action)]];
            }
        }
        if ([current isKindOfClass:UIControl.class]) {
            UIControl *control = (UIControl *)current;
            for (id target in control.allTargets) {
                for (NSString *action in [control actionsForTarget:target forControlEvent:UIControlEventTouchUpInside] ?: @[]) {
                    if (out.count >= 8) break;
                    [out addObject:[NSString stringWithFormat:@"%@:control>%@.%@",
                        NSStringFromClass(current.class), NSStringFromClass([target class]), action]];
                }
            }
        }
        [queue addObjectsFromArray:current.subviews];
    }
    return out;
}
/* TEST42 FIX7 read-only: registered handler count/events (UIAction and
   nil-target included) and whether the class overrides touch delivery. */
static NSString *ALB46PanelHandlerSummary(UIView *view) {
    NSUInteger handlers = 0;
    UIControlEvents events = [view isKindOfClass:UIControl.class]
        ? ALB46ControlHandlerEvents((UIControl *)view, &handlers) : 0;
    Class cls = view.class;
    BOOL touchOverride = class_getMethodImplementation(cls, @selector(touchesEnded:withEvent:)) !=
        class_getMethodImplementation(UIButton.class, @selector(touchesEnded:withEvent:));
    BOOL trackOverride = class_getMethodImplementation(cls, @selector(endTrackingWithTouch:withEvent:)) !=
        class_getMethodImplementation(UIButton.class, @selector(endTrackingWithTouch:withEvent:));
    BOOL sendOverride = class_getMethodImplementation(cls, @selector(sendAction:to:forEvent:)) !=
        class_getMethodImplementation(UIButton.class, @selector(sendAction:to:forEvent:));
    return [NSString stringWithFormat:@"handlers=%lu events=0x%llx touches=%d tracking=%d sendAction=%d",
        (unsigned long)handlers, (unsigned long long)events, touchOverride, trackOverride, sendOverride];
}
static NSDictionary *ALB43PanelCandidate(UIView *view, UIView *stack, NSArray<UIView *> *ordered) {
    NSNumber *bound = objc_getAssociatedObject(view, &kAWEHomeActionKindKey);
    NSString *evidence = AWEHomeActionEvidence(view);
    CGRect frame = [view convertRect:view.bounds toView:stack];
    return @{@"class": NSStringFromClass(view.class) ?: @"?",
             @"superclass": NSStringFromClass(view.superclass) ?: @"?",
             @"frame": NSStringFromCGRect(frame),
             @"visible": @(AWEHomeActionButtonLocallyUsable(view, stack)),
             @"orderedIndex": @([ordered indexOfObjectIdenticalTo:view] == NSNotFound ? -1 : (NSInteger)[ordered indexOfObjectIdenticalTo:view]),
             @"boundKind": bound ?: @(-1),
             @"evidenceKind": @(AWEHomeActionKindFromEvidence(view)),
             @"evidence": evidence.length > 160 ? [evidence substringToIndex:160] : evidence,
             @"axId": view.accessibilityIdentifier ?: @"",
             @"axLabel": view.accessibilityLabel ?: @"",
             @"controlHandlers": ALB46PanelHandlerSummary(view),
             @"targets": ALB43PanelTargets(view)};
}
static void ALB43RecordPanelActionMiss(UIView *stack, AWEHomeActionKind kind, NSString *stage) {
    if (!stack || !NSThread.isMainThread) return;
    NSArray<UIView *> *ordered = ALB33AllHomeActionButtons(stack);
    NSMutableArray *videoButtons = [NSMutableArray array];
    for (UIView *view in ordered) {
        if (videoButtons.count >= 10) break;
        [videoButtons addObject:ALB43PanelCandidate(view, stack, ordered)];
    }
    // Other interactive right-column views that are NOT AWEFeedVideoButton:
    // reveals whether Favorite/Share moved to a different runtime class.
    NSMutableArray *others = [NSMutableArray array];
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:stack];
    CGFloat width = CGRectGetWidth(stack.bounds);
    for (NSUInteger i = 0; i < queue.count && i < 400 && others.count < 16; i++) {
        UIView *view = queue[i];
        if ([view.accessibilityIdentifier hasPrefix:@"AwemeLiquidBar"]) continue;
        if ([ordered indexOfObjectIdenticalTo:view] != NSNotFound) continue;
        BOOL interactive = [view isKindOfClass:UIControl.class] || view.gestureRecognizers.count > 0;
        CGRect frame = [view convertRect:view.bounds toView:stack];
        if (view != stack && interactive && CGRectGetWidth(frame) <= 120 && CGRectGetHeight(frame) <= 140 &&
            CGRectGetMidX(frame) >= width * 0.5)
            [others addObject:ALB43PanelCandidate(view, stack, ordered)];
        [queue addObjectsFromArray:view.subviews];
    }
    NSMutableArray *slots = [NSMutableArray array];
    NSDictionary *slotMap = objc_getAssociatedObject(stack, &kAWEHomeActionStackSlotsKey);
    for (NSNumber *key in slotMap) {
        AWEHomeActionSlotView *slot = slotMap[key];
        [slots addObject:@{@"kind": key, @"original": NSStringFromClass(slot.originalView.class) ?: @"nil",
                           @"originalIndex": @(slot.originalView ? (NSInteger)[ordered indexOfObjectIdenticalTo:slot.originalView] : -1)}];
    }
    NSDictionary *payload = @{@"requestedKind": @(kind), @"stage": stage ?: @"?",
        @"stack": NSStringFromClass(stack.class) ?: @"?", @"videoButtonCount": @(ordered.count),
        @"videoButtons": videoButtons, @"otherInteractive": others, @"slots": slots};
    if (ALBReproIsRecording()) ALBReproRecordEvent(@"panel.action.unresolved", payload);
    AWEInteractionDiagnosticWrite(@"PANEL_ACTION_UNRESOLVED %@", payload);
}

static BOOL AWERecognizerHasBusinessTarget(UIGestureRecognizer *recognizer) {
    if (!recognizer || !recognizer.enabled) return NO;
    id containers = AWEObjectIvar(recognizer, "_targets");
    if (![containers isKindOfClass:NSArray.class]) {
        @try { containers = [recognizer valueForKey:@"_targets"]; }
        @catch (__unused NSException *exception) { containers = nil; }
    }
    if (![containers isKindOfClass:NSArray.class]) return NO;
    for (id container in (NSArray *)containers) {
        id target = AWEObjectIvar(container, "_target");
        SEL action = AWESelectorIvar(container, "_action");
        if (!target || !action || ![target respondsToSelector:action]) continue;
        if (!AWEExactNativeTargetIsTelemetry(target, action)) return YES;
    }
    return NO;
}

/* Right action buttons need the same ownership model as the working top Search:
   the visible UIKit glass must receive the physical touch so UIKit can run its
   genuine Liquid Glass deformation, while Douyin's *real* recognizer (with its
   original target/action and private state) observes that same touch.  Do not
   synthesize tracking transforms and do not call the business action manually. */
static UIGestureRecognizer *AWEPrimaryHomeActionTapGesture(UIView *owner) {
    if (!owner) return nil;
    NSMutableArray<NSDictionary *> *queue = [NSMutableArray arrayWithObject:
        @{ @"view": owner, @"depth": @0 }];
    UIGestureRecognizer *best = nil;
    NSInteger bestScore = NSIntegerMin;
    NSUInteger visited = 0;
    while (queue.count > 0 && visited < 64) {
        NSDictionary *entry = queue.firstObject;
        [queue removeObjectAtIndex:0];
        UIView *view = entry[@"view"];
        NSUInteger depth = [entry[@"depth"] unsignedIntegerValue];
        if (!view || ALBIsOwnedView(view)) continue;
        visited++;
        for (UIGestureRecognizer *recognizer in view.gestureRecognizers) {
            if (recognizer == objc_getAssociatedObject(
                    owner, &kAWEGlassPressFeedbackRecognizerKey)) continue;
            NSInteger score = AWEExactTapRecognizerScore(recognizer, owner, depth);
            if (score == NSIntegerMin || !AWERecognizerHasBusinessTarget(recognizer)) continue;
            if (score > bestScore) {
                bestScore = score;
                best = recognizer;
            }
        }
        if (depth < 5) {
            for (UIView *child in view.subviews) {
                [queue addObject:@{ @"view": child, @"depth": @(depth + 1) }];
            }
        }
    }
    return best;
}

static void AWERestoreRightActionGestureLease(AWEHomeActionSlotView *slot,
                                               NSString *reason) {
    if (!slot) return;
    UIGestureRecognizer *gesture = slot.leasedActionGesture;
    UIView *original = slot.leasedActionGestureOriginalView;
    if (gesture) {
        UIView *from = gesture.view;
        if (original && from != original) {
            [original addGestureRecognizer:gesture];
        }
        gesture.cancelsTouchesInView = slot.leasedActionGestureOriginalCancelsTouches;
        AWEInteractionDiagnosticWrite(
            @"RIGHT_NATIVE_GESTURE_RESTORE reason=%@ recognizer=%@ from=%@ to=%@ state=%ld",
            reason ?: @"unknown", NSStringFromClass(gesture.class),
            AWEInteractionObjectSummary(from), AWEInteractionObjectSummary(original),
            (long)gesture.state);
    }
    slot.leasedActionGesture = nil;
    slot.leasedActionGestureOriginalView = nil;
    slot.leasedActionGestureOriginalCancelsTouches = NO;
    if (gesture) {
        slot.userInteractionEnabled = NO;
        slot.systemGlassButton.userInteractionEnabled = NO;
    }
}

static void AWECollectImageViews(UIView *root,
                                 NSMutableArray<UIImageView *> *result,
                                 NSUInteger depth) {
    if (!root || !result || depth > 10 || ALBIsOwnedView(root)) return;
    if ([root isKindOfClass:UIImageView.class]) {
        UIImageView *imageView = (UIImageView *)root;
        if (imageView.image) [result addObject:imageView];
    }
    for (UIView *child in root.subviews) {
        if ([child isKindOfClass:AWEHomeActionSlotView.class]) continue;
        AWECollectImageViews(child, result, depth + 1);
    }
}

static BOOL AWEViewIsInsideOurHomeOverlay(UIView *view, UIView *root) {
    for (UIView *current = view; current && current != root; current = current.superview) {
        NSString *identifier = current.accessibilityIdentifier;
        if ([identifier hasPrefix:@"AwemeLiquidBar.Home"]) return YES;
    }
    return NO;
}

static UIImageView *AWEBestHomeActionImageView(UIView *root) {
    if (!root) return nil;
    UIImageView *bound = objc_getAssociatedObject(root,
                                                   &kAWEHomeActionOriginalImageViewKey);
    if (bound && bound.image && AWEViewIsDescendantOfView(bound, root)) return bound;

    NSMutableArray<UIImageView *> *images = [NSMutableArray array];
    AWECollectImageViews(root, images, 0);
    UIImageView *best = nil;
    CGFloat bestScore = -CGFLOAT_MAX;
    for (UIImageView *imageView in images) {
        if (AWEViewIsInsideOurHomeOverlay(imageView, root)) continue;
        CGRect frame = [imageView convertRect:imageView.bounds toView:root];
        CGFloat width = CGRectGetWidth(frame);
        CGFloat height = CGRectGetHeight(frame);
        if (width < 14.0 || height < 14.0 || width > 70.0 || height > 70.0) continue;
        CGFloat score = width * height;
        score -= MAX(0.0, CGRectGetMidY(frame) - 42.0) * 9.0;
        if (imageView.hidden || imageView.alpha < 0.01 ||
            imageView.layer.opacity < 0.01f) score -= 30.0;
        if (score > bestScore) {
            bestScore = score;
            best = imageView;
        }
    }
    return best;
}

static UIVisualEffect *AWECreateHomeAdaptiveGlassEffect(void) {
    return ALBMaterialMakeEffect(YES);
}

static UIView *AWEFindViewByExactRuntimeClass(UIView *root,
                                              NSString *className,
                                              NSUInteger depth);

static BOOL AWEImageAverageColor(UIImage *image,
                                 CGFloat *redOut,
                                 CGFloat *greenOut,
                                 CGFloat *blueOut) {
    if (!image) return NO;

    /* These same symbol/PNG objects are sampled repeatedly while Douyin lays
       out the action stack. Cache both successful and failed results on the
       UIImage so clear-mode foreground tracking never recopies pixel buffers
       on every layout pass. */
    NSArray<NSNumber *> *cached = objc_getAssociatedObject(
        image, &kAWEImageAverageColorCacheKey);
    if ([cached isKindOfClass:NSArray.class] && cached.count == 4) {
        BOOL valid = cached[0].boolValue;
        if (valid) {
            if (redOut) *redOut = cached[1].doubleValue;
            if (greenOut) *greenOut = cached[2].doubleValue;
            if (blueOut) *blueOut = cached[3].doubleValue;
        }
        return valid;
    }

    CGImageRef cgImage = image.CGImage;
    if (!cgImage) {
        objc_setAssociatedObject(image, &kAWEImageAverageColorCacheKey,
            @[@NO, @0.0, @0.0, @0.0], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        return NO;
    }
    CFDataRef data = CGDataProviderCopyData(CGImageGetDataProvider(cgImage));
    if (!data) {
        objc_setAssociatedObject(image, &kAWEImageAverageColorCacheKey,
            @[@NO, @0.0, @0.0, @0.0], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        return NO;
    }

    const UInt8 *bytes = CFDataGetBytePtr(data);
    size_t width = CGImageGetWidth(cgImage);
    size_t height = CGImageGetHeight(cgImage);
    size_t bits = CGImageGetBitsPerPixel(cgImage);
    size_t rowBytes = CGImageGetBytesPerRow(cgImage);
    CGBitmapInfo info = CGImageGetBitmapInfo(cgImage);
    BOOL valid = NO;
    CGFloat red = 0.0, green = 0.0, blue = 0.0, count = 0.0;

    if (bytes && width > 0 && height > 0 && bits == 32 && rowBytes > 0) {
        BOOL little = (info & kCGBitmapByteOrderMask) == kCGBitmapByteOrder32Little;
        size_t stepX = MAX((size_t)1, width / 14);
        size_t stepY = MAX((size_t)1, height / 14);
        for (size_t y = 0; y < height; y += stepY) {
            const UInt8 *row = bytes + y * rowBytes;
            for (size_t x = 0; x < width; x += stepX) {
                const UInt8 *pixel = row + x * 4;
                UInt8 r = little ? pixel[2] : pixel[0];
                UInt8 g = pixel[1];
                UInt8 b = little ? pixel[0] : pixel[2];
                UInt8 a = pixel[3];
                if (a < 48) continue;
                red += r / 255.0;
                green += g / 255.0;
                blue += b / 255.0;
                count += 1.0;
            }
        }
        if (count > 0.0) {
            red /= count;
            green /= count;
            blue /= count;
            valid = YES;
        }
    }
    CFRelease(data);

    objc_setAssociatedObject(image, &kAWEImageAverageColorCacheKey,
        @[@(valid), @(red), @(green), @(blue)],
        OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    if (valid) {
        if (redOut) *redOut = red;
        if (greenOut) *greenOut = green;
        if (blueOut) *blueOut = blue;
    }
    return valid;
}

static BOOL AWEImageLooksSelected(UIImage *image, AWEHomeActionKind kind) {
    CGFloat red = 0.0, green = 0.0, blue = 0.0;
    if (!AWEImageAverageColor(image, &red, &green, &blue)) return NO;
    if (kind == AWEHomeActionKindLike) {
        return red > 0.56 && red > green * 1.18 && red > blue * 1.08;
    }
    if (kind == AWEHomeActionKindFavorite) {
        BOOL yellow = red > 0.58 && green > 0.38 && blue < 0.42;
        BOOL warmPink = red > 0.62 && red > green * 1.15;
        return yellow || warmPink;
    }
    return NO;
}

static BOOL AWEColorPrefersLightForeground(UIColor *color,
                                            UITraitCollection *trait,
                                            BOOL *validOut) {
    if (validOut) *validOut = NO;
    if (!color) return YES;
    UIColor *resolved = trait
        ? [color resolvedColorWithTraitCollection:trait]
        : color;
    CGFloat white = 0.0, alpha = 0.0;
    if ([resolved getWhite:&white alpha:&alpha] && alpha > 0.05) {
        if (validOut) *validOut = YES;
        return white >= 0.58;
    }
    CGFloat red = 0.0, green = 0.0, blue = 0.0;
    if ([resolved getRed:&red green:&green blue:&blue alpha:&alpha] &&
        alpha > 0.05) {
        if (validOut) *validOut = YES;
        CGFloat luminance = 0.2126 * red + 0.7152 * green + 0.0722 * blue;
        return luminance >= 0.58;
    }
    return YES;
}

static BOOL AWEHomeSourcePrefersLightForeground(UIImageView *source,
                                                 UITraitCollection *fallbackTrait,
                                                 BOOL *validOut) {
    if (validOut) *validOut = NO;
    if (!source) {
        return fallbackTrait.userInterfaceStyle != UIUserInterfaceStyleLight;
    }

    /*
     Douyin changes the visible template icon's tint between white and black as
     the video underneath changes. Reading the template bitmap first sees only
     its black mask and freezes our replacement symbol in black. For template
     images, mirror the source UIImageView's resolved tint first; original PNGs
     still use their actual pixels, preserving selected and multicolour artwork.
     This changes only the symbol foreground and does not touch SwiftUI glass.
    */
    UIImage *image = source.image;
    BOOL templateImage = image &&
        image.renderingMode == UIImageRenderingModeAlwaysTemplate;
    if (templateImage) {
        BOOL tintValid = NO;
        BOOL tintLight = AWEColorPrefersLightForeground(
            source.tintColor, source.traitCollection ?: fallbackTrait, &tintValid);
        if (tintValid) {
            if (validOut) *validOut = YES;
            return tintLight;
        }
    }

    if (image) {
        CGFloat red = 0.0, green = 0.0, blue = 0.0;
        if (AWEImageAverageColor(image, &red, &green, &blue)) {
            if (validOut) *validOut = YES;
            CGFloat luminance =
                0.2126 * red + 0.7152 * green + 0.0722 * blue;
            return luminance >= 0.58;
        }
    }

    BOOL tintValid = NO;
    BOOL tintLight = AWEColorPrefersLightForeground(
        source.tintColor, source.traitCollection ?: fallbackTrait, &tintValid);
    if (tintValid) {
        if (validOut) *validOut = YES;
        return tintLight;
    }
    return fallbackTrait.userInterfaceStyle != UIUserInterfaceStyleLight;
}

static UIColor *AWEHomeExplicitForegroundForSource(UIImageView *source,
                                                    UIView *context,
                                                    BOOL allowGlobalFallback) {
    BOOL valid = NO;
    BOOL light = AWEHomeSourcePrefersLightForeground(
        source, context.traitCollection, &valid);
    if (!valid && allowGlobalFallback && gAWEHomeAdaptiveForegroundValid) {
        light = gAWEHomeAdaptiveForegroundIsLight;
        valid = YES;
    }
    if (!valid) {
        /* Douyin's immersive feed defaults to a white foreground. */
        light = YES;
    }
    return light ? UIColor.whiteColor : UIColor.blackColor;
}

static BOOL AWEHomeActionIsSelected(UIView *view,
                                    AWEHomeActionKind kind,
                                    UIImageView *source) {
    if (!view) return NO;
    if ([view respondsToSelector:@selector(isSelected)] &&
        ((BOOL (*)(id, SEL))objc_msgSend)(view, @selector(isSelected))) {
        return YES;
    }
    NSString *evidence = AWEHomeActionEvidence(view);
    if ([evidence containsString:@"取消点赞"] ||
        [evidence containsString:@"已点赞"] ||
        [evidence containsString:@"取消收藏"] ||
        [evidence containsString:@"已收藏"] ||
        [evidence containsString:@"liked"] ||
        [evidence containsString:@"collected"] ||
        [evidence containsString:@"selected"]) {
        return YES;
    }
    if ((kind == AWEHomeActionKindLike || kind == AWEHomeActionKindFavorite) &&
        source.image) {
        return AWEImageLooksSelected(source.image, kind);
    }
    return NO;
}

static NSArray<NSString *> *AWEHomeActionSymbolNames(AWEHomeActionKind kind, BOOL selected) {
    switch (kind) {
        case AWEHomeActionKindLike: return selected ? @[@"hand.thumbsup.fill"] : @[@"hand.thumbsup"];
        case AWEHomeActionKindComment: return @[@"quote.closing"];
        case AWEHomeActionKindFavorite: return selected ? @[@"star.fill"] : @[@"star"];
        case AWEHomeActionKindShare: return @[@"square.and.arrow.up"];
        default: return @[];
    }
}

static void AWEUnbindHomeActionSource(UIImageView *source) {
    if (!source) return;
    NSNumber *hidden = objc_getAssociatedObject(source, &kAWEHomeActionSourceHiddenKey);
    NSNumber *alpha = objc_getAssociatedObject(source, &kAWEHomeActionSourceAlphaKey);
    AWESetHomeActionSourceOwner(source, nil);
    objc_setAssociatedObject(source, &kAWEHomeActionSourceHiddenKey, nil,
                             OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    objc_setAssociatedObject(source, &kAWEHomeActionSourceAlphaKey, nil,
                             OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    source.hidden = hidden ? hidden.boolValue : NO;
    source.alpha = alpha ? alpha.doubleValue : 1.0;
    source.layer.opacity = (float)source.alpha;
}

static void AWEBindHomeActionSource(UIView *owner, UIImageView *source) {
    if (!owner || !source) return;
    UIImageView *previous = objc_getAssociatedObject(
        owner, &kAWEHomeActionOriginalImageViewKey);
    if (previous && previous != source) AWEUnbindHomeActionSource(previous);

    UIView *oldOwner = AWEHomeActionSourceOwner(source);
    if (oldOwner && oldOwner != owner) {
        UIImageView *oldSource = objc_getAssociatedObject(
            oldOwner, &kAWEHomeActionOriginalImageViewKey);
        if (oldSource == source) {
            objc_setAssociatedObject(oldOwner,
                                     &kAWEHomeActionOriginalImageViewKey,
                                     nil,
                                     OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }
        AWEUnbindHomeActionSource(source);
    }

    if (!objc_getAssociatedObject(source, &kAWEHomeActionSourceHiddenKey)) {
        objc_setAssociatedObject(source, &kAWEHomeActionSourceHiddenKey,
                                 @(source.hidden),
                                 OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(source, &kAWEHomeActionSourceAlphaKey,
                                 @(source.alpha),
                                 OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    objc_setAssociatedObject(owner, &kAWEHomeActionOriginalImageViewKey,
                             source, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    AWESetHomeActionSourceOwner(source, owner);
    source.hidden = YES;
    source.alpha = 0.0;
    source.layer.opacity = 0.0f;
}

/*
 Custom top/right controls must stay on the same system-owned material path as
 the native UITabBar.  Direct SwiftUI glassEffect(.clear/.regular) pins a
 concrete material variant and can miss the user's system Clear/Tinted glass
 preference.  A real UIButtonConfiguration glass style lets UIKit rebuild the
 material when system glass appearance, contrast, transparency or traits
 change.  No custom background tint or opacity is added, keeping both modes
 restrained.
*/
// TEST10: this switch belongs only to playback controls. Native top/bottom
// controllers and message glass never read it. Keep TEST7 bottom creation intact.
static BOOL ALB8PlaybackButtonsForceClear(void) {
    return YES; // TEST10: playback controls always use clear; bars keep their native material.
}
static char kALB9IconIdentityKey;
static const void *ALB8MaterialRoleKey(void) {
    return NSSelectorFromString(@"ALB8.PlaybackMaterialRole");
}
static NSHashTable<UIButton *> *AWEAdaptiveGlassButtonRegistry(void) {
    if (!gAWEAdaptiveGlassButtons) {
        gAWEAdaptiveGlassButtons = [NSHashTable weakObjectsHashTable];
    }
    return gAWEAdaptiveGlassButtons;
}

static void AWERegisterAdaptiveGlassButton(UIButton *button) {
    if (!button) return;
    [AWEAdaptiveGlassButtonRegistry() addObject:button];
}

static void AWEApplySoftClearEdgeToButton(UIButton *button) {
    if (!button) return;
    button.layer.borderWidth = 0.0;
    button.layer.borderColor = UIColor.clearColor.CGColor;
    button.layer.cornerRadius = 0.0;
}

static BOOL AWEAdaptiveButtonIsEffectivelyVisible(UIButton *button) {
    if (!button || !button.window || button.hidden || button.alpha <= 0.01 ||
        button.layer.opacity <= 0.01f || CGRectIsEmpty(button.bounds)) return NO;
    CGRect frame = [button convertRect:button.bounds toView:button.window];
    return CGRectIntersectsRect(frame, button.window.bounds);
}

/*
 Clear glass already resolves a local light/dark material internally. Reading
 that resolved material is both more reliable and much cheaper than rendering
 the whole Douyin window into a bitmap (video/Metal layers are not faithfully
 captured by renderInContext and were the reason automatic icons stayed white).
 */
static UIUserInterfaceStyle AWEAdaptiveButtonResolvedLocalStyle(UIButton *button) {
    UIUserInterfaceStyle fallback = button.traitCollection.userInterfaceStyle;
    if (fallback != UIUserInterfaceStyleLight &&
        fallback != UIUserInterfaceStyleDark) {
        fallback = gAWEHomeChromeLastStableStyle;
    }
    if (fallback != UIUserInterfaceStyleLight &&
        fallback != UIUserInterfaceStyleDark) {
        fallback = gAWEAlbumMorphLastAppliedStyle;
    }
    if (fallback != UIUserInterfaceStyleLight &&
        fallback != UIUserInterfaceStyleDark) {
        fallback = UIScreen.mainScreen.traitCollection.userInterfaceStyle;
    }
    if (fallback != UIUserInterfaceStyleLight &&
        fallback != UIUserInterfaceStyleDark) fallback = UIUserInterfaceStyleDark;
    return AWEGlassInternalInterfaceStyle(button, fallback);
}

static void AWEApplyAutomaticContrastForeground(UIButton *button,
                                                 BOOL foregroundLight) {
    if (!button || !button.configuration) return;
    // 2.5.1: a button UIKit is morphing into its menu keeps its glyph.
    if (ALB25MaterialButtonInMenuSession(button)) return;
    NSNumber *previous = objc_getAssociatedObject(
        button, &kAWEAdaptiveGlassForegroundLightKey);
    UIColor *color = foregroundLight ? UIColor.whiteColor : UIColor.blackColor;
    if (previous && previous.boolValue == foregroundLight &&
        [button.configuration.baseForegroundColor isEqual:color] &&
        button.imageView.image != nil && button.imageView.alpha > 0.01) return;
    UIButtonConfiguration *configuration = [button.configuration copy];
    UIImage *image = configuration.image;
    if (image) {
        configuration.image = [image imageWithRenderingMode:
            UIImageRenderingModeAlwaysTemplate];
    }
    configuration.baseForegroundColor = color;
    button.configuration = configuration;
    button.tintColor = color;
    button.imageView.tintColor = color;
    button.imageView.hidden = NO;
    button.imageView.alpha = 1.0;
    [button setNeedsUpdateConfiguration];
    [button setNeedsLayout];
    objc_setAssociatedObject(button, &kAWEAdaptiveGlassForegroundLightKey,
                             @(foregroundLight), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
}
static void AWERefreshAutomaticContrastForButton(UIButton *button) {
    if(ALB9RefreshLocalButtonInk(button))return;
    if (!button || ![objc_getAssociatedObject(
            button, &kAWEAdaptiveGlassAutomaticContrastKey) boolValue]) return;
    UIUserInterfaceStyle localStyle = AWEAdaptiveButtonResolvedLocalStyle(button);
    /* In pure-clear mode the material itself is intentionally nearly neutral,
       so its trait is not a reliable contrast signal. Prefer the latest bounded
       video-backdrop sample when one exists. */
    BOOL foregroundLight = (AWEOperatingSystemMajorVersion() >= 26 &&
                            ALB8PlaybackButtonsForceClear() &&
                            gAWETransparentBackdropContrastValid)
        ? gAWETransparentBackdropForegroundLight
        : (localStyle != UIUserInterfaceStyleLight);
    AWEApplyAutomaticContrastForeground(button, foregroundLight);
    objc_setAssociatedObject(button, &kAWEAdaptiveGlassLastSampleTimeKey,
                             @(CACurrentMediaTime()),
                             OBJC_ASSOCIATION_RETAIN_NONATOMIC);
}

static BOOL AWEAdaptiveForegroundMatches(UIColor *left, UIColor *right) {
    if (left == right) return YES;
    if (!left || !right) return NO;
    NSString *leftHex = AWEHexStringFromColor(left);
    NSString *rightHex = AWEHexStringFromColor(right);
    return leftHex.length && [leftHex isEqualToString:rightHex];
}

static void AWEEnforceExplicitForeground(UIButton *button, BOOL force) {
    if (!button) return;
    // 2.5: a native carrier draws this button's glyph; never re-add the image.
    if (ALB25MaterialButtonIsCarried(button)) return;
    UIColor *explicitForeground = objc_getAssociatedObject(
        button, &kAWEAdaptiveGlassExplicitForegroundKey);
    if (!explicitForeground) return;

    NSString *signature = AWEHexStringFromColor(explicitForeground)
        ?: explicitForeground.description;
    NSString *previous = objc_getAssociatedObject(
        button, &kAWEAdaptiveGlassAppliedForegroundSignatureKey);
    UIButtonConfiguration *configuration = [button.configuration copy];
    UIImage *baseImage = objc_getAssociatedObject(
        button, &kAWEAdaptiveGlassBaseImageKey);
    BOOL needsConfiguration = force || ![previous isEqualToString:signature] ||
        !AWEAdaptiveForegroundMatches(configuration.baseForegroundColor,
                                      explicitForeground);
    if (configuration && needsConfiguration) {
        if (baseImage) {
            configuration.image = [baseImage imageWithTintColor:explicitForeground
                renderingMode:UIImageRenderingModeAlwaysOriginal];
        } else if (configuration.image) {
            configuration.image = [configuration.image imageWithTintColor:explicitForeground
                renderingMode:UIImageRenderingModeAlwaysOriginal];
        }
        configuration.baseForegroundColor = explicitForeground;
        button.configuration = configuration;
        objc_setAssociatedObject(button,
            &kAWEAdaptiveGlassAppliedForegroundSignatureKey,
            signature, OBJC_ASSOCIATION_COPY_NONATOMIC);
    }
    button.tintAdjustmentMode = UIViewTintAdjustmentModeNormal;
    button.tintColor = explicitForeground;
    button.imageView.tintColor = explicitForeground;
    // 3.11.7: a button wearing a bar item keeps its own icon hidden.
    if (!ALBFaceActive(button)) {
        button.imageView.hidden = NO;
        button.imageView.alpha = 1.0;
    }
}

static void AWEInstallAdaptiveForegroundUpdateHandler(UIButton *button) {
    if (!button || [objc_getAssociatedObject(
            button, &kAWEAdaptiveGlassUpdateHandlerInstalledKey) boolValue]) {
        return;
    }
    __weak UIButton *weakButton = button;
    button.configurationUpdateHandler = ^(UIButton *updatedButton) {
        UIButton *liveButton = weakButton ?: updatedButton;
        AWEEnforceExplicitForeground(liveButton, NO);
    };
    objc_setAssociatedObject(button,
        &kAWEAdaptiveGlassUpdateHandlerInstalledKey,
        @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
}

static void AWEApplyResolvedGlassStyleToAdaptiveButton(UIButton *button) {
    if (!button || button.isTracking || button.isHighlighted) return;
    // 2.5.1: frozen for the whole menu session (morph out, menu, morph back).
    if (ALB25MaterialButtonInMenuSession(button)) return;
    if (button.window && !AWEHomeViewEffectivelyVisible(button)) return;
    BOOL transparent = [objc_getAssociatedObject(
        button, &kAWEAdaptiveGlassTransparentKey) boolValue];
    UIColor *explicitForeground = objc_getAssociatedObject(
        button, &kAWEAdaptiveGlassExplicitForegroundKey);
    UIUserInterfaceStyle homeStyle = gAWEHomeChromeLastStableStyle;
    if (homeStyle != UIUserInterfaceStyleLight &&
        homeStyle != UIUserInterfaceStyleDark) {
        homeStyle = gAWEAlbumMorphLastAppliedStyle;
    }
    UIUserInterfaceStyle style = homeStyle;
    if (AWEOperatingSystemMajorVersion() >= 26) {
        NSString *role = objc_getAssociatedObject(button, ALB8MaterialRoleKey());
        // The verified Photos bar resolves Home in Dark and other pages from
        // app appearance. Reuse that context, not a separate manual tint layer.
        style = role.length && !transparent ? gAWEAlbumMorphLastAppliedStyle
                                            : UIUserInterfaceStyleUnspecified;
    } else if (transparent) {
        style = UIUserInterfaceStyleUnspecified;
    }
    if (style != UIUserInterfaceStyleLight &&
        style != UIUserInterfaceStyleDark) {
        style = UIUserInterfaceStyleUnspecified;
    }
    NSString *materialRole = objc_getAssociatedObject(button, ALB8MaterialRoleKey());
    BOOL feedMaterial = [materialRole isEqualToString:@"top"] || [materialRole isEqualToString:@"playback"];
    if (ALB25MaterialEnabled() || (feedMaterial && ALB25MaterialRegisteredGlassEnabled()))
        style = ALB25MaterialStyle(button, feedMaterial);
    BOOL changed = button.overrideUserInterfaceStyle != style;
    if (changed) {
        button.overrideUserInterfaceStyle = style;
        [button setNeedsUpdateConfiguration];
        [button setNeedsLayout];
    }
    ALB25MaterialApplyButton(button, feedMaterial);
    AWEApplySoftClearEdgeToButton(button);
    if (explicitForeground) {
        AWEInstallAdaptiveForegroundUpdateHandler(button);
        AWEEnforceExplicitForeground(button, changed);
    }
}

static void AWERefreshRegisteredAdaptiveGlassButtons(void) {
    for (UIButton *button in AWEAdaptiveGlassButtonRegistry().allObjects) {
        AWEApplyResolvedGlassStyleToAdaptiveButton(button);
    }
}

static UIButtonConfiguration *AWECreateAdaptiveGlassIconConfiguration(
    BOOL tintedGlass) {
    if (ALB25MaterialEnabled()) return ALB25MaterialButtonConfiguration();
    SEL maker = NSSelectorFromString(tintedGlass ? @"glassButtonConfiguration" : @"clearGlassButtonConfiguration");
    Class cls = UIButtonConfiguration.class;
    if ([cls respondsToSelector:maker]) return ((id (*)(id,SEL))objc_msgSend)(cls,maker);
    return tintedGlass ? [UIButtonConfiguration tintedButtonConfiguration] : [UIButtonConfiguration plainButtonConfiguration];
}

/* 3.11: the right column draws one glass, the collapsing dock's: the system
   glass button's own plain glass (Regular, or Clear + 28 % black with
   "glass.motionClear", ALB25MaterialMotionButtonConfiguration), never
   registered with a scroll view, never copied into another window, fixed
   Dark like the dock's video glass, ink white. The icon (or artwork) stays
   the configuration's image, so UIKit's own press, stretch and distortion
   carry it with the glass. No recipe, no light/dark sampling, no registry:
   nothing re-dresses the button afterwards. */
static char kALBRGMenuActiveKey;
/* The avatar's menu is up (ALBRGMenuBegins / ALBRGMenuEnds in
   ALBNativeInteraction.h): nothing re-dresses the button meanwhile. A menu
   whose end never arrived stops counting after 20 s. */
static BOOL ALBRGMenuActive(UIButton *button) {
    NSNumber *since = objc_getAssociatedObject(button, &kALBRGMenuActiveKey);
    return since && CACurrentMediaTime() - since.doubleValue < 20.0;
}
/* The glass is Dark like the liquid bar's page; UIKit turns it light or dark
   through its own edge (ALBFollowSyncEdge / the bar item face). */
static void ALBRGToneStyle(UIButton *button) {
    if (!button || ALBRGMenuActive(button)) return;
    if (button.overrideUserInterfaceStyle != UIUserInterfaceStyleDark) {
        button.overrideUserInterfaceStyle = UIUserInterfaceStyleDark;
        [button setNeedsUpdateConfiguration];
    }
    ALBFaceSyncStyle(button);
}
/* 3.11: the collapsing dock's right-column geometry. Each glass is centred
   on Douyin's own icon, avatar or music cover, read live from Douyin's view
   (no fixed offset): like / comment / favourite / share at one diameter
   ("right.glassSize", 36-64, default 48), the avatar and the music cover at
   their own size plus a ring of glass ("right.glassRing", 0-12, default 4).
   "right.glassOffsetY" (-8..8, default 0) moves the four icon glasses only. */
static CGFloat ALBRGActionDiameter(void) { return round(ALB5Number(@"right.glassSize", 48, 36, 64)); }
static CGFloat ALBRGRing(void) { return round(ALB5Number(@"right.glassRing", 4, 0, 12)); }
static CGFloat ALBRGActionOffsetY(void) { return round(ALB5Number(@"right.glassOffsetY", 0, -8, 8) * 2.0) / 2.0; }
/* Avatar / music glass: the artwork's side plus the ring, whole points. */
static CGFloat ALBRGArtworkDiameter(CGFloat nativeSide) {
    CGFloat side = isfinite(nativeSide) && nativeSide > 1 ? round(nativeSide) : 44.0;
    return side + 2.0 * ALBRGRing();
}
/* 3.11.1: the four icon glasses keep one gap to their count / name label.
   The like glass, centred on Douyin's like icon, sets that gap; every other
   icon glass sits the same distance above its own label (Douyin draws the
   share arrow higher in its button than the other icons, so a glass centred
   on it stood further from its label). Without a label, or without a like
   to measure, a glass stays centred on its icon. The move is at most 12 pt. */
static UILabel *ALB32RightTailLabel(UIView *row,UIView *stack);
static char kALBRGGapKey, kALBRGGapReportKey;
static CGFloat ALBRGLabelTop(UIView *owner, UIView *stack) {
    UILabel *label = owner && stack ? ALB32RightTailLabel(owner, stack) : nil;
    if (!label) return NAN;
    CGRect rect = ALB19RightConvertRect(label, label.bounds, stack, stack);
    CGFloat line = label.font.lineHeight > 0 ? MIN(label.font.lineHeight, CGRectGetHeight(rect)) : CGRectGetHeight(rect);
    CGFloat top = CGRectGetMidY(rect) - line / 2.0;
    return isfinite(top) ? top : NAN;
}
/* The gap under one glass centred on its icon (NaN: no label below it). */
static CGFloat ALBRGNaturalGap(UIView *stack, UIView *owner, CGPoint iconCenter, CGFloat diameter) {
    CGFloat top = ALBRGLabelTop(owner, stack);
    if (!isfinite(top) || top <= iconCenter.y) return NAN;
    return top - (iconCenter.y + diameter / 2.0);
}
static void ALBRGNoteReferenceGap(UIView *stack, CGFloat gap) {
    if (stack) objc_setAssociatedObject(stack, &kALBRGGapKey, isfinite(gap) ? @(gap) : nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
}
static CGFloat ALBRGReferenceGap(UIView *stack) {
    NSNumber *gap = stack ? objc_getAssociatedObject(stack, &kALBRGGapKey) : nil;
    return gap ? gap.doubleValue : NAN;
}
static CGPoint ALBRGActionCenter(UIView *stack, UIView *owner, AWEHomeActionKind kind, CGPoint iconCenter, CGFloat diameter) {
    CGFloat reference = ALBRGReferenceGap(stack);
    CGFloat natural = ALBRGNaturalGap(stack, owner, iconCenter, diameter);
    CGPoint center = iconCenter;
    if (kind != AWEHomeActionKindLike && isfinite(reference) && isfinite(natural))
        center.y += MAX(-12.0, MIN(12.0, natural - reference));
    if (stack && kind >= AWEHomeActionKindLike && kind <= AWEHomeActionKindShare) {
        NSMutableDictionary *report = objc_getAssociatedObject(stack, &kALBRGGapReportKey) ?: [NSMutableDictionary dictionary];
        report[@(kind)] = [NSString stringWithFormat:@"%@%@", isfinite(natural) ? [NSString stringWithFormat:@"%.1f", natural] : @"无数字",
                           fabs(center.y - iconCenter.y) > 0.05 ? [NSString stringWithFormat:@"→下移%.1f", center.y - iconCenter.y] : @""];
        objc_setAssociatedObject(stack, &kALBRGGapReportKey, report, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    return center;
}
/* 诊断: each icon glass's own gap to its label (centred on its icon). */
static NSString *ALBRGGapReport(UIView *stack) {
    NSDictionary *report = stack ? objc_getAssociatedObject(stack, &kALBRGGapReportKey) : nil;
    if (!report.count) return @"无";
    NSArray *names = @[@"", @"赞", @"评", @"藏", @"转"];
    NSMutableArray *parts = [NSMutableArray array];
    for (NSInteger kind = AWEHomeActionKindLike; kind <= AWEHomeActionKindShare; kind++)
        if (report[@(kind)]) [parts addObject:[NSString stringWithFormat:@"%@%@", names[kind], report[@(kind)]]];
    CGFloat reference = ALBRGReferenceGap(stack);
    return [NSString stringWithFormat:@"%@（基准%@）", [parts componentsJoinedByString:@" "],
            isfinite(reference) ? [NSString stringWithFormat:@"%.1f", reference] : @"无"];
}
static void AWEConfigureAdaptiveSystemGlassIconButton(
    UIButton *button,
    UIImage *image,
    NSString *identityKey,
    CGFloat pointSize,
    UIColor *foregroundColor,
    BOOL preserveOriginalImage,
    BOOL tintedGlass,
    BOOL strongEdgeSoftening) {
    (void)tintedGlass;
    (void)strongEdgeSoftening;
    if (!button || !image || button.isTracking || button.isHighlighted || ALBRGMenuActive(button)) return;
    [ALBRGButtons() addObject:button];

    objc_setAssociatedObject(button,&kALB9IconIdentityKey,identityKey,OBJC_ASSOCIATION_COPY_NONATOMIC);
    objc_setAssociatedObject(button, &kAWEAdaptiveGlassTransparentKey, @NO, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    objc_setAssociatedObject(button, &kAWEAdaptiveGlassAutomaticContrastKey, @NO, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    objc_setAssociatedObject(button, &kAWEAdaptiveGlassExplicitForegroundKey,
                             preserveOriginalImage ? nil : foregroundColor, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    objc_setAssociatedObject(button, &kAWEAdaptiveGlassBaseImageKey,
                             image, OBJC_ASSOCIATION_RETAIN_NONATOMIC);

    NSString *foreground = foregroundColor
        ? (AWEHexStringFromColor(foregroundColor) ?: foregroundColor.description) : @"SYSTEM";
    // 3.11.4: the bar glass's key too (read after the column was built, or a
    // new 透明／着色 setting: rebuilt once with the new glass).
    NSString *signature = [NSString stringWithFormat:@"motion|%@|%.2f|%@|%d|%d|%.3f|%lu|f%d%d%@",
        identityKey ?: @"unknown", pointSize, foreground, preserveOriginalImage,
        ALB25MaterialMotionClear(), ALB25MaterialDarkTint(),
        (unsigned long)gAWEConfiguredIconGeneration, ALB25MaterialFollowBar(), ALBBarFacesWanted(),
        ALB25MaterialFollowBar() ? ALB25MaterialFollowGlassKey() : @""];
    NSString *previous = objc_getAssociatedObject(
        button, &kAWEAdaptiveGlassConfigurationSignatureKey);
    BOOL needsConfiguration = ![previous isEqualToString:signature] ||
                              button.configuration == nil;
    // 3.11.7: what a bar item face shows (ALBBarFace.h); the face draws it
    // again only when this signature changes.
    ALBFaceNoteIcon(button, image, pointSize, preserveOriginalImage ? nil : foregroundColor, preserveOriginalImage, signature);

    if (needsConfiguration) {
        UIButtonConfiguration *configuration = ALB25MaterialMotionButtonConfigurationTone(NO);
        configuration.title = nil;
        configuration.subtitle = nil;
        configuration.image = image;
        configuration.cornerStyle = UIButtonConfigurationCornerStyleCapsule;
        configuration.contentInsets = NSDirectionalEdgeInsetsZero;
        configuration.imagePadding = 0.0;
        configuration.baseBackgroundColor = nil;
        if (!preserveOriginalImage) {
            // Explicit white/black/accent/custom win; otherwise the label
            // colour of the Dark glass (white), like the dock's ink.
            configuration.baseForegroundColor = foregroundColor;
            if (foregroundColor) {
                configuration.image = [image imageWithTintColor:foregroundColor
                    renderingMode:UIImageRenderingModeAlwaysOriginal];
            }
            configuration.preferredSymbolConfigurationForImage =
                [UIImageSymbolConfiguration configurationWithPointSize:pointSize
                                                                weight:UIImageSymbolWeightMedium
                                                                 scale:UIImageSymbolScaleMedium];
        } else {
            configuration.baseForegroundColor = nil;
        }
        button.configuration = configuration;
        button.backgroundColor = UIColor.clearColor;
        button.opaque = NO;
        button.clipsToBounds = NO;
        button.imageView.contentMode = UIViewContentModeCenter;
        button.adjustsImageWhenHighlighted = NO;
        button.adjustsImageWhenDisabled = NO;
        if (!preserveOriginalImage) {
            button.tintColor = foregroundColor;
            button.imageView.tintColor = foregroundColor;
        }
        objc_setAssociatedObject(button,
            &kAWEAdaptiveGlassConfigurationSignatureKey,
            signature, OBJC_ASSOCIATION_COPY_NONATOMIC);
    }

    ALBRGToneStyle(button);
    ALBFaceSync(button);
    ALBFollowSyncEdge(button);
    AWEApplySoftClearEdgeToButton(button);
    if (!preserveOriginalImage && foregroundColor) {
        AWEInstallAdaptiveForegroundUpdateHandler(button);
        AWEEnforceExplicitForeground(button, needsConfiguration);
        if (needsConfiguration) [button setNeedsUpdateConfiguration];
    }
}

static void AWEConfigureAdaptiveSystemGlassPlateButton(
    UIButton *button,
    NSString *identityKey,
    BOOL tintedGlass) {
    (void)tintedGlass;
    if (!button) return;
    ALBFaceNotePlate(button);
    NSString *signature = [NSString stringWithFormat:@"motion-plate|%@|%d|%.3f|%lu|f%d%d%@",
        identityKey ?: @"plate", ALB25MaterialMotionClear(), ALB25MaterialDarkTint(),
        (unsigned long)gAWEConfiguredIconGeneration, ALB25MaterialFollowBar(), ALBBarFacesWanted(),
        ALB25MaterialFollowBar() ? ALB25MaterialFollowGlassKey() : @""];
    NSString *previous = objc_getAssociatedObject(
        button, &kAWEAdaptiveGlassConfigurationSignatureKey);
    if (![previous isEqualToString:signature] || !button.configuration) {
        UIButtonConfiguration *configuration = ALB25MaterialMotionButtonConfigurationTone(NO);
        configuration.title = nil;
        configuration.subtitle = nil;
        configuration.image = nil;
        configuration.cornerStyle = UIButtonConfigurationCornerStyleCapsule;
        configuration.contentInsets = NSDirectionalEdgeInsetsZero;
        configuration.baseBackgroundColor = nil;
        configuration.baseForegroundColor = nil;
        button.configuration = configuration;
        button.backgroundColor = UIColor.clearColor;
        button.opaque = NO;
        button.clipsToBounds = NO;
        objc_setAssociatedObject(button,
            &kAWEAdaptiveGlassConfigurationSignatureKey,
            signature, OBJC_ASSOCIATION_COPY_NONATOMIC);
    }
    objc_setAssociatedObject(button, &kAWEAdaptiveGlassTransparentKey,
                             @NO, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    objc_setAssociatedObject(button, &kAWEAdaptiveGlassAutomaticContrastKey,
                             @NO, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    [ALBRGButtons() addObject:button];
    ALBRGToneStyle(button);
    ALBFaceSync(button);
    ALBFollowSyncEdge(button);
}

static BOOL AWEViewHasSameStyleMarker(UIView *view) {
    if (!view) return NO;
    NSArray<NSString *> *markers = @[@"拍同款", @"听抖音"];
    NSString *label = view.accessibilityLabel ?: @"";
    NSString *value = [view.accessibilityValue isKindOfClass:NSString.class] ? view.accessibilityValue : @"";
    NSString *identifier = view.accessibilityIdentifier ?: @"";
    for (NSString *marker in markers) {
        if ([label containsString:marker] || [value containsString:marker] ||
            [identifier containsString:marker]) return YES;
    }
    if ([view isKindOfClass:UILabel.class]) {
        NSString *text = ((UILabel *)view).text ?: @"";
        for (NSString *marker in markers) if ([text containsString:marker]) return YES;
    }
    if ([view isKindOfClass:UIButton.class]) {
        UIButton *button = (UIButton *)view;
        NSString *t1 = button.currentTitle ?: @"";
        NSString *t2 = button.titleLabel.text ?: @"";
        for (NSString *marker in markers) {
            if ([t1 containsString:marker] || [t2 containsString:marker]) return YES;
        }
    }
    return NO;
}

static BOOL AWESameStyleStableAnchorClass(UIView *view) {
    if (!view) return NO;
    NSString *name = NSStringFromClass(view.class);
    return [name containsString:@"SingleSongMusicStyleView"] ||
           [name containsString:@"StyleOneMusicView"] ||
           [name containsString:@"AWEPlayInteractionListenFeedView"] ||
           [name containsString:@"ListenDouyin"] ||
           [name containsString:@"ListenAweme"] ||
           [name containsString:@"ListenFeedView"];
}

static UIView *AWESameStyleAncestorForTarget(UIView *target, UIView *stop) {
    if (!target) return nil;
    UIView *best = nil;
    CGFloat bestDelta = CGFLOAT_MAX;
    for (UIView *cursor = target; cursor; cursor = cursor.superview) {
        if (AWESameStyleStableAnchorClass(cursor)) return cursor;
        CGFloat w = CGRectGetWidth(cursor.bounds), h = CGRectGetHeight(cursor.bounds);
        if (w >= 28.0 && w <= 74.0 && h >= 28.0 && h <= 74.0) {
            CGFloat delta = fabs(w - 44.0) + fabs(h - 44.0);
            if (delta < bestDelta) {
                bestDelta = delta;
                best = cursor;
            }
        }
        if (cursor == stop) break;
    }
    return best;
}

// Explicit panel actions reuse the bound right-column native business target,
// even when that control's visual is hidden. Stay in the current source stack.

#include "ALBNativeMinimize.h"
#include "ALBGlassMaterials.h"
/* 3.2.1: three of our gesture-delegate proxies can sit on the same
   recognizer: 3.1's top-chrome gate (ALB3GlassTouchGate), 2.5.3's avatar-menu
   gate (ALBAvatarMenuGestureGate) and 2.5.3's native action bridge. 3.2 let a
   gate wrap a delegate whose chain already led back to itself (A.original =
   B, B.original = A); -[UIGestureRecognizer setDelegate:] then asked
   respondsToSelector: around that loop until the main thread's stack
   overflowed at launch. A proxy only wraps when it is not in the chain yet. */
static id ALB32ProxyNext(id proxy) {
    if (!proxy) return nil;
    static Class topGate, avatarGate, bridge;
    static dispatch_once_t once;
    dispatch_once(&once, ^{
        topGate = NSClassFromString(@"ALB3GlassTouchGate");
        avatarGate = NSClassFromString(@"ALBAvatarMenuGestureGate");
        bridge = NSClassFromString(@"ALBNativeActionBridge");
    });
    @try {
        if ((topGate && [proxy isKindOfClass:topGate]) || (avatarGate && [proxy isKindOfClass:avatarGate]))
            return [proxy valueForKey:@"original"];
        if (bridge && [proxy isKindOfClass:bridge]) return [proxy valueForKey:@"originalDelegate"];
    } @catch (__unused NSException *exception) {}
    return nil;
}
static BOOL ALB32DelegateChainContains(id start, id target) {
    if (!target) return NO;
    NSUInteger hops = 0;
    for (id cursor = start; cursor && hops < 16; cursor = ALB32ProxyNext(cursor), hops++)
        if (cursor == target) return YES;
    return NO;
}

#include "ALBClearContrast.h"
#include "ALBNativeInteraction.h"
#include "ALBBarFace.h"
/* 3.11.44: the pill machinery (a system glass button whose image is the
   original content, so it deforms with the press) — ALBChatFace.h; the chat
   page itself is no longer touched. */
#include "ALBChatFace.h"
/* 3.11.42–3.11.44: the share panel, the comment share sheet and the note
   page's comment box (ALBMoreGlass.h). */
#include "ALBMoreGlass.h"

static BOOL ALB33ForwardLeasedActionFromSource(UIView *source, NSString *context) {
    if (!source.window) return NO;
    for (UIButton *button in ALBArtworkButtons().allObjects) {
        ALBNativeActionBridge *bridge=objc_getAssociatedObject(button,&kALBNativeActionBridgeKey);
        if (!bridge.rightColumn || bridge.source!=source || !bridge.gesture) continue;
        if (AWEInvokeExactNativeRecognizer(bridge.gesture,context)) return YES;
    }
    return NO;
}

#include "ALB3Right.h"

#include "ALBDanmakuGlass.h"

static BOOL AWESameStyleIsRightActionStackV23(UIView *stack) {
    if (!stack || !stack.window || stack.hidden || stack.alpha <= 0.01) return NO;
    if (![NSStringFromClass(stack.class) containsString:@"AWEElementStackView"]) return NO;
    CGRect wr = [stack convertRect:stack.bounds toView:stack.window];
    CGFloat ww = CGRectGetWidth(stack.window.bounds);
    CGFloat sw = CGRectGetWidth(wr), sh = CGRectGetHeight(wr);
    /* The genuine feed action rail is the narrow right-side stack (FLEX/logs:
       x≈360,w≈80).  Caption/copy stacks are wide (x≈12,w≈325) and caused the
       ghost glass that reappeared after like/favourite relayouts. */
    if (sw < 52.0 || sw > 128.0 || sh < 150.0) return NO;
    if (CGRectGetMidX(wr) < ww * 0.72) return NO;
    if (CGRectGetMaxX(wr) < ww - 12.0 || CGRectGetMinX(wr) < ww * 0.62) return NO;
    return YES;
}

static void AWESameStyleDestroyStackPlateV23(UIView *stack) {
    if (!stack) return;
    UIButton *plate = objc_getAssociatedObject(stack, &kAWESameStyleStackPlateKey);
    if (plate) { ALBReleaseArtwork(plate); ALBUnbindOriginalGlassAction(plate); [plate removeFromSuperview]; }
    objc_setAssociatedObject(stack, &kAWESameStyleStackPlateKey, nil,
                             OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    objc_setAssociatedObject(stack, &kAWESameStyleStackLastFrameKey, nil,
                             OBJC_ASSOCIATION_RETAIN_NONATOMIC);
}

static UIView *AWESameStyleBottomSlotForStackV20(UIView *stack) {
    if (!stack) return nil;
    UIView *best = nil;
    CGFloat bestY = -CGFLOAT_MAX;
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithArray:stack.subviews ?: @[]];
    NSUInteger idx = 0;
    while (idx < queue.count && idx < 180) {
        UIView *v = queue[idx++];
        for (UIView *sub in v.subviews) [queue addObject:sub];
        if (v.hidden || ALB7RightNativeAlpha(v) <= 0.01) continue;
        NSString *name = NSStringFromClass(v.class) ?: @"";
        if (![name containsString:@"AWEBaseElementView"]) continue;
        CGRect r = ALB19RightConvertRect(v,v.bounds,stack,stack);
        CGFloat w = CGRectGetWidth(r), h = CGRectGetHeight(r);
        if (w < 52.0 || w > 92.0 || h < 46.0 || h > 84.0) continue;
        CGFloat midY = CGRectGetMidY(r);
        if (midY > bestY) {
            bestY = midY;
            best = v;
        }
    }
    return best;
}

/* 3.11.49：右下角音乐点了没反应时的最后一招：按音乐 ID 打开音乐页 */
static BOOL ALBQJOpenURL(NSString *text, NSString **how);
static NSString *gALBMusicLast;
static BOOL AWEOpenMusicPageForStack(UIView *stack) {
    id aweme = AWECurrentAwemeModelForStack(stack);
    id music = AWESafeValueForKey(aweme, @"music");
    NSString *mid = AWEStringFromValue(AWEFirstSafeValue(music, @[@"musicID", @"musicId", @"mid", @"idStr", @"id_str", @"identifier"]));
    if (!mid.length) { gALBMusicLast = @"兜底：没拿到音乐 ID"; return NO; }
    NSString *how = nil;
    BOOL ok = ALBQJOpenURL([NSString stringWithFormat:@"snssdk1128://music/detail/%@", mid], &how);
    gALBMusicLast = [NSString stringWithFormat:@"兜底：音乐 %@ → %@", mid, how ?: (ok ? @"打开" : @"没打开")];
    return ok;
}

/* 点完 1 秒还停在原来那一页（音乐页没出来）：按音乐 ID 打开 */
static char kALBMusicTapStackKey;
static NSUInteger gALBMusicTaps, gALBMusicNoPage;
@interface ALBWeakRef : NSObject
@property (nonatomic, weak) id value;
@end
@implementation ALBWeakRef
@end
@interface ALBMusicTapWatcher : NSObject
+ (instancetype)shared;
- (void)tapped:(UIButton *)plate;
@end
@implementation ALBMusicTapWatcher
+ (instancetype)shared { static ALBMusicTapWatcher *w; if (!w) w = [ALBMusicTapWatcher new]; return w; }
- (void)tapped:(UIButton *)plate {
    gALBMusicTaps++;
    gALBNativeLastForward = nil;   // 这一下转给了谁（转发在这之后异步发生）
    UIWindow *window = plate.window ?: AWEActiveMainWindow();
    UIViewController *before = AWETopViewControllerFrom(window.rootViewController);
    __weak UIView *weakStack = ((ALBWeakRef *)objc_getAssociatedObject(plate, &kALBMusicTapStackKey)).value;
    __weak UIViewController *weakBefore = before;
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        UIView *stack = weakStack;
        UIViewController *now = AWETopViewControllerFrom(window.rootViewController);
        NSString *forwarded = gALBNativeLastForward ?: @"没转";
        if (!stack.window || now != weakBefore || weakBefore.presentedViewController) {
            gALBMusicLast = [NSString stringWithFormat:@"转给 %@ → 页面出来了（%@）", forwarded, NSStringFromClass((now ?: weakBefore.presentedViewController).class) ?: @"-"];
            return;
        }
        gALBMusicNoPage++;
        AWEOpenMusicPageForStack(stack);
        gALBMusicLast = [NSString stringWithFormat:@"转给 %@ → 1 秒后页面没变；%@", forwarded, gALBMusicLast ?: @"-"];
    });
}
@end

static void AWERefreshSameStyleGlass(UIView *host) {
    if (!host) return;

    /* v20: stop tying the glass lifetime to the recycled "拍同款/听抖音"
       content subtree.  The right-side AWEElementStackView is the stable thing:
       avatar/like/comment/favorite/share are present for every feed item, and
       the bottom music slot occupies the last AWEBaseElementView.  Own one
       plate per stack and keep it alive for the whole visible cell lifetime. */
    UIView *stack = [NSStringFromClass(host.class) containsString:@"AWEElementStackView"]
        ? host : AWEHomeActionStackForView(host);
    if (!stack) return;
 if(ALB6RightLayoutIsMutating())return;
 if(stack.window && UIApplication.sharedApplication.applicationState!=UIApplicationStateActive)return;
 static char refreshInProgressKey;
 if ([objc_getAssociatedObject(stack, &refreshInProgressKey) boolValue]) return;
 objc_setAssociatedObject(stack, &refreshInProgressKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
 @try { ALB6BeginRightGeometry(stack);


    UIButton *plate = objc_getAssociatedObject(stack, &kAWESameStyleStackPlateKey);
    if (!AWEPluginFeaturesEnabled() || gAWESettingsVisible ||
        !stack.window || stack.hidden || stack.alpha <= 0.01) {
        if (plate) { ALBReleaseArtwork(plate); plate.hidden = YES; }
        return;
    }
    if (!AWESameStyleIsRightActionStackV23(stack)) {
        /* Do not merely hide a mis-bound plate: like/favourite relayout can
           call this path again and resurrect it.  Remove the association too. */
        AWESameStyleDestroyStackPlateV23(stack);
        return;
    }

    UIView *bottomSlot = AWESameStyleBottomSlotForStackV20(stack);
    CGFloat sw = CGRectGetWidth(stack.bounds), sh = CGRectGetHeight(stack.bounds);

    CGPoint center;
    NSString *anchorName = @"stack-fallback";
    if (bottomSlot) {
        CGRect slotRect = ALB19RightConvertRect(bottomSlot,bottomSlot.bounds,stack,stack);
        /* FLEX: the native 44x44 music image is right aligned inside the
           80x64 bottom slot (x≈29,y≈8).  Use the slot geometry itself rather
           than waiting for that inner image to exist. */
        center = CGPointMake(CGRectGetMaxX(slotRect) - 29.0,
                             CGRectGetMidY(slotRect) - 2.0);
        anchorName = NSStringFromClass(bottomSlot.class) ?: @"AWEBaseElementView";
    } else {
        center = CGPointMake(MAX(25.0, sw - 29.0), MAX(25.0, sh - 34.0));
    }

    UIImageView *artwork = ALBMusicArtwork(bottomSlot);
    // 3.11.11: a small picture is no cover: without a cover Douyin shows its
    // fixed empty disc with a small 听抖音 headphone inside, and the column
    // put its glass round the headphone (user report). Below 34 pt the glass
    // is the empty disc's: 44 pt at the cover's place, under Douyin's disc.
    if (artwork && MIN(CGRectGetWidth(artwork.bounds), CGRectGetHeight(artwork.bounds)) < 34.0) artwork = nil;
    // 3.11: the cover's own size plus the ring (the dock's geometry); 44 pt
    // (Douyin's cover) while the cover is not there yet.
    const CGFloat diameter = ALBRGArtworkDiameter(artwork
        ? MIN(CGRectGetWidth(artwork.bounds), CGRectGetHeight(artwork.bounds)) : 44.0);
    CGRect desired = CGRectMake(center.x - diameter * 0.5,
                                center.y - diameter * 0.5,
                                diameter, diameter);

    BOOL created = NO;
    if (!plate || ![plate isKindOfClass:UIButton.class]) {
        [plate removeFromSuperview];
        plate = [ALBArtworkGlassButton buttonWithType:UIButtonTypeCustom];
        plate.userInteractionEnabled = NO;
        plate.backgroundColor = UIColor.clearColor;
        plate.opaque = NO;
        plate.clipsToBounds = NO;
        plate.accessibilityIdentifier = @"AwemeLiquidBar.SameStyleGlass.V20.StackOwned";
        objc_setAssociatedObject(stack, &kAWESameStyleStackPlateKey, plate,
                                 OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        created = YES;
    }
    if (!artwork && plate.superview != stack) {
        [plate removeFromSuperview];
        [stack insertSubview:plate atIndex:0];
        created = YES;
    } else if (!artwork && !ALBFollowAtBottom(plate)) {
        [stack insertSubview:plate atIndex:0];
    }

    NSValue *last = objc_getAssociatedObject(stack, &kAWESameStyleStackLastFrameKey);
    BOOL moved = !last || !CGRectEqualToRect(last.CGRectValue, desired);
    [CATransaction begin];
    [CATransaction setDisableActions:YES];
    if (!artwork) ALBSetRestingButtonGeometry(plate, desired);
    if (plate.layer.cornerRadius != diameter * 0.5) plate.layer.cornerRadius = diameter * 0.5;
    if (![plate.layer.cornerCurve isEqualToString:kCACornerCurveContinuous]) plate.layer.cornerCurve = kCACornerCurveContinuous;
    if (plate.hidden) plate.hidden = NO;
    if (plate.alpha != 1.0) plate.alpha = 1.0;
    if (stack.clipsToBounds) stack.clipsToBounds = NO;
    if (stack.layer.masksToBounds) stack.layer.masksToBounds = NO;
    [CATransaction commit];

    if (artwork && bottomSlot) {
        CGRect imageRect = ALB19RightConvertRect(artwork,artwork.bounds,stack,stack);
        CGRect artworkFrame = CGRectMake(CGRectGetMidX(imageRect)-diameter*0.5,
            CGRectGetMidY(imageRect)-diameter*0.5, diameter, diameter);
        ALBPlaceArtworkButton(plate, artwork, stack, artworkFrame);
        // Same rule as the avatar glass: the artwork at its native side, in
        // the middle of a picture as big as the glass (3.11).
        CGFloat nativeArtworkSide = MIN(CGRectGetWidth(artwork.bounds), CGRectGetHeight(artwork.bounds));
        CGFloat artworkSide = MIN(diameter, MAX(1.0, round(nativeArtworkSide)));
        ALBInstallNativeArtwork(plate, artwork, artworkSide, diameter, @"right.music.native");
        // Layout-only centering. UIKit still owns the native glass deformation
        // and image stretch during press; no interaction transform is replaced.
        plate.contentHorizontalAlignment = UIControlContentHorizontalAlignmentCenter;
        plate.contentVerticalAlignment = UIControlContentVerticalAlignmentCenter;
        ALBBindNativeAction(plate, bottomSlot, stack, AWEHomeActionKindUnknown);
        ALBWeakRef *stackRef = objc_getAssociatedObject(plate, &kALBMusicTapStackKey);
        if (!stackRef) { stackRef = [ALBWeakRef new]; objc_setAssociatedObject(plate, &kALBMusicTapStackKey, stackRef, OBJC_ASSOCIATION_RETAIN_NONATOMIC); }
        stackRef.value = stack;
        if (![plate.allTargets containsObject:[ALBMusicTapWatcher shared]])
            [plate addTarget:[ALBMusicTapWatcher shared] action:@selector(tapped:) forControlEvents:UIControlEventTouchUpInside];
        /* 3.11.51：3.11.49 诊断【右下角音乐】“点了 0 次”。音乐玻璃里铺着系统栏按钮（ALBBarFace.h，按压变形那层），手指落在它的
           控件上，触摸是转交给这颗玻璃按钮的；UIKit 对转交的触摸不发 TouchUpInside，所以上面挂的动作（转给抖音音乐按钮、
           看页面有没有出来）一次都没跑。同双击面板的按钮（3.11.19）：抬手时在按钮上、按钮自己没发，就补发一次。 */
        ALBFaceTapOnTouchUp(plate);
        if (!objc_getAssociatedObject(plate, &kALBNativeFallbackKey)) {
            __weak UIView *weakStack = stack;
            BOOL (^fallback)(void) = ^BOOL { UIView *live = weakStack; return live ? AWEOpenMusicPageForStack(live) : NO; };
            objc_setAssociatedObject(plate, &kALBNativeFallbackKey, fallback, OBJC_ASSOCIATION_COPY_NONATOMIC);
        }
    } else {
        ALBReleaseArtwork(plate);
        plate.userInteractionEnabled = NO;
        AWEConfigureAdaptiveSystemGlassPlateButton(
            plate, @"right.same-style.v20.stack", AWEHomeTintedGlassEnabled());
    }

    objc_setAssociatedObject(stack, &kAWESameStyleStackLastFrameKey,
                             [NSValue valueWithCGRect:desired],
                             OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    if (created || moved) {
        CGRect wr = [stack convertRect:desired toView:stack.window];
        AWEInteractionDiagnosticWrite(
            @"SAMESTYLE_V20_STACK anchor=%@ stack=%@ plate=%@ persistent=1",
            anchorName, NSStringFromCGRect([stack convertRect:stack.bounds toView:stack.window]),
            NSStringFromCGRect(wr));
    }

 } @finally {
     @try { ALB6EndRightGeometry(stack); }
     @finally { objc_setAssociatedObject(stack, &refreshInProgressKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC); }
 }
}

static void AWERefreshVisibleSameStyleAnchors(UIView *root) {
    if (!root || !root.window) return;
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:root];
    NSMutableSet<NSValue *> *seen = [NSMutableSet set];
    NSUInteger idx = 0;
    while (idx < queue.count && idx < 2600) {
        UIView *v = queue[idx++];
        for (UIView *sub in v.subviews) [queue addObject:sub];
        UIView *anchor = nil;
        if (AWESameStyleStableAnchorClass(v)) anchor = v;
        else if (AWEViewHasSameStyleMarker(v)) anchor = AWESameStyleAncestorForTarget(v, nil);
        if (!anchor || !anchor.window) continue;
        NSValue *key = [NSValue valueWithPointer:(const void *)anchor];
        if ([seen containsObject:key]) continue;
        [seen addObject:key];
        /* Direct anchors with 0x0 bounds are intentionally included here so
           their retry series can catch the post-reuse layout pass. */
        AWERefreshSameStyleGlass(anchor);
    }
}


static BOOL AWEOriginalTabBarBackdropClass(UIView *view) {
    NSString *name = NSStringFromClass(view.class);
    return [name isEqualToString:@"AWENormalModeTabBarBlurView"] ||
           [name isEqualToString:@"AWETabBarSkinContainerView"] ||
           [name isEqualToString:@"AWETabBarSkinView"];
}

static void AWEForceOriginalBottomBackdropClear(UIView *view) {
    if (!view || !AWEPluginFeaturesEnabled()) return;
    view.backgroundColor = UIColor.clearColor;
    view.layer.backgroundColor = UIColor.clearColor.CGColor;
    view.opaque = NO;
    if ([view isKindOfClass:UIVisualEffectView.class]) {
        ((UIVisualEffectView *)view).effect = nil;
    }
}

static void AWEClearOriginalTabBarBackdropTree(UIView *root, NSUInteger depth) {
    if (!root || depth > 7) return;
    for (UIView *child in root.subviews) {
        if (AWEOriginalTabBarBackdropClass(child)) {
            AWEForceOriginalBottomBackdropClear(child);
            child.alpha = 0.0;
            /* FLEX shows a second 440x83 plain UIView immediately around the
               Blur/Skin nodes on Shop/Profile. Clear that carrier too, but do
               not hide it so UIKit's layout/hit testing remains intact. */
            UIView *carrier = child.superview;
            if (carrier && CGRectGetHeight(carrier.bounds) >= 70.0 &&
                CGRectGetHeight(carrier.bounds) <= 96.0) {
                AWEForceOriginalBottomBackdropClear(carrier);
            }
        }
        NSString *name = NSStringFromClass(child.class);
        if (([name containsString:@"_UITabBarContainerWrapperView"] ||
             [name containsString:@"_UITabBarContainerView"]) &&
            CGRectGetHeight(child.bounds) >= 70.0) {
            AWEForceOriginalBottomBackdropClear(child);
        }
        AWEClearOriginalTabBarBackdropTree(child, depth + 1);
    }
}

static void AWEProbeBottomBackdropCandidates(UIView *root, NSUInteger depth) {
    if (!root || depth > 12 || !root.window) return;
    static CFTimeInterval lastScan = 0;
    static NSUInteger visited = 0;
    if (depth == 0) {
        if (!AWEInteractionDiagnosticsEnabled() ||
            UIApplication.sharedApplication.applicationState != UIApplicationStateActive) return;
        CFTimeInterval now = CACurrentMediaTime();
        if (now - lastScan < 1.0) return;
        lastScan = now;
        visited = 0;
    }
    if (++visited > 640) return;
    UIWindow *window = root.window;
    CGFloat wh = CGRectGetHeight(window.bounds), ww = CGRectGetWidth(window.bounds);
    for (UIView *child in root.subviews) {
        if (visited >= 640) break;
        if (!child.hidden && child.alpha > 0.01 && ![child isKindOfClass:UILabel.class] &&
            ![child isKindOfClass:UIControl.class] && ![child isKindOfClass:UIImageView.class]) {
            CGRect wr = [child.superview convertRect:child.frame toView:window];
            BOOL bottom = CGRectGetMaxY(wr) >= wh - 4.0 && CGRectGetMinY(wr) >= wh - 130.0;
            BOOL wide = CGRectGetWidth(wr) >= ww * 0.86;
            UIColor *bg = child.backgroundColor;
            CGFloat alpha = bg ? CGColorGetAlpha(bg.CGColor) : 0.0;
            BOOL effect = [child isKindOfClass:UIVisualEffectView.class];
            if (bottom && wide && (effect || alpha > 0.02)) {
                AWEInteractionDiagnosticWrite(@"BOTTOM_CAND tab=%ld class=%@ frame=%@ bg=%@ alpha=%.3f effect=%d opaque=%d",
                    (long)AWECurrentMainTabIndex(), NSStringFromClass(child.class),
                    NSStringFromCGRect(wr), bg.description ?: @"nil", alpha, effect, child.opaque);
            }
        }
        AWEProbeBottomBackdropCandidates(child, depth + 1);
    }
}


typedef NS_ENUM(NSInteger, AWEBottomRouteKind) {
    AWEBottomRouteNone = 0,
    AWEBottomRouteShop = 1,
    AWEBottomRouteProfile = 2,
    AWEBottomRouteGrid = 3,
    /* 3.3: Home's 团购 channel. Only the bottom-content pass uses it
       (AWEExtendRouteContentBehindBottomBar); route detection still says None. */
    AWEBottomRouteGroupon = 4,
};

static BOOL gAWEBottomRefreshScheduled = NO;
static BOOL gAWEBottomApplyingRefresh = NO;
static char kAWEBottomV15BaseInsetKey;
static char kAWEBottomV15BaseAdjustedBottomKey;
static char kAWEBottomV15LastFrameKey;
static char kAWEBottomV21DesiredShopFrameKey;
static char kAWEBottomV21ShopScoreKey;
static char kAWEBottomV21ShopOldBottomKey;
static char kALB29GridCollectionKey, kALB29GridScanKey;
static char kALB32BottomFrameStateKey, kALB32BottomChangedViewsKey;

static BOOL ALB32BottomViewIsVisible(UIView *view, UIWindow *window) {
    if (!view || view.window != window) return NO;
    for (UIView *cursor = view; cursor && cursor != window; cursor = cursor.superview)
        if (cursor.hidden || cursor.alpha < 0.01) return NO;
    CGRect rect = [view convertRect:view.bounds toView:window];
    return CGRectGetWidth(rect) > 1.0 && CGRectGetHeight(rect) > 1.0 &&
           CGRectGetMinX(rect) < CGRectGetWidth(window.bounds) - 20.0 &&
           CGRectGetMaxX(rect) > 20.0 && CGRectIntersectsRect(rect, window.bounds);
}

/* Capture: the mall controller is at view depth 15 and its product feed is
   below depth 28. A depth-12 view search misses it even though it is displayed
   as a channel on main tab 0. Loaded controller children give the real page
   without scanning thousands of retained feed cells. */
static UIView *ALB32BottomVisibleRouteRoot(UIWindow *window, AWEBottomRouteKind route) {
    UIViewController *root = window.rootViewController;
    if (!root) return nil;
    NSMutableArray<UIViewController *> *queue = [NSMutableArray arrayWithObject:root];
    UIView *best = nil;
    NSInteger bestScore = 0;
    for (NSUInteger i = 0; i < queue.count && i < 180; i++) {
        UIViewController *controller = queue[i];
        for (UIViewController *child in controller.childViewControllers)
            if (queue.count < 180) [queue addObject:child];
        UIView *view = controller.viewIfLoaded;
        if (!ALB32BottomViewIsVisible(view, window)) continue;
        CGRect viewport = [view convertRect:view.bounds toView:window];
        if (CGRectGetWidth(viewport) < CGRectGetWidth(window.bounds) * 0.78 ||
            CGRectGetHeight(viewport) < 200.0) continue;
        NSString *name = NSStringFromClass(controller.class);
        NSInteger score = 0;
        if (route == AWEBottomRouteShop) {
            if ([name containsString:@"IESECMallCore"]) score = 3;
            else if ([name containsString:@"AWEECNewMall"] ||
                     [name containsString:@"AWECNewMall"] ||
                     [name containsString:@"CommerceMall"]) score = 2;
            else if ([name containsString:@"IESECMall"]) score = 1;
        } else if (route == AWEBottomRouteGrid) {
            NSString *lower = name.lowercaseString;
            if ([lower containsString:@"dcfeedlist"]) score = 3;
            else if ([lower containsString:@"doublecolumn"] ||
                     [lower containsString:@"dualcolumn"] ||
                     [lower containsString:@"gridfeed"] ||
                     [lower containsString:@"waterfallfeed"]) score = 2;
        }
        if (score > bestScore) { best = view; bestScore = score; }
    }
    return best;
}

/* Record only frames we own, with weak membership. On leaving this route,
   restore only when native layout has not already supplied a newer frame. */
static void ALB32BottomAssignExtendedFrame(UIView *view, CGRect frame,
                                          AWEBottomRouteKind route) {
    if (!view.window || CGRectEqualToRect(view.frame, frame)) return;
    NSMutableDictionary *state = objc_getAssociatedObject(view, &kALB32BottomFrameStateKey);
    if (!state) {
        state = [@{@"base": [NSValue valueWithCGRect:view.frame], @"route": @(route)} mutableCopy];
        objc_setAssociatedObject(view, &kALB32BottomFrameStateKey, state, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        NSHashTable<UIView *> *changed = objc_getAssociatedObject(view.window, &kALB32BottomChangedViewsKey);
        if (!changed) {
            changed = [NSHashTable weakObjectsHashTable];
            objc_setAssociatedObject(view.window, &kALB32BottomChangedViewsKey, changed, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }
        [changed addObject:view];
    } else if (state[@"applied"] &&
               !CGRectEqualToRect(view.frame, [state[@"applied"] CGRectValue])) {
        state[@"base"] = [NSValue valueWithCGRect:view.frame];
    }
    state[@"applied"] = [NSValue valueWithCGRect:frame];
    [CATransaction begin];
    [CATransaction setDisableActions:YES];
    view.frame = frame;
    [CATransaction commit];
}

static void ALB32BottomRestoreInactiveFrames(UIWindow *window, AWEBottomRouteKind route) {
    NSHashTable<UIView *> *changed = objc_getAssociatedObject(window, &kALB32BottomChangedViewsKey);
    for (UIView *view in changed.allObjects) {
        NSDictionary *state = objc_getAssociatedObject(view, &kALB32BottomFrameStateKey);
        if ([state[@"route"] integerValue] == route &&
            ALB32BottomViewIsVisible(view, window)) continue;
        NSValue *applied = state[@"applied"], *base = state[@"base"];
        if (applied && base && CGRectEqualToRect(view.frame, applied.CGRectValue)) {
            [CATransaction begin];
            [CATransaction setDisableActions:YES];
            view.frame = base.CGRectValue;
            [CATransaction commit];
        }
        objc_setAssociatedObject(view, &kALB32BottomFrameStateKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(view, &kAWEBottomV21DesiredShopFrameKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(view, &kAWEBottomV21ShopOldBottomKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        [changed removeObject:view];
    }
    if (route != AWEBottomRouteGrid) {
        objc_setAssociatedObject(window, &kALB29GridCollectionKey, nil, OBJC_ASSOCIATION_COPY_NONATOMIC);
        objc_setAssociatedObject(window, &kALB29GridScanKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
}

static UICollectionView *ALB29CachedGrid(UIWindow *window) {
    UICollectionView *(^resolve)(void)=objc_getAssociatedObject(window,&kALB29GridCollectionKey);
    UICollectionView *collection=resolve ? resolve() : nil;
    if (!collection || collection.window!=window || AWECurrentMainTabIndex()!=0) return nil;
    for (UIView *v=collection;v && v!=window;v=v.superview)
        if (v.hidden || v.alpha<.01) return nil;
    CGRect rect=[collection convertRect:collection.bounds toView:window];
    if (!CGRectIntersectsRect(rect,window.bounds) || rect.size.width<window.bounds.size.width*.82) return nil;
    UIView *routeRoot = ALB32BottomVisibleRouteRoot(window, AWEBottomRouteGrid);
    if (routeRoot && [collection isDescendantOfView:routeRoot]) return collection;
    // The app may reuse the same collection when returning to single-column.
    // Do not let a retained weak cache turn that layout into a grid forever.
    CGFloat left=CGFLOAT_MAX,right=-CGFLOAT_MAX,width=window.bounds.size.width;
    NSUInteger visited=0;
    for (UICollectionViewCell *cell in collection.visibleCells) {
        if (visited++>=12) break;
        CGRect frame=cell.frame;
        if (frame.size.width<width*.25 || frame.size.width>width*.60 || frame.size.height<100) continue;
        left=MIN(left,CGRectGetMidX(frame)); right=MAX(right,CGRectGetMidX(frame));
    }
    if (right-left<width*.25) return nil;
    return collection;
}


static NSString *AWEBottomViewPath(UIView *view, UIWindow *window) {
    if (!view) return @"nil";
    NSMutableArray<NSString *> *parts = [NSMutableArray array];
    for (UIView *cursor = view; cursor && parts.count < 10; cursor = cursor.superview) {
        [parts addObject:NSStringFromClass(cursor.class) ?: @"?"];
        if (cursor == window) break;
    }
    return [parts componentsJoinedByString:@"<-"];
}

static BOOL AWEBottomTreeContainsRouteClass(UIView *root, AWEBottomRouteKind route,
                                            NSUInteger depth) {
    if (!root || depth > 12 || root.hidden || root.alpha < 0.01) return NO;
    NSString *name = NSStringFromClass(root.class);
    /* A controller's root is frequently a plain UIView. Read only its direct
       responder (no per-node ancestry walk) so grid/favorites controllers with
       anonymous roots are still found. Ignore retained offscreen pages. */
    if (root.window && !CGRectIntersectsRect([root convertRect:root.bounds toView:root.window], root.window.bounds)) return NO;
    UIResponder *owner = root.nextResponder;
    if ([owner isKindOfClass:UIViewController.class])
        name = [name stringByAppendingFormat:@"/%@", NSStringFromClass(owner.class)];
    if (route == AWEBottomRouteShop) {
        if ([name containsString:@"IESECMallCore"] || [name containsString:@"IESECMall"] ||
            [name containsString:@"AWECNewMall"] || [name containsString:@"CommerceMall"] ||
            [name containsString:@"MallCore"]) return YES;
    } else if (route == AWEBottomRouteProfile) {
        if ([name containsString:@"AWEProfileBaseContainer"] ||
            [name containsString:@"AWEProfile"] || [name containsString:@"AWEFavorite"]) return YES;
    } else if (route == AWEBottomRouteGrid) {
        NSString *lower = name.lowercaseString;
        if ([lower containsString:@"doublecolumn"] || [lower containsString:@"dualcolumn"] ||
            [lower containsString:@"gridfeed"] || [lower containsString:@"waterfallfeed"]) return YES;
    }
    for (UIView *child in root.subviews) {
        if (AWEBottomTreeContainsRouteClass(child, route, depth + 1)) return YES;
    }
    return NO;
}

static AWEBottomRouteKind AWEBottomRouteForWindow(UIWindow *window) {
    if (!window) return AWEBottomRouteNone;
    // Channels live below the native tab controller. Do not infer their route
    // from the main-tab index, or from a fixed depth in the view hierarchy.
    if (ALB32BottomVisibleRouteRoot(window, AWEBottomRouteGrid)) return AWEBottomRouteGrid;
    if (ALB32BottomVisibleRouteRoot(window, AWEBottomRouteShop)) return AWEBottomRouteShop;
    UIViewController *top = AWETopViewControllerFrom(window.rootViewController);
    for (UIViewController *vc = top; vc; vc = vc.parentViewController) {
        NSString *name = NSStringFromClass(object_getClass(vc));
        if ([name containsString:@"IESECMallCore"] || [name containsString:@"IESECMall"] ||
            [name containsString:@"AWEECNewMall"] || [name containsString:@"AWECNewMall"] || [name containsString:@"CommerceMall"] ||
            [name containsString:@"MallCore"]) {
            return AWEBottomRouteShop;
        }
        if ([name containsString:@"AWEProfileBaseContainer"] || [name containsString:@"AWEProfile"] ||
            [name containsString:@"Favorite"] || [name containsString:@"Favourit"]) return AWEBottomRouteProfile;
        NSString *lower=name.lowercaseString;
        if ([lower containsString:@"doublecolumn"] || [lower containsString:@"dualcolumn"] ||
            [lower containsString:@"gridfeed"] || [lower containsString:@"waterfallfeed"]) return AWEBottomRouteGrid;
    }
    /* The normal-tab index is authoritative for its active page. Retained
       offscreen Profile controllers must not win over the current Mall page. */
    NSInteger tab = AWECurrentMainTabIndex();
    if (AWESecondTabIsShop() && tab == 1) return AWEBottomRouteShop;
    if (tab == 4) return AWEBottomRouteProfile;
    if (tab == 0 && (ALB29CachedGrid(window) || AWEBottomTreeContainsRouteClass(window, AWEBottomRouteGrid, 0)))
        return AWEBottomRouteGrid;
    if (AWEBottomTreeContainsRouteClass(window, AWEBottomRouteShop, 0)) {
        return AWEBottomRouteShop;
    }
    if (AWEBottomTreeContainsRouteClass(window, AWEBottomRouteProfile, 0)) {
        return AWEBottomRouteProfile;
    }
    if (AWESecondTabIsShop() && AWECurrentMainTabIndex() == 1) return AWEBottomRouteShop;
    return AWEBottomRouteNone;
}

static NSString *AWEBottomRouteName(AWEBottomRouteKind route) {
    return route == AWEBottomRouteShop ? @"shop" :
           route == AWEBottomRouteProfile ? @"profile/favorites" :
           route == AWEBottomRouteGrid ? @"double-column" :
           route == AWEBottomRouteGroupon ? @"groupon" : @"none";
}

static BOOL AWEBottomPathRelevantForRoute(UIView *view, AWEBottomRouteKind route) {
    for (UIView *cursor = view; cursor; cursor = cursor.superview) {
        NSString *name = NSStringFromClass(cursor.class);
        if ([cursor.nextResponder isKindOfClass:UIViewController.class])
            name = [name stringByAppendingFormat:@"/%@", NSStringFromClass(cursor.nextResponder.class)];
        if (route == AWEBottomRouteShop) {
            if ([name containsString:@"IESECMallCoreFeedNode"] ||
                [name containsString:@"IESECMitaViewPagerCell"] ||
                [name containsString:@"AWEECNewMall"] || [name containsString:@"AWECNewMall"] ||
                [name containsString:@"IESECMallCore"] ||
                [name containsString:@"IESECMall"]) return YES;
        } else if (route == AWEBottomRouteProfile) {
            if ([name containsString:@"AWEListKitTabContentCollectionView"] ||
                [name containsString:@"AWETabContentItemContainerCell"] ||
                [name containsString:@"AWEProfileBaseContainer"] ||
                [name containsString:@"AWEProfile"] || [name containsString:@"AWEFavorite"]) return YES;
        } else if (route == AWEBottomRouteGrid) {
            NSString *lower = name.lowercaseString;
            if ([lower containsString:@"doublecolumn"] || [lower containsString:@"dualcolumn"] || [lower containsString:@"dcfeedlist"] ||
                [lower containsString:@"gridfeed"] || [lower containsString:@"waterfallfeed"]) return YES;
        } else if (route == AWEBottomRouteGroupon) {
            if ([name containsString:@"AWEGroupon"]) return YES;
        }
        if ([cursor isKindOfClass:UIWindow.class]) break;
    }
    return NO;
}

static void AWEBottomV15OpenClipChain(UIView *view, UIWindow *window,
                                         AWEBottomRouteKind route) {
    if (!view || !window) return;
    CGFloat ww = CGRectGetWidth(window.bounds);
    CGFloat wh = CGRectGetHeight(window.bounds);
    for (UIView *cursor = view.superview; cursor && cursor != window; cursor = cursor.superview) {
        if (!AWEBottomPathRelevantForRoute(cursor, route)) continue;
        CGRect wr = cursor.superview ? [cursor.superview convertRect:cursor.frame toView:window]
                                     : [cursor convertRect:cursor.bounds toView:window];
        CGFloat gap = wh - CGRectGetMaxY(wr);
        if (CGRectGetWidth(wr) >= ww * 0.78 && gap >= -3.0 && gap <= 138.0) {
            cursor.clipsToBounds = NO;
            cursor.layer.masksToBounds = NO;
        }
    }
}

/* The profile's sticky header owns origin and top inset. Bottom cleanup must
   compose with the CURRENT values: replaying an entry-time frame/top inset
   resets that header's nested-scroll handoff when the finger reverses. */
static CGRect ALB34ProfileExtendedFrame(CGRect current, CGFloat bottomGap) {
    if (isfinite(bottomGap) && bottomGap >= 30.0 && bottomGap <= 135.0)
        current.size.height += bottomGap;
    return current;
}

static UIEdgeInsets ALB34ProfileReleasedInset(UIEdgeInsets current,
                                             CGFloat baseBottom,
                                             CGFloat adjustedBottom) {
    if (adjustedBottom >= 28.0 && adjustedBottom <= 145.0)
        current.bottom = MAX(-145.0, MIN(0.0, baseBottom - adjustedBottom));
    else if (baseBottom >= 28.0 && baseBottom <= 145.0)
        current.bottom = 0.0;
    return current;
}

static BOOL ALB34ProfileScrollBusy(BOOL tracking, BOOL dragging, BOOL decelerating,
                                 UIGestureRecognizerState panState) {
    return tracking || dragging || decelerating ||
        panState == UIGestureRecognizerStateBegan ||
        panState == UIGestureRecognizerStateChanged;
}

static BOOL ALB34ProfileScrollChainBusy(UIView *view) {
    for (UIView *cursor = view; cursor && ![cursor isKindOfClass:UIWindow.class];
         cursor = cursor.superview) {
        if (![cursor isKindOfClass:UIScrollView.class]) continue;
        UIScrollView *scroll = (UIScrollView *)cursor;
        if (ALB34ProfileScrollBusy(scroll.tracking, scroll.dragging, scroll.decelerating,
                                   scroll.panGestureRecognizer.state)) return YES;
    }
    return NO;
}

static BOOL AWEBottomV15AdjustView(UIView *view, UIWindow *window,
                                   AWEBottomRouteKind route, NSString *reason) {
    // Restore the v15/TEST9 no-jump boundary. Profile uses a nested sticky
    // scroll coordinator: even an idle frame/inset write changes its next
    // reversal handoff. Background cleanup must never own this geometry.
    if (route == AWEBottomRouteProfile) return NO;
    if (!AWEPluginFeaturesEnabled() || gAWESettingsVisible) return NO;
    if (!view || !window || !view.superview || view.hidden || view.alpha < 0.01) return NO;
    NSString *name = NSStringFromClass(view.class);
    if ([name containsString:@"TabBar"] || [name containsString:@"LiquidBar"] ||
        [view.accessibilityIdentifier hasPrefix:@"AwemeLiquidBar"]) return NO;
    if (!AWEBottomPathRelevantForRoute(view, route)) return NO;

    CGRect wr = [view.superview convertRect:view.frame toView:window];
    CGFloat ww = CGRectGetWidth(window.bounds), wh = CGRectGetHeight(window.bounds);
    CGFloat gap = wh - CGRectGetMaxY(wr);
    BOOL horizontallyVisible = CGRectGetMaxX(wr) > -24.0 &&
                               CGRectGetMinX(wr) < ww + 24.0;
    BOOL large = horizontallyVisible && CGRectGetWidth(wr) >= ww * 0.82 &&
                 CGRectGetHeight(wr) >= wh * 0.25 &&
                 CGRectGetMinY(wr) < wh * 0.58;
    BOOL isScroll = [view isKindOfClass:UIScrollView.class];
    BOOL routeAnchor =
        (route == AWEBottomRouteShop &&
         ([name containsString:@"IESECMallCoreFeedNode"] ||
          [name containsString:@"AWECNewMall"] ||
          [name containsString:@"IESECMitaViewPagerCell"] ||
          [name containsString:@"IESECMitaViewPager"] ||
          [name containsString:@"IESECMitaPagerContainer"])) ||
        (route == AWEBottomRouteProfile &&
         ([name containsString:@"AWEListKitTabContentCollectionView"] ||
          [name containsString:@"AWETabContentItemContainerCell"]));
    /* XHS succeeds by extending the real collection/content anchor and opening
       its clip chain, not by resizing every anonymous UIView in the page. */
    BOOL frameNeedsExtension = large && gap >= 30.0 && gap <= 135.0 &&
                               (isScroll || routeAnchor);
    BOOL insetNeedsRelease = NO;
    if (isScroll) {
        UIScrollView *scroll = (UIScrollView *)view;
        insetNeedsRelease = scroll.contentInset.bottom >= 28.0 ||
                            scroll.adjustedContentInset.bottom >= 28.0 ||
                            scroll.verticalScrollIndicatorInsets.bottom >= 28.0;
    }
    if (!frameNeedsExtension && !insetNeedsRelease) return NO;
    // A content cell can be idle while its ancestor/child is scrolling. The
    // route pass also checks descendant scrolls before mutating any ancestor.
    if (ALB34ProfileScrollChainBusy(view)) return NO;

    CGRect before = view.frame;
    CGPoint offset = CGPointZero;
    if ([view isKindOfClass:UIScrollView.class]) offset = ((UIScrollView *)view).contentOffset;

    if (frameNeedsExtension) {
        // gap is measured from the live bottom edge, so a frame already
        // extended to the window has zero gap and is never extended twice.
        CGRect desired = ALB34ProfileExtendedFrame(before, gap);
        if (!CGRectEqualToRect(view.frame, desired)) view.frame = desired;
        view.clipsToBounds = NO;
        view.layer.masksToBounds = NO;
        view.superview.clipsToBounds = NO;
        view.superview.layer.masksToBounds = NO;
        AWEBottomV15OpenClipChain(view, window, route);
    }

    if (isScroll) {
        UIScrollView *scroll = (UIScrollView *)view;
        NSValue *savedInset = objc_getAssociatedObject(scroll, &kAWEBottomV15BaseInsetKey);
        NSNumber *savedAdjusted = objc_getAssociatedObject(scroll, &kAWEBottomV15BaseAdjustedBottomKey);
        if (!savedInset || !savedAdjusted) {
            savedInset = [NSValue valueWithUIEdgeInsets:scroll.contentInset];
            savedAdjusted = @(scroll.adjustedContentInset.bottom);
            objc_setAssociatedObject(scroll, &kAWEBottomV15BaseInsetKey, savedInset,
                                     OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            objc_setAssociatedObject(scroll, &kAWEBottomV15BaseAdjustedBottomKey, savedAdjusted,
                                     OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }
        UIEdgeInsets inset = ALB34ProfileReleasedInset(scroll.contentInset,
            savedInset.UIEdgeInsetsValue.bottom, savedAdjusted.doubleValue);
        UIEdgeInsets indicator = scroll.verticalScrollIndicatorInsets;
        if (indicator.bottom >= 28.0 && indicator.bottom <= 145.0) indicator.bottom = 0.0;
        if (!UIEdgeInsetsEqualToEdgeInsets(scroll.contentInset, inset)) scroll.contentInset = inset;
        if (!UIEdgeInsetsEqualToEdgeInsets(scroll.verticalScrollIndicatorInsets, indicator))
            scroll.verticalScrollIndicatorInsets = indicator;
        if (!CGPointEqualToPoint(scroll.contentOffset, offset)) scroll.contentOffset = offset;
        AWEBottomV15OpenClipChain(scroll, window, route);
    }

    CGRect afterWr = [view.superview convertRect:view.frame toView:window];
    NSValue *last = objc_getAssociatedObject(view, &kAWEBottomV15LastFrameKey);
    BOOL changed = !last || !CGRectEqualToRect(last.CGRectValue, afterWr);
    objc_setAssociatedObject(view, &kAWEBottomV15LastFrameKey,
                             [NSValue valueWithCGRect:afterWr], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    if (changed) {
        UIEdgeInsets inset = [view isKindOfClass:UIScrollView.class]
            ? ((UIScrollView *)view).contentInset : UIEdgeInsetsZero;
        AWEInteractionDiagnosticWrite(@"BOTTOM_V16_EXTEND reason=%@ route=%@ class=%@ before=%@ after=%@ inset=%@ path=%@",
            reason ?: @"", AWEBottomRouteName(route), name, NSStringFromCGRect(wr),
            NSStringFromCGRect(afterWr), NSStringFromUIEdgeInsets(inset),
            AWEBottomViewPath(view, window));
    }
    return YES;
}

static BOOL AWEBottomV16ExcludedShopCover(UIView *view) {
    if (!view) return YES;
    NSString *name = NSStringFromClass(view.class);
    if ([view isKindOfClass:UIControl.class] || [view isKindOfClass:UILabel.class] ||
        [view isKindOfClass:UIImageView.class] || [view isKindOfClass:UIScrollView.class] ||
        [view isKindOfClass:UICollectionViewCell.class] || [view isKindOfClass:UITableViewCell.class]) return YES;
    if ([name containsString:@"TabBar"] || [name containsString:@"LiquidBar"] ||
        [name containsString:@"Glass"] || [name containsString:@"Toast"] ||
        [name containsString:@"Alert"] || [name containsString:@"Sheet"] ||
        [view.accessibilityIdentifier hasPrefix:@"AwemeLiquidBar"]) return YES;
    return NO;
}

static void AWEBottomV16ClearShopBottomCovers(UIWindow *window, NSString *reason) {
    if (!window || AWEBottomRouteForWindow(window) != AWEBottomRouteShop) return;
    CGFloat ww = CGRectGetWidth(window.bounds), wh = CGRectGetHeight(window.bounds);
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:window];
    NSUInteger idx = 0, cleared = 0;
    while (idx < queue.count && idx < 3000) {
        UIView *view = queue[idx++];
        for (UIView *sub in view.subviews) [queue addObject:sub];
        if (view == window || !view.superview || view.hidden || view.alpha < 0.01) continue;
        if (!AWEBottomPathRelevantForRoute(view, AWEBottomRouteShop)) continue;
        if (AWEBottomV16ExcludedShopCover(view)) continue;

        CGRect wr = [view.superview convertRect:view.frame toView:window];
        CGFloat h = CGRectGetHeight(wr), w = CGRectGetWidth(wr);
        BOOL nearBottomStrip = w >= ww * 0.86 && h >= 32.0 && h <= 150.0 &&
                               CGRectGetMaxY(wr) >= wh - 4.0 &&
                               CGRectGetMinY(wr) >= wh - 155.0;
        if (!nearBottomStrip) continue;

        UIColor *bg = view.backgroundColor;
        CGFloat alpha = bg ? CGColorGetAlpha(bg.CGColor) : 0.0;
        BOOL hasLayerBG = view.layer.backgroundColor != NULL &&
                          CGColorGetAlpha(view.layer.backgroundColor) > 0.02;
        BOOL hasEffect = [view isKindOfClass:UIVisualEffectView.class] &&
                         ((UIVisualEffectView *)view).effect != nil;
        if (alpha <= 0.02 && !hasLayerBG && !hasEffect && !view.opaque) continue;

        view.backgroundColor = UIColor.clearColor;
        view.layer.backgroundColor = UIColor.clearColor.CGColor;
        view.opaque = NO;
        if ([view isKindOfClass:UIVisualEffectView.class]) {
            ((UIVisualEffectView *)view).effect = nil;
        }
        cleared++;
        if (cleared <= 18) {
            AWEInteractionDiagnosticWrite(@"BOTTOM_V16_COVER_CLEAR reason=%@ class=%@ frame=%@ path=%@",
                reason ?: @"", NSStringFromClass(view.class), NSStringFromCGRect(wr),
                AWEBottomViewPath(view, window));
        }
    }
}

static void AWEBottomV16LogShopChainForView(UIView *view, UIWindow *window) {
    if (!view || !window || AWEBottomRouteForWindow(window) != AWEBottomRouteShop) return;
    static CFTimeInterval lastLog = 0.0;
    CFTimeInterval now = CACurrentMediaTime();
    if (now - lastLog < 0.8) return;
    lastLog = now;
    NSUInteger count = 0;
    for (UIView *cursor = view; cursor && cursor != window && count < 12; cursor = cursor.superview, count++) {
        if (!cursor.superview) break;
        CGRect wr = [cursor.superview convertRect:cursor.frame toView:window];
        AWEInteractionDiagnosticWrite(@"BOTTOM_V16_CHAIN level=%lu class=%@ frame=%@ clips=%d opaque=%d bg=%@",
            (unsigned long)count, NSStringFromClass(cursor.class), NSStringFromCGRect(wr),
            cursor.clipsToBounds, cursor.opaque, cursor.backgroundColor.description ?: @"nil");
    }
}

static BOOL AWEBottomV17IsScrollEdgeEffectView(UIView *view) {
    if (!view) return NO;
    NSString *name = NSStringFromClass(view.class) ?: @"";
    return [name containsString:@"ScrollEdgeEffectView"];
}

static void AWEBottomV17ClearShopSystemChrome(UIWindow *window, NSString *reason) {
    if (!window || AWEBottomRouteForWindow(window) != AWEBottomRouteShop) return;
    CGFloat ww = CGRectGetWidth(window.bounds), wh = CGRectGetHeight(window.bounds);
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:window];
    NSUInteger idx = 0, cleared = 0;
    while (idx < queue.count && idx < 3600) {
        UIView *view = queue[idx++];
        for (UIView *sub in view.subviews) [queue addObject:sub];
        if (view == window || !view.superview || view.hidden) continue;
        NSString *name = NSStringFromClass(view.class) ?: @"";
        CGRect wr = [view.superview convertRect:view.frame toView:window];
        BOOL fullBottom = CGRectGetWidth(wr) >= ww * 0.88 &&
                          CGRectGetMaxY(wr) >= wh - 2.0 &&
                          CGRectGetMinY(wr) >= wh - 180.0;

        /* FLEX in v16 shows this exact UIKit wrapper at {0,873,440,83} on the
           mall page. It is outside AWENormalModeTabBar, so the old subtree
           cleaner could never reach it. Keep its layout/hit-testing, clear only
           its full-width carrier surface. */
        BOOL wrapper = [name containsString:@"_UITabBarContainerWrapperView"] && fullBottom;
        BOOL originalBarCarrier = [name isEqualToString:@"UIView"] && fullBottom &&
                                  view.superview &&
                                  [NSStringFromClass(view.superview.class) containsString:@"AWENormalModeTabBar"];
        BOOL edge = AWEBottomV17IsScrollEdgeEffectView(view) && fullBottom &&
                    AWEBottomPathRelevantForRoute(view, AWEBottomRouteShop);
        if (!wrapper && !originalBarCarrier && !edge) continue;

        view.backgroundColor = UIColor.clearColor;
        view.layer.backgroundColor = UIColor.clearColor.CGColor;
        view.opaque = NO;
        if ([view isKindOfClass:UIVisualEffectView.class]) ((UIVisualEffectView *)view).effect = nil;
        if (edge) {
            view.hidden = YES;
            view.alpha = 0.0;
            view.userInteractionEnabled = NO;
        }
        if (cleared++ < 12) {
            AWEInteractionDiagnosticWrite(@"BOTTOM_V17_SYSTEM_CLEAR reason=%@ class=%@ frame=%@ edge=%d path=%@",
                reason ?: @"", name, NSStringFromCGRect(wr), edge,
                AWEBottomViewPath(view, window));
        }
    }
}

static BOOL AWEBottomV18IsProtectedFloatingGlassNode(UIView *view) {
    if (!view) return YES;
    NSString *name = NSStringFromClass(view.class) ?: @"";
    if ([name containsString:@"Platter"] ||
        [name containsString:@"VisualProvider"] ||
        [name containsString:@"TabButton"] ||
        [name containsString:@"UITabBarButton"] ||
        [name containsString:@"Liquid"] ||
        [name containsString:@"Glass"] ||
        [view.accessibilityIdentifier hasPrefix:@"AwemeLiquidBar"]) return YES;
    return NO;
}

static void AWEBottomV18ClearShopTabBarCarrierTree(UIWindow *window, NSString *reason) {
    if (!window || AWEBottomRouteForWindow(window) != AWEBottomRouteShop) return;
    CGFloat ww = CGRectGetWidth(window.bounds), wh = CGRectGetHeight(window.bounds);
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:window];
    NSUInteger idx = 0, changed = 0;
    while (idx < queue.count && idx < 3200) {
        UIView *view = queue[idx++];
        for (UIView *sub in view.subviews) [queue addObject:sub];
        if (view == window || !view.superview || view.hidden) continue;
        NSString *name = NSStringFromClass(view.class) ?: @"";
        CGRect wr = [view.superview convertRect:view.frame toView:window];
        BOOL bottomBarFrame = CGRectGetWidth(wr) >= ww * 0.90 &&
                              CGRectGetHeight(wr) >= 60.0 &&
                              CGRectGetHeight(wr) <= 100.0 &&
                              CGRectGetMaxY(wr) >= wh - 1.5;
        BOOL carrier = bottomBarFrame &&
                       ([name containsString:@"AWEFakeTabBar"] ||
                        [name containsString:@"AWENormalModeTabBar"] ||
                        [name containsString:@"_UITabBarContainerWrapperView"]);
        if (!carrier) continue;

        UIColor *oldBG = view.backgroundColor;
        BOOL hadBG = oldBG && CGColorGetAlpha(oldBG.CGColor) > 0.01;
        if (hadBG || view.opaque || view.layer.backgroundColor) {
            view.backgroundColor = UIColor.clearColor;
            view.layer.backgroundColor = UIColor.clearColor.CGColor;
            view.opaque = NO;
            changed++;
        }
        if ([view respondsToSelector:NSSelectorFromString(@"setBackgroundImage:")]) {
            ((void(*)(id,SEL,id))objc_msgSend)(view, NSSelectorFromString(@"setBackgroundImage:"), [UIImage new]);
        }
        if ([view respondsToSelector:NSSelectorFromString(@"setShadowImage:")]) {
            ((void(*)(id,SEL,id))objc_msgSend)(view, NSSelectorFromString(@"setShadowImage:"), [UIImage new]);
        }

        /* FLEX shows the stubborn full-width surface as an anonymous UIView
           inside AWENormalModeTabBar/AWEFakeTabBar. Clear only full-size carrier
           descendants; preserve the 398x62 _UITabBarPlatterView subtree. */
        NSMutableArray<UIView *> *inner = [NSMutableArray arrayWithArray:view.subviews];
        NSUInteger j = 0;
        while (j < inner.count && j < 120) {
            UIView *sub = inner[j++];
            if (!sub.superview || AWEBottomV18IsProtectedFloatingGlassNode(sub)) continue;
            for (UIView *child in sub.subviews) [inner addObject:child];
            CGRect local = [sub convertRect:sub.bounds toView:view];
            BOOL full = CGRectGetWidth(local) >= CGRectGetWidth(view.bounds) * 0.90 &&
                        CGRectGetHeight(local) >= CGRectGetHeight(view.bounds) * 0.82 &&
                        CGRectGetMinY(local) <= 8.0 && CGRectGetMaxY(local) >= CGRectGetHeight(view.bounds) - 8.0;
            if (!full || [sub isKindOfClass:UIControl.class]) continue;
            UIColor *bg = sub.backgroundColor;
            BOOL visibleBG = bg && CGColorGetAlpha(bg.CGColor) > 0.01;
            BOOL layerBG = sub.layer.backgroundColor &&
                           CGColorGetAlpha(sub.layer.backgroundColor) > 0.01;
            BOOL effect = [sub isKindOfClass:UIVisualEffectView.class] &&
                          ((UIVisualEffectView *)sub).effect != nil;
            if (!visibleBG && !layerBG && !effect && !sub.opaque) continue;
            sub.backgroundColor = UIColor.clearColor;
            sub.layer.backgroundColor = UIColor.clearColor.CGColor;
            sub.opaque = NO;
            if ([sub isKindOfClass:UIVisualEffectView.class]) {
                ((UIVisualEffectView *)sub).effect = nil;
            }
            if (changed++ < 8) {
                AWEInteractionDiagnosticWrite(@"BOTTOM_V18_TAB_CARRIER_CLEAR reason=%@ class=%@ parent=%@ frame=%@",
                    reason ?: @"", NSStringFromClass(sub.class), name, NSStringFromCGRect(local));
            }
        }
    }
}

static void AWEBottomV18ExtendShopWrapperChain(UIView *adjustedView, UIWindow *window,
                                                NSString *reason) {
    if (!adjustedView || !window || AWEBottomRouteForWindow(window) != AWEBottomRouteShop) return;
    CGFloat wh = CGRectGetHeight(window.bounds);
    NSUInteger level = 0;
    for (UIView *cursor = adjustedView.superview;
         cursor && cursor != window && level < 7;
         cursor = cursor.superview, level++) {
        if (!cursor.superview) break;
        NSString *name = NSStringFromClass(cursor.class) ?: @"";
        if ([name containsString:@"TabBar"] || [name containsString:@"LiquidBar"] ||
            [name containsString:@"Glass"]) break;
        CGRect wr = [cursor.superview convertRect:cursor.frame toView:window];
        CGFloat gap = wh - CGRectGetMaxY(wr);
        BOOL wide = CGRectGetWidth(wr) >= CGRectGetWidth(window.bounds) * 0.86;
        if (wide && gap >= 30.0 && gap <= 135.0) {
            CGRect frame = cursor.frame;
            frame.size.height += gap;
            cursor.frame = frame;
            cursor.clipsToBounds = NO;
            cursor.layer.masksToBounds = NO;
            AWEInteractionDiagnosticWrite(@"BOTTOM_V18_WRAPPER_EXTEND reason=%@ level=%lu class=%@ gap=%.1f frame=%@",
                reason ?: @"", (unsigned long)level, name, gap,
                NSStringFromCGRect([cursor.superview convertRect:cursor.frame toView:window]));
        }
        if ([name containsString:@"IESECMallCoreFeedNode"]) break;
    }
}





static CGFloat AWEBottomV21ShopOldBottomInWindow(UIWindow *window) {
    if (!window) return 0.0;
    CGFloat ww = CGRectGetWidth(window.bounds), wh = CGRectGetHeight(window.bounds);
    CGFloat best = 0.0;
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:window];
    NSUInteger idx = 0;
    while (idx < queue.count && idx < 2200) {
        UIView *v = queue[idx++];
        for (UIView *sub in v.subviews) [queue addObject:sub];
        if (v == window || v.hidden || v.alpha <= 0.01) continue;
        NSString *name = NSStringFromClass(v.class) ?: @"";
        if (![name containsString:@"_UITabBarContainerWrapperView"] &&
            ![name containsString:@"AWENormalModeTabBar"] &&
            ![name containsString:@"AWEFakeTabBar"]) continue;
        CGRect wr = [v convertRect:v.bounds toView:window];
        BOOL full = CGRectGetWidth(wr) >= ww * 0.90 &&
                    CGRectGetHeight(wr) >= 55.0 && CGRectGetHeight(wr) <= 110.0;
        CGFloat y = CGRectGetMinY(wr);
        if (full && y >= wh - 130.0 && y <= wh - 45.0) {
            if (best <= 0.0 || y < best) best = y;
        }
    }
    if (best <= 0.0 && gAWELastTabBar && ((UIView *)gAWELastTabBar).window == window) {
        CGRect wr = [((UIView *)gAWELastTabBar) convertRect:((UIView *)gAWELastTabBar).bounds
                                                    toView:window];
        if (!CGRectIsEmpty(wr)) best = CGRectGetMinY(wr);
    }
    if (best <= 0.0) best = wh - 83.0;
    return best;
}

static void AWEBottomV22ExtendShopClippingAncestors(
    UICollectionView *collection, UIWindow *window, CGFloat oldBottom, NSString *reason);

static void AWEBottomV21ApplyStoredShopFrame(UICollectionView *collection) {
    if (!collection || !collection.window) return;
    AWEBottomRouteKind route = AWEBottomRouteForWindow(collection.window);
    NSDictionary *frameState = objc_getAssociatedObject(collection, &kALB32BottomFrameStateKey);
    if ((route != AWEBottomRouteShop && route != AWEBottomRouteGrid) ||
        (frameState && [frameState[@"route"] integerValue] != route) ||
        !ALB32BottomViewIsVisible(collection, collection.window)) return;
    NSNumber *oldValue = objc_getAssociatedObject(collection, &kAWEBottomV21ShopOldBottomKey);
    if (!oldValue) return;
    UIWindow *window = collection.window;
    CGFloat oldBottom = oldValue.doubleValue;
    CGFloat targetBottom = CGRectGetHeight(window.bounds);
    CGRect wr = [collection convertRect:collection.bounds toView:window];
    CGFloat maxY = CGRectGetMaxY(wr);
    if (fabs(maxY - targetBottom) <= 1.0) {
        AWEBottomV22ExtendShopClippingAncestors(collection, window, oldBottom, @"content.clip.reapply");
        return;
    }

    /* Follow Douyin's legitimate sticky/header geometry. We only intervene
       when native layout puts the feed back on the old tab-bar boundary; we
       never force an old origin/y while the mall is collapsing headers. */
    if (fabs(maxY - oldBottom) > 5.0) return;
    CGFloat extension = targetBottom - maxY;
    if (extension < 1.0 || extension > 150.0) return;

    CGRect desired = collection.frame;
    CGPoint from = [window convertPoint:CGPointMake(CGRectGetMidX(wr), maxY) toView:collection.superview];
    CGPoint to = [window convertPoint:CGPointMake(CGRectGetMidX(wr), targetBottom) toView:collection.superview];
    desired.size.height += to.y - from.y;
    ALB32BottomAssignExtendedFrame(collection, desired, route);
    objc_setAssociatedObject(collection, &kAWEBottomV21DesiredShopFrameKey,
                             [NSValue valueWithCGRect:desired],
                             OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    collection.clipsToBounds = YES;
    collection.layer.masksToBounds = YES;
    AWEBottomV22ExtendShopClippingAncestors(
        collection, window, oldBottom, @"shop.collection.reapply");
    AWEInteractionDiagnosticWrite(@"BOTTOM_V22_SHOP_REAPPLY class=%@ extension=%.1f frame=%@",
        NSStringFromClass(collection.class), extension,
        NSStringFromCGRect([collection convertRect:collection.bounds toView:window]));
}

static void AWEBottomV22ExtendShopClippingAncestors(
    UICollectionView *collection,
    UIWindow *window,
    CGFloat oldBottom,
    NSString *reason) {
    if (!collection || !window) return;
    CGFloat ww = CGRectGetWidth(window.bounds);
    CGFloat targetBottom = CGRectGetHeight(window.bounds);
    AWEBottomRouteKind route = AWEBottomRouteForWindow(window);
    NSUInteger level = 0;

    /*
     v21 made every ancestor clipsToBounds=NO. That exposed the mall's folding
     header/icon grid above its intended sticky boundary. v22 keeps Douyin's
     clipping semantics intact: only ancestors that are actually clipping and
     still end at the old tab-bar boundary are lengthened to the full window
     bottom. The top edge/mask behavior therefore remains native.
    */
    for (UIView *cursor = collection.superview;
         cursor && cursor != window && level < 18;
         cursor = cursor.superview, level++) {
        if (!cursor.superview) break;
        NSString *name = NSStringFromClass(cursor.class) ?: @"";
        if ([name containsString:@"TabBar"] ||
            [name containsString:@"LiquidBar"] ||
            [name containsString:@"Glass"]) break;

        CGRect wr = [cursor convertRect:cursor.bounds toView:window];
        BOOL endsAtOldBottom = fabs(CGRectGetMaxY(wr) - oldBottom) <= 5.0;
        BOOL nearlyFullWidth = CGRectGetWidth(wr) >= ww * 0.82;
        BOOL clips = cursor.clipsToBounds || cursor.layer.masksToBounds;
        if (!endsAtOldBottom || !nearlyFullWidth || !clips) continue;

        CGFloat extension = targetBottom - CGRectGetMaxY(wr);
        if (extension < 1.0 || extension > 150.0) continue;
        CGRect frame = cursor.frame;
        CGPoint from = [window convertPoint:CGPointMake(CGRectGetMidX(wr), CGRectGetMaxY(wr)) toView:cursor.superview];
        CGPoint to = [window convertPoint:CGPointMake(CGRectGetMidX(wr), targetBottom) toView:cursor.superview];
        frame.size.height += to.y - from.y;
        ALB32BottomAssignExtendedFrame(cursor, frame, route);

        static CFTimeInterval lastLog = 0.0;
        CFTimeInterval now = CACurrentMediaTime();
        if (now - lastLog > 0.35) {
            lastLog = now;
            AWEInteractionDiagnosticWrite(
                @"BOTTOM_V22_SHOP_CLIP_EXTEND reason=%@ level=%lu class=%@ extension=%.1f frame=%@ clips=%d",
                reason ?: @"", (unsigned long)level, name, extension,
                NSStringFromCGRect([cursor convertRect:cursor.bounds toView:window]),
                cursor.clipsToBounds);
        }
    }
}

static BOOL AWEBottomV21ShopCollectionCandidate(UICollectionView *collection,
                                                 UIWindow *window,
                                                 CGFloat oldBottom,
                                                 CGFloat *scoreOut) {
    if (scoreOut) *scoreOut = -CGFLOAT_MAX;
    if (!collection || !window || !collection.window || collection.hidden ||
        collection.alpha <= 0.01 || !collection.superview) return NO;
    NSString *className = NSStringFromClass(collection.class) ?: @"";
    NSString *lowerClass = className.lowercaseString;
    /* The Mita horizontal pager is itself a UICollectionView subclass. v21
       bound it as a second "feed", which made the folding header/icons escape
       their sticky region. It is never a product-feed candidate. */
    if ([lowerClass containsString:@"viewpager"] ||
        [lowerClass containsString:@"pagercontainer"] ||
        [lowerClass containsString:@"foldscroll"] ||
        [lowerClass containsString:@"foldcontainer"] ||
        [lowerClass containsString:@"pagecontainer"]) {
        return NO;
    }

    CGRect wr = [collection convertRect:collection.bounds toView:window];
    CGFloat ww = CGRectGetWidth(window.bounds);
    BOOL visible = CGRectIntersectsRect(wr, window.bounds);
    CGFloat gap=window.bounds.size.height-CGRectGetMaxY(wr);
    // The actual native safe-area boundary differs across feed variants.
    BOOL reachesOldBottom = fabs(CGRectGetMaxY(wr) - oldBottom) <= 5.0 ||
        (gap>=0 && gap<=150);
    BOOL wide = CGRectGetWidth(wr) >= ww * 0.82;
    BOOL substantial = CGRectGetHeight(wr) >= 260.0;
    if (!visible || !reachesOldBottom || !wide || !substantial) return NO;

    NSString *path = AWEBottomViewPath(collection, window);
    BOOL mallPath = [path containsString:@"Mall"] || [path containsString:@"Mita"] ||
                    [path containsString:@"AWECNewMall"] || [path containsString:@"IESEC"];
    if (!mallPath) return NO;

    CGFloat verticalOverflow = collection.contentSize.height - CGRectGetHeight(collection.bounds);
    CGFloat horizontalOverflow = collection.contentSize.width - CGRectGetWidth(collection.bounds);
    /* Product masonry feeds are decisively vertical. Reject sideways page
       containers even if their class name changes in a future Douyin build. */
    if (horizontalOverflow > 80.0 &&
        horizontalOverflow > MAX(120.0, verticalOverflow * 0.85)) {
        return NO;
    }
    CGFloat score = CGRectGetWidth(wr) * CGRectGetHeight(wr);
    if (verticalOverflow > 20.0) score += 1000000.0 + MIN(verticalOverflow, 5000.0) * 10.0;
    if (horizontalOverflow > verticalOverflow + 80.0) score -= 500000.0;
    if ([path containsString:@"Feed"] || [path containsString:@"FoldScroll"] ||
        [path containsString:@"PageContainer"]) score += 120000.0;
    if (scoreOut) *scoreOut = score;
    return YES;
}

static BOOL AWEBottomV21BindOneShopCollection(UICollectionView *collection,
                                               UIWindow *window,
                                               CGFloat oldBottom,
                                               NSString *reason) {
    if (!collection || !window) return NO;
    CGRect wr = [collection convertRect:collection.bounds toView:window];
    CGFloat targetBottom = CGRectGetHeight(window.bounds);
    CGFloat extension = targetBottom - CGRectGetMaxY(wr);
    if (extension < 1.0 || extension > 150.0) {
        AWEBottomV21ApplyStoredShopFrame(collection);
        return objc_getAssociatedObject(collection, &kAWEBottomV21DesiredShopFrameKey) != nil;
    }

    oldBottom=CGRectGetMaxY(wr);
    CGRect desired = collection.frame;
    CGPoint from=[window convertPoint:CGPointMake(CGRectGetMidX(wr),oldBottom) toView:collection.superview];
    CGPoint to=[window convertPoint:CGPointMake(CGRectGetMidX(wr),targetBottom) toView:collection.superview];
    desired.size.height += to.y-from.y;
    objc_setAssociatedObject(collection, &kAWEBottomV21DesiredShopFrameKey,
                             [NSValue valueWithCGRect:desired],
                             OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    objc_setAssociatedObject(collection, &kAWEBottomV21ShopOldBottomKey,
                             @(oldBottom), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    AWEBottomV21ApplyStoredShopFrame(collection);
    AWEBottomV22ExtendShopClippingAncestors(collection, window, oldBottom, reason);
    AWEInteractionDiagnosticWrite(
        @"BOTTOM_V22_SHOP_BIND reason=%@ class=%@ oldBottom=%.1f extension=%.1f before=%@ after=%@ inset=%@ adjusted=%.1f",
        reason ?: @"", NSStringFromClass(collection.class), oldBottom, extension,
        NSStringFromCGRect(wr),
        NSStringFromCGRect([collection convertRect:collection.bounds toView:window]),
        NSStringFromUIEdgeInsets(collection.contentInset), collection.adjustedContentInset.bottom);
    return YES;
}

static void AWEBottomV21PrepareShop(UIWindow *window, NSString *reason) {
    if (!window || AWEBottomRouteForWindow(window) != AWEBottomRouteShop) return;
    UIView *routeRoot = ALB32BottomVisibleRouteRoot(window, AWEBottomRouteShop);
    if (!routeRoot) return;
    CGFloat oldBottom = AWEBottomV21ShopOldBottomInWindow(window);
    NSMutableArray<UICollectionView *> *candidates = [NSMutableArray array];
    // Start at the visible mall root. The previous whole-window walk could
    // exhaust its budget in retained video pages before reaching FeedNode.
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:routeRoot];
    NSUInteger idx = 0;
    while (idx < queue.count && idx < 2800) {
        UIView *v = queue[idx++];
        if (v.hidden || v.alpha<.01 || AWEBottomV18IsProtectedFloatingGlassNode(v)) continue;
        CGRect viewport = [v convertRect:v.bounds toView:window];
        if (!CGRectIntersectsRect(viewport, window.bounds)) continue;
        for (UIView *sub in v.subviews) [queue addObject:sub];
        if (![v isKindOfClass:UICollectionView.class]) continue;
        CGFloat score = 0.0;
        if (AWEBottomV21ShopCollectionCandidate((UICollectionView *)v, window,
                                                 oldBottom, &score)) {
            objc_setAssociatedObject(v, &kAWEBottomV21ShopScoreKey, @(score),
                                     OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            [candidates addObject:(UICollectionView *)v];
        }
    }
    [candidates sortUsingComparator:^NSComparisonResult(UICollectionView *a, UICollectionView *b) {
        NSNumber *sa = objc_getAssociatedObject(a, &kAWEBottomV21ShopScoreKey);
        NSNumber *sb = objc_getAssociatedObject(b, &kAWEBottomV21ShopScoreKey);
        if (sa.doubleValue > sb.doubleValue) return NSOrderedAscending;
        if (sa.doubleValue < sb.doubleValue) return NSOrderedDescending;
        return NSOrderedSame;
    }];

    NSUInteger bound = 0;
    /* v22 binds exactly one real vertical product feed. The Mita pager is a
       UICollectionView subclass too, but must remain under Douyin's fold logic. */
    for (UICollectionView *collection in candidates) {
        if (bound >= 1) break;
        if (AWEBottomV21BindOneShopCollection(collection, window, oldBottom, reason)) bound++;
    }
    // Captured MallCore root and its native theme both end at y=873/956.
    // Extend their existing backing surface together with the real feed;
    // clearing the outer white controller would merely expose a black gap.
    CGFloat bottom = CGRectGetHeight(window.bounds);
    for (NSUInteger i = 0; i < idx; i++) {
        UIView *view = queue[i];
        NSString *name = NSStringFromClass(view.class);
        BOOL backing = view == routeRoot || [name isEqualToString:@"IESECMitaRootView"] ||
            [name isEqualToString:@"IESECMitaStackContainer"] ||
            [name isEqualToString:@"IESECMallCoreThemeBackgroundsNode"] ||
            [name isEqualToString:@"IESECMallGradientBackgroundView"];
        if (!backing || !view.superview || view.hidden || view.alpha < 0.01) continue;
        CGRect rect = [view convertRect:view.bounds toView:window];
        CGFloat gap = bottom - CGRectGetMaxY(rect);
        if (CGRectGetWidth(rect) < CGRectGetWidth(window.bounds) * 0.82 ||
            gap < 1.0 || gap > 150.0 || fabs(CGRectGetMaxY(rect) - oldBottom) > 6.0) continue;
        CGRect frame = view.frame;
        CGPoint from = [window convertPoint:CGPointMake(CGRectGetMidX(rect), CGRectGetMaxY(rect)) toView:view.superview];
        CGPoint to = [window convertPoint:CGPointMake(CGRectGetMidX(rect), bottom) toView:view.superview];
        frame.size.height += to.y - from.y;
        ALB32BottomAssignExtendedFrame(view, frame, AWEBottomRouteShop);
    }
    AWEBottomV16ClearShopBottomCovers(window, reason);
    AWEBottomV17ClearShopSystemChrome(window, reason);
    AWEBottomV18ClearShopTabBarCarrierTree(window, reason);
    AWEInteractionDiagnosticWrite(
        @"BOTTOM_V22_SHOP_PASS reason=%@ oldBottom=%.1f bound=%lu candidates=%lu scanned=%lu",
        reason ?: @"", oldBottom, (unsigned long)bound,
        (unsigned long)candidates.count, (unsigned long)idx);
}


static void AWEBottomV22ClearShopNativeBarFast(UIView *nativeBar,
                                                NSString *reason) {
    if (!nativeBar || !nativeBar.window) return;
    AWEBottomRouteKind route=AWEBottomRouteForWindow(nativeBar.window);
    if (route!=AWEBottomRouteShop && route!=AWEBottomRouteGrid &&
        route!=AWEBottomRouteProfile) return;

    UIWindow *window = nativeBar.window;
    NSMutableArray<UIView *> *carriers = [NSMutableArray array];
    for (UIView *cursor = nativeBar;
         cursor && cursor != window;
         cursor = cursor.superview) {
        NSString *name = NSStringFromClass(cursor.class) ?: @"";
        if ([name containsString:@"AWENormalModeTabBar"] ||
            [name containsString:@"AWEFakeTabBar"] ||
            [name containsString:@"_UITabBarContainerView"] ||
            [name containsString:@"_UITabBarContainerWrapperView"]) {
            [carriers addObject:cursor];
        }
    }

    NSUInteger changed = 0;
    for (UIView *carrier in carriers) {
        if (!AWEBottomV18IsProtectedFloatingGlassNode(carrier)) {
            carrier.backgroundColor = UIColor.clearColor;
            carrier.layer.backgroundColor = UIColor.clearColor.CGColor;
            carrier.opaque = NO;
        }

        NSMutableArray<UIView *> *queue =
            [NSMutableArray arrayWithArray:carrier.subviews ?: @[]];
        NSUInteger idx = 0;
        while (idx < queue.count && idx < 140) {
            UIView *sub = queue[idx++];
            if (!sub.superview || [sub isKindOfClass:UIControl.class] ||
                AWEBottomV18IsProtectedFloatingGlassNode(sub)) continue;
            for (UIView *child in sub.subviews) [queue addObject:child];
            CGRect local = [sub convertRect:sub.bounds toView:carrier];
            BOOL full = CGRectGetWidth(local) >= CGRectGetWidth(carrier.bounds) * 0.88 &&
                        CGRectGetHeight(local) >= CGRectGetHeight(carrier.bounds) * 0.78 &&
                        CGRectGetMinY(local) <= 10.0 &&
                        CGRectGetMaxY(local) >= CGRectGetHeight(carrier.bounds) - 10.0;
            if (!full) continue;
            BOOL visibleBG =
                (sub.backgroundColor && CGColorGetAlpha(sub.backgroundColor.CGColor) > 0.01) ||
                (sub.layer.backgroundColor &&
                 CGColorGetAlpha(sub.layer.backgroundColor) > 0.01) ||
                ([sub isKindOfClass:UIVisualEffectView.class] &&
                 ((UIVisualEffectView *)sub).effect != nil) ||
                sub.opaque;
            if (!visibleBG) continue;
            sub.backgroundColor = UIColor.clearColor;
            sub.layer.backgroundColor = UIColor.clearColor.CGColor;
            sub.opaque = NO;
            if ([sub isKindOfClass:UIVisualEffectView.class]) {
                ((UIVisualEffectView *)sub).effect = nil;
            }
            changed++;
        }
    }

    static CFTimeInterval lastLog = 0.0;
    CFTimeInterval now = CACurrentMediaTime();
    if (changed > 0 && now - lastLog > 0.4) {
        lastLog = now;
        AWEInteractionDiagnosticWrite(
            @"BOTTOM_V22_SHOP_CHROME_FAST reason=%@ carriers=%lu changed=%lu",
            reason ?: @"", (unsigned long)carriers.count,
            (unsigned long)changed);
    }
}

static void AWEBottomV22ScheduleShopSettle(UIWindow *window,
                                            NSString *reason) {
    if (!window) return;
    __weak UIWindow *weakWindow = window;
    NSString *base = [reason copy] ?: @"shop";
    NSArray<NSNumber *> *delays = @[@0.02, @0.16, @0.38, @0.78];
    for (NSNumber *delayNumber in delays) {
        NSTimeInterval delay = delayNumber.doubleValue;
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW,
                                     (int64_t)(delay * NSEC_PER_SEC)),
                       dispatch_get_main_queue(), ^{
            UIWindow *strongWindow = weakWindow;
            if (!strongWindow ||
                AWEBottomRouteForWindow(strongWindow) != AWEBottomRouteShop) return;
            UIView *bar = (UIView *)gAWELastTabBar;
            if (bar.window == strongWindow) {
                AWEBottomV22ClearShopNativeBarFast(
                    bar, [NSString stringWithFormat:@"%@+%.2f", base, delay]);
            }
            AWEBottomV21PrepareShop(
                strongWindow,
                [NSString stringWithFormat:@"%@.settle+%.2f", base, delay]);
        });
    }
}

/* Identify the displayed two-column feed by its actual visible cells as
   well as class names. Unknown version-specific controller names must not
   prevent this detector from running at all. Cache only an attached view. */
static BOOL ALB28PrepareGridBottom(UIWindow *window, NSString *reason) {
    if (!window || AWECurrentMainTabIndex()!=0) return NO;
    UIView *routeRoot = ALB32BottomVisibleRouteRoot(window, AWEBottomRouteGrid);
    UICollectionView *cached=ALB29CachedGrid(window);
    if (cached) {
        AWEBottomV21ApplyStoredShopFrame(cached);
        NSNumber *old=objc_getAssociatedObject(cached,&kAWEBottomV21ShopOldBottomKey);
        if (old) AWEBottomV22ExtendShopClippingAncestors(cached,window,old.doubleValue,reason);
        return YES;
    }
    CFTimeInterval now=CACurrentMediaTime();
    NSNumber *last=objc_getAssociatedObject(window,&kALB29GridScanKey);
    if (!routeRoot && last && now-last.doubleValue<.6) return NO;
    objc_setAssociatedObject(window,&kALB29GridScanKey,@(now),OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    CGFloat width=window.bounds.size.width;
    UICollectionView *best=nil; CGFloat bestArea=0;
    NSMutableArray<UIView *> *queue=[NSMutableArray arrayWithObject:routeRoot ?: window];
    for (NSUInteger i=0;i<queue.count && i<900;i++) {
        UIView *v=queue[i];
        if (v.hidden || v.alpha<.01 || AWEBottomV18IsProtectedFloatingGlassNode(v)) continue;
        [queue addObjectsFromArray:v.subviews];
        if (![v isKindOfClass:UICollectionView.class]) continue;
        UICollectionView *collection=(UICollectionView *)v;
        CGRect r=[v convertRect:v.bounds toView:window];
        CGFloat gap=window.bounds.size.height-CGRectGetMaxY(r);
        if (!CGRectIntersectsRect(r,window.bounds) || r.size.width<width*.82 || r.size.height<260 ||
            gap < -5 || gap>150 || collection.contentSize.width>collection.bounds.size.width+40) continue;
        NSArray<UICollectionViewCell *> *cells=collection.visibleCells;
        // The capture identifies AWEDCFeedListViewController before cells are
        // populated. Bind its real collection immediately, rather than leaving
        // the 83-point native gap until two visible columns happen to exist.
        BOOL paired=routeRoot && [collection isDescendantOfView:routeRoot];
        for (NSUInteger a=0;a<cells.count && a<12 && !paired;a++) {
            CGRect left=cells[a].frame;
            if (left.size.width<width*.25 || left.size.width>width*.60 || left.size.height<100) continue;
            for (NSUInteger b=a+1;b<cells.count && b<12;b++) {
                CGRect right=cells[b].frame;
                if (right.size.width<width*.25 || right.size.width>width*.60 || right.size.height<100) continue;
                // Waterfall columns need vertical overlap, not equal top edges.
                CGFloat overlap=MIN(CGRectGetMaxY(left),CGRectGetMaxY(right))-MAX(left.origin.y,right.origin.y);
                if (fabs(CGRectGetMidX(left)-CGRectGetMidX(right))>width*.25 && overlap>40) { paired=YES; break; }
            }
        }
        CGFloat area=r.size.width*r.size.height + (collection.superview == routeRoot ? 1000000.0 : 0.0);
        if (paired && area>bestArea) { best=collection; bestArea=area; }
    }
    if (!best) return NO;
    __weak UICollectionView *weak=best;
    UICollectionView *(^resolve)(void)=^{ return weak; };
    objc_setAssociatedObject(window,&kALB29GridCollectionKey,resolve,OBJC_ASSOCIATION_COPY_NONATOMIC);
    CGRect rect=[best convertRect:best.bounds toView:window];
    AWEBottomV21BindOneShopCollection(best,window,CGRectGetMaxY(rect),reason);
    return YES;
}

// Restore v9's bottom-window coverage, without restoring its unbounded frame
// mutations. Only native thin/full-width backdrop fills are cleared; artwork,
// app content, action targets and every plugin-owned surface are excluded.
static void ALB24ClearNativeBottomBackdrops(UIWindow *window, AWEBottomRouteKind route) {
    if (!window || route==AWEBottomRouteNone || !ALBBottomBarFloating() ||
        AWEAnyVisibleCommentPanelForRightRecovery()) return;
    static CFTimeInterval last=0; static AWEBottomRouteKind previous=AWEBottomRouteNone;
    CFTimeInterval now=CACurrentMediaTime();
    if (route==previous && now-last<.35) return;
    previous=route;last=now;
    CGFloat ww=window.bounds.size.width, wh=window.bounds.size.height;
    NSMutableArray<UIView *> *queue=[NSMutableArray arrayWithObject:window];
    NSUInteger cleared=0;
    for (NSUInteger i=0;i<queue.count && i<960;i++) {
        UIView *v=queue[i];
        if (AWEBottomV18IsProtectedFloatingGlassNode(v)) continue;
        if (v.hidden || v.alpha<.01) continue;
        [queue addObjectsFromArray:v.subviews];
        if (v==window || [v isKindOfClass:UIScrollView.class] || [v isKindOfClass:UIControl.class]) continue;
        if ([v isKindOfClass:UIImageView.class] && ((UIImageView *)v).image) continue;
        CGRect r=[v convertRect:v.bounds toView:window];
        if (r.size.width<ww*.90 || r.size.height<18 || r.size.height>145 ||
            CGRectGetMaxY(r)<wh-3 || CGRectGetMinY(r)<wh-145) continue;
        NSString *name=NSStringFromClass(v.class).lowercaseString;
        BOOL nativeBackgroundAncestor=NO;
        UIView *ancestor=v.superview;
        for (NSUInteger depth=0;ancestor && ancestor!=window && depth<5;depth++,ancestor=ancestor.superview) {
            NSString *owner=NSStringFromClass(ancestor.class).lowercaseString;
            if ([owner containsString:@"barbackground"] || [owner containsString:@"safeareabackground"] ||
                [owner containsString:@"bottombackground"] || [owner containsString:@"awenormalmodetabbar"] ||
                [owner containsString:@"awefaketabbar"] || [owner containsString:@"_uitabbarcontainer"]) {
                nativeBackgroundAncestor=YES; break;
            }
        }
        BOOL backdrop=[name containsString:@"background"] || [name containsString:@"backdrop"] ||
            [name containsString:@"safearea"] || [name containsString:@"tabbar"] ||
            ([v class]==UIView.class && nativeBackgroundAncestor) ||
            ([v isKindOfClass:UIVisualEffectView.class] && nativeBackgroundAncestor);
        if (!backdrop) continue;
        // Do not zero an entire renderer; clear only an identifiable backing fill.
        if (v.backgroundColor && CGColorGetAlpha(v.backgroundColor.CGColor)>.001) {
            v.backgroundColor=UIColor.clearColor; cleared++;
        }
        if (v.layer.backgroundColor && CGColorGetAlpha(v.layer.backgroundColor)>.001)
            v.layer.backgroundColor=UIColor.clearColor.CGColor;
        if (v.opaque) v.opaque=NO;
        if ([v isKindOfClass:UIVisualEffectView.class] &&
            ([name containsString:@"barbackground"] || [name containsString:@"backgroundview"] || nativeBackgroundAncestor) &&
            ((UIVisualEffectView *)v).effect) {
            ((UIVisualEffectView *)v).effect=nil; cleared++;
        }
    }
    if (cleared) AWEAlbumMorphProbeWrite(@"BOTTOM24_BACKDROP route=%@ cleared=%lu",AWEBottomRouteName(route),(unsigned long)cleared);
}

// TEST37: extend only the inner vertical grid under a tab-content cell.
// The sticky outer list and the horizontal pager are coordinate-system owners,
// not extension targets. Equal height and bottom-inset deltas preserve both
// the minimum and maximum content offsets of the inner grid.
@interface ALB37ProfileViewportLease : NSObject
@property(nonatomic,weak) UIView *parent;
@property(nonatomic) CGFloat heightDelta;
@property(nonatomic) CGFloat appliedHeight;
@property(nonatomic) CGFloat appliedBottom;
@property(nonatomic) BOOL applying;
@end
@implementation ALB37ProfileViewportLease
@end
static NSMapTable<UICollectionView *, ALB37ProfileViewportLease *> *gALB37ProfileViewports;
static CGFloat ALB37CompensatedBottomInset(CGFloat current, CGFloat previousApplied,
                                           CGFloat oldDelta, CGFloat newDelta) {
    CGFloat nativeBottom=fabs(current-previousApplied)<0.01 ? current-oldDelta : current;
    return nativeBottom+newDelta;
}
static BOOL ALB37IsInnerProfileGrid(UICollectionView *list) {
    NSString *name=NSStringFromClass(list.class);
    if ([name containsString:@"ProfileStick"] || [name containsString:@"ListKitTabContent"] ||
        !CGAffineTransformIsIdentity(list.transform) ||
        list.pagingEnabled || list.alwaysBounceHorizontal ||
        list.contentSize.width>list.bounds.size.width+2) return NO;
    UICollectionViewLayout *layout=list.collectionViewLayout;
    if ([layout isKindOfClass:UICollectionViewFlowLayout.class] &&
        ((UICollectionViewFlowLayout *)layout).scrollDirection!=UICollectionViewScrollDirectionVertical) return NO;
    // Exactly the first vertical collection inside the pager's container cell.
    for (UIView *cursor=list.superview;cursor && cursor!=list.window;cursor=cursor.superview) {
        if ([NSStringFromClass(cursor.class) containsString:@"AWETabContentItemContainerCell"]) return YES;
        if ([cursor isKindOfClass:UIScrollView.class]) return NO;
    }
    return NO;
}
static void ALB37RestoreProfileViewports(void) {
    for (UICollectionView *list in gALB37ProfileViewports.keyEnumerator) {
        ALB37ProfileViewportLease *lease=[gALB37ProfileViewports objectForKey:list];
        if (lease.applying || list.superview!=lease.parent) continue;
        lease.applying=YES;
        CGRect frame=list.frame;
        UIEdgeInsets inset=list.contentInset;
        BOOL restoreHeight=fabs(list.bounds.size.height-lease.appliedHeight)<0.01;
        BOOL restoreInset=fabs(inset.bottom-lease.appliedBottom)<0.01;
        frame.size.height-=lease.heightDelta;
        inset.bottom-=lease.heightDelta;
        CGPoint offset=list.contentOffset;
        [UIView performWithoutAnimation:^{
            if (restoreHeight) list.frame=frame;
            if (restoreInset) list.contentInset=inset;
            if (!CGPointEqualToPoint(list.contentOffset,offset)) list.contentOffset=offset;
        }];
        lease.applying=NO;
    }
    [gALB37ProfileViewports removeAllObjects];
}
static void ALB37ExtendProfileInnerList(UICollectionView *list) {
    UIWindow *window=list.window;
    if (!window || !ALBBottomBarFloating() || gAWESettingsVisible ||
        !AWEPluginFeaturesEnabled() || AWECurrentMainTabIndex()!=4 ||
        !ALB32BottomViewIsVisible(list,window) || !ALB37IsInnerProfileGrid(list)) return;
    ALB37ProfileViewportLease *lease=[gALB37ProfileViewports objectForKey:list];
    if (lease.applying) return;
    BOOL scrolling=ALB34ProfileScrollChainBusy(list);
    // Follow native header/viewport changes; never replay an old y, width,
    // top inset, content size or sticky-list offset.
    CGFloat oldDelta=lease && list.superview==lease.parent ? lease.heightDelta : 0;
    CGFloat baseHeight=list.bounds.size.height;
    if (oldDelta>0 && fabs(baseHeight-lease.appliedHeight)<0.01) baseHeight-=oldDelta;
    CGRect baseBounds=list.bounds; baseBounds.size.height=baseHeight;
    CGRect visible=[list convertRect:baseBounds toView:window];
    CGFloat gap=CGRectGetMaxY(window.bounds)-CGRectGetMaxY(visible);
    if (baseHeight<window.bounds.size.height*.2 || visible.size.width<window.bounds.size.width*.78 ||
        !isfinite(gap) || gap<0 || gap>145 || baseHeight<=0) return;
    CGFloat scaleY=visible.size.height/baseHeight;
    if (!isfinite(scaleY) || scaleY<=0) return;
    CGFloat delta=gap/scaleY;
    CGFloat bottom=ALB37CompensatedBottomInset(list.contentInset.bottom,
        lease ? lease.appliedBottom : list.contentInset.bottom, oldDelta, delta);
    CGFloat height=baseHeight+delta;
    if (fabs(list.bounds.size.height-height)<0.01 && fabs(list.contentInset.bottom-bottom)<0.01) return;
    if (!gALB37ProfileViewports) gALB37ProfileViewports=[NSMapTable weakToStrongObjectsMapTable];
    if (!lease) { lease=[ALB37ProfileViewportLease new]; [gALB37ProfileViewports setObject:lease forKey:list]; }
    lease.parent=list.superview; lease.applying=YES;
    lease.heightDelta=delta; lease.appliedHeight=height; lease.appliedBottom=bottom;
    CGRect frame=list.frame; frame.size.height=height;
    UIEdgeInsets inset=list.contentInset; inset.bottom=bottom;
    CGPoint offset=list.contentOffset;
    @try {
        [UIView performWithoutAnimation:^{
            // Add reservation before growing, so the intermediate legal scroll
            // range never shrinks. The final range is exactly the native one.
            list.contentInset=inset;
            list.frame=frame;
            if (!scrolling && !CGPointEqualToPoint(list.contentOffset,offset)) list.contentOffset=offset;
        }];
    } @finally { lease.applying=NO; }
}

// Open only full-width clipping ancestors; cell/image clipping stays native.
static NSMapTable<UIView *, NSNumber *> *gALB36ProfileClips;
static BOOL ALB36ProfileClipEligible(CGRect rect, CGSize windowSize) {
    CGFloat width=windowSize.width, height=windowSize.height;
    CGFloat gap=height-CGRectGetMaxY(rect);
    return width>0 && height>0 && isfinite(gap) &&
        rect.size.width>=width*.78 && rect.size.height>=height*.20 &&
        CGRectGetMinX(rect)>=-width*.1 && CGRectGetMaxX(rect)<=width*1.1 &&
        gap>=-3 && gap<=145;
}
static void ALB36RestoreProfileClips(void) {
    ALB37RestoreProfileViewports();
    for (UIView *view in gALB36ProfileClips.keyEnumerator) {
        if (!view.clipsToBounds && [gALB36ProfileClips objectForKey:view].boolValue)
            view.clipsToBounds=YES;
    }
    [gALB36ProfileClips removeAllObjects];
}
static void ALB36OpenProfileClipChain(UIView *view, UIWindow *window) {
    for (UIView *cursor=view;cursor && cursor!=window;cursor=cursor.superview) {
        if (AWEBottomV18IsProtectedFloatingGlassNode(cursor)) break;
        CGRect rect=[cursor convertRect:cursor.bounds toView:window];
        // Only a full-width content viewport ending at the native bottom band.
        // Keep cell/image clipping and horizontal category strips unchanged.
        if (!ALB36ProfileClipEligible(rect,window.bounds.size)) continue;
        if (!gALB36ProfileClips) gALB36ProfileClips=[NSMapTable weakToStrongObjectsMapTable];
        if (![gALB36ProfileClips objectForKey:cursor])
            [gALB36ProfileClips setObject:@(cursor.clipsToBounds) forKey:cursor];
        if (cursor.clipsToBounds) cursor.clipsToBounds=NO;
    }
}
static void ALB36RevealProfileBottom(UIWindow *window) {
    if (!window || !ALBBottomBarFloating()) return;
    NSMutableArray<UIView *> *queue=[NSMutableArray arrayWithObject:window];
    for (NSUInteger i=0;i<queue.count && i<1800;i++) {
        UIView *view=queue[i];
        if (view.hidden || view.alpha<.01 || AWEBottomV18IsProtectedFloatingGlassNode(view)) continue;
        NSString *name=NSStringFromClass(view.class);
        if ([view isKindOfClass:UIScrollView.class] &&
            AWEBottomPathRelevantForRoute(view,AWEBottomRouteProfile) &&
            ALB32BottomViewIsVisible(view,window)) {
            ALB36OpenProfileClipChain(view,window);
            if ([view isKindOfClass:UICollectionView.class])
                ALB37ExtendProfileInnerList((UICollectionView *)view);
        }
        // Thumbnail cells cannot contain another full-screen profile viewport.
        if ([view isKindOfClass:UICollectionViewCell.class] &&
            ![name containsString:@"TabContentItemContainer"] &&
            ![name containsString:@"Profile"]) continue;
        [queue addObjectsFromArray:view.subviews];
    }
}
// TEST43: a newly created sub-tab grid (first entry to Favorites) performs
// its own layout passes while the ListKit pager still has its cell offscreen
// or detached, so the visibility gate rejects them. Sliding the page in moves
// only the pager; the grid's bounds do not change and it is not laid out
// again until a later viewDidAppear rescan (returning from a work). The
// pager's own layout is the moment its page becomes visible: apply the same
// existing clip/extension to the inner grid of each visible container cell.
static const void *kALB43InnerGridKey=&kALB43InnerGridKey;
static UICollectionView *ALB43InnerProfileGrid(UICollectionViewCell *cell) {
    UICollectionView *(^cached)(void)=objc_getAssociatedObject(cell,kALB43InnerGridKey);
    UICollectionView *grid=cached ? cached() : nil;
    if (grid && [grid isDescendantOfView:cell] && ALB37IsInnerProfileGrid(grid)) return grid;
    grid=nil;
    NSMutableArray<UIView *> *queue=[NSMutableArray arrayWithArray:cell.contentView.subviews];
    for (NSUInteger i=0;i<queue.count && i<48;i++) {
        UIView *view=queue[i];
        if ([view isKindOfClass:UICollectionView.class] && ALB37IsInnerProfileGrid((UICollectionView *)view)) {
            grid=(UICollectionView *)view; break;
        }
        // The inner grid is the first vertical list; never search inside another scroll view.
        if (![view isKindOfClass:UIScrollView.class]) [queue addObjectsFromArray:view.subviews];
    }
    if (grid) {
        __weak UICollectionView *weakGrid=grid;
        UICollectionView *(^resolve)(void)=^{ return weakGrid; };
        objc_setAssociatedObject(cell,kALB43InnerGridKey,resolve,OBJC_ASSOCIATION_COPY_NONATOMIC);
    }
    return grid;
}
static void ALB36ProfileViewportDidLayout(UIView *view);
static void ALB43RevealVisibleProfilePages(UICollectionView *pager) {
    if (!pager.window || !ALBBottomBarFloating() || gAWESettingsVisible ||
        !AWEPluginFeaturesEnabled() || AWECurrentMainTabIndex()!=4) return;
    for (UICollectionViewCell *cell in pager.visibleCells) {
        if (![NSStringFromClass(cell.class) containsString:@"AWETabContentItemContainerCell"]) continue;
        UICollectionView *grid=ALB43InnerProfileGrid(cell);
        if (!grid) continue;
        ALB36ProfileViewportDidLayout(grid);
        ALB37ExtendProfileInnerList(grid);
    }
}
static void ALB36ProfileViewportDidLayout(UIView *view) {
    if (!view.window || !ALBBottomBarFloating() || gAWESettingsVisible ||
        !AWEPluginFeaturesEnabled() || AWECurrentMainTabIndex()!=4 ||
        !ALB32BottomViewIsVisible(view,view.window)) return;
    // A recycled Favorites list can appear after viewDidAppear. Check this
    // known viewport's ancestor chain only; no scan/queue/scroll mutation.
    ALB36OpenProfileClipChain(view,view.window);
}

/* 3.3: the 团购 channel's list ended above the bottom bar, so the channel's
   own light background showed behind the bar and no rule could remove it.
   Its list is extended behind the bar the way the mall and favourites are.
   The container reports itself (hook below); no window scan on the feed. */
static __weak UIView *gALB33GrouponContainer;
static BOOL ALB33GrouponRouteVisible(UIWindow *window) {
    UIView *container = gALB33GrouponContainer;
    if (!container || container.window != window || !ALB32BottomViewIsVisible(container, window)) return NO;
    CGRect rect = [container convertRect:container.bounds toView:window];
    return CGRectGetWidth(rect) >= CGRectGetWidth(window.bounds) * 0.9 && fabs(CGRectGetMinX(rect)) < 20.0;
}

/* 3.4: 团购 only. 3.3 used the mall's generic pass, which also released the
   list's bottom inset: the list's own loading footer stayed on screen and
   half of the bottom kept the page colour. Now only the vertical list's
   frame reaches the screen bottom; its insets, scrolling, end and footer
   stay Douyin's (as on the mall and favourites, the last row can rest
   behind the bar). Plain full-width fills in the channel's bottom band are
   made clear. Everything is given back when the plug-in is switched off. */
static char kALB34GrouponFrameKey, kALB34GrouponClearedKey;
// 3.11.3: a list inside another list: when the plug-in last set its frame,
// how many times Douyin put it back right away, and whether it gave up.
static char kALB311GrouponSetAtKey, kALB311GrouponFightsKey, kALB311GrouponContestedKey;
static NSHashTable<UIScrollView *> *ALB34GrouponLists(void) {
    static NSHashTable<UIScrollView *> *lists;
    if (!lists) lists = [NSHashTable weakObjectsHashTable];
    return lists;
}
static NSHashTable<UIView *> *ALB34GrouponFills(void) {
    static NSHashTable<UIView *> *fills;
    if (!fills) fills = [NSHashTable weakObjectsHashTable];
    return fills;
}
static BOOL ALB34ScrollIsVerticalList(UIScrollView *scroll) {
    return !scroll.pagingEnabled &&
        scroll.contentSize.width <= CGRectGetWidth(scroll.bounds) + 1.0;
}
/* Extends one list if its bottom stops short of the screen; YES if written.
   3.11.3: the channel's feed list (AWEGrouponLifeFeedsCollectionView) sits in
   a cell of the channel's outer list (AWEGrouponC2CollectionView) and was
   never extended (3.11.2 诊断: y277-878, 已延长=否; the outer one y150-956):
   with the channel at its top the grey under it showed behind the bar. A
   list inside other lists is measured where it would be with those lists at
   their top (it moves with their content), and only while none of them moves. */
static BOOL ALB34ExtendGrouponScroll(UIScrollView *scroll, UIWindow *window, UIView *container) {
    if (!scroll.window || scroll.tracking || scroll.dragging || scroll.decelerating) return NO;
    if (objc_getAssociatedObject(scroll, &kALB311GrouponContestedKey)) return NO;
    NSValue *ours = objc_getAssociatedObject(scroll, &kALB34GrouponFrameKey);
    if (ours && CGRectEqualToRect(scroll.frame, ours.CGRectValue)) return NO;
    CGFloat wh = CGRectGetHeight(window.bounds), ww = CGRectGetWidth(window.bounds);
    CGRect rect = [scroll convertRect:scroll.bounds toView:window];
    CGFloat scrolled = 0;
    UIScrollView *nearestOuter = nil;
    for (UIView *cursor = scroll.superview; cursor && cursor != container; cursor = cursor.superview) {
        if (![cursor isKindOfClass:UIScrollView.class]) continue;
        UIScrollView *outer = (UIScrollView *)cursor;
        if (outer.tracking || outer.dragging || outer.decelerating) return NO;
        if (!ALB34ScrollIsVerticalList(outer)) continue;
        if (!nearestOuter) nearestOuter = outer;
        scrolled += outer.contentOffset.y + outer.adjustedContentInset.top;
    }
    CFTimeInterval now = CACurrentMediaTime();
    if (nearestOuter && ours) {
        // Put back right after the plug-in set it, twice: the cell pins its
        // list; it is left as Douyin wants it (no layout tug-of-war).
        NSNumber *setAt = objc_getAssociatedObject(scroll, &kALB311GrouponSetAtKey);
        if (setAt && now - setAt.doubleValue < 0.15) {
            NSInteger fights = [objc_getAssociatedObject(scroll, &kALB311GrouponFightsKey) integerValue] + 1;
            objc_setAssociatedObject(scroll, &kALB311GrouponFightsKey, @(fights), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            if (fights >= 2) {
                objc_setAssociatedObject(scroll, &kALB311GrouponContestedKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
                AWEInteractionDiagnosticWrite(@"GROUPON311 contested list=%@", NSStringFromClass(scroll.class));
                return NO;
            }
        }
    }
    CGFloat gap = wh - (CGRectGetMaxY(rect) + scrolled);
    if (gap < 20.0 || gap > 140.0) return NO;
    // A list inside another list covers nothing that starts below it in that
    // list (a footer, another card): only empty room is taken.
    if (nearestOuter) {
        CGFloat bottom = CGRectGetMaxY([scroll convertRect:scroll.bounds toView:nearestOuter]);
        for (UIView *path = scroll; path && path != nearestOuter; path = path.superview) {
            for (UIView *sibling in path.superview.subviews) {
                if (sibling == path || sibling.hidden || sibling.alpha < 0.01 || CGRectIsEmpty(sibling.bounds)) continue;
                if ([NSStringFromClass(sibling.class) containsString:@"Indicator"]) continue;
                CGRect below = [sibling convertRect:sibling.bounds toView:nearestOuter];
                if (CGRectGetMinY(below) >= bottom - 1.0 && CGRectGetMinY(below) < bottom + gap) return NO;
            }
        }
    }
    CGRect frame = scroll.frame;
    frame.size.height += gap;
    CGPoint offset = scroll.contentOffset;
    [CATransaction begin];
    [CATransaction setDisableActions:YES];
    scroll.frame = frame;
    if (!CGPointEqualToPoint(scroll.contentOffset, offset)) scroll.contentOffset = offset;
    [CATransaction commit];
    objc_setAssociatedObject(scroll, &kALB34GrouponFrameKey, [NSValue valueWithCGRect:scroll.frame],
                             OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    if (nearestOuter) objc_setAssociatedObject(scroll, &kALB311GrouponSetAtKey, @(now), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    [ALB34GrouponLists() addObject:scroll];
    // Plain wrappers inside the channel must not clip the new height
    // (never a scroll view: it would draw its scrolled-out content). Measured
    // like the list: with the lists around it at their top.
    for (UIView *cursor = scroll.superview; cursor && cursor != container; cursor = cursor.superview) {
        if ([cursor isKindOfClass:UIScrollView.class] || !cursor.clipsToBounds) continue;
        CGRect wrapper = [cursor convertRect:cursor.bounds toView:window];
        CGFloat wrapperGap = wh - (CGRectGetMaxY(wrapper) + scrolled);
        if (CGRectGetWidth(wrapper) >= ww * 0.78 && wrapperGap > 0.5 && wrapperGap <= 140.0)
            cursor.clipsToBounds = NO;
    }
    return YES;
}
/* 3.11.2: with its list extended, the channel shows a plain white band
   behind its search bar and category row (without the extension it does
   not: user report and the 3.11.1 团购 诊断, "上部底色 UIView y115-203").
   Cleared like the bottom fills (and given back when the plug-in is off),
   so both states look like the unextended one. */
static void ALB34ClearGrouponBand(UIView *container, UIWindow *window) {
    if (!container || container.window != window) return;
    // Only while this channel's own list is extended (the band comes with it).
    BOOL extended = NO;
    for (UIScrollView *list in ALB34GrouponLists().allObjects)
        if ([list isDescendantOfView:container] && objc_getAssociatedObject(list, &kALB34GrouponFrameKey)) { extended = YES; break; }
    if (!extended) return;
    static CFTimeInterval last;
    CFTimeInterval now = CACurrentMediaTime();
    if (now - last < 0.3) return;
    last = now;
    CGFloat ww = CGRectGetWidth(window.bounds), wh = CGRectGetHeight(window.bounds);
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:container];
    for (NSUInteger index = 0; index < queue.count && index < 600; index++) {
        UIView *view = queue[index];
        if (view.hidden || view.alpha < 0.01 || ALBIsOwnedView(view)) continue;
        // Never a card (a list's cells are content).
        if ([view isKindOfClass:UICollectionViewCell.class] || [view isKindOfClass:UITableViewCell.class]) continue;
        [queue addObjectsFromArray:view.subviews];
        if (view == container || view.class != UIView.class) continue;
        UIColor *background = view.backgroundColor;
        CGFloat white = 0, alpha = 0;
        if (!background || ![background getWhite:&white alpha:&alpha] || alpha < 0.9 || white < 0.99) continue;
        CGRect rect = [view convertRect:view.bounds toView:window];
        if (CGRectGetWidth(rect) < ww * 0.9 || CGRectGetMinY(rect) < 60.0 || CGRectGetMinY(rect) > 200.0 ||
            CGRectGetHeight(rect) < 30.0 || CGRectGetHeight(rect) > 140.0 || CGRectGetMaxY(rect) > wh * 0.45) continue;
        if (!objc_getAssociatedObject(view, &kALB34GrouponClearedKey))
            objc_setAssociatedObject(view, &kALB34GrouponClearedKey, background, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        [ALB34GrouponFills() addObject:view];
        view.backgroundColor = UIColor.clearColor;
    }
}
static void ALB34ExtendGrouponList(UIWindow *window, NSString *reason) {
    UIView *container = gALB33GrouponContainer;
    if (!container || container.window != window) return;
    CGFloat ww = CGRectGetWidth(window.bounds), wh = CGRectGetHeight(window.bounds);
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:container];
    NSMutableArray<UIView *> *lists = [NSMutableArray array];
    NSUInteger extended = 0, cleared = 0;
    for (NSUInteger index = 0; index < queue.count && index < 600; index++) {
        UIView *view = queue[index];
        if (view.hidden || view.alpha < 0.01 || ALBIsOwnedView(view)) continue;
        CGRect rect = [view convertRect:view.bounds toView:window];
        BOOL onScreen = CGRectGetMaxX(rect) > 20.0 && CGRectGetMinX(rect) < ww - 20.0;
        if ([view isKindOfClass:UIScrollView.class] && onScreen &&
            CGRectGetWidth(rect) >= ww * 0.9 && CGRectGetHeight(rect) >= wh * 0.4 &&
            ALB34ScrollIsVerticalList((UIScrollView *)view)) {
            if (ALB34ExtendGrouponScroll((UIScrollView *)view, window, container)) extended++;
            [lists addObject:view];
            continue; // a list's cells are content, not the page's bottom band
        }
        // A plain full-width fill of the channel's bottom band: no children,
        // no drawn layer content, no sublayers (never a bar with content).
        BOOL plainFill = view.subviews.count == 0 && !view.layer.contents && view.layer.sublayers.count == 0;
        if (view != container && plainFill && ![view isKindOfClass:UIControl.class] &&
            ![view isKindOfClass:UIImageView.class] && ![view isKindOfClass:UILabel.class] &&
            CGRectGetWidth(rect) >= ww * 0.9 && CGRectGetHeight(rect) >= 12.0 && CGRectGetHeight(rect) <= 145.0 &&
            CGRectGetMinY(rect) >= wh - 150.0 && CGRectGetMaxY(rect) >= wh - 3.0 &&
            view.backgroundColor && CGColorGetAlpha(view.backgroundColor.CGColor) > 0.001) {
            if (!objc_getAssociatedObject(view, &kALB34GrouponClearedKey))
                objc_setAssociatedObject(view, &kALB34GrouponClearedKey, view.backgroundColor,
                                         OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            [ALB34GrouponFills() addObject:view];
            view.backgroundColor = UIColor.clearColor;
            cleared++;
        }
        [queue addObjectsFromArray:view.subviews];
    }
    // 3.11.3: lists inside those lists (the channel's feed in a cell of the
    // outer list). Only lists are looked for in there, never fills; never
    // inside a list found there (its cards) or a sideways list (carousels),
    // and at most five levels down.
    NSMutableArray<UIView *> *inner = [NSMutableArray array];
    NSMutableArray<NSNumber *> *depths = [NSMutableArray array];
    for (UIView *list in lists) for (UIView *subview in list.subviews) { [inner addObject:subview]; [depths addObject:@1]; }
    for (NSUInteger index = 0; index < inner.count && index < 300; index++) {
        UIView *view = inner[index];
        NSInteger depth = depths[index].integerValue;
        if (view.hidden || view.alpha < 0.01 || [view.accessibilityIdentifier hasPrefix:@"AwemeLiquidBar"]) continue;
        if ([view isKindOfClass:UIScrollView.class]) {
            if (!ALB34ScrollIsVerticalList((UIScrollView *)view)) continue;
            CGRect rect = [view convertRect:view.bounds toView:window];
            BOOL onScreen = CGRectGetMaxX(rect) > 20.0 && CGRectGetMinX(rect) < ww - 20.0;
            if (onScreen && CGRectGetWidth(rect) >= ww * 0.9 && CGRectGetHeight(rect) >= wh * 0.4) {
                if (ALB34ExtendGrouponScroll((UIScrollView *)view, window, container)) extended++;
                continue;
            }
        }
        if (depth >= 5) continue;
        for (UIView *subview in view.subviews) { [inner addObject:subview]; [depths addObject:@(depth + 1)]; }
    }
    ALB34ClearGrouponBand(container, window);
    if (extended || cleared)
        AWEInteractionDiagnosticWrite(@"GROUPON34 reason=%@ extended=%lu cleared=%lu",
            reason ?: @"", (unsigned long)extended, (unsigned long)cleared);
}
/* Douyin laid the channel out again: put the known lists back at once. */
static void ALB34ReapplyGrouponLists(UIView *container) {
    UIWindow *window = container.window;
    if (!window || !AWEPluginFeaturesEnabled()) return;
    for (UIScrollView *scroll in ALB34GrouponLists().allObjects)
        if ([scroll isDescendantOfView:container]) ALB34ExtendGrouponScroll(scroll, window, container);
}
/* Plug-in off: Douyin's own frames and fills back. */
static void ALB34RestoreGroupon(void) {
    // Douyin lays its list out again (its own frame) on the next pass.
    for (UIScrollView *scroll in ALB34GrouponLists().allObjects) {
        objc_setAssociatedObject(scroll, &kALB34GrouponFrameKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(scroll, &kALB311GrouponSetAtKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(scroll, &kALB311GrouponFightsKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        [scroll.superview setNeedsLayout];
    }
    [ALB34GrouponLists() removeAllObjects];
    for (UIView *fill in ALB34GrouponFills().allObjects) {
        UIColor *original = objc_getAssociatedObject(fill, &kALB34GrouponClearedKey);
        if (original) fill.backgroundColor = original;
        objc_setAssociatedObject(fill, &kALB34GrouponClearedKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    [ALB34GrouponFills() removeAllObjects];
}

/* 团购频道：外层列表（AWEGrouponC2CollectionView）和里面的信息流（AWEGrouponLifeFeedsCollectionView）都比装它们的视图矮一截
   （抖音给系统底栏留的位置），底栏后面露出页面的浅灰底。两条列表在设高度的那一刻补到父视图的底：横向铺满父视图、底下空出
   20–200、这块空里没有别的东西（纯色的空视图不算）→ 高度补满，下内边距至少补同样多。开关 bottom.grouponFill。 */
static char kALBGrouponFillExtraKey;
static NSUInteger gALBGrouponFillExtends, gALBGrouponFillSkips, gALBGrouponFillInsets;
static NSString *gALBGrouponFillLast;
static CGRect ALBGrouponFillFrame(UIScrollView *list, CGRect frame) {
    if (!AWEPluginFeaturesEnabled() || !ALB5Bool(@"bottom.grouponFill", YES)) return frame;
    UIView *parent = list.superview;
    if (!parent || CGRectIsEmpty(parent.bounds)) return frame;
    CGFloat extra = CGRectGetHeight(parent.bounds) - CGRectGetMaxY(frame);
    if (fabs(CGRectGetMinX(frame)) > 1.0 || fabs(CGRectGetWidth(frame) - CGRectGetWidth(parent.bounds)) > 2.0 ||
        extra < 20.0 || extra > 200.0) return frame;
    for (UIView *sibling in parent.subviews) {
        if (sibling == list || sibling.hidden || sibling.alpha < 0.01 || CGRectIsEmpty(sibling.bounds)) continue;
        if (sibling.class == UIView.class && sibling.subviews.count == 0) continue;
        if (CGRectGetMinY(sibling.frame) >= CGRectGetMaxY(frame) - 1.0 && CGRectGetMinY(sibling.frame) < CGRectGetHeight(parent.bounds)) {
            gALBGrouponFillSkips++;
            gALBGrouponFillLast = [NSString stringWithFormat:@"%@ 下面有 %@，不补", NSStringFromClass(list.class), NSStringFromClass(sibling.class)];
            return frame;
        }
    }
    frame.size.height += extra;
    NSNumber *before = objc_getAssociatedObject(list, &kALBGrouponFillExtraKey);
    if (fabs(before.doubleValue - extra) > 0.5) {
        objc_setAssociatedObject(list, &kALBGrouponFillExtraKey, @(extra), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        gALBGrouponFillLast = [NSString stringWithFormat:@"%@ 高 %.0f → %.0f（父视图 %@ 高 %.0f）", NSStringFromClass(list.class),
            CGRectGetHeight(frame) - extra, CGRectGetHeight(frame), NSStringFromClass(parent.class), CGRectGetHeight(parent.bounds)];
    }
    gALBGrouponFillExtends++;
    return frame;
}
static void ALBGrouponFillInset(UIScrollView *list) {
    CGFloat extra = [objc_getAssociatedObject(list, &kALBGrouponFillExtraKey) doubleValue];
    if (extra < 1.0 || list.adjustedContentInset.bottom >= extra - 0.5) return;   // 系统自动加的底部安全区也算
    UIEdgeInsets inset = list.contentInset;
    inset.bottom = extra;
    list.contentInset = inset;
    gALBGrouponFillInsets++;
}
static void ALBGrouponFillLayout(UIScrollView *list) {
    CGRect want = ALBGrouponFillFrame(list, list.frame);
    if (CGRectEqualToRect(want, list.frame)) return;
    [UIView performWithoutAnimation:^{ list.frame = want; }];
    ALBGrouponFillInset(list);
}
static NSString *ALB47GrouponReport(void) {
    return [NSString stringWithFormat:@"列表补到父视图底 %lu 次（下面有东西不补 %lu 次）、补下内边距 %lu 次；最近 %@",
        (unsigned long)gALBGrouponFillExtends, (unsigned long)gALBGrouponFillSkips, (unsigned long)gALBGrouponFillInsets, gALBGrouponFillLast ?: @"-"];
}

%group ALBGrouponFeedFillGroup
%hook ALBGrouponFeedList
- (void)setFrame:(CGRect)frame {
    %orig(ALBGrouponFillFrame((UIScrollView *)self, frame));
    ALBGrouponFillInset((UIScrollView *)self);
}
- (void)layoutSubviews {
    %orig;
    ALBGrouponFillLayout((UIScrollView *)self);
}
%end
%end

%group ALBGrouponOuterFillGroup
%hook ALBGrouponOuterList
- (void)setFrame:(CGRect)frame {
    %orig(ALBGrouponFillFrame((UIScrollView *)self, frame));
    ALBGrouponFillInset((UIScrollView *)self);
}
- (void)layoutSubviews {
    %orig;
    ALBGrouponFillLayout((UIScrollView *)self);
}
%end
%end

static void AWEExtendRouteContentBehindBottomBar(UIWindow *window, NSString *reason) {
    if (!window || UIApplication.sharedApplication.applicationState != UIApplicationStateActive) return;
    if (!AWEPluginFeaturesEnabled()) {
        ALB32BottomRestoreInactiveFrames(window, AWEBottomRouteNone);
        ALB36RestoreProfileClips();
        ALB34RestoreGroupon();
        return;
    }
    if (gAWESettingsVisible ||
        AWEAnyVisibleCommentPanelForRightRecovery() || AWEShouldSuppressBarForSearch()) return;
    AWEBottomRouteKind route = AWEBottomRouteForWindow(window);
    if (route == AWEBottomRouteNone && ALB33GrouponRouteVisible(window)) route = AWEBottomRouteGroupon;
    if (route != AWEBottomRouteProfile) ALB36RestoreProfileClips();
    ALB32BottomRestoreInactiveFrames(window, route);
    static AWEBottomRouteKind appearanceRoute = (AWEBottomRouteKind)-1;
    if (appearanceRoute != route) {
        appearanceRoute = route;
        if (gAWEAlbumMorphController && gAWEAlbumMorphVisible)
            AWEApplyAlbumMorphResolvedAppearance(window, gAWEAlbumMorphController.currentOriginalIndex);
    }
    if ((route==AWEBottomRouteNone || route==AWEBottomRouteGrid) && ALB28PrepareGridBottom(window,reason))
        route=AWEBottomRouteGrid;
    if (ALBReproIsRecording() && gALB30LastEvaluatedRoute != route) {
        gALB30LastEvaluatedRoute=route;
        ALBReproRecordEvent(@"bottom.route.evaluated", @{@"route":AWEBottomRouteName(route),
            @"reason":reason ?: @"unknown", @"tab":@(AWECurrentMainTabIndex()),
            @"nativeBar":ALB30ReproView((UIView *)gAWELastTabBar)});
    }
    if (route == AWEBottomRouteNone) return;
    ALB24ClearNativeBottomBackdrops(window,route);
    if (route == AWEBottomRouteGroupon) {
        ALB34ExtendGrouponList(window, reason);
        return;
    }
    // Keep the TEST35 no-jump boundary. Profile/Favorites additionally gets
    // the same carrier-only background clear as the other native bottom routes;
    // this changes no scroll/frame geometry.
    if (route == AWEBottomRouteProfile) {
        if (((UIView *)gAWELastTabBar).window==window)
            AWEBottomV22ClearShopNativeBarFast((UIView *)gAWELastTabBar,reason);
        ALB36RevealProfileBottom(window);
        return;
    }
    if (route == AWEBottomRouteGrid) {
        if (((UIView *)gAWELastTabBar).window==window)
            AWEBottomV22ClearShopNativeBarFast((UIView *)gAWELastTabBar,reason);
        return;
    }
    if (route == AWEBottomRouteShop) {
        AWEBottomV21PrepareShop(window, reason);
        if (((UIView *)gAWELastTabBar).window==window)
            AWEBottomV22ClearShopNativeBarFast((UIView *)gAWELastTabBar,reason);
        return;
    }
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:window];
    NSMutableArray<UIView *> *candidates = [NSMutableArray array];
    NSUInteger idx = 0, adjusted = 0, relevant = 0;
    BOOL profileScrollBusy = NO;
    UIView *shopAdjustedView = nil;
    while (idx < queue.count && idx < 3000) {
        UIView *v = queue[idx++];
        for (UIView *sub in v.subviews) [queue addObject:sub];
        if (v == window || !v.superview || !ALB32BottomViewIsVisible(v, window)) continue;
        if (!AWEBottomPathRelevantForRoute(v, route)) continue;
        relevant++;
        [candidates addObject:v];
        if (route == AWEBottomRouteProfile && [v isKindOfClass:UIScrollView.class]) {
            UIScrollView *scroll = (UIScrollView *)v;
            if (ALB34ProfileScrollBusy(scroll.tracking, scroll.dragging, scroll.decelerating,
                                       scroll.panGestureRecognizer.state)) profileScrollBusy = YES;
        }
    }
    // The child list can own the gesture while the sticky parent is idle, or
    // vice versa. Collect first; never resize either half of that relationship
    // while any visible profile scroll is handling the gesture/deceleration.
    for (UIView *v in candidates) {
        if (profileScrollBusy) break;
        if (AWEBottomV15AdjustView(v, window, route, reason)) {
            adjusted++;
            if (route == AWEBottomRouteShop && !shopAdjustedView) shopAdjustedView = v;
        }
    }
    if (route == AWEBottomRouteShop) {
        if (shopAdjustedView) {
            AWEBottomV18ExtendShopWrapperChain(shopAdjustedView, window, reason);
            AWEBottomV16LogShopChainForView(shopAdjustedView, window);
        }
        AWEBottomV16ClearShopBottomCovers(window, reason);
        AWEBottomV17ClearShopSystemChrome(window, reason);
        AWEBottomV18ClearShopTabBarCarrierTree(window, reason);
    }
    static NSString *lastSignature = nil;
    NSString *signature = [NSString stringWithFormat:@"%@|%lu|%lu",
                           AWEBottomRouteName(route),
                           (unsigned long)adjusted, (unsigned long)relevant];
    if (![signature isEqualToString:lastSignature]) {
        lastSignature = [signature copy];
        UIViewController *top = AWETopViewControllerFrom(window.rootViewController);
        AWEInteractionDiagnosticWrite(@"BOTTOM_V17_ROUTE reason=%@ route=%@ adjusted=%lu relevant=%lu scanned=%lu top=%@",
            reason ?: @"", AWEBottomRouteName(route), (unsigned long)adjusted,
            (unsigned long)relevant, (unsigned long)idx,
            top ? NSStringFromClass(object_getClass(top)) : @"nil");
    }
}

static void AWEScheduleBottomWindowRefresh(UIWindow *window, NSString *reason) {
    if (!window || gAWEBottomRefreshScheduled || gAWEBottomApplyingRefresh || gAWESettingsVisible ||
        UIApplication.sharedApplication.applicationState != UIApplicationStateActive) return;
    static CFTimeInterval lastRun = 0.0;
    CFTimeInterval now = CACurrentMediaTime();
    BOOL immediate = [reason containsString:@"appear"];
    if (!immediate && now - lastRun < 0.18) return;
    AWEBottomRouteKind route = AWEBottomRouteForWindow(window);
    CFTimeInterval minimumInterval = (route == AWEBottomRouteShop ||
        (route == AWEBottomRouteNone && ALB33GrouponRouteVisible(window))) ? 0.45 : 0.18;
    if (!immediate && now - lastRun < minimumInterval) return;
    lastRun = now;
    gAWEBottomRefreshScheduled = YES;
    __weak UIWindow *weakWindow = window;
    NSString *why = [reason copy];
    dispatch_async(dispatch_get_main_queue(), ^{
        gAWEBottomRefreshScheduled = NO;
        gAWEBottomApplyingRefresh = YES;
        @try { AWEExtendRouteContentBehindBottomBar(weakWindow, why); }
        @finally { gAWEBottomApplyingRefresh = NO; }
    });
}

static void AWEHideGlobalDownloadMenu(void) {
    if (!gAWEDownloadMenuSlot) return;
    gAWEDownloadMenuSlot.hidden = YES;
    gAWEDownloadMenuSlot.alpha = 0.0;
    gAWEDownloadMenuSourceStack = nil;
}

static BOOL AWEDownloadMenuRouteBlocked(void) {
    if (gAWESettingsVisible) return YES;
    if (AWEAnyVisibleCommentPanelForRightRecovery()) return YES;
    if (AWEShouldSuppressBarForSearch() || AWEImmediateCommerceProductDetailVisible()) return YES;

    BOOL playableFeed = AWECurrentRouteHasPlayableFeedController();
    /* Stale sensitive-controller registrations can survive a completed route
       transition for a short time. Do not let those stale objects suppress the
       download control when a real playable feed is already visible. */
    if (AWEImmediateSensitiveDestinationVisible() && !playableFeed) return YES;

    if (AWEShouldSuppressBarForUserDetailRoute() && !playableFeed) return YES;
    return NO;
}

static void AWELayoutExternalBridgeMenuForStack(UIView *stack) {
    (void)stack;
    /* 1.0.55a: independent download button retired. Download now lives only
       in the stable avatar-base menu, so no feed/right-stack geometry can
       create, move, hide, or resurrect a floating download control. */
    AWEHideGlobalDownloadMenu();
}

static void AWERefreshExternalBridgeMenu(UIView *stack) {
    (void)stack;
    AWEHideGlobalDownloadMenu();
}

static UIImageView *AWEBestProfileAvatarImageView(UIView *root) {
    if (!root) return nil;
    static char alb8NativeAvatarKey;
    NSHashTable<UIImageView *> *cached=objc_getAssociatedObject(root,&alb8NativeAvatarKey);
    UIImageView *bound=cached.anyObject;
    if (bound.image && [bound isDescendantOfView:root] && !ALBIsOwnedView(bound)) return bound;
    NSMutableArray<UIImageView *> *images = [NSMutableArray array];
    AWECollectImageViews(root, images, 0);
    UIImageView *best = nil;
    CGFloat bestScore = -CGFLOAT_MAX;
    for (UIImageView *imageView in images) {
        // Never select the configuration-owned copy as the next native source.
        if (ALBIsOwnedView(imageView)) continue;
        CGRect frame = [imageView convertRect:imageView.bounds toView:root];
        CGFloat width = CGRectGetWidth(frame), height = CGRectGetHeight(frame);
        if (width < 34.0 || height < 34.0 || width > 66.0 || height > 66.0) {
            continue;
        }
        CGFloat score = width * height - fabs(width - height) * 40.0;
        if (imageView.hidden || imageView.alpha < 0.01) score -= 500.0;
        if (score > bestScore) { bestScore = score; best = imageView; }
    }
    if (best) {
        cached=[NSHashTable weakObjectsHashTable]; [cached addObject:best];
        objc_setAssociatedObject(root,&alb8NativeAvatarKey,cached,OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    return best;
}

static void AWEStoreAndClearProfileVisual(UIView *view) {
    if (!view) return;
    if (![objc_getAssociatedObject(view, &kAWEProfileVisualMarkerKey) boolValue]) {
        objc_setAssociatedObject(view, &kAWEProfileVisualMarkerKey, @YES,
                                 OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(view, &kAWEProfileOriginalBackgroundKey,
            view.backgroundColor ?: (id)NSNull.null,
            OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(view, &kAWEProfileOriginalBorderWidthKey,
            @(view.layer.borderWidth), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        UIColor *border = view.layer.borderColor
            ? [UIColor colorWithCGColor:view.layer.borderColor]
            : nil;
        objc_setAssociatedObject(view, &kAWEProfileOriginalBorderColorKey,
            border ?: (id)NSNull.null, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    view.backgroundColor = UIColor.clearColor;
    view.layer.borderWidth = 0.0;
    view.layer.borderColor = UIColor.clearColor.CGColor;
}

static UIView *AWETopLevelDescendantOfStack(UIView *view, UIView *stack) {
    UIView *cursor = view;
    while (cursor && cursor.superview && cursor.superview != stack) {
        cursor = cursor.superview;
    }
    return cursor && cursor.superview == stack ? cursor : nil;
}

static UIAction *AWEAvatarLiveAwemeAction(NSString *title,
                                          NSString *systemImage,
                                          UIView *stack,
                                          void (^handler)(id aweme)) {
    __weak UIView *weakStack = stack;
    return [UIAction actionWithTitle:title
        image:[UIImage systemImageNamed:systemImage]
        identifier:nil
        handler:^(__kindof UIAction * _Nonnull action) {
            (void)action;
            UIView *currentStack = weakStack;
            id aweme = AWECurrentAwemeModelForStack(currentStack);
            if (!aweme) {
                AWEShowDownloadToast(@"未识别到当前作品，请稍后重试");
                AWEInteractionDiagnosticWrite(@"AVATAR_MENU_DOWNLOAD model=nil title=%@",
                                              title ?: @"");
                return;
            }
            AWEInteractionDiagnosticWrite(@"AVATAR_MENU_DOWNLOAD model=%@ title=%@",
                                          AWEAwemeIdentity(aweme), title ?: @"");
            if (handler) handler(aweme);
        }];
}

#include "ALBAvatarMenuTouch.h"

#pragma mark - 1.0.56c16 clean screen v2 (display-only, persistent across reuse)

static void AWEStableCleanSuppressView(UIView *view, BOOL disableInteraction) {
    if (!view) return;
    if (![objc_getAssociatedObject(view, &kAWEStableCleanMarkerKey) boolValue]) {
        objc_setAssociatedObject(view, &kAWEStableCleanMarkerKey, @YES,
                                 OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(view, &kAWEStableCleanOriginalOpacityKey,
                                 @(view.layer.opacity),
                                 OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(view, &kAWEStableCleanOriginalInteractionKey,
                                 @(view.userInteractionEnabled),
                                 OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        if (!gAWEStableCleanSuppressedViews) {
            gAWEStableCleanSuppressedViews = [NSHashTable weakObjectsHashTable];
        }
        [gAWEStableCleanSuppressedViews addObject:view];
    }
    view.layer.opacity = 0.0f;
    if (disableInteraction) view.userInteractionEnabled = NO;
}

static void AWEStableCleanRestoreView(UIView *view) {
    if (!view || ![objc_getAssociatedObject(view, &kAWEStableCleanMarkerKey) boolValue]) return;
    NSNumber *opacity = objc_getAssociatedObject(view, &kAWEStableCleanOriginalOpacityKey);
    NSNumber *interaction = objc_getAssociatedObject(view, &kAWEStableCleanOriginalInteractionKey);
    if (opacity) view.layer.opacity = opacity.floatValue;
    if (interaction) view.userInteractionEnabled = interaction.boolValue;
    objc_setAssociatedObject(view, &kAWEStableCleanMarkerKey, nil, OBJC_ASSOCIATION_ASSIGN);
    objc_setAssociatedObject(view, &kAWEStableCleanOriginalOpacityKey, nil, OBJC_ASSOCIATION_ASSIGN);
    objc_setAssociatedObject(view, &kAWEStableCleanOriginalInteractionKey, nil, OBJC_ASSOCIATION_ASSIGN);
}

static void AWEStableCleanRestoreAll(void) {
    NSArray<UIView *> *views = gAWEStableCleanSuppressedViews.allObjects ?: @[];
    for (UIView *view in views) AWEStableCleanRestoreView(view);
    [gAWEStableCleanSuppressedViews removeAllObjects];
}

static BOOL AWEStableCleanClassLooksLikeSystemMenu(UIView *view) {
    NSString *lower = NSStringFromClass(view.class).lowercaseString;
    return [lower containsString:@"contextmenu"] ||
           [lower containsString:@"menuplatter"] ||
           [lower containsString:@"menulist"] ||
           [lower containsString:@"calloutbar"];
}

static BOOL AWEStableCleanClassIsExplicitTarget(UIView *view) {
    if (!view) return NO;
    /* Runtime builds frequently insert private subclasses around these views.
       Comparing NSStringFromClass() alone misses an already-visible CURRENT
       cell even though the next reused cell later hits the base-class hook.
       Cache the real Class objects and accept subclasses via isKindOfClass:. */
    static NSSet<NSString *> *exactNames = nil;
    static NSArray<Class> *targetClasses = nil;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        NSArray<NSString *> *names = @[
            @"AWEHPTopBarCTAContainer", @"AWEHPDiscoverFeedEntranceView",
            @"AWELeftSideBarEntranceView", @"DUXBadge", @"AWEBaseElementView",
            @"AWEPlayInteractionDescriptionLabel", @"AWEUserNameLabel",
            @"ACCEditTagStickerView", @"AWEFeedTemplateAnchorView",
            @"AWESearchFeedTagView", @"AWEPlayInteractionSearchAnchorView",
            @"AFDRecommendToFriendTagView", @"AWELandscapeFeedEntryView",
            @"AWEFeedAnchorContainerView", @"AFDAIbumFolioView",
            @"AFDAlbumFolioView", @"DUXPopover", @"AWEMixVideoPanelMoreView",
            @"AWEHotSearchInnerBottomView", @"AWEHPSegmentControlScrollView",
            @"AWEVideoPlayDanmakuContainerView", @"AWEDanmakuContainerView",
            @"AWEStoryProgressSlideView", @"AWEStoryProgressContainerView",
            @"AWEDemaciaChapterProgressSlider",
            @"AWEPlayInteractionProgressContainerView", @"AWEDPlayerProgressContainerView"
        ];
        exactNames = [NSSet setWithArray:names];
        NSMutableArray<Class> *classes = [NSMutableArray arrayWithCapacity:names.count];
        for (NSString *name in names) {
            Class cls = NSClassFromString(name);
            if (cls) [classes addObject:cls];
        }
        targetClasses = [classes copy];
    });
    if ([exactNames containsObject:NSStringFromClass(view.class)]) return YES;
    for (Class cls in targetClasses) {
        if ([view isKindOfClass:cls]) return YES;
    }
    return NO;
}

static BOOL AWEStableCleanViewIsInsideCommentUI(UIView *view) {
    if (!view) return NO;
    UIResponder *responder = view;
    for (NSUInteger depth = 0; responder && depth < 32; depth++) {
        if ([responder isKindOfClass:UIViewController.class]) {
            NSString *lower = NSStringFromClass(((UIViewController *)responder).class).lowercaseString;
            if ([lower containsString:@"comment"]) return YES;
        }
        responder = responder.nextResponder;
    }
    for (UIView *ancestor = view; ancestor; ancestor = ancestor.superview) {
        NSString *lower = NSStringFromClass(ancestor.class).lowercaseString;
        if ([lower containsString:@"comment"] &&
            ([lower containsString:@"panel"] || [lower containsString:@"container"] ||
             [lower containsString:@"list"] || [lower containsString:@"input"])) {
            return YES;
        }
    }
    return NO;
}

static BOOL AWEStableCleanShouldSuppressElementStack(UIView *stack) {
    return gAWEStableCleanScreenEnabled && stack &&
           !AWEStableCleanViewIsInsideCommentUI(stack);
}

static void AWEStableCleanSuppressRightStack(UIView *stack) {
    if (!gAWEStableCleanScreenEnabled || !stack) return;
    AWEHomeProfileGlassView *slot = objc_getAssociatedObject(stack, &kAWEProfileGlassSlotKey);
    UIButton *menuButton = slot.menuButton;
    if (menuButton) {
        AWERefreshAvatarMenuIfNeeded(slot, stack, slot.profileHost);
        ALBReleaseArtwork(menuButton);
        menuButton = ALBPlaceCleanMenu(menuButton, stack, slot.frame)
            ? gALBCleanMenuHost.button : nil;
    }
    if (menuButton) {
        if (menuButton.configuration) menuButton.configuration = nil;
        [menuButton setImage:nil forState:UIControlStateNormal];
        [menuButton setBackgroundImage:nil forState:UIControlStateNormal];
        menuButton.backgroundColor = UIColor.clearColor;
        menuButton.layer.borderWidth = 0;
    }
    for (UIView *child in [stack.subviews copy]) {
        if (child == menuButton) continue; /* invisible exit/menu hit target */
        AWEStableCleanSuppressView(child, YES);
    }
    if (menuButton) {
        AWEStableCleanRestoreView(menuButton);
        menuButton.layer.opacity = 1.0f;
        menuButton.userInteractionEnabled = YES;
        menuButton.hidden = NO;
        menuButton.alpha = 1.0;
        AWERefreshAvatarMenuIfNeeded(slot, stack, slot.profileHost);
        // Independent controller-owned region; the scoped ancestor tap gate
        // protects the remembered avatar hit area during clean-screen mode.
    }
}
/* DYYY's stable clear-screen idea is class-targeted, not a global UILabel /
   UIImageView heuristic.  Scan every visible feed hierarchy so the CURRENT
   item is cleared immediately, but stop at comment UI roots to keep the
   comment drawer fully interactive and readable. */
static void AWEStableCleanSuppressExactTargetsInTree(UIView *root,
                                                       NSUInteger depth) {
    if (!gAWEStableCleanScreenEnabled || !root || depth > 28) return;
    if (AWEStableCleanClassLooksLikeSystemMenu(root)) return;
    if (AWEStableCleanViewIsInsideCommentUI(root)) return;

    NSString *className = NSStringFromClass(root.class);
    if ([className isEqualToString:@"AWEElementStackView"]) {
        AWEStableCleanSuppressRightStack(root);
        return;
    }
    if ([className isEqualToString:@"AWEFeedTopBarContainer"] ||
        AWEStableCleanClassIsExplicitTarget(root)) {
        AWEStableCleanSuppressView(root, YES);
        // 3.11.50: our chrome next to it re-checks (it hides while clean).
        if (ALB3TopChromeForContainer(root)) ALB3MirrorTopChrome(root);
        return;
    }
    for (UIView *child in [root.subviews copy]) {
        AWEStableCleanSuppressExactTargetsInTree(child, depth + 1);
    }
}

static char kAWEStableStatusBarClassHookedKey;

static BOOL AWEClassOwnsInstanceSelector(Class cls, SEL selector) {
    if (!cls || !selector) return NO;
    unsigned int count = 0;
    Method *methods = class_copyMethodList(cls, &count);
    BOOL owns = NO;
    for (unsigned int index = 0; index < count; index++) {
        if (method_getName(methods[index]) == selector) { owns = YES; break; }
    }
    free(methods);
    return owns;
}

/* Current Douyin often inserts private hosting/container subclasses above the
   six historical DYYY roots. Install a permanent per-class wrapper on every
   active controller class. The wrapper only changes behavior while our clean
   state is active and otherwise delegates to that class's original IMP. */
/* Returns YES when this call hooked the class (NO: already hooked, or not hookable). */
static BOOL AWEStableEnsureStatusBarHookForClass(Class cls) {
    if (!cls || [objc_getAssociatedObject((id)cls,
            &kAWEStableStatusBarClassHookedKey) boolValue]) return NO;
    SEL selector = @selector(prefersStatusBarHidden);
    Method resolved = class_getInstanceMethod(cls, selector);
    if (!resolved) return NO;
    IMP original = method_getImplementation(resolved);
    const char *types = method_getTypeEncoding(resolved);
    if (!original || !types) return NO;

    BOOL (^replacementBlock)(id) = ^BOOL(id receiver) {
        if (gAWEStableCleanScreenEnabled) return YES;
        return ((BOOL (*)(id, SEL))original)(receiver, selector);
    };
    IMP replacement = imp_implementationWithBlock(replacementBlock);
    if (!replacement) return NO;

    if (AWEClassOwnsInstanceSelector(cls, selector)) {
        Method ownMethod = class_getInstanceMethod(cls, selector);
        method_setImplementation(ownMethod, replacement);
    } else {
        class_addMethod(cls, selector, replacement, types);
    }
    objc_setAssociatedObject((id)cls, &kAWEStableStatusBarClassHookedKey,
        @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    return YES;
}

static void AWEStableCleanSuppressStatusBarViewsInTree(UIView *root,
                                                        NSUInteger depth) {
    if (!gAWEStableCleanScreenEnabled || !root || depth > 16) return;
    NSString *lower = NSStringFromClass(root.class).lowercaseString;
    CGRect screenFrame = [root convertRect:root.bounds toView:nil];
    BOOL nearTop = CGRectGetMinY(screenFrame) < 110.0 &&
                   CGRectGetHeight(screenFrame) <= 110.0;
    if (nearTop && [lower containsString:@"statusbar"]) {
        AWEStableCleanSuppressView(root, NO);
        return;
    }
    for (UIView *child in [root.subviews copy]) {
        AWEStableCleanSuppressStatusBarViewsInTree(child, depth + 1);
    }
}

/* 3.11.50: also follows childViewControllerForStatusBarHidden (the controller
   UIKit actually asks need not be a child), visits each controller once, and
   counts the classes hooked on the way. `request`: also ask for an update. */
static NSUInteger AWEStableCleanRequestStatusBarRefreshController(UIViewController *controller,
                                                                  NSUInteger depth, BOOL request,
                                                                  NSHashTable *seen) {
    if (!controller || depth > 18 || [seen containsObject:controller]) return 0;
    [seen addObject:controller];
    NSUInteger hooked = 0;
    if (gAWEStableCleanScreenEnabled && AWEStableEnsureStatusBarHookForClass(controller.class)) hooked++;
    if (request) [controller setNeedsStatusBarAppearanceUpdate];
    NSMutableArray<UIViewController *> *next = [NSMutableArray array];
    if (controller.presentedViewController) [next addObject:controller.presentedViewController];
    if ([controller isKindOfClass:UINavigationController.class] &&
        ((UINavigationController *)controller).topViewController)
        [next addObject:((UINavigationController *)controller).topViewController];
    if ([controller isKindOfClass:UITabBarController.class] &&
        ((UITabBarController *)controller).selectedViewController)
        [next addObject:((UITabBarController *)controller).selectedViewController];
    UIViewController *asked = nil;
    @try { asked = controller.childViewControllerForStatusBarHidden; } @catch (__unused NSException *exception) { asked = nil; }
    if ([asked isKindOfClass:UIViewController.class]) [next addObject:asked];
    [next addObjectsFromArray:controller.childViewControllers ?: @[]];
    for (UIViewController *child in next)
        hooked += AWEStableCleanRequestStatusBarRefreshController(child, depth + 1, request, seen);
    return hooked;
}

static void AWEStableCleanRequestStatusBarRefreshAll(BOOL request);
static void AWEStableCleanRequestStatusBarRefresh(void) { AWEStableCleanRequestStatusBarRefreshAll(YES); }

static NSUInteger gAWEStableCleanLastWalkHooks = 0;
static NSArray<UIWindow *> *AWEStableCleanSceneWindows(void) {
    UIApplication *app = UIApplication.sharedApplication;
    NSMutableArray<UIWindow *> *windows = [NSMutableArray array];
    if (@available(iOS 13.0, *)) {
        for (UIScene *scene in app.connectedScenes) {
            if (![scene isKindOfClass:UIWindowScene.class]) continue;
            if (scene.activationState != UISceneActivationStateForegroundActive &&
                scene.activationState != UISceneActivationStateForegroundInactive) continue;
            [windows addObjectsFromArray:((UIWindowScene *)scene).windows ?: @[]];
        }
    } else {
        [windows addObjectsFromArray:app.windows ?: @[]];
    }
    return windows;
}

/* 3.11.52（用户：“好像就剩状态栏清不掉”；诊断：进清屏 0.5 秒后状态栏还在，按 childViewControllerForStatusBarHidden 一路问到
   AWEFeedRootViewController，它说要藏、也钩上了，补请求 18 次都没用）。所以真正决定状态栏的不是我们算出来的那一个，或者请求被吞了：
   · UIKit 自己认的那个页面（私有 _effectiveStatusBarHiddenViewController，有才用）也钩上；
   · 请求更新时再直接调一次 UIViewController 自己的 setNeedsStatusBarAppearanceUpdate（抖音的容器若改写了它，绕过去）；
   · 清屏时 UIViewController 本身也钩上（没自己改写的页面都说要藏）；
   · 抖音若不是按页面管状态栏（Info.plist 的 UIViewControllerBasedStatusBarAppearance=NO），改用应用级的藏 / 显，并挡住清屏中别人把它显示回来。 */
static UIViewController *AWEStableCleanUIKitDecider(UIViewController *root) {
    SEL selector = NSSelectorFromString(@"_effectiveStatusBarHiddenViewController");
    if (!root || ![root respondsToSelector:selector]) return nil;
    id decider = nil;
    @try { decider = ((id (*)(id, SEL))objc_msgSend)(root, selector); } @catch (__unused NSException *exception) { decider = nil; }
    return [decider isKindOfClass:UIViewController.class] ? decider : nil;
}
/* 3.11.53：抖音若交换过 UIViewController 的 setNeedsStatusBarAppearanceUpdate（全局换掉，按类取到的就是它的），UIKit 原来的实现会挂在
   交换后的那个名字下。在 UIViewController 的方法里找名字以 …etNeedsStatusBarAppearanceUpdate 结尾、实现在 UIKitCore 里的那个，直接调它。 */
static NSString *gAWEStableCleanSetNeedsSource = nil;
static IMP AWEStableCleanUIKitSetNeedsIMP(void) {
    static IMP imp;
    static BOOL looked;
    if (looked) return imp;
    looked = YES;
    IMP current = class_getMethodImplementation(UIViewController.class, @selector(setNeedsStatusBarAppearanceUpdate));
    Dl_info info;
    BOOL currentInUIKit = current && dladdr((const void *)current, &info) && info.dli_fname && strstr(info.dli_fname, "UIKitCore");
    if (currentInUIKit) { imp = current; gAWEStableCleanSetNeedsSource = @"UIKit 自己的（没被换）"; return imp; }
    unsigned int count = 0;
    Method *methods = class_copyMethodList(UIViewController.class, &count);
    for (unsigned int i = 0; i < count && !imp; i++) {
        NSString *name = NSStringFromSelector(method_getName(methods[i]));
        if (![name hasSuffix:@"etNeedsStatusBarAppearanceUpdate"] || method_getNumberOfArguments(methods[i]) != 2) continue;
        IMP candidate = method_getImplementation(methods[i]);
        if (candidate && dladdr((const void *)candidate, &info) && info.dli_fname && strstr(info.dli_fname, "UIKitCore")) {
            imp = candidate;
            gAWEStableCleanSetNeedsSource = [NSString stringWithFormat:@"被换过，UIKit 的在 %@", name];
        }
    }
    free(methods);
    if (!imp) {
        imp = current;
        const char *image = (current && dladdr((const void *)current, &info) && info.dli_fname) ? strrchr(info.dli_fname, '/') : NULL;
        gAWEStableCleanSetNeedsSource = [NSString stringWithFormat:@"被换过（%s），没找到 UIKit 的", image ? image + 1 : "?"];
    }
    return imp;
}
static void AWEStableCleanBaseSetNeeds(UIViewController *controller) {
    IMP base = AWEStableCleanUIKitSetNeedsIMP();
    if (controller && base) ((void (*)(id, SEL))base)(controller, @selector(setNeedsStatusBarAppearanceUpdate));
}
static BOOL AWEStableCleanControllerBasedStatusBar(void) {
    id value = [NSBundle.mainBundle objectForInfoDictionaryKey:@"UIViewControllerBasedStatusBarAppearance"];
    return value ? [value boolValue] : YES;
}
static NSUInteger gAWEStableCleanAppBarBlocked = 0;
static BOOL gAWEStableCleanAppBarSet = NO, gAWEStableCleanAppBarWasHidden = NO;
static void AWEStableCleanApplyAppStatusBar(BOOL entering) {
    if (AWEStableCleanControllerBasedStatusBar()) return;
    UIApplication *app = UIApplication.sharedApplication;
    if (entering) {
        if (!gAWEStableCleanAppBarSet) { gAWEStableCleanAppBarWasHidden = app.statusBarHidden; gAWEStableCleanAppBarSet = YES; }
        [app setStatusBarHidden:YES withAnimation:UIStatusBarAnimationFade];
    } else if (gAWEStableCleanAppBarSet) {
        gAWEStableCleanAppBarSet = NO;
        [app setStatusBarHidden:gAWEStableCleanAppBarWasHidden withAnimation:UIStatusBarAnimationFade];
    }
}

static void AWEStableCleanRequestStatusBarRefreshAll(BOOL request) {
    NSHashTable *seen = [NSHashTable weakObjectsHashTable];
    NSUInteger hooked = 0;
    if (gAWEStableCleanScreenEnabled && AWEStableEnsureStatusBarHookForClass(UIViewController.class)) hooked++;
    for (UIWindow *window in AWEStableCleanSceneWindows()) {
        if (!window.hidden && window.alpha > 0.01 && window.rootViewController) {
            UIViewController *root = window.rootViewController;
            hooked += AWEStableCleanRequestStatusBarRefreshController(root, 0, request, seen);
            UIViewController *decider = AWEStableCleanUIKitDecider(root);
            if (decider && ![seen containsObject:decider])
                hooked += AWEStableCleanRequestStatusBarRefreshController(decider, 0, request, seen);
            if (request) { AWEStableCleanBaseSetNeeds(root); if (decider) AWEStableCleanBaseSetNeeds(decider); }
        }
    }
    if (request && gAWEStableCleanScreenEnabled) AWEStableCleanApplyAppStatusBar(YES);
    gAWEStableCleanLastWalkHooks = hooked;
}

/* 诊断：每个窗口（类、层级、隐藏、整屏、根页面、它要不要藏、能不能管状态栏、UIKit 自己认的决定者） */
static NSString *AWEStableCleanWindowsReport(void) {
    NSMutableArray<NSString *> *lines = [NSMutableArray array];
    SEL canAffect = NSSelectorFromString(@"_canAffectStatusBarAppearance");
    for (UIWindow *window in AWEStableCleanSceneWindows()) {
        if (lines.count >= 8) break;
        UIViewController *root = window.rootViewController;
        BOOL full = CGRectContainsRect(window.frame, UIScreen.mainScreen.bounds);
        NSString *affect = @"?";
        if ([window respondsToSelector:canAffect]) {
            BOOL value = NO;
            @try { value = ((BOOL (*)(id, SEL))objc_msgSend)(window, canAffect); } @catch (__unused NSException *exception) { value = NO; }
            affect = value ? @"能" : @"不能";
        }
        UIViewController *decider = AWEStableCleanUIKitDecider(root);
        BOOL rootWants = NO, deciderWants = NO;
        @try { rootWants = root.prefersStatusBarHidden; deciderWants = decider.prefersStatusBarHidden; } @catch (__unused NSException *exception) {}
        [lines addObject:[NSString stringWithFormat:@"%@(层%.0f%@%@%@ 根=%@ 要藏=%@ 管状态栏=%@ UIKit认=%@%@)",
            NSStringFromClass(window.class), window.windowLevel, window.hidden ? @" 隐" : @"", window.alpha < 0.01 ? @" 透" : @"",
            full ? @" 整屏" : @"", root ? NSStringFromClass(root.class) : @"无", rootWants ? @"是" : @"否", affect,
            decider ? NSStringFromClass(decider.class) : @"-", decider ? (deciderWants ? @"（要藏）" : @"（不藏）") : @""]];
    }
    AWEStableCleanUIKitSetNeedsIMP();
    return [NSString stringWithFormat:@"按页面管=%@ 应用级藏=%@ 刷新请求=%@ 窗口：%@",
        AWEStableCleanControllerBasedStatusBar() ? @"是" : @"否", UIApplication.sharedApplication.statusBarHidden ? @"是" : @"否",
        gAWEStableCleanSetNeedsSource ?: @"-",
        [lines componentsJoinedByString:@" ｜ "]];
}

static BOOL AWEStableCleanStatusBarShowing(void) {
    UIWindow *window = AWEActiveMainWindow();
    if (@available(iOS 13.0, *)) {
        UIStatusBarManager *manager = window.windowScene.statusBarManager;
        return manager ? !manager.statusBarHidden : NO;
    }
    return NO;
}

/* The controller UIKit asks for the main window's status bar: full-screen
   presentations, then childViewControllerForStatusBarHidden. */
static NSString *AWEStableCleanStatusBarDecider(void) {
    UIViewController *controller = AWEActiveMainWindow().rootViewController;
    NSMutableArray<NSString *> *chain = [NSMutableArray array];
    UIViewController *last = nil;
    for (NSUInteger index = 0; controller && index < 24; index++) {
        last = controller;
        [chain addObject:NSStringFromClass(controller.class)];
        UIViewController *next = nil;
        UIViewController *presented = controller.presentedViewController;
        if (presented && !presented.isBeingDismissed &&
            (presented.modalPresentationStyle == UIModalPresentationFullScreen ||
             presented.modalPresentationCapturesStatusBarAppearance)) next = presented;
        if (!next) {
            @try { next = controller.childViewControllerForStatusBarHidden; } @catch (__unused NSException *exception) { next = nil; }
        }
        if (next == controller) break;
        controller = next;
    }
    if (!last) return @"没有";
    NSArray<NSString *> *tail = chain.count > 3 ? [chain subarrayWithRange:NSMakeRange(chain.count - 3, 3)] : chain;
    BOOL hooked = [objc_getAssociatedObject((id)last.class, &kAWEStableStatusBarClassHookedKey) boolValue];
    BOOL wants = NO;
    @try { wants = last.prefersStatusBarHidden; } @catch (__unused NSException *exception) { wants = NO; }
    return [NSString stringWithFormat:@"%@（它要藏=%@，钩上=%@）", [tail componentsJoinedByString:@" → "],
            wants ? @"是" : @"否", hooked ? @"是" : @"否"];
}

/* 3.11.50: the status bar came back now and then: a controller of a class
   that was not on screen when clean screen started (the next item is an
   album, a live, an ad …) was never hooked. Every reapply pass hooks what is
   new, and asks UIKit again when something was hooked or the bar shows. */
static void AWEStableCleanCheckStatusBar(void) {
    if (!gAWEStableCleanScreenEnabled) return;
    AWEStableCleanRequestStatusBarRefreshAll(NO);
    NSUInteger hooked = gAWEStableCleanLastWalkHooks;
    BOOL showing = AWEStableCleanStatusBarShowing();
    if (!hooked && !showing) return;
    gAWEStableCleanLateHooks += hooked;
    static CFTimeInterval requestedAt;
    CFTimeInterval now = CACurrentMediaTime();
    if (!hooked && now - requestedAt < 0.5) return;
    requestedAt = now;
    gAWEStableCleanStatusRetries++;
    gAWEStableCleanStatusLast = [NSString stringWithFormat:@"新钩 %lu 个类，当时状态栏%@，问的是 %@",
        (unsigned long)hooked, showing ? @"还在" : @"已藏", AWEStableCleanStatusBarDecider()];
    AWEStableCleanRequestStatusBarRefreshAll(YES);
}

/* 3.11.50: the top chrome (ALB3TopChromeView) sits next to Douyin's top bar,
   not inside it, so hiding the top bar never hid it. In place it re-checks
   its visibility only when the top bar lays out or moves, which entering or
   leaving clean screen does not do (lifted, the per-frame sync did it). */
static void AWEStableCleanSyncTopChrome(void) {
    UIView *container = gAWEHomeFeedTopContainer;
    if (container && ALB3TopChromeForContainer(container)) ALB3MirrorTopChrome(container);
}

static NSString *AWEStableCleanTopState(void) {
    UIView *container = gAWEHomeFeedTopContainer;
    UIView *chrome = container ? (UIView *)ALB3TopChromeForContainer(container) : nil;
    if (!chrome) return @"没有";
    BOOL lifted = [chrome.superview.accessibilityIdentifier isEqualToString:@"AwemeLiquidBar.GlassLayer"];
    BOOL hidden = !chrome.window || chrome.hidden || chrome.alpha < 0.01 || chrome.layer.opacity < 0.01f;
    return [NSString stringWithFormat:@"%@（%@）", hidden ? @"藏着" : @"显示", lifted ? @"最上层" : @"原地"];
}

static NSString *AWEStableCleanReport(void) {
    return [NSString stringWithFormat:@"“隐藏状态栏”=%@；现在%@；进过 %lu 次；顶栏 %@；状态栏 %@；"
            @"补藏状态栏 %lu 次，进入后才钩上的类 %lu 个，挡下应用级显示 %lu 次；最近一次补藏：%@；最近一次进入 0.5 秒后：%@",
        ALB5Bool(@"statusBar.hide", NO) ? @"开" : @"关",
        gAWEStableCleanScreenEnabled ? @"在清屏" : @"没清屏", (unsigned long)gAWEStableCleanEnters,
        AWEStableCleanTopState(), AWEStableCleanStatusBarShowing() ? @"显示" : @"藏着",
        (unsigned long)gAWEStableCleanStatusRetries, (unsigned long)gAWEStableCleanLateHooks, (unsigned long)gAWEStableCleanAppBarBlocked,
        gAWEStableCleanStatusLast ?: @"-", gAWEStableCleanAfterEnter ?: @"-"];
}

static void AWEStableRefreshCurrentCleanMenu(void) {
    UIView *stack = gAWEStableCleanScreenStack;
    if (!stack) return;
    AWEHomeProfileGlassView *slot = objc_getAssociatedObject(stack, &kAWEProfileGlassSlotKey);
    if (!slot.menuButton) return;
    objc_setAssociatedObject(slot.menuButton, &kAWEAvatarMenuSignatureKey,
                             nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    AWERefreshAvatarMenuIfNeeded(slot, stack, slot.profileHost);
}

static void AWEStableApplyCleanScreenGlobal(void) {
    if (!gAWEStableCleanScreenEnabled) return;
    UIApplication *app = UIApplication.sharedApplication;
    NSArray<UIWindow *> *windows = nil;
    if (@available(iOS 13.0, *)) {
        NSMutableArray<UIWindow *> *collected = [NSMutableArray array];
        for (UIScene *scene in app.connectedScenes) {
            if (![scene isKindOfClass:UIWindowScene.class]) continue;
            if (scene.activationState != UISceneActivationStateForegroundActive &&
                scene.activationState != UISceneActivationStateForegroundInactive) continue;
            [collected addObjectsFromArray:((UIWindowScene *)scene).windows ?: @[]];
        }
        windows = collected;
    } else {
        windows = app.windows ?: @[];
    }
    for (UIWindow *window in windows) {
        if (!window || window.hidden || window.alpha <= 0.01) continue;
        AWEStableCleanSuppressStatusBarViewsInTree(window, 0);
        if (window.windowLevel != UIWindowLevelNormal) continue;
        if (window == (UIWindow *)gAWEAlbumMorphOverlayWindow ||
            [NSStringFromClass(window.class) containsString:@"AWEAlbumMorphOverlayWindow"]) continue;
        AWEStableCleanSuppressExactTargetsInTree(window, 0);
    }
    AWEStableCleanSyncTopChrome();
    AWEStableCleanEnforceBottomBarSuppression();
}

static void AWEStableCleanEnforceBottomBarSuppression(void) {
    if (!gAWEStableCleanScreenEnabled) return;
    if (gAWELastTabBar) {
        UIView *original = (UIView *)gAWELastTabBar;
        AWEStableCleanSuppressView(original, YES);
    }
    if (gAWEAlbumMorphController) {
        AWEStableCleanSuppressView(gAWEAlbumMorphController.view, YES);
        AWEStableCleanSuppressView(gAWEAlbumMorphController.tabBar, YES);
    }
    if (gAWEAlbumMorphOverlayWindow) {
        AWEStableCleanSuppressView((UIView *)gAWEAlbumMorphOverlayWindow, YES);
    }
}

static void AWEScheduleCleanScreenReapply(NSString *reason) {
    if (!gAWEStableCleanScreenEnabled) return;
    CFTimeInterval now = CACurrentMediaTime();
    if (now - gAWEStableCleanLastReapplyTime < 0.035) return;
    gAWEStableCleanLastReapplyTime = now;
    NSUInteger generation = ++gAWEStableCleanReapplyGeneration;
    AWEStableApplyCleanScreenGlobal();
    AWEStableCleanCheckStatusBar();
    const NSTimeInterval delays[] = {0.055, 0.16, 0.36, 0.8};
    for (NSUInteger i = 0; i < sizeof(delays) / sizeof(delays[0]); i++) {
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW,
            (int64_t)(delays[i] * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            if (!gAWEStableCleanScreenEnabled ||
                generation != gAWEStableCleanReapplyGeneration) return;
            AWEStableApplyCleanScreenGlobal();
            AWEStableCleanCheckStatusBar();
        });
    }
    if (AWEInteractionDiagnosticsEnabled() && reason.length) {
        AWEInteractionDiagnosticWrite(@"CLEAN_V2_REAPPLY reason=%@ gen=%lu",
                                      reason, (unsigned long)generation);
    }
}

static void AWEStableEnterCleanScreenFromStack(UIView *stack) {
    if (ALBReproIsRecording()) ALBReproRecordEvent(@"clean.enter.request", @{
        @"alreadyEnabled":@(gAWEStableCleanScreenEnabled), @"stack":ALB30ReproView(stack)});
    if (gAWEStableCleanScreenEnabled || !stack || !stack.window) return;
    AWEHomeProfileGlassView *slot = objc_getAssociatedObject(stack, &kAWEProfileGlassSlotKey);
    ALB8RememberCleanMenuAnchor(stack, slot.menuButton);
    gAWEStableCleanScreenEnabled = YES;
    gAWEStableCleanScreenStack = stack;
    AWEStableCleanRequestStatusBarRefresh();
    AWEStableRefreshCurrentCleanMenu();
    // Install the independent hit target before clean-screen invalidates the
    // source avatar's native visibility and layout coordinates.
    ALBPlaceCleanMenu(slot.menuButton, stack, slot.frame);
    AWEStableApplyCleanScreenGlobal();
    gAWEStableCleanLastReapplyTime = 0.0; // the enter pass is never throttled away
    AWEScheduleCleanScreenReapply(@"enter");
    gAWEStableCleanEnters++;
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        if (!gAWEStableCleanScreenEnabled) return;
        gAWEStableCleanAfterEnter = [NSString stringWithFormat:@"顶栏 %@，状态栏 %@，问的是 %@；%@",
            AWEStableCleanTopState(), AWEStableCleanStatusBarShowing() ? @"显示" : @"藏着", AWEStableCleanStatusBarDecider(),
            AWEStableCleanWindowsReport()];
    });
    if (ALBReproIsRecording()) ALBReproRecordEvent(@"clean.enter.applied", @{
        @"stack":ALB30ReproView(stack), @"host":ALB30ReproView(gALBCleanMenuHost),
        @"button":ALB30ReproView(gALBCleanMenuHost.button),
        @"region":NSStringFromCGRect(gALBCleanMenuHost.hitRegion)});
    AWEInteractionDiagnosticWrite(@"CLEAN_STABLE enter stack=%@", AWEInteractionObjectSummary(stack));
}

static void AWEStableExitCleanScreen(void) {
    if (ALBReproIsRecording()) ALBReproRecordEvent(@"clean.exit.request", @{
        @"enabled":@(gAWEStableCleanScreenEnabled), @"host":ALB30ReproView(gALBCleanMenuHost)});
    if (!gAWEStableCleanScreenEnabled) return;
    UIView *stack = gAWEStableCleanScreenStack;
    gAWEStableCleanScreenEnabled = NO;
    ++gAWEStableCleanReapplyGeneration;
    ALBRemoveCleanMenuHost();
    AWEStableCleanRestoreAll();
    AWEStableCleanSyncTopChrome(); // in place it shows again only when told
    AWEStableCleanApplyAppStatusBar(NO);
    AWERefreshProfileAvatarGlass(stack);
    AWEStableCleanRequestStatusBarRefresh();
    gAWEStableCleanScreenStack = stack;
    AWEStableRefreshCurrentCleanMenu();
    gAWEStableCleanScreenStack = nil;
    AWEStartBarVisibilityDriver();
    if (ALBReproIsRecording()) ALBReproRecordEvent(@"clean.exit.applied", @{
        @"stack":ALB30ReproView(stack), @"enabled":@(gAWEStableCleanScreenEnabled)});
    AWEInteractionDiagnosticWrite(@"CLEAN_STABLE exit");
}

/* 3.11.45: the save items for a work (avatar menu). 视频：保存视频（最高画质，实况作品是保存实况）；图集：保存当前图片 /
   保存当前实况（当前是实况时）、保存所有图片、保存所有实况（有实况时）、保存所有类型图片（图片＋实况＋视频，有实况或视频时）。 */
static NSArray<UIMenuElement *> *ALBSaveMenuElements(UIView *stack, id model) {
    NSMutableArray<UIMenuElement *> *items = [NSMutableArray array];
    NSUInteger albumCount = model ? AWEAlbumImagesForAweme(model).count : 0;
    if (!model || !albumCount) {
        BOOL live = model && ALBMSMainIsLive(model);
        [items addObject:AWEAvatarLiveAwemeAction(live ? @"保存实况" : @"保存视频", live ? @"livephoto" : @"video", stack,
            ^(id aweme) {
                if (AWEAlbumImagesForAweme(aweme).count) AWEDownloadCurrentImageForAweme(aweme);
                else ALBMSSave(aweme, ALBMSWhatMain, @"头像菜单");
            })];
        return items;
    }
    ALBMSKind current = ALBMSAlbumCurrentKind(model);
    NSUInteger lives = ALBMSAlbumLiveCount(model);
    BOOL mixed = lives > 0;
    for (id image in AWEAlbumImagesForAweme(model)) if (ALBMSAlbumEntry(image).kind == ALBMSKindVideo) { mixed = YES; break; }
    [items addObject:AWEAvatarLiveAwemeAction(@"保存当前图片", @"photo", stack,
        ^(id aweme) { AWEDownloadCurrentImageForAweme(aweme); })];
    if (current == ALBMSKindLive || current == ALBMSKindVideo) {
        [items addObject:AWEAvatarLiveAwemeAction(current == ALBMSKindLive ? @"保存当前实况" : @"保存当前视频",
            current == ALBMSKindLive ? @"livephoto" : @"video", stack,
            ^(id aweme) { ALBMSSave(aweme, ALBMSWhatCurrentLive, @"头像菜单"); })];
    }
    if (albumCount > 1) {
        [items addObject:AWEAvatarLiveAwemeAction(@"保存所有图片", @"photo.on.rectangle.angled", stack,
            ^(id aweme) { AWEDownloadAllImagesForAweme(aweme); })];
        if (lives > 0) {
            [items addObject:AWEAvatarLiveAwemeAction(@"保存所有实况", @"livephoto", stack,
                ^(id aweme) { ALBMSSave(aweme, ALBMSWhatAllLive, @"头像菜单"); })];
        }
        if (mixed) {
            [items addObject:AWEAvatarLiveAwemeAction(@"保存所有类型图片", @"square.stack.3d.down.right", stack,
                ^(id aweme) { ALBMSSave(aweme, ALBMSWhatAllTypes, @"头像菜单"); })];
        }
    }
    return items;
}

static UIMenu *AWEAvatarBaseMenuForStack(UIView *stack, UIView *profileHost) {
    NSMutableArray<UIMenuElement *> *children = [NSMutableArray array];
    __weak UIView *weakProfileHost = profileHost;
    UIAction *profileAction = [UIAction actionWithTitle:@"进入主页"
        image:[UIImage systemImageNamed:@"person.crop.circle"]
        identifier:nil
        handler:^(__kindof UIAction * _Nonnull action) {
            (void)action;
            UIView *target = weakProfileHost;
            BOOL result = AWETriggerQuickMenuDestinationView(target);
            AWEInteractionDiagnosticWrite(@"AVATAR_MENU profile result=%d target=%@",
                                          result, AWEInteractionObjectSummary(target));
        }];
    [children addObject:profileAction];

    __weak UIView *weakCleanStack = stack;
    UIAction *cleanAction = [UIAction actionWithTitle:(gAWEStableCleanScreenEnabled ? @"退出清屏" : @"一键清屏")
        image:[UIImage systemImageNamed:(gAWEStableCleanScreenEnabled ? @"eye" : @"eye.slash")]
        identifier:nil
        handler:^(__kindof UIAction * _Nonnull action) {
            (void)action;
            if (gAWEStableCleanScreenEnabled) {
                AWEStableExitCleanScreen();
            } else {
                UIView *currentStack = weakCleanStack;
                if (currentStack.window) AWEStableEnterCleanScreenFromStack(currentStack);
            }
        }];
    if (ALB5Bool(@"avatar.cleanScreen", YES) || gAWEStableCleanScreenEnabled)
        [children addObject:cleanAction];

    if (AWEAvatarMenuDownloadEnabled()) {
        /* 3.11.45: the save items follow what the current work is at the moment
           the menu opens (an album's current image may be a live photo); videos
           and live photos are saved by ALBMediaSave.h, images
           with the plugin's own downloader (unchanged). */
        __weak UIView *weakSaveStack = stack;
        UIDeferredMenuElement *saves = [UIDeferredMenuElement elementWithUncachedProvider:^(void (^completion)(NSArray<UIMenuElement *> *)) {
            UIView *liveStack = weakSaveStack;
            completion(ALBSaveMenuElements(liveStack, AWECurrentAwemeModelForStack(liveStack)));
        }];
        [children addObject:saves];
        [children addObject:AWEAvatarLiveAwemeAction(
            @"保存音频", @"waveform", stack,
            ^(id aweme) { AWEDownloadAudioForAweme(aweme); })];
        [children addObject:AWEAvatarLiveAwemeAction(
            @"复制完整文案", @"doc.on.doc", stack,
            ^(id aweme) { AWECopyCompleteTextForAweme(aweme); })];
    }
    return [UIMenu menuWithTitle:@"" children:children];
}

static NSString *AWEAvatarMenuSignatureForStack(UIView *stack,
                                                     UIView *profileHost) {
    id model = AWECurrentAwemeModelForStack(stack);
    NSUInteger albumCount = model ? AWEAlbumImagesForAweme(model).count : 0;
    return [NSString stringWithFormat:@"%p|%p|%lu|%d|%d|%d",
        (__bridge void *)profileHost, (__bridge void *)model,
        (unsigned long)albumCount, AWEAvatarMenuDownloadEnabled(),
        gAWEStableCleanScreenEnabled, ALB5Bool(@"avatar.cleanScreen", YES)];
}

/* 3.11.49：“头像展开菜单”关掉时，点头像直接进作者主页（同菜单里的“进入主页”），不弹菜单 */
static char kALBAvatarTapHostKey;
static NSUInteger gALBAvatarTaps;
static NSString *gALBAvatarLast;
@interface ALBAvatarTapTarget : NSObject
+ (instancetype)shared;
- (void)tapped:(UIButton *)button;
@end
@implementation ALBAvatarTapTarget
+ (instancetype)shared { static ALBAvatarTapTarget *t; if (!t) t = [ALBAvatarTapTarget new]; return t; }
- (void)tapped:(UIButton *)button {
    if (ALB5Bool(@"avatar.menu", YES)) return;
    /* 3.11.52（用户：“头像点击进入别人主页……只能点一次，回来再点就不行”）：头像玻璃铺着系统栏按钮表面，触摸是转交来的，
       UIKit 不一定发 TouchUpInside（第一次常常发，之后就不发了）；抖音自己的头像手势不在这颗按钮的上层，看不到这次点按。
       现在抬手时补发（ALBFaceTapOnTouchUp），每次点按都到这里，直接进主页；0.8 秒内重复的只算一次。
       3.11.51 的“0.5 秒后页面没变才进”去掉了（没有别的路会替它进）。 */
    static CFTimeInterval last;
    CFTimeInterval now = CACurrentMediaTime();
    if (now - last < 0.8) return;
    last = now;
    UIView *host = ((ALBWeakRef *)objc_getAssociatedObject(button, &kALBAvatarTapHostKey)).value;
    gALBAvatarTaps++;
    gALBAvatarLast = host ? (AWETriggerQuickMenuDestinationView(host) ? @"送到抖音的头像" : @"头像上没找到能点的") : @"头像已不在";
}
@end

static void AWERefreshAvatarMenuIfNeeded(AWEHomeProfileGlassView *slot,
                                         UIView *stack,
                                         UIView *profileHost) {
    if (!slot.menuButton || !stack || !profileHost) return;
    // 3.11: the avatar glass is the dock's Dark glass; only while its menu
    // is up it takes the light/dark from behind it (ALBRGMenuBegins).
    if (!slot.menuButton.tracking) ALBRGToneStyle(slot.menuButton);
    ALBWeakRef *hostRef = objc_getAssociatedObject(slot.menuButton, &kALBAvatarTapHostKey);
    if (!hostRef) { hostRef = [ALBWeakRef new]; objc_setAssociatedObject(slot.menuButton, &kALBAvatarTapHostKey, hostRef, OBJC_ASSOCIATION_RETAIN_NONATOMIC); }
    hostRef.value = profileHost;
    if (![slot.menuButton.allTargets containsObject:[ALBAvatarTapTarget shared]])
        [slot.menuButton addTarget:[ALBAvatarTapTarget shared] action:@selector(tapped:) forControlEvents:UIControlEventTouchUpInside];
    // 3.11.52：表面转交的触摸抬手时补发 TouchUpInside（菜单开着时 ALBAvatarTapTarget 直接返回，不影响菜单）
    ALBFaceTapOnTouchUp(slot.menuButton);
    if (!ALB5Bool(@"avatar.menu", YES)) {
        if (!slot.menuButton.tracking && (slot.menuButton.menu || slot.menuButton.showsMenuAsPrimaryAction)) {
            slot.menuButton.showsMenuAsPrimaryAction = NO;
            slot.menuButton.menu = nil;
            objc_setAssociatedObject(slot.menuButton, &kAWEAvatarMenuSignatureKey, nil, OBJC_ASSOCIATION_COPY_NONATOMIC);
        }
        return;
    }
    NSString *signature = AWEAvatarMenuSignatureForStack(stack, profileHost);
    NSString *previous = objc_getAssociatedObject(
        slot.menuButton, &kAWEAvatarMenuSignatureKey);
    if (slot.menuButton.menu && [previous isEqualToString:signature]) return;

    if (slot.menuButton.tracking) return;
    slot.menuButton.menu = AWEAvatarBaseMenuForStack(stack, profileHost);
    slot.menuButton.showsMenuAsPrimaryAction = YES;
    objc_setAssociatedObject(slot.menuButton, &kAWEAvatarMenuSignatureKey,
                             signature, OBJC_ASSOCIATION_COPY_NONATOMIC);
    // 3.11.7: a bar item face takes the new menu now, not on the next pass.
    ALBFaceSync(slot.menuButton);
}

static AWEHomeProfileGlassView *AWEEnsureProfileGlassSlot(UIView *stack) {
    if (!stack) return nil;
    AWEHomeProfileGlassView *slot = objc_getAssociatedObject(
        stack, &kAWEProfileGlassSlotKey);
    if (!slot) {
        slot = [[AWEHomeProfileGlassView alloc] initWithFrame:CGRectZero];
        slot.userInteractionEnabled = NO;
        slot.backgroundColor = UIColor.clearColor;
        slot.opaque = NO;
        slot.accessibilityIdentifier = @"AwemeLiquidBar.HomeAction.ProfileGlass";
        UIButton *button = [UIButton buttonWithType:UIButtonTypeCustom];
        button.userInteractionEnabled = NO;
        button.backgroundColor = UIColor.clearColor;
        button.opaque = NO;
        button.clipsToBounds = NO;
        [slot addSubview:button];
        slot.glassButton = button;

        UIButton *menuButton = [ALBArtworkGlassButton buttonWithType:UIButtonTypeCustom];
        menuButton.backgroundColor = UIColor.clearColor;
        menuButton.opaque = NO;
        menuButton.clipsToBounds = NO;
        menuButton.userInteractionEnabled = YES;
        menuButton.showsMenuAsPrimaryAction = YES;
        menuButton.accessibilityLabel = @"头像操作";
        menuButton.accessibilityIdentifier = @"AwemeLiquidBar.HomeAction.ProfileMenu";
        [stack addSubview:menuButton];
        slot.menuButton = menuButton;

        objc_setAssociatedObject(stack, &kAWEProfileGlassSlotKey, slot,
                                 OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        [stack insertSubview:slot atIndex:0];
    } else {
        if (slot.superview != stack) {
            [slot removeFromSuperview];
            [stack insertSubview:slot atIndex:0];
        }
    }
    return slot;
}

static void AWERefreshProfileAvatarGlass(UIView *stack) {
 if(ALB6RightLayoutIsMutating())return;
 if(stack.window && UIApplication.sharedApplication.applicationState!=UIApplicationStateActive)return;
 ALB6BeginRightGeometry(stack);
 @try {
    if (!stack || !stack.window) {
        AWEHomeProfileGlassView *existing = stack ? objc_getAssociatedObject(
            stack, &kAWEProfileGlassSlotKey) : nil;
        existing.hidden = YES;
        existing.menuButton.hidden = YES;
        return;
    }
    if (stack.hidden || stack.alpha < 0.01) {
        /* Preserve the live binding during paging/comment transitions. The
           parent stack already controls actual visibility. */
        return;
    }
    UIView *pictureHost = AWEFindViewByExactRuntimeClass(
        stack, @"AWEPlayInteractionUserProfilePictureView", 0);
    if (!pictureHost) {
        pictureHost = AWEFindViewByExactRuntimeClass(
            stack, @"AWEPlayInteractionUserProfileContainerView", 0);
    }
    UIImageView *avatar = AWEBestProfileAvatarImageView(pictureHost);
    if (!pictureHost || !avatar || !avatar.window) {
        AWEHomeProfileGlassView *existing = objc_getAssociatedObject(
            stack, &kAWEProfileGlassSlotKey);
        if (!existing.profileHost || !existing.profileHost.window) {
            existing.hidden = YES;
            existing.menuButton.hidden = YES;
        }
        return;
    }

    AWEHomeProfileGlassView *slot = AWEEnsureProfileGlassSlot(stack);
    if (!slot) return;
    // 3.11: the avatar's own size plus the ring (the dock's geometry).
    CGFloat nativeAvatarSide = MIN(CGRectGetWidth(avatar.bounds), CGRectGetHeight(avatar.bounds));
    const CGFloat diameter = ALBRGArtworkDiameter(nativeAvatarSide);
    CGPoint center = ALB19RightConvertPoint(avatar,
        CGPointMake(CGRectGetMidX(avatar.bounds), CGRectGetMidY(avatar.bounds)),stack,stack);
    ALB19RightSetBounds(slot,CGRectMake(0.0, 0.0, diameter, diameter));
    ALB19RightSetCenter(slot,center);
    slot.glassButton.frame = slot.bounds;
    slot.profileHost = pictureHost;
    slot.avatarImageView = avatar;
    slot.hidden = NO;
    slot.alpha = 1.0;

    CGFloat avatarHitDiameter = MIN(50.0, MAX(40.0,
        MIN(CGRectGetWidth(avatar.bounds), CGRectGetHeight(avatar.bounds))));
    (void)avatarHitDiameter;
    slot.menuButton.hidden = NO;
    slot.menuButton.alpha = 1.0;
    slot.menuButton.userInteractionEnabled = YES;

    UIView *anchor = AWETopLevelDescendantOfStack(pictureHost, stack);
    if (anchor && anchor != slot) {
        [stack insertSubview:slot belowSubview:anchor];
    }

    AWEStoreAndClearProfileVisual(pictureHost);
    AWEStoreAndClearProfileVisual(avatar.superview);
    AWEStoreAndClearProfileVisual(avatar);
    avatar.layer.cornerRadius = MIN(CGRectGetWidth(avatar.bounds),
                                    CGRectGetHeight(avatar.bounds)) * 0.5;
    avatar.layer.cornerCurve = kCACornerCurveContinuous;
    avatar.clipsToBounds = YES;
    slot.glassButton.hidden = YES;
    if (gAWEStableCleanScreenEnabled) {
        AWEStableCleanSuppressRightStack(stack);
        return;
    }
    ALBPlaceArtworkButton(slot.menuButton, avatar, stack,
        ALB19RightConvertRect(slot,slot.bounds,stack,stack));
    ALBProtectAvatarMenuTouch(slot.menuButton, stack);
    CGFloat artworkSide = MIN(diameter, MAX(1.0, round(nativeAvatarSide)));
    ALBInstallNativeArtwork(slot.menuButton, avatar, artworkSide, diameter, @"right.profile.avatar.native");
    AWERefreshAvatarMenuIfNeeded(slot, stack, pictureHost);

 } @finally { ALB6EndRightGeometry(stack); }
}

static NSMutableDictionary<NSNumber *, AWEHomeActionSlotView *> *
AWEHomeActionSlotsForStack(UIView *stack) {
    NSMutableDictionary *slots = objc_getAssociatedObject(stack,
                                                           &kAWEHomeActionStackSlotsKey);
    if (!slots) {
        slots = [NSMutableDictionary dictionary];
        objc_setAssociatedObject(stack, &kAWEHomeActionStackSlotsKey, slots,
                                 OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    return slots;
}

static AWEHomeActionSlotView *AWEEnsureHomeActionSlot(UIView *stack,
                                                       AWEHomeActionKind kind) {
    if (!stack || kind == AWEHomeActionKindUnknown) return nil;
    NSMutableDictionary *slots = AWEHomeActionSlotsForStack(stack);
    NSNumber *key = @(kind);
    AWEHomeActionSlotView *slot = slots[key];
    if (!slot) {
        slot = [[AWEHomeActionSlotView alloc] initWithFrame:CGRectZero];
        slot.accessibilityIdentifier = [NSString stringWithFormat:
            @"AwemeLiquidBar.HomeActionSlot.%ld", (long)kind];
        /* V3 validated path: this slot is visual-only. Douyin's native
           AWEFeedVideoButton remains the real hit-test/business owner, so
           physical touches and private recognizers are never intercepted. */
        slot.userInteractionEnabled = NO;
        slot.backgroundColor = UIColor.clearColor;
        slot.opaque = NO;

        if (@available(iOS 26.0, *)) {
            UIButton *glassButton = [[ALBRightGlassButton alloc] initWithFrame:CGRectZero];
            glassButton.userInteractionEnabled = NO;
            glassButton.exclusiveTouch = NO;
            glassButton.backgroundColor = UIColor.clearColor;
            glassButton.opaque = NO;
            glassButton.clipsToBounds = NO;
            /* No synthetic TouchUpInside business forwarding here.
               V3 keeps this visual control pass-through and mirrors the real
               owner touch only for native Liquid Glass deformation. */
            [slot addSubview:glassButton];
            slot.systemGlassButton = glassButton;
        }
        slot.actionKind = kind;

        slots[key] = slot;
        [stack addSubview:slot];
    } else if (slot.superview != stack) {
        [slot removeFromSuperview];
        [stack addSubview:slot];
    }
    return slot;
}

static void AWEConfigureHomeActionSlot(AWEHomeActionSlotView *slot,
                                        UIView *button,
                                        UIImageView *source,
                                        AWEHomeActionKind kind,
                                        BOOL selected,
                                        CGPoint center) {
    const CGFloat diameter = ALBRGActionDiameter();
    const CGFloat symbolSize = (kind == AWEHomeActionKindShare) ? 20.0 : 21.0;
    NSString *symbolKey = AWEHomeActionSymbolKey(kind, selected);
    BOOL originalPNG = NO;
    UIImage *symbol = AWEConfiguredRoleImage(
        symbolKey, AWEHomeActionSymbolNames(kind, selected), symbolSize,
        UIImageSymbolWeightSemibold, &originalPNG);
    if (!symbol) {
        AWERestoreRightActionGestureLease(slot, @"symbol-missing");
        slot.hidden = YES;
        slot.systemGlassButton.hidden = YES;
        return;
    }

    if (slot.originalView && slot.originalView != button) {
        AWERestoreRightActionGestureLease(slot, @"owner-changed");
        AWEUnbindPassThroughHomeActionGlass(slot);
        [slot addSubview:slot.systemGlassButton];
    }
    slot.originalView = button;
    slot.sourceImageView = source;
    slot.actionKind = kind;
    ALB19RightSetBounds(slot,CGRectMake(0.0, 0.0, diameter, diameter));
    ALB19RightSetCenter(slot,CGPointMake(center.x, center.y + ALBRGActionOffsetY()));
    slot.hidden = NO;
    slot.alpha = 1.0;
    slot.overrideUserInterfaceStyle = UIUserInterfaceStyleUnspecified;

    /* V3 validated ownership: bookkeeping/visual layer only. The original
       AWEFeedVideoButton underneath receives the untouched physical touch. */
    // Keep an in-flight UIKit tracking sequence alive during feed relayout.
    ALBLayoutRightNativeButton(slot);

    UIColor *foregroundColor = nil;
    if (!originalPNG) {
        AWEConfiguredIconColorMode colorMode = AWEStoredSymbolColorMode(symbolKey);
        if (colorMode != AWEConfiguredIconColorModeAutomatic) {
            foregroundColor = AWEApplyConfiguredIconColorMode(symbolKey, nil);
        } else if (selected && kind == AWEHomeActionKindLike) {
            foregroundColor = UIColor.systemPinkColor;
        } else if (selected && kind == AWEHomeActionKindFavorite) {
            foregroundColor = UIColor.systemYellowColor;
        } else if (AWEHomeTransparentGlassEnabled() && !ALBBarFacesWanted()) {
            // 3.11.11: never with a bar item face: "自动" is the face's own ink
            // there (white on dark glass, black once it turns light). This old
            // switch (gone from the settings, but a value saved by an old
            // version still counts) copies the colour of Douyin's hidden icon;
            // the only way an "自动" icon of the column can be fixed black
            // (user report "自动颜色不生效，一直是黑色"; 诊断 shows it).
            foregroundColor = AWEHomeExplicitForegroundForSource(
                source, button, YES);
        }
    }

    if (@available(iOS 26.0, *)) {
        slot.photosGlassHost.hidden = YES;
        slot.systemGlassButton.hidden = NO;
        AWEConfigureAdaptiveSystemGlassIconButton(
            slot.systemGlassButton,
            symbol,
            symbolKey,
            symbolSize,
            foregroundColor,
            originalPNG,
            AWEHomeTintedGlassEnabled(),
            NO);
        AWERestoreRightActionGestureLease(slot, @"native-button-original-owner");
        slot.systemGlassButton.accessibilityIdentifier = @"AwemeLiquidBar.HomeAction.NativeButton";
        ALBBindNativeAction(slot.systemGlassButton, button, slot.superview, kind);
        ALBLayoutRightNativeButton(slot);
        objc_setAssociatedObject(button, &kAWEHomeActionEmbeddedGlassSlotKey, slot, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        slot.userInteractionEnabled = slot.systemGlassButton.superview == slot;
    } else {
        AWERestoreRightActionGestureLease(slot, @"unsupported-os");
        AWEUnbindPassThroughHomeActionGlass(slot);
        slot.hidden = YES;
    }
}

static void AWEHideAndReleaseHomeActionSlot(AWEHomeActionSlotView *slot) {
    if (!slot) return;
    AWERestoreRightActionGestureLease(slot, @"hide-release");
    if (slot.sourceImageView) AWEUnbindHomeActionSource(slot.sourceImageView);
    if (slot.originalView) {
        objc_setAssociatedObject(slot.originalView,
                                 &kAWEHomeActionOriginalImageViewKey,
                                 nil,
                                 OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    AWEUnbindPassThroughHomeActionGlass(slot);
    slot.originalView = nil;
    slot.sourceImageView = nil;
    slot.userInteractionEnabled = NO;
    slot.hidden = YES;
}

static void AWERefreshHomeActionStack(UIView *stack) {
 if(ALB6RightLayoutIsMutating())return;
 if(stack.window && UIApplication.sharedApplication.applicationState!=UIApplicationStateActive)return;
 ALB6BeginRightGeometry(stack);
 @try {
    if (!AWEPluginFeaturesEnabled()) { ALBRestoreAllNativeArtwork(); return; }
    if (gAWESettingsVisible) return;
    if (!stack || objc_getAssociatedObject(stack, &kAWEHomeActionStackApplyingKey)) return;
    CGRect stackWindow = stack.window
        ? [stack convertRect:stack.bounds toView:stack.window]
        : CGRectZero;
    AWEHomeDiagnosticWrite(NO,
        @"STACK_REFRESH stack=%p class=%@ frame=%@ visible=%d hidden=%d alpha=%.3f",
        stack, NSStringFromClass(stack.class), NSStringFromCGRect(stackWindow),
        AWEHomeViewEffectivelyVisible(stack), stack.hidden, stack.alpha);
    objc_setAssociatedObject(stack, &kAWEHomeActionStackApplyingKey, @YES,
                             OBJC_ASSOCIATION_RETAIN_NONATOMIC);

    NSMutableDictionary<NSNumber *, AWEHomeActionSlotView *> *slots =
        AWEHomeActionSlotsForStack(stack);
    if (!stack.window) {
        if (gAWEDownloadMenuSourceStack == stack) AWEHideGlobalDownloadMenu();
        AWEHomeProfileGlassView *profileSlot = objc_getAssociatedObject(
            stack, &kAWEProfileGlassSlotKey);
        profileSlot.hidden = YES;
        profileSlot.menuButton.hidden = YES;
        ALBReleaseArtwork(profileSlot.menuButton);
        AWEExternalBridgeMenuSlotView *bridgeSlot = objc_getAssociatedObject(
            stack, &kAWEExternalBridgeMenuSlotKey);
        bridgeSlot.hidden = YES;
        [bridgeSlot removeFromSuperview];
        for (AWEHomeActionSlotView *slot in slots.allValues) {
            AWEHideAndReleaseHomeActionSlot(slot);
        }
        ALB32RegisterRightRail(stack);
        objc_setAssociatedObject(stack, &kAWEHomeActionStackApplyingKey, nil,
                                 OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        return;
    }
    if (stack.hidden || stack.alpha < 0.01) {
        if (gAWEDownloadMenuSourceStack == stack) AWEHideGlobalDownloadMenu();
        /* Keep visual slots and source bindings intact. They are children of
           the stack and naturally follow its temporary hidden/offscreen state. */
        AWEExternalBridgeMenuSlotView *bridgeSlot = objc_getAssociatedObject(
            stack, &kAWEExternalBridgeMenuSlotKey);
        bridgeSlot.hidden = YES;
        ALB32RegisterRightRail(stack);
        objc_setAssociatedObject(stack, &kAWEHomeActionStackApplyingKey, nil,
                                 OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        return;
    }

    NSArray<UIView *> *buttons = AWESortedVisibleHomeActionButtons(stack);
    AWEHomeDiagnosticWrite(NO, @"STACK_BUTTONS stack=%p count=%lu",
                           stack, (unsigned long)buttons.count);
    // 3.11.1: the like glass's gap to its label is every icon glass's gap.
    for (UIView *button in buttons) {
        if (AWEHomeActionKindForButton(button, buttons) != AWEHomeActionKindLike) continue;
        UIImageView *likeSource = AWEBestHomeActionImageView(button);
        if (!likeSource.image) break;
        CGPoint likeCenter = ALB19RightConvertPoint(likeSource,
            CGPointMake(CGRectGetMidX(likeSource.bounds), CGRectGetMidY(likeSource.bounds)),stack,stack);
        ALBRGNoteReferenceGap(stack, ALBRGNaturalGap(stack, button, likeCenter, ALBRGActionDiameter()));
        break;
    }
    NSMutableSet<NSNumber *> *seen = [NSMutableSet set];
    for (UIView *button in buttons) {
        AWEHomeActionKind kind = AWEHomeActionKindForButton(button, buttons);
        if (kind == AWEHomeActionKindUnknown || kind > AWEHomeActionKindShare) continue;
        NSNumber *kindKey = @(kind);
        if ([seen containsObject:kindKey]) continue;

        UIImageView *source = AWEBestHomeActionImageView(button);
        if (!source || !source.image) continue;
        BOOL selected = AWEHomeActionIsSelected(button, kind, source);
        CGPoint iconCenter = ALB19RightConvertPoint(source,
            CGPointMake(CGRectGetMidX(source.bounds), CGRectGetMidY(source.bounds)),stack,stack);
        if (!isfinite(iconCenter.x) || !isfinite(iconCenter.y)) continue;

        AWEHomeActionSlotView *slot = AWEEnsureHomeActionSlot(stack, kind);
        if (!slot) continue;
        if (slot.sourceImageView && slot.sourceImageView != source) {
            AWEUnbindHomeActionSource(slot.sourceImageView);
        }
        if (slot.originalView && slot.originalView != button) {
            objc_setAssociatedObject(slot.originalView,
                                     &kAWEHomeActionOriginalImageViewKey,
                                     nil,
                                     OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }

        AWEBindHomeActionSource(button, source);
        AWEConfigureHomeActionSlot(slot, button, source, kind, selected,
            ALBRGActionCenter(stack, button, kind, iconCenter, ALBRGActionDiameter()));
        [stack bringSubviewToFront:slot];
        [seen addObject:kindKey];
    }

    for (NSNumber *key in slots.allKeys) {
        if (![seen containsObject:key]) {
            AWEHomeActionSlotView *slot = slots[key];
            BOOL bindingStillLocal = slot.originalView && slot.sourceImageView &&
                AWEViewIsDescendantOfView(slot.originalView, stack) &&
                slot.sourceImageView.image != nil;
            /* Do not make a one-frame incomplete paging tree permanent. */
            if (!bindingStillLocal) {
                AWEHideAndReleaseHomeActionSlot(slot);
            }
        }
    }
    AWERefreshProfileAvatarGlass(stack);
    AWERefreshExternalBridgeMenu(stack);
    ALB32RegisterRightRail(stack);
    objc_setAssociatedObject(stack, &kAWEHomeActionStackApplyingKey, nil,
                             OBJC_ASSOCIATION_RETAIN_NONATOMIC);

 } @finally { ALB6EndRightGeometry(stack); }
}

static void AWELayoutBoundHomeActionSlots(UIView *stack) {
 if(ALB6RightLayoutIsMutating())return;
 if(stack.window && UIApplication.sharedApplication.applicationState!=UIApplicationStateActive)return;
 ALB6BeginRightGeometry(stack);
 @try {
    if (!stack || !stack.window) return;
    NSMutableDictionary<NSNumber *, AWEHomeActionSlotView *> *slots =
        objc_getAssociatedObject(stack, &kAWEHomeActionStackSlotsKey);
    if (![slots isKindOfClass:NSMutableDictionary.class]) return;
    [CATransaction begin];
    [CATransaction setDisableActions:YES];
    AWEHomeActionSlotView *likeSlot = slots[@(AWEHomeActionKindLike)];
    if (likeSlot.sourceImageView.image && likeSlot.originalView && AWEViewIsDescendantOfView(likeSlot.originalView, stack)) {
        UIImageView *likeSource = likeSlot.sourceImageView;
        CGPoint likeCenter = ALB19RightConvertPoint(likeSource,
            CGPointMake(CGRectGetMidX(likeSource.bounds), CGRectGetMidY(likeSource.bounds)),stack,stack);
        if (isfinite(likeCenter.y))
            ALBRGNoteReferenceGap(stack, ALBRGNaturalGap(stack, likeSlot.originalView, likeCenter, ALBRGActionDiameter()));
    }
    for (AWEHomeActionSlotView *slot in slots.allValues) {
        UIImageView *source = slot.sourceImageView;
        UIView *owner = slot.originalView;
        if (!source || !owner || !source.image ||
            !AWEViewIsDescendantOfView(owner, stack)) continue;
        CGPoint center = ALB19RightConvertPoint(source,
            CGPointMake(CGRectGetMidX(source.bounds), CGRectGetMidY(source.bounds)),stack,stack);
        if (!isfinite(center.x) || !isfinite(center.y)) continue;
        CGFloat diameter = ALBRGActionDiameter();
        CGRect targetBounds = CGRectMake(0.0, 0.0, diameter, diameter);
        center = ALBRGActionCenter(stack, owner, slot.actionKind, center, diameter);
        CGPoint targetCenter = CGPointMake(center.x, center.y + ALBRGActionOffsetY());
        ALB19RightSetBounds(slot,targetBounds);
        ALB19RightSetCenter(slot,targetCenter);
        if (slot.hidden) slot.hidden = NO;
        ALBLayoutRightNativeButton(slot);
        slot.systemGlassButton.hidden = NO;
        owner.userInteractionEnabled = YES;
        BOOL nativeBridgeActive = objc_getAssociatedObject(slot.systemGlassButton, &kALBNativeActionBridgeKey) != nil;
        slot.userInteractionEnabled = nativeBridgeActive && slot.systemGlassButton.superview == slot;
        slot.systemGlassButton.userInteractionEnabled = nativeBridgeActive;
    }
    AWELayoutExternalBridgeMenuForStack(stack);
    [CATransaction commit];

 } @finally { ALB6EndRightGeometry(stack); }
}

static void AWEScheduleHomeActionStackRefresh(UIView *stack) {
    if (!AWEPluginFeaturesEnabled() || !stack) return;
    if ([objc_getAssociatedObject(stack,&kAWEHomeActionStackApplyingKey) boolValue]) return;
    if ([objc_getAssociatedObject(
            stack, &kAWEHomeActionStackRefreshPendingKey) boolValue]) {
        return;
    }
    objc_setAssociatedObject(stack, &kAWEHomeActionStackRefreshPendingKey,
                             @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    NSInteger generation =
        [objc_getAssociatedObject(stack, &kAWEHomeActionStackRetryGenerationKey)
            integerValue] + 1;
    objc_setAssociatedObject(stack, &kAWEHomeActionStackRetryGenerationKey,
                             @(generation), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    NSArray<NSNumber *> *delays = @[@0.0, @0.18, @0.55];
    __weak UIView *weakStack = stack;
    for (NSUInteger index = 0; index < delays.count; index++) {
        NSNumber *delay = delays[index];
        BOOL finalPass = index + 1 == delays.count;
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW,
                                     (int64_t)(delay.doubleValue * NSEC_PER_SEC)),
                       dispatch_get_main_queue(), ^{
            UIView *strongStack = weakStack;
            if (!strongStack) return;
            NSInteger current = [objc_getAssociatedObject(
                strongStack, &kAWEHomeActionStackRetryGenerationKey) integerValue];
            if (current == generation) {
                AWERefreshHomeActionStack(strongStack);
            }
            if (finalPass) {
                objc_setAssociatedObject(strongStack,
                    &kAWEHomeActionStackRefreshPendingKey,
                    nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            }
        });
    }
}

static void AWEScheduleHomeActionRefreshForButton(UIView *button) {
    if (!AWEPluginFeaturesEnabled()) return;
    UIView *stack = AWEHomeActionStackForView(button);
    if (stack) AWEScheduleHomeActionStackRefresh(stack);
}

static UIUserInterfaceStyle AWEGlassInternalInterfaceStyle(
    UIView *glass,
    UIUserInterfaceStyle fallbackStyle) {
    if (!glass) return fallbackStyle;
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithArray:glass.subviews];
    NSInteger dark = 0, light = 0;
    NSUInteger visited = 0;
    while (queue.count > 0 && visited < 120) {
        UIView *view = queue.firstObject;
        [queue removeObjectAtIndex:0];
        visited++;
        for (UIView *child in view.subviews) [queue addObject:child];
        NSString *name = NSStringFromClass(view.class).lowercaseString;
        BOOL materialNode = [name containsString:@"glass"] ||
                            [name containsString:@"liquid"] ||
                            [name containsString:@"backdrop"] ||
                            [name containsString:@"material"] ||
                            [name containsString:@"visualeffect"] ||
                            [name containsString:@"contentview"] ||
                            [name containsString:@"platter"] ||
                            [name containsString:@"lens"];
        if (!materialNode) continue;
        UIUserInterfaceStyle style = view.traitCollection.userInterfaceStyle;
        if (style == UIUserInterfaceStyleDark) dark += 2;
        else if (style == UIUserInterfaceStyleLight) light += 2;

        BOOL valid = NO;
        BOOL colorIsLight = AWEColorPrefersLightForeground(
            view.backgroundColor, view.traitCollection, &valid);
        if (!valid && view.layer.backgroundColor) {
            UIColor *layerColor = [UIColor colorWithCGColor:view.layer.backgroundColor];
            colorIsLight = AWEColorPrefersLightForeground(
                layerColor, view.traitCollection, &valid);
        }
        if (valid) {
            if (colorIsLight) light++;
            else dark++;
        }
    }
    if (dark > light) return UIUserInterfaceStyleDark;
    if (light > dark) return UIUserInterfaceStyleLight;
    UIUserInterfaceStyle own = glass.traitCollection.userInterfaceStyle;
    return own == UIUserInterfaceStyleUnspecified ? fallbackStyle : own;
}

static CGFloat AWEIOS27AverageLumaInPatch(UIImage *image,
                                           CGPoint point,
                                           CGFloat patchPoints) {
    if (!image.CGImage) return -1.0;
    CGImageRef source = image.CGImage;
    size_t pixelWidth = CGImageGetWidth(source);
    size_t pixelHeight = CGImageGetHeight(source);
    CGSize screenSize = UIScreen.mainScreen.bounds.size;
    if (pixelWidth < 2 || pixelHeight < 2 ||
        screenSize.width < 2.0 || screenSize.height < 2.0) return -1.0;

    CGFloat sx = (CGFloat)pixelWidth / screenSize.width;
    CGFloat sy = (CGFloat)pixelHeight / screenSize.height;
    CGRect sample = CGRectMake((point.x - patchPoints * 0.5) * sx,
                               (point.y - patchPoints * 0.5) * sy,
                               MAX(2.0, patchPoints * sx),
                               MAX(2.0, patchPoints * sy));
    CGRect pixelBounds = CGRectMake(0.0, 0.0,
                                    (CGFloat)pixelWidth,
                                    (CGFloat)pixelHeight);
    sample = CGRectIntersection(CGRectIntegral(sample), pixelBounds);
    if (CGRectIsNull(sample) || CGRectIsEmpty(sample)) return -1.0;

    CGImageRef crop = CGImageCreateWithImageInRect(source, sample);
    if (!crop) return -1.0;
    uint8_t rgba[4] = {0,0,0,0};
    CGColorSpaceRef colorSpace = CGColorSpaceCreateDeviceRGB();
    CGContextRef context = CGBitmapContextCreate(
        rgba, 1, 1, 8, 4, colorSpace,
        kCGImageAlphaPremultipliedLast | kCGBitmapByteOrder32Big);
    CGColorSpaceRelease(colorSpace);
    if (!context) {
        CGImageRelease(crop);
        return -1.0;
    }
    CGContextSetInterpolationQuality(context, kCGInterpolationMedium);
    CGContextDrawImage(context, CGRectMake(0, 0, 1, 1), crop);
    CGContextRelease(context);
    CGImageRelease(crop);

    CGFloat r = rgba[0] / 255.0;
    CGFloat g = rgba[1] / 255.0;
    CGFloat b = rgba[2] / 255.0;
    return 0.2126 * r + 0.7152 * g + 0.0722 * b;
}

static CGFloat AWEIOS27MedianLuma(CGFloat *values, NSUInteger count) {
    if (!values || count == 0) return -1.0;
    for (NSUInteger i = 1; i < count; i++) {
        CGFloat value = values[i];
        NSInteger j = (NSInteger)i - 1;
        while (j >= 0 && values[j] > value) {
            values[j + 1] = values[j];
            j--;
        }
        values[j + 1] = value;
    }
    if (count & 1) return values[count / 2];
    return (values[count / 2 - 1] + values[count / 2]) * 0.5;
}

static UIImage *AWECreateLowResolutionBackdropSnapshot(void) {
    static BOOL captureInProgress = NO;
    if (!NSThread.isMainThread || captureInProgress || gAWESettingsVisible ||
        UIApplication.sharedApplication.applicationState != UIApplicationStateActive) return nil;
    UIWindow *window = AWEActiveMainWindow();
    if (!window || !window.windowScene) return nil;
    CGSize size = window.bounds.size;
    if (size.width < 100.0 || size.height < 200.0) return nil;
    captureInProgress = YES;
    @try {
        UIGraphicsImageRendererFormat *format = [UIGraphicsImageRendererFormat defaultFormat];
        format.opaque = YES;
        format.scale = 0.16;
        UIGraphicsImageRenderer *renderer = [[UIGraphicsImageRenderer alloc]
            initWithSize:size format:format];
        __block BOOL rendered = NO;
        UIImage *image = [renderer imageWithActions:^(__unused UIGraphicsImageRendererContext *context) {
            rendered = [window drawViewHierarchyInRect:window.bounds afterScreenUpdates:NO];
        }];
        return rendered ? image : nil;
    } @finally {
        captureInProgress = NO;
    }
}

static void AWEApplyEventDrivenTransparentContrast(CGFloat luma,
                                                     NSString *reason) {
    if (luma < 0.0) return;
    BOOL previous = gAWETransparentBackdropForegroundLight;
    BOOL next = previous;
    if (!gAWETransparentBackdropContrastValid) {
        next = luma < 0.50;
    } else if (previous) {
        if (luma > 0.60) next = NO;
    } else if (luma < 0.40) {
        next = YES;
    }
    gAWETransparentBackdropLastLuma = luma;
    gAWETransparentBackdropContrastValid = YES;
    gAWETransparentBackdropForegroundLight = next;

    UIColor *foreground = next ? UIColor.whiteColor : UIColor.blackColor;
    for (UIButton *button in AWEAdaptiveGlassButtonRegistry().allObjects) {
        if ([objc_getAssociatedObject(button, &kAWEAdaptiveGlassAutomaticContrastKey) boolValue]) {
            AWEApplyAutomaticContrastForeground(button, next);
        }
    }
    /* 3.2: 2.5.3 also inked its own bottom bar here. The 3.1 bottom bar keeps
       its accent and Dark glass, so only the right column's automatic icons
       follow the sample; the chrome is refreshed only when the ink flips. */
    (void)foreground;
    if (next != previous) AWEScheduleHomeChromeRecovery(AWEActiveMainWindow());
    if (AWEInteractionDiagnosticsEnabled()) {
        AWEInteractionDiagnosticWrite(@"CLEAR_CONTRAST_V19 reason=%@ luma=%.3f light=%d changed=%d",
            reason ?: @"unknown", luma, next, next != previous);
    }
}

static void AWEPerformEventDrivenTransparentContrastSample(NSString *reason) {
    if (gAWESettingsVisible) return;
    if (!(AWEHomeTransparentGlassEnabled() || AWEIOS27WantsClearBottomMaterial())) return;
    if (!AWEIndexUsesHomeVisualPolicy(AWECurrentMainTabIndex())) return;
    CFTimeInterval now = CACurrentMediaTime();
    if (now - gAWETransparentBackdropLastSampleTime < 0.16) return;
    gAWETransparentBackdropLastSampleTime = now;
    UIImage *image = AWECreateLowResolutionBackdropSnapshot();
    if (!image) return;
    CGSize screen = UIScreen.mainScreen.bounds.size;
    const CGPoint points[] = {
        {screen.width * 0.20, screen.height * 0.18},
        {screen.width * 0.50, screen.height * 0.18},
        {screen.width * 0.78, screen.height * 0.32},
        {screen.width * 0.78, screen.height * 0.52},
        {screen.width * 0.22, screen.height * 0.78},
        {screen.width * 0.52, screen.height * 0.78}
    };
    CGFloat values[6]; NSUInteger count = 0;
    for (NSUInteger i = 0; i < 6; i++) {
        CGFloat value = AWEIOS27AverageLumaInPatch(image, points[i], 34.0);
        if (value >= 0.0) values[count++] = value;
    }
    if (count < 3) return;
    CGFloat sorted[6]; memcpy(sorted, values, sizeof(CGFloat) * count);
    AWEApplyEventDrivenTransparentContrast(AWEIOS27MedianLuma(sorted, count), reason);
}

static void AWEScheduleEventDrivenTransparentContrast(NSString *reason) {
    if (!(AWEHomeTransparentGlassEnabled() || AWEIOS27WantsClearBottomMaterial())) return;
    NSUInteger generation = ++gAWETransparentBackdropSampleGeneration;
    for (NSNumber *delay in @[@0.10, @0.34]) {
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW,
            (int64_t)(delay.doubleValue * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            if (generation != gAWETransparentBackdropSampleGeneration) return;
            AWEPerformEventDrivenTransparentContrastSample(reason);
        });
    }
}

static UIView *AWEFindViewByExactRuntimeClass(UIView *root,
                                              NSString *className,
                                              NSUInteger depth) {
    if (!root || depth > 18) return nil;
    if ([NSStringFromClass(root.class) isEqualToString:className]) return root;
    for (UIView *child in root.subviews) {
        UIView *result = AWEFindViewByExactRuntimeClass(child, className, depth + 1);
        if (result) return result;
    }
    return nil;
}

static UIView *AWEFindTopOwnerCandidate(UIView *root, BOOL search) {
    if (!root) return nil;
    if (search) {
        UIView *discover = AWEFindViewByExactRuntimeClass(
            root, @"AWEHPDiscoverFeedEntranceView", 0);
        if (discover) return discover;
        return AWEFindViewByExactRuntimeClass(
            root, @"AWEHPSearchBubbleEntranceView", 0);
    }
    return AWEFindViewByExactRuntimeClass(
        root, @"AWELeftSideBarEntranceView", 0);
}



#pragma mark - App appearance

UIUserInterfaceStyle AWEAppResolvedAppearanceStyle(UIWindow *window) {
    UIWindow *resolvedWindow = window ?: AWEActiveMainWindow();
    UIUserInterfaceStyle style = resolvedWindow.windowScene.traitCollection.userInterfaceStyle;
    if (style != UIUserInterfaceStyleLight && style != UIUserInterfaceStyleDark) {
        style = resolvedWindow.traitCollection.userInterfaceStyle;
    }
    if (style != UIUserInterfaceStyleLight && style != UIUserInterfaceStyleDark) {
        style = UITraitCollection.currentTraitCollection.userInterfaceStyle;
    }
    if (style != UIUserInterfaceStyleLight && style != UIUserInterfaceStyleDark) {
        style = UIUserInterfaceStyleLight;
    }
    return style;
}


#include "ALBRootScroll.h"
void ALB5CompactStateChanged(BOOL compact) { gAWEAlbumMorphCompact=compact; if(!compact) { gALB5TimerCollapsed=NO; ALB5ScheduleIdleCollapse(); } }

static BOOL AWEForwardTopActionOwner(UIView *owner,
                                         AWEHomeTopActionKind kind) {
    if (!owner) return NO;
    if (kind == AWEHomeTopActionKindSearch) {
        return AWEForwardExactNativeTapFromView(owner, @"SEARCH");
    }
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:owner];
    NSUInteger visited = 0;
    while (queue.count > 0 && visited < 48) {
        UIView *view = queue.firstObject;
        [queue removeObjectAtIndex:0];
        visited++;
        if ([view isKindOfClass:UIControl.class]) {
            UIControl *control = (UIControl *)view;
            BOOL hasTouchUp = NO;
            BOOL hasPrimary = NO;
            for (id target in control.allTargets) {
                hasTouchUp = hasTouchUp ||
                    ([control actionsForTarget:target
                               forControlEvent:UIControlEventTouchUpInside].count > 0);
                hasPrimary = hasPrimary ||
                    ([control actionsForTarget:target
                               forControlEvent:UIControlEventPrimaryActionTriggered].count > 0);
            }
            UIControlEvents event = hasTouchUp
                ? UIControlEventTouchUpInside
                : (hasPrimary ? UIControlEventPrimaryActionTriggered : 0);
            if (event != 0) {
                [control sendActionsForControlEvents:event];
                AWEInteractionDiagnosticWrite(
                    @"TOP_FORWARD kind=%@ path=control event=%@ control=%@ targets=%lu",
                    kind == AWEHomeTopActionKindSearch ? @"SEARCH" : @"MENU",
                    event == UIControlEventTouchUpInside ? @"touchUp" : @"primary",
                    AWEInteractionObjectSummary(control),
                    (unsigned long)control.allTargets.count);
                return YES;
            }
        }
        for (UIGestureRecognizer *recognizer in view.gestureRecognizers) {
            if (!recognizer.enabled) continue;
            NSString *name = NSStringFromClass(recognizer.class).lowercaseString;
            if (![recognizer isKindOfClass:UITapGestureRecognizer.class] &&
                ![name containsString:@"tap"] && ![name containsString:@"click"]) {
                continue;
            }
            NSInteger oldState = 0;
            BOOL changed = AWESetIntegerIvar(recognizer,
                "_state_DO_NOT_USE_DIRECTLY", UIGestureRecognizerStateEnded,
                &oldState);
            BOOL sent = AWEInvokeGestureRecognizer(recognizer);
            if (changed) {
                AWESetIntegerIvar(recognizer,
                    "_state_DO_NOT_USE_DIRECTLY", oldState, NULL);
            }
            if (sent) {
                AWEInteractionDiagnosticWrite(
                    @"TOP_FORWARD kind=%@ path=gesture recognizer=%@ view=%@",
                    kind == AWEHomeTopActionKindSearch ? @"SEARCH" : @"MENU",
                    NSStringFromClass(recognizer.class),
                    AWEInteractionObjectSummary(view));
                return YES;
            }
        }
        for (UIView *child in view.subviews) [queue addObject:child];
    }
    BOOL activated = NO;
    @try { activated = [owner accessibilityActivate]; }
    @catch (__unused NSException *exception) { activated = NO; }
    AWEInteractionDiagnosticWrite(
        @"TOP_FORWARD kind=%@ path=accessibility result=%d owner=%@ visited=%lu",
        kind == AWEHomeTopActionKindSearch ? @"SEARCH" : @"MENU",
        activated, AWEInteractionObjectSummary(owner), (unsigned long)visited);
    return activated;
}


#pragma mark - Native top-left dynamic Liquid Glass menu

/*
 The early ForceLiquidGlassUnified source only restyled WeChat's already-open
 MainFrameActionFloatView. The latest WCGlass binary instead binds a real
 UIMenu to the source UIButton, builds UIAction children synchronously and
 enables showsMenuAsPrimaryAction. This section follows the latter structure:
 there is no delayed empty deferred provider and no forwarding of the
 original sidebar tap while the menu is opening.
*/


static NSString *AWETrimQuickMenuText(NSString *text) {
    if (![text isKindOfClass:NSString.class]) return @"";
    return [text stringByTrimmingCharactersInSet:
        NSCharacterSet.whitespaceAndNewlineCharacterSet];
}

static BOOL AWEViewDirectlyMatchesQuickMenuTitle(UIView *view,
                                                  NSString *title) {
    if (!view || !title.length) return NO;
    if ([AWETrimQuickMenuText(view.accessibilityLabel) isEqualToString:title] ||
        [AWETrimQuickMenuText(view.accessibilityValue) isEqualToString:title]) {
        return YES;
    }
    if ([view isKindOfClass:UILabel.class]) {
        if ([AWETrimQuickMenuText(((UILabel *)view).text)
                isEqualToString:title]) return YES;
    }
    if ([view isKindOfClass:UIButton.class]) {
        UIButton *button = (UIButton *)view;
        if ([AWETrimQuickMenuText(button.currentTitle)
                isEqualToString:title] ||
            [AWETrimQuickMenuText(button.titleLabel.text)
                isEqualToString:title]) return YES;
    }
    return NO;
}

static BOOL AWEViewHasUsableTapRecognizer(UIView *view) {
    if (!view) return NO;
    for (UIGestureRecognizer *recognizer in view.gestureRecognizers) {
        if (!recognizer.enabled) continue;
        NSString *name = NSStringFromClass(recognizer.class).lowercaseString;
        if ([recognizer isKindOfClass:UITapGestureRecognizer.class] ||
            [name containsString:@"tap"] ||
            [name containsString:@"click"]) return YES;
    }
    return NO;
}

static BOOL AWEQuickMenuExcludedView(UIView *view) {
    if (!view) return YES;
    for (UIView *cursor = view; cursor; cursor = cursor.superview) {
        NSString *cursorName = NSStringFromClass(cursor.class).lowercaseString;
        if ([cursor.accessibilityIdentifier isEqualToString:@"AwemeLiquidBar.TopChrome"]) {
            return YES;
        }
        if ([cursorName containsString:@"feedtopbarcontainer"]) break;
    }
    NSString *name = NSStringFromClass(view.class).lowercaseString;
    return [name containsString:@"contextmenu"] ||
           [name containsString:@"menuplatter"] ||
           [name containsString:@"menupresentation"] ||
           [name containsString:@"popover"] ||
           [name containsString:@"alertcontroller"];
}

static UIView *AWEQuickMenuActionOwnerForMatchedView(UIView *matched,
                                                      UIWindow *window) {
    if (!matched || !window) return nil;
    UIView *fallback = matched;
    UIView *cursor = matched;
    for (NSUInteger depth = 0; cursor && cursor != window && depth < 8;
         depth++, cursor = cursor.superview) {
        if (AWEQuickMenuExcludedView(cursor)) continue;
        if ([cursor isKindOfClass:UIControl.class] ||
            AWEViewHasUsableTapRecognizer(cursor)) return cursor;
        NSString *name = NSStringFromClass(cursor.class).lowercaseString;
        if ([name containsString:@"button"] ||
            [name containsString:@"tab"] ||
            [name containsString:@"segment"] ||
            [name containsString:@"channel"] ||
            [name containsString:@"item"] ||
            [name containsString:@"cell"]) {
            fallback = cursor;
        }
    }
    return fallback;
}

static NSInteger AWEQuickMenuCandidateScore(UIView *candidate,
                                             UIWindow *window,
                                             BOOL topOnly) {
    if (!candidate || !window || candidate.hidden || candidate.alpha <= 0.02 ||
        !candidate.window || AWEQuickMenuExcludedView(candidate)) return NSIntegerMin;
    CGRect frame = [candidate convertRect:candidate.bounds toView:window];
    if (CGRectIsEmpty(frame) || CGRectIsNull(frame) ||
        !CGRectIntersectsRect(frame, window.bounds)) return NSIntegerMin;
    CGFloat midY = CGRectGetMidY(frame);
    CGFloat topLimit = MIN(240.0, CGRectGetHeight(window.bounds) * 0.32);
    if (topOnly && midY > topLimit) return NSIntegerMin;

    NSInteger score = 100;
    if ([candidate isKindOfClass:UIControl.class]) score += 130;
    if (AWEViewHasUsableTapRecognizer(candidate)) score += 110;
    NSString *name = NSStringFromClass(candidate.class).lowercaseString;
    if ([name containsString:@"tab"] || [name containsString:@"segment"] ||
        [name containsString:@"channel"] || [name containsString:@"feed"]) {
        score += 90;
    }
    if (midY <= topLimit) score += 220;
    if (CGRectGetWidth(frame) >= 28.0 && CGRectGetWidth(frame) <= 240.0 &&
        CGRectGetHeight(frame) >= 20.0 && CGRectGetHeight(frame) <= 110.0) {
        score += 35;
    }
    return score;
}

static UIView *AWEBestQuickMenuDestinationView(UIWindow *window,
                                                NSString *title,
                                                BOOL topOnly) {
    if (!window || !title.length) return nil;
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:window];
    NSHashTable<UIView *> *seen = [NSHashTable weakObjectsHashTable];
    UIView *best = nil;
    NSInteger bestScore = NSIntegerMin;
    NSUInteger visited = 0;

    while (queue.count > 0 && visited < 1400) {
        UIView *view = queue.firstObject;
        [queue removeObjectAtIndex:0];
        if (!view || [seen containsObject:view]) continue;
        [seen addObject:view];
        visited++;
        if (view.hidden || view.alpha <= 0.01 || AWEQuickMenuExcludedView(view)) {
            continue;
        }
        if (AWEViewDirectlyMatchesQuickMenuTitle(view, title)) {
            UIView *owner = AWEQuickMenuActionOwnerForMatchedView(view, window);
            NSInteger score = AWEQuickMenuCandidateScore(owner, window, topOnly);
            if (score > bestScore) {
                bestScore = score;
                best = owner;
            }
        }
        for (UIView *child in view.subviews) [queue addObject:child];
    }
    return best;
}

static BOOL AWETriggerQuickMenuDestinationView(UIView *target) {
    if (!target) return NO;

    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:target];
    NSUInteger visited = 0;
    while (queue.count > 0 && visited < 96) {
        UIView *view = queue.firstObject;
        [queue removeObjectAtIndex:0];
        visited++;

        if ([view isKindOfClass:UIControl.class]) {
            UIControl *control = (UIControl *)view;
            UIControlEvents event = 0;
            for (id actionTarget in control.allTargets) {
                if ([control actionsForTarget:actionTarget
                              forControlEvent:UIControlEventPrimaryActionTriggered].count) {
                    event = UIControlEventPrimaryActionTriggered;
                    break;
                }
                if ([control actionsForTarget:actionTarget
                              forControlEvent:UIControlEventTouchUpInside].count) {
                    event = UIControlEventTouchUpInside;
                }
            }
            if (event) {
                [control sendActionsForControlEvents:event];
                return YES;
            }
        }

        for (UIGestureRecognizer *recognizer in view.gestureRecognizers) {
            if (!recognizer.enabled) continue;
            NSString *name = NSStringFromClass(recognizer.class).lowercaseString;
            if (![recognizer isKindOfClass:UITapGestureRecognizer.class] &&
                ![name containsString:@"tap"] && ![name containsString:@"click"]) {
                continue;
            }
            NSInteger oldState = 0;
            BOOL changed = AWESetIntegerIvar(recognizer,
                "_state_DO_NOT_USE_DIRECTLY", UIGestureRecognizerStateEnded,
                &oldState);
            BOOL sent = AWEInvokeGestureRecognizer(recognizer);
            if (changed) {
                AWESetIntegerIvar(recognizer,
                    "_state_DO_NOT_USE_DIRECTLY", oldState, NULL);
            }
            if (sent) return YES;
        }
        for (UIView *child in view.subviews) [queue addObject:child];
    }

    BOOL activated = NO;
    @try { activated = [target accessibilityActivate]; }
    @catch (__unused NSException *exception) { activated = NO; }
    return activated;
}

static BOOL AWEActivateQuickMenuDestination(NSString *title) {
    UIWindow *window = AWEActiveMainWindow();
    if (!window || !title.length) return NO;

    UIView *target = AWEBestQuickMenuDestinationView(window, title, YES);
    if (!target && [title isEqualToString:@"商城"] &&
        AWESecondTabIsShop() && gAWELastTabBar) {
        BOOL forwarded = AWEForwardToOriginalButton((UIView *)gAWELastTabBar, 1);
        AWEInteractionDiagnosticWrite(
            @"TOP_MENU_ACTION title=%@ result=%d path=bottom-shop-fallback",
            title, forwarded);
        if (forwarded) return YES;
    }
    if (!target) target = AWEBestQuickMenuDestinationView(window, title, NO);
    BOOL result = AWETriggerQuickMenuDestinationView(target);
    AWEInteractionDiagnosticWrite(
        @"TOP_MENU_ACTION title=%@ result=%d target=%@",
        title, result, AWEInteractionObjectSummary(target));
    return result;
}

static NSString *AWEQuickMenuTitleForView(UIView *view) {
    if ([view isKindOfClass:UILabel.class]) {
        return AWETrimQuickMenuText(((UILabel *)view).text);
    }
    if ([view isKindOfClass:UIButton.class]) {
        UIButton *button = (UIButton *)view;
        return AWETrimQuickMenuText(button.currentTitle ?: button.titleLabel.text);
    }
    return @"";
}

static BOOL AWEViewEffectivelyVisibleInsideTopContainer(UIView *view,
                                                         UIView *container) {
    if (!view || !container || !view.window) return NO;
    for (UIView *cursor = view; cursor; cursor = cursor.superview) {
        if (cursor == container) return YES;
        if (cursor.hidden || cursor.alpha <= 0.01 || cursor.layer.opacity <= 0.01f) return NO;
    }
    return NO;
}

static BOOL AWEViewBelongsToTopTabItem(UIView *view, UIView *container) {
    for (UIView *cursor = view; cursor && cursor != container.superview;
         cursor = cursor.superview) {
        NSString *name = NSStringFromClass(cursor.class).lowercaseString;
        if ([name containsString:@"toptabitem"] ||
            [name containsString:@"segmentcontrolscroll"] ||
            [name containsString:@"multitab"] ||
            [name containsString:@"channelitem"] ||
            [name containsString:@"feedtabitem"]) {
            return YES;
        }
        if (cursor == container) break;
    }
    return NO;
}

static NSString *AWEQuickMenuSymbolNameForTitle(NSString *title) {
    NSString *trimmed = AWETrimQuickMenuText(title);
    if ([trimmed containsString:@"直播"]) return @"play.rectangle";
    if ([trimmed containsString:@"商城"] || [trimmed containsString:@"购物"] ||
        [trimmed containsString:@"商店"]) return @"storefront";
    if ([trimmed containsString:@"关注"]) return @"person.2";
    if ([trimmed containsString:@"推荐"]) return @"sparkles";
    if ([trimmed containsString:@"精选"]) return @"checkmark.seal";
    if ([trimmed containsString:@"经验"]) return @"lightbulb";
    if ([trimmed containsString:@"同城"] || [trimmed containsString:@"附近"]) {
        return @"location";
    }
    return @"circle.grid.2x2";
}

static NSArray<NSDictionary<NSString *, id> *> *
AWEDynamicTopQuickMenuDefinitions(UIView *container) {
    if (!container) return @[];
    NSMutableArray<NSDictionary<NSString *, id> *> *candidates =
        [NSMutableArray array];
    NSMutableSet<NSString *> *seenTitles = [NSMutableSet set];
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:container];
    NSUInteger visited = 0;
    while (queue.count > 0 && visited < 600) {
        UIView *view = queue.firstObject;
        [queue removeObjectAtIndex:0];
        if (!view) continue;
        visited++;
        NSString *title = AWEQuickMenuTitleForView(view);
        BOOL externallyVisible =
            AWEViewEffectivelyVisibleInsideTopContainer(view, container);
        if (title.length > 0 && title.length <= 12 && externallyVisible &&
            AWEViewBelongsToTopTabItem(view, container) &&
            ![seenTitles containsObject:title]) {
            CGRect frame = [view convertRect:view.bounds toView:container];
            BOOL geometry = !CGRectIsEmpty(frame) &&
                CGRectGetHeight(frame) >= 18.0 && CGRectGetHeight(frame) <= 72.0 &&
                CGRectGetMidY(frame) <= MAX(96.0, CGRectGetHeight(container.bounds));
            if (geometry) {
                [seenTitles addObject:title];
                UIView *target = AWEQuickMenuActionOwnerForMatchedView(
                    view, container.window ?: AWEActiveMainWindow());
                NSMutableDictionary *definition = [@{
                    @"title": title,
                    @"route": title,
                    @"symbol": AWEQuickMenuSymbolNameForTitle(title),
                    @"x": @(CGRectGetMidX(frame))
                } mutableCopy];
                UIColor *nativeTextColor = nil;
                if ([view isKindOfClass:UILabel.class]) {
                    nativeTextColor = ((UILabel *)view).textColor;
                } else if ([view isKindOfClass:UIButton.class]) {
                    UIButton *nativeButton = (UIButton *)view;
                    nativeTextColor = [nativeButton titleColorForState:nativeButton.state]
                        ?: [nativeButton titleColorForState:UIControlStateNormal]
                        ?: nativeButton.titleLabel.textColor;
                }
                if (nativeTextColor) definition[@"textColor"] = nativeTextColor;
                definition[@"titleView"] = view;
                if (target) definition[@"target"] = target;
                [candidates addObject:definition];
            }
        }
        for (UIView *child in view.subviews) [queue addObject:child];
    }
    [candidates sortUsingComparator:^NSComparisonResult(NSDictionary *left,
                                                         NSDictionary *right) {
        CGFloat lx = [left[@"x"] doubleValue];
        CGFloat rx = [right[@"x"] doubleValue];
        return lx < rx ? NSOrderedAscending : (lx > rx ? NSOrderedDescending
                                                        : NSOrderedSame);
    }];
    if (candidates.count > 0) return candidates;
    return @[
        @{@"title": @"直播", @"route": @"直播", @"symbol": @"play.rectangle", @"x": @0},
        @{@"title": @"商城", @"route": @"商城", @"symbol": @"storefront", @"x": @1},
        @{@"title": @"关注", @"route": @"关注", @"symbol": @"person.2", @"x": @2},
        @{@"title": @"推荐", @"route": @"推荐", @"symbol": @"sparkles", @"x": @3}
    ];
}

#pragma mark - 3.0 home top chrome (bar glass, ported from LiquidGlassLab)

/* Douyin's AWEFeedTopBarContainer stays in place, laid out and animated by
   Douyin, but draws nothing (an empty layer mask) and takes no touches.
   ALB3TopChromeView sits right above it in the same superview, mirrors its
   geometry and visibility, and forwards every tap to Douyin's own views:
   a category to its tab item, search to the search entrance, and the left
   button's sidebar entry to the sidebar entrance. */

static char kALB3TopChromeKey;
static char kALB3TopDefinitionsKey;
static char kALB3TopMaskedKey;
static char kALB3TopRefreshPendingKey;
static char kALB3TopLastRefreshKey;

static NSDictionary<NSString *, id> *ALB3TopConfiguration(void) {
    return @{
        @"count": @(AWETopTelegramVisibleCount()),
        @"keepSingle": @(ALBTopSingleSelectionEnabled()),
        @"groupScale": @(ALB5Number(@"top.groupScale", 1.0, 0.5, 1.2)),
        @"slotWidth": @(ALB5Number(@"top.slotWidth", 76, 44, 120)),
        @"sideScale": @(ALB5Number(@"top.sideScale", 1.0, 0.6, 1.3)),
        @"sideMargin": @(ALB5Number(@"top.sideMargin", 16, 0, 40)),
        @"hideLeft": @(AWEHideTopLeftButtonEnabled()),
        @"hideSearch": @(AWEHideTopSearchButtonEnabled()),
        @"leftMenu": @(ALB5Bool(@"top.leftMenu", YES)),
        @"showGroup": @(AWETopTelegramSwitcherEnabled()),
        @"nearGroup": @(ALB5Bool(@"top.nearGroup", NO)),
        @"leftGap": @(ALB5Number(@"top.leftGap", 14, 0, 80)),
        @"rightGap": @(ALB5Number(@"top.rightGap", 14, 0, 80)),
    };
}

/* Settings take effect at once (any page's switch or slider). */
static void ALB3ObserveTopOptionsOnce(void) {
    static BOOL observing;
    if (observing) return;
    observing = YES;
    [NSNotificationCenter.defaultCenter addObserverForName:@"ALB5.OptionsChanged" object:nil
                                                     queue:NSOperationQueue.mainQueue
                                                usingBlock:^(__unused NSNotification *note) {
        UIView *container = gAWEHomeFeedTopContainer;
        if (container) ALB3RefreshTopChrome(container);
    }];
}

static ALB3TopChromeView *ALB3TopChromeForContainer(UIView *container) {
    return container ? objc_getAssociatedObject(container, &kALB3TopChromeKey) : nil;
}

static NSArray<NSDictionary<NSString *, id> *> *ALB3TopDefinitions(UIView *container) {
    NSArray *cached = container ? objc_getAssociatedObject(container, &kALB3TopDefinitionsKey) : nil;
    return [cached isKindOfClass:NSArray.class] ? cached : @[];
}

static void ALB3SetTopContainerMasked(UIView *container, BOOL masked) {
    if (!container) return;
    BOOL current = [objc_getAssociatedObject(container, &kALB3TopMaskedKey) boolValue];
    if (masked) {
        if (!current || !container.layer.mask) {
            CALayer *mask = [CALayer layer];
            mask.frame = CGRectZero;
            container.layer.mask = mask;
            objc_setAssociatedObject(container, &kALB3TopMaskedKey, @YES,
                                     OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }
    } else if (current) {
        container.layer.mask = nil;
        objc_setAssociatedObject(container, &kALB3TopMaskedKey, nil,
                                 OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
}

static BOOL ALB3TopContainerShowing(UIView *container) {
    return container.window && !container.hidden && container.alpha > 0.01 &&
        container.layer.opacity > 0.01f && !gAWEStableCleanScreenEnabled;
}

#include "ALB37GlassLayer.h"

/* Same superview, directly above Douyin's container, same geometry. */
static void ALB3MirrorTopChrome(UIView *container) {
    ALB3TopChromeView *chrome = ALB3TopChromeForContainer(container);
    if (!chrome || !container.superview) return;
    // 3.7: at the top of the window, following Douyin's top bar
    // (ALB37GlassLayer.h puts it back here whenever it cannot be there).
    if (ALB37ChromeLifted() && container.window) { ALB37TrackChrome(chrome, container); return; }
    if (ALB37TracksChrome(chrome)) ALB37ForgetChrome(chrome);
    ALB3PlaceTopChromeInPlace(chrome, container);
}

/* Next to Douyin's top bar, in its superview (3.0-3.6). */
static void ALB3PlaceTopChromeInPlace(UIView *chrome, UIView *container) {
    UIView *host = container.superview;
    if (!chrome || !host) return;
    if (chrome.superview != host) {
        [host insertSubview:chrome aboveSubview:container];
    } else {
        NSUInteger chromeIndex = [host.subviews indexOfObjectIdenticalTo:chrome];
        NSUInteger containerIndex = [host.subviews indexOfObjectIdenticalTo:container];
        if (chromeIndex != NSNotFound && containerIndex != NSNotFound &&
            chromeIndex < containerIndex) {
            [host insertSubview:chrome aboveSubview:container];
        }
    }
    if (!CGRectEqualToRect(chrome.bounds, container.bounds)) chrome.bounds = container.bounds;
    if (!CGPointEqualToPoint(chrome.center, container.center)) chrome.center = container.center;
    if (!CGAffineTransformEqualToTransform(chrome.transform, container.transform)) {
        chrome.transform = container.transform;
    }
    BOOL showing = ALB3TopContainerShowing(container);
    if (chrome.hidden == showing) chrome.hidden = !showing;
    if (fabs(chrome.alpha - container.alpha) > 0.001) chrome.alpha = container.alpha;
}

static NSInteger ALB3TopIndexForIndicator(UIView *container, UIView *indicator,
                                          NSArray<NSDictionary<NSString *, id> *> *definitions) {
    if (!container || !indicator || definitions.count == 0) return NSNotFound;
    CGRect frame = [indicator convertRect:indicator.bounds toView:container];
    CGFloat x = CGRectGetMidX(frame);
    NSInteger best = NSNotFound;
    CGFloat bestDistance = CGFLOAT_MAX;
    for (NSUInteger index = 0; index < definitions.count; index++) {
        CGFloat distance = fabs([definitions[index][@"x"] doubleValue] - x);
        if (distance < bestDistance) {
            bestDistance = distance;
            best = (NSInteger)index;
        }
    }
    return best;
}

static NSInteger ALB3SelectedTopIndex(UIView *container,
                                      NSArray<NSDictionary<NSString *, id> *> *definitions) {
    if (!container || definitions.count == 0) return NSNotFound;
    UIView *indicator = AWEFindViewByExactRuntimeClass(
        container, @"AWEFeedMultiTabSelectedContainerView", 0);
    if (!indicator) {
        indicator = AWEFindViewByExactRuntimeClass(
            container, @"AWEHPMultiTabSelectedContainerView", 0);
    }
    return ALB3TopIndexForIndicator(container, indicator, definitions);
}

/* Douyin's own title row, so the chrome sits exactly where it was. */
static CGFloat ALB3TopRowCenterY(UIView *container,
                                 NSArray<NSDictionary<NSString *, id> *> *definitions) {
    CGFloat sum = 0.0;
    NSUInteger count = 0;
    for (NSDictionary<NSString *, id> *definition in definitions) {
        UIView *titleView = [definition[@"titleView"] isKindOfClass:UIView.class]
            ? definition[@"titleView"] : nil;
        if (!titleView.window) continue;
        CGRect frame = [titleView convertRect:titleView.bounds toView:container];
        sum += CGRectGetMidY(frame);
        count++;
    }
    if (count > 0) return sum / count;
    UIView *owner = AWEFindTopOwnerCandidate(container, NO) ?: AWEFindTopOwnerCandidate(container, YES);
    if (owner.window) return CGRectGetMidY([owner convertRect:owner.bounds toView:container]);
    return -1.0;
}

static BOOL ALB3ActivateTopDefinition(NSDictionary<NSString *, id> *definition) {
    if (![definition isKindOfClass:NSDictionary.class]) return NO;
    UIView *target = [definition[@"target"] isKindOfClass:UIView.class]
        ? definition[@"target"] : nil;
    if (target && target.window && AWETriggerQuickMenuDestinationView(target)) {
        return YES;
    }
    NSString *route = definition[@"route"] ?: definition[@"title"];
    return route.length ? AWEActivateQuickMenuDestination(route) : NO;
}

/* 3.3: the Home channels that play no video (the bottom bar takes the
   page's appearance there). A channel just tapped counts at once, before
   Douyin's indicator has moved. */
static NSString *gALB33TappedChannelTitle;
static CFTimeInterval gALB33TappedChannelUntil;
static BOOL ALB33TitleIsNonVideoChannel(NSString *title) {
    return [title isKindOfClass:NSString.class] &&
        [@[@"商城", @"经验", @"团购", @"购物"] containsObject:title];
}
static BOOL ALB33HomeChannelIsVideo(void) {
    if (gALB33TappedChannelTitle && CACurrentMediaTime() < gALB33TappedChannelUntil)
        return !ALB33TitleIsNonVideoChannel(gALB33TappedChannelTitle);
    UIView *container = gALB32InkTopContainer;
    if (!container.window) return YES;
    NSArray<NSDictionary<NSString *, id> *> *definitions = ALB3TopDefinitions(container);
    NSInteger selected = ALB3SelectedTopIndex(container, definitions);
    if (selected == NSNotFound || selected < 0 || selected >= (NSInteger)definitions.count) return YES;
    return !ALB33TitleIsNonVideoChannel(definitions[(NSUInteger)selected][@"title"]);
}

static void ALB3TopSelectIndex(UIView *container, NSInteger index) {
    NSArray<NSDictionary<NSString *, id> *> *definitions = ALB3TopDefinitions(container);
    if (index < 0 || index >= (NSInteger)definitions.count) return;
    id tappedTitle = definitions[(NSUInteger)index][@"title"];
    gALB33TappedChannelTitle = [tappedTitle isKindOfClass:NSString.class] ? tappedTitle : nil;
    gALB33TappedChannelUntil = CACurrentMediaTime() + 0.8;
    BOOL result = ALB3ActivateTopDefinition(definitions[(NSUInteger)index]);
    if (gAWEAlbumMorphController)
        AWEApplyAlbumMorphResolvedAppearance(container.window, gAWEAlbumMorphController.currentOriginalIndex);
    AWEInteractionDiagnosticWrite(@"TOP3_SELECT index=%ld title=%@ result=%d",
        (long)index, definitions[(NSUInteger)index][@"title"], result);
    // A channel switch (团购, …) can change whether the bottom bar shows:
    // look again while the new channel settles.
    AWEStartBarVisibilityDriver();
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.6 * NSEC_PER_SEC)),
                   dispatch_get_main_queue(), ^{ AWEStartBarVisibilityDriver(); });
}

static void ALB3TopForwardOwner(UIView *container, BOOL search) {
    // The bottom search capsule may have borrowed Douyin's search
    // recognizer; give it back to its owner before forwarding to it.
    if (search) AWERestoreSharedSearchGestureToOriginal(@"top.search.forward");
    UIView *owner = AWEFindTopOwnerCandidate(container, search);
    BOOL result = owner ? AWEForwardTopActionOwner(owner,
        search ? AWEHomeTopActionKindSearch : AWEHomeTopActionKindMenu) : NO;
    AWEInteractionDiagnosticWrite(@"TOP3_%@ owner=%@ result=%d",
        search ? @"SEARCH" : @"SIDEBAR", AWEInteractionObjectSummary(owner), result);
}

/* 3.11.45 用户：“给左上角展开菜单增加一个切换单双列的区域……布局类似这种（电话 App 的 经典 / 统一 两块），三段式底栏单击
   首页可以触发单双列切换，但是液态底栏不行，看能不能借此直接找到单双列切换的入口”。入口就是“在首页时再点一次首页”：
   三段式底栏把点击原样交给抖音的首页键，抖音就切单 / 双列；液态底栏 3.11 起特意把“首页上再点首页”拦掉了
   （HOME_RESELECT_BLOCKED，免得误切）。这里：菜单顶上两块（单列 / 双列，当前那块打勾），点了不一样的那块就替用户点一次
   抖音的首页键（不在首页先切到首页再点）。现在是哪种按页面认（首页里看得见双列的列表＝双列）。
   诊断【单双列】：每次切换前后认出来的状态、抖音偏好里看着像单双列的键前后的值（找直接切的办法用）。 */
extern BOOL ALBDockBridgeTapTitle(NSString *title);
static NSUInteger gALBColumnRequests, gALBColumnTaps;
static NSString *gALBColumnLast;
static NSString *gALBColumnSeenGrid;
/* 3.11.46：再按页面认一次——首页里看得见、占大半屏的双列列表（控制器类名带 DoubleColumn / DCFeed） */
static BOOL ALBColumnGridVisible(UIWindow *window) {
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:window];
    CGRect screen = window.bounds;
    for (NSUInteger i = 0; i < queue.count && i < 2500; i++) {
        UIView *v = queue[i];
        if (v.hidden || v.alpha < 0.01) continue;
        UIResponder *owner = v.nextResponder;
        if ([owner isKindOfClass:UIViewController.class]) {
            NSString *name = NSStringFromClass(owner.class);
            if ([name containsString:@"DoubleColumn"] || [name hasPrefix:@"AWEDCFeed"]) {
                CGRect r = [v convertRect:v.bounds toView:window];
                CGRect visible = CGRectIntersection(r, screen);
                if (!CGRectIsNull(visible) && visible.size.width > screen.size.width * 0.8 && visible.size.height > screen.size.height * 0.5) {
                    gALBColumnSeenGrid = name;
                    return YES;
                }
            }
        }
        if ([v isKindOfClass:UICollectionViewCell.class]) continue;
        [queue addObjectsFromArray:v.subviews];
    }
    return NO;
}
static NSInteger ALBColumnMode(UIWindow *window) {      // 2 双列 1 单列 0 认不出（不在首页）
    if (!window) return 0;
    if (ALB32BottomVisibleRouteRoot(window, AWEBottomRouteGrid)) return 2;
    if (AWECurrentOriginalMainTabIndex() != 0) return 0;
    if (AWEBottomRouteForWindow(window) == AWEBottomRouteGrid) return 2;
    return ALBColumnGridVisible(window) ? 2 : 1;
}
static NSDictionary<NSString *, NSString *> *ALBColumnDefaultsSnapshot(void) {
    NSMutableDictionary<NSString *, NSString *> *found = [NSMutableDictionary dictionary];
    NSDictionary *all = NSUserDefaults.standardUserDefaults.dictionaryRepresentation;
    for (NSString *key in all) {
        NSString *lower = key.lowercaseString;
        if ([lower hasPrefix:@"awemeliquidbar"]) continue;
        // 3.11.46：别的插件的键（双击、玻璃、面板、按钮……）不要
        if ([lower containsString:@"tap"] || [lower containsString:@"glass"] || [lower containsString:@"panel"] ||
            [lower containsString:@"button"] || [lower containsString:@"indicator"] || [lower containsString:@"history"] ||
            [lower containsString:@"hint"] || [lower containsString:@"lynxview"]) continue;
        if (![lower containsString:@"column"] && ![lower containsString:@"dual"] && ![lower containsString:@"waterfall"] &&
            ![lower containsString:@"feedmode"] && ![lower containsString:@"grid"] && ![lower containsString:@"double"]) continue;
        NSString *value = [all[key] description] ?: @"";
        found[key] = value.length > 40 ? [[value substringToIndex:40] stringByAppendingString:@"…"] : value;
        if (found.count >= 30) break;
    }
    return found;
}
static BOOL ALBColumnTapHome(void) {
    gALBColumnTaps++;
    if (ALBDockModeActive()) return ALBDockBridgeTapTitle(@"首页");
    AWENormalModeTabBar *bar = gAWELastTabBar;
    if (!bar && gAWELastController) bar = AWEPrepareBarForController(gAWELastController, NO);
    return bar ? AWEForwardToOriginalButton((UIView *)bar, 0) : NO;
}
static void ALBColumnSwitchTo(NSInteger want) {
    gALBColumnRequests++;
    UIWindow *window = AWEActiveMainWindow();
    NSInteger before = ALBColumnMode(window);
    NSDictionary *keysBefore = ALBColumnDefaultsSnapshot();
    if (before == want) { AWEShowDownloadToast(want == 2 ? @"已经是双列" : @"已经是单列"); return; }
    BOOL first = ALBColumnTapHome();
    BOOL wasHome = before != 0;
    __weak UIWindow *weakWindow = window;
    void (^finish)(BOOL) = ^(BOOL second) {
        UIWindow *w = weakWindow ?: AWEActiveMainWindow();
        NSInteger after = ALBColumnMode(w);
        NSDictionary *keysAfter = ALBColumnDefaultsSnapshot();
        NSMutableArray<NSString *> *changed = [NSMutableArray array];
        for (NSString *key in [[NSSet setWithArray:keysBefore.allKeys] setByAddingObjectsFromArray:keysAfter.allKeys]) {
            if (![keysBefore[key] isEqualToString:keysAfter[key] ?: @""] || !keysBefore[key])
                [changed addObject:[NSString stringWithFormat:@"%@: %@ → %@", key, keysBefore[key] ?: @"无", keysAfter[key] ?: @"无"]];
        }
        NSMutableArray<NSString *> *all = [NSMutableArray array];
        for (NSString *key in keysAfter) [all addObject:[NSString stringWithFormat:@"%@=%@", key, keysAfter[key]]];
        gALBColumnLast = [NSString stringWithFormat:@"想要%@：之前=%@ 之后=%@；点了首页 %@%@；变了的偏好：%@；看着像的偏好：%@",
            want == 2 ? @"双列" : @"单列", @[@"认不出", @"单列", @"双列"][(NSUInteger)before], @[@"认不出", @"单列", @"双列"][(NSUInteger)after],
            first ? @"成功" : @"失败", second ? @"（先切到首页，又点了一次）" : @"",
            changed.count ? [changed componentsJoinedByString:@"；"] : @"无", all.count ? [all componentsJoinedByString:@"；"] : @"无"];
        if (after != 0 && after != want) AWEShowDownloadToast(@"没切过去：抖音这次没有响应首页键（诊断【单双列】里有记录）");
    };
    if (wasHome) {
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.9 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ finish(NO); });
        return;
    }
    // 不在首页：先切到首页，等一下再看要不要再点一次
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        UIWindow *w = weakWindow ?: AWEActiveMainWindow();
        BOOL again = ALBColumnMode(w) != want && ALBColumnMode(w) != 0;
        if (again) ALBColumnTapHome();
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.9 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ finish(again); });
    });
}
/* 菜单里的两块图：手机外框里一整块（单列）/ 两列小块（双列），模板图（颜色跟菜单） */
/* 单 / 双列：左上角菜单里侧边栏下面两项，和其他菜单项同一级，当前那项打勾 */
static NSArray<UIMenuElement *> *ALBColumnMenuItems(UIView *container) {
    NSInteger mode = ALBColumnMode(container.window ?: AWEActiveMainWindow());
    NSMutableArray<UIMenuElement *> *items = [NSMutableArray array];
    for (NSInteger want = 1; want <= 2; want++) {
        UIAction *action = [UIAction actionWithTitle:want == 1 ? @"单列" : @"双列"
                                               image:[UIImage systemImageNamed:want == 1 ? @"rectangle.portrait" : @"square.grid.2x2"]
                                          identifier:nil
                                             handler:^(__unused UIAction *menuAction) {
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.16 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ ALBColumnSwitchTo(want); });
        }];
        action.state = mode == want ? UIMenuElementStateOn : UIMenuElementStateOff;
        [items addObject:action];
    }
    return items;
}
static NSString *ALBColumnReport(void) {
    NSInteger mode = ALBColumnMode(AWEActiveMainWindow());
    return [NSString stringWithFormat:@"现在=%@（按页面认到的双列控制器：%@）；切换 %lu 次、替用户点首页 %lu 次；最近一次：%@",
        @[@"认不出（不在首页）", @"单列", @"双列"][(NSUInteger)mode], gALBColumnSeenGrid ?: @"没见过", (unsigned long)gALBColumnRequests,
        (unsigned long)gALBColumnTaps, gALBColumnLast ?: @"还没切过"];
}

/* The left button's menu: Douyin's categories (current one checked) and
   Douyin's sidebar. Built each time the menu opens. */
static NSArray<UIMenuElement *> *ALB3TopMenuElements(UIView *container) {
    NSArray<NSDictionary<NSString *, id> *> *definitions = ALB3TopDefinitions(container);
    NSInteger selected = ALB3SelectedTopIndex(container, definitions);
    NSMutableArray<UIMenuElement *> *categories = [NSMutableArray array];
    for (NSUInteger index = 0; index < definitions.count; index++) {
        NSDictionary<NSString *, id> *definition = definitions[index];
        NSString *title = [definition[@"title"] isKindOfClass:NSString.class] ? definition[@"title"] : nil;
        if (!title.length) continue;
        NSString *route = [definition[@"route"] isKindOfClass:NSString.class] ? definition[@"route"] : title;
        NSString *symbol = [definition[@"symbol"] isKindOfClass:NSString.class] ? definition[@"symbol"] : @"circle";
        UIAction *action = [UIAction actionWithTitle:title
                                               image:[UIImage systemImageNamed:symbol]
                                          identifier:nil
                                             handler:^(__unused UIAction *menuAction) {
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.16 * NSEC_PER_SEC)),
                           dispatch_get_main_queue(), ^{
                AWEActivateQuickMenuDestination(route);
            });
        }];
        action.state = (NSInteger)index == selected ? UIMenuElementStateOn : UIMenuElementStateOff;
        [categories addObject:action];
    }
    NSMutableArray<UIMenuElement *> *elements = [NSMutableArray array];
    if (categories.count > 0) {
        [elements addObject:[UIMenu menuWithTitle:@""
                                            image:nil
                                       identifier:nil
                                          options:UIMenuOptionsDisplayInline
                                         children:categories]];
    }
    __weak UIView *weakContainer = container;
    [elements addObject:[UIAction actionWithTitle:@"侧边栏"
                                            image:[UIImage systemImageNamed:@"sidebar.left"]
                                       identifier:nil
                                          handler:^(__unused UIAction *menuAction) {
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.16 * NSEC_PER_SEC)),
                       dispatch_get_main_queue(), ^{
            UIView *live = weakContainer;
            if (live) ALB3TopForwardOwner(live, NO);
        });
    }]];
    [elements addObjectsFromArray:ALBColumnMenuItems(container)];
    return elements;
}

static void ALB3RemoveTopChrome(UIView *container) {
    ALB3TopChromeView *chrome = ALB3TopChromeForContainer(container);
    // 3.3: Douyin's search recognizer goes back before its carrier goes away.
    UIGestureRecognizer *searchGesture = gAWESharedSearchGesture;
    if (searchGesture && (!searchGesture.view || (chrome && [searchGesture.view isDescendantOfView:chrome])))
        AWERestoreSharedSearchGestureToOriginal(@"top.remove");
    if (chrome) {
        ALB3RegisterEdge(chrome, nil, 1);
        [chrome removeFromSuperview];
        objc_setAssociatedObject(container, &kALB3TopChromeKey, nil,
                                 OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    ALB3SetTopContainerMasked(container, NO);
}

/* 3.3: the top search button carries Douyin's own search recognizer, the way
   the bottom search capsule does, so the real touch opens search. Forwarding
   from the button's action alone did nothing on Douyin 39.9. */
static UIView *ALB33TopSearchControl(UIView *chrome) {
    if (!chrome.window || chrome.hidden || chrome.alpha <= 0.01 || AWEHideTopSearchButtonEnabled()) return nil;
    UIView *best = nil;
    CGFloat bestX = -CGFLOAT_MAX;
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:chrome];
    for (NSUInteger index = 0; index < queue.count && index < 300; index++) {
        UIView *view = queue[index];
        // Only the navigation bar's items; never a category of the group.
        if ([view isKindOfClass:UITabBar.class]) continue;
        if (view != chrome && [view isKindOfClass:UIControl.class] && !view.hidden && view.alpha > 0.01 &&
            CGRectGetWidth(view.bounds) > 1 && CGRectGetWidth(view.bounds) < 90 &&
            CGRectGetHeight(view.bounds) < 90) {
            CGFloat x = CGRectGetMidX([view convertRect:view.bounds toView:chrome]);
            if (x > bestX) { bestX = x; best = view; }
            continue;
        }
        [queue addObjectsFromArray:view.subviews];
    }
    return bestX > CGRectGetWidth(chrome.bounds) * 0.6 ? best : nil;
}
static BOOL ALB33SearchGestureLeasedInto(UIView *root) {
    UIView *view = gAWESharedSearchGesture.view;
    return root && view && [view isDescendantOfView:root];
}
/* When Douyin's leased recognizer last recognized a tap: the button's own
   action forwards only when the real recognizer did not take the touch. */
static CFTimeInterval gALB33SearchRecognizedAt;
@interface ALB33SearchFireObserver : NSObject
+ (instancetype)shared;
- (void)recognized:(UIGestureRecognizer *)gesture;
@end
@implementation ALB33SearchFireObserver
+ (instancetype)shared {
    static ALB33SearchFireObserver *observer;
    static dispatch_once_t once;
    dispatch_once(&once, ^{ observer = [ALB33SearchFireObserver new]; });
    return observer;
}
- (void)recognized:(UIGestureRecognizer *)gesture {
    if (gesture.state == UIGestureRecognizerStateEnded) gALB33SearchRecognizedAt = CACurrentMediaTime();
}
@end
static void ALB33ObserveSearchGesture(UIGestureRecognizer *gesture) {
    static char observedKey;
    if (!gesture || objc_getAssociatedObject(gesture, &observedKey)) return;
    [gesture addTarget:[ALB33SearchFireObserver shared] action:@selector(recognized:)];
    objc_setAssociatedObject(gesture, &observedKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
}

static void ALB3RefreshTopChrome(UIView *container) {
    if (!container) return;
    BOOL wanted = container.window && ALB3ChromeAvailable() &&
        AWEPluginFeaturesEnabled() && AWETopGlassEnabled();
    if (!wanted) {
        ALB3RemoveTopChrome(container);
        return;
    }
    ALB3ObserveTopOptionsOnce();
    ALB3TopChromeView *chrome = ALB3TopChromeForContainer(container);
    if (!chrome) {
        Class chromeClass = NSClassFromString(@"ALB3TopChromeView");
        if (!chromeClass) return;
        chrome = [[chromeClass alloc] initWithFrame:container.frame];
        objc_setAssociatedObject(container, &kALB3TopChromeKey, chrome,
                                 OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        __weak UIView *weakContainer = container;
        chrome.onSelectIndex = ^(NSInteger index) {
            UIView *live = weakContainer;
            if (live) ALB3TopSelectIndex(live, index);
        };
        __weak ALB3TopChromeView *weakChrome = chrome;
        chrome.onSearch = ^{
            // 3.3: Douyin's own recognizer rides this touch. Its action and the
            // button's run in either order, so look shortly after: forward
            // only if the real recognizer did not recognize this tap.
            CFTimeInterval tapped = CACurrentMediaTime();
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.25 * NSEC_PER_SEC)),
                           dispatch_get_main_queue(), ^{
                if (ALB33SearchGestureLeasedInto(weakChrome) &&
                    gALB33SearchRecognizedAt > tapped - 0.6) return;
                UIView *live = weakContainer;
                if (live) ALB3TopForwardOwner(live, YES);
            });
        };
        chrome.onLeftPrimary = ^{
            UIView *live = weakContainer;
            if (live) ALB3TopForwardOwner(live, NO);
        };
        chrome.menuElementsProvider = ^NSArray<UIMenuElement *> *{
            UIView *live = weakContainer;
            return live ? ALB3TopMenuElements(live) : @[];
        };
    }
    ALB3SetTopContainerMasked(container, YES);
    ALB3MirrorTopChrome(container);
    // Its taps are its own: Douyin's tap recognizers above it never see them.
    ALB3ProtectGlassTouch(chrome, container.superview);
    [chrome applyConfiguration:ALB3TopConfiguration()];
    NSArray<NSDictionary<NSString *, id> *> *definitions =
        AWEDynamicTopQuickMenuDefinitions(container);
    objc_setAssociatedObject(container, &kALB3TopDefinitionsKey, definitions,
                             OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    NSMutableArray<NSString *> *titles = [NSMutableArray arrayWithCapacity:definitions.count];
    for (NSDictionary<NSString *, id> *definition in definitions) {
        NSString *title = [definition[@"title"] isKindOfClass:NSString.class] ? definition[@"title"] : @"";
        [titles addObject:title];
    }
    NSInteger selected = ALB3SelectedTopIndex(container, definitions);
    if (selected == NSNotFound) selected = chrome.selectedIndex;
    selected = MAX(0, MIN(selected, (NSInteger)titles.count - 1));
    [chrome applyTitles:titles selectedIndex:selected];
    UIView *searchControl = ALB3TopContainerShowing(container) ? ALB33TopSearchControl(chrome) : nil;
    UIView *searchOwner = searchControl ? AWEFindTopOwnerCandidate(container, YES) : nil;
    UIGestureRecognizer *leased = gAWESharedSearchGesture;
    // Never mid-touch: a long press on the bottom capsule keeps its recognizer.
    BOOL idle = !leased || (leased.state == UIGestureRecognizerStatePossible && leased.numberOfTouches == 0);
    if (searchControl && searchOwner && idle && !ALB33SearchGestureLeasedInto(searchControl) &&
        AWELeaseSharedSearchGestureToView(searchControl, searchOwner, @"top.bind"))
        ALB33ObserveSearchGesture(gAWESharedSearchGesture);
    // 3.3: a channel reached by swiping also re-decides the bottom bar's style.
    static char lastChannelKey;
    NSString *channelTitle = titles.count ? titles[(NSUInteger)selected] : nil;
    if (channelTitle && ALB3TopContainerShowing(container) &&
        ![channelTitle isEqualToString:objc_getAssociatedObject(container, &lastChannelKey)]) {
        objc_setAssociatedObject(container, &lastChannelKey, channelTitle, OBJC_ASSOCIATION_COPY_NONATOMIC);
        if (gAWEAlbumMorphController)
            AWEApplyAlbumMorphResolvedAppearance(container.window, gAWEAlbumMorphController.currentOriginalIndex);
    }
    chrome.rowCenterY = ALB3TopRowCenterY(container, definitions);
    // 3.7: lifted glass is never registered (the feed's top edge effect is
    // hidden by ALB37GlassLayer.h instead).
    ALB37RefreshChromeRegistration(chrome, container);
    // 3.5: the top chrome's own bar-item glass, for "right.glassSource" 1.
    ALB25MaterialCaptureRegisteredGlass(chrome);
    gALB32InkTopContainer = container;
    objc_setAssociatedObject(container, &kALB3TopLastRefreshKey, @(CACurrentMediaTime()),
                             OBJC_ASSOCIATION_RETAIN_NONATOMIC);
}

/* Coalesced, at most every 0.25 s; geometry is mirrored on every layout. */
static void ALB3ScheduleTopChromeRefresh(UIView *container) {
    if (!container ||
        [objc_getAssociatedObject(container, &kALB3TopRefreshPendingKey) boolValue]) return;
    objc_setAssociatedObject(container, &kALB3TopRefreshPendingKey, @YES,
                             OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    double last = [objc_getAssociatedObject(container, &kALB3TopLastRefreshKey) doubleValue];
    double wait = MAX(0.0, 0.25 - (CACurrentMediaTime() - last));
    __weak UIView *weakContainer = container;
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(wait * NSEC_PER_SEC)),
                   dispatch_get_main_queue(), ^{
        UIView *live = weakContainer;
        if (!live) return;
        objc_setAssociatedObject(live, &kALB3TopRefreshPendingKey, nil,
                                 OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        ALB3RefreshTopChrome(live);
    });
}

/* Douyin fills its titles in over the first moments; refresh a few times. */
static void ALB3ScheduleTopChromeSettle(UIView *container) {
    ALB3ScheduleTopChromeRefresh(container);
    __weak UIView *weakContainer = container;
    for (NSNumber *delay in @[@0.35, @0.9, @2.0]) {
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(delay.doubleValue * NSEC_PER_SEC)),
                       dispatch_get_main_queue(), ^{
            UIView *live = weakContainer;
            if (live) ALB3ScheduleTopChromeRefresh(live);
        });
    }
}

/* Douyin moved its selected-category underline: follow it. */
static void ALB3TopIndicatorMoved(UIView *indicator) {
    UIView *container = nil;
    for (UIView *cursor = indicator.superview; cursor; cursor = cursor.superview) {
        if ([NSStringFromClass(cursor.class) isEqualToString:@"AWEFeedTopBarContainer"]) {
            container = cursor;
            break;
        }
    }
    ALB3TopChromeView *chrome = ALB3TopChromeForContainer(container);
    if (!chrome) return;
    NSInteger selected = ALB3TopIndexForIndicator(container, indicator, ALB3TopDefinitions(container));
    if (selected != NSNotFound && selected != chrome.selectedIndex) {
        [chrome showSelectedIndex:selected];
    }
}


#include "ALB22NativeEndpoint.h"
// TEST24: resolve a real method from the receiver's runtime class. Some
// receivers expose a method in the class list but not through NSObject's
// reflection path; the old code reported every rejection as "no entry".
/* Native minimize geometry trace (diagnostics only). Bottom-bar scaling is
   removed, so the canvas carries only the vertical offset. One compact row
   per phase: canvas, controller root, bar and every direct bar child
   (platters/carriers), local + window geometry. */
void ALB49TraceNativeScale(UITabBar *bar, const char *phase) {
    if (!bar || !NSThread.isMainThread || !AWEInteractionDiagnosticsEnabled()) return;
    UIView *canvas = nil;
    for (UIView *v = bar.superview; v; v = v.superview)
        if ([v.accessibilityIdentifier isEqualToString:@"AwemeLiquidBar.BottomScaleCanvas"]) { canvas = v; break; }
    NSMutableArray *children = [NSMutableArray array];
    for (UIView *child in bar.subviews) {
        if (children.count >= 8) break;
        CALayer *shown = child.layer.presentationLayer;
        [children addObject:[NSString stringWithFormat:@"%@ hidden=%d a=%.2f frame=%@ bounds=%@ t=%@ pres=%@ win=%@",
            NSStringFromClass(object_getClass(child)), child.hidden, child.alpha,
            NSStringFromCGRect(child.frame), NSStringFromCGRect(child.bounds),
            NSStringFromCGAffineTransform(child.transform),
            shown ? NSStringFromCGRect(shown.frame) : @"-",
            NSStringFromCGRect([child convertRect:child.bounds toView:nil])]];
    }
    AWEInteractionDiagnosticWrite(@"NATIVE_SCALE_TRACE phase=%s canvasT=%@ root=%@ rootT=%@ bar=%@ barT=%@ barWin=%@ children=%@",
        phase ?: "?",
        canvas ? NSStringFromCGAffineTransform(canvas.transform) : @"-",
        NSStringFromCGRect(bar.superview.frame), NSStringFromCGAffineTransform(bar.superview.transform),
        NSStringFromCGRect(bar.frame), NSStringFromCGAffineTransform(bar.transform),
        NSStringFromCGRect([bar convertRect:bar.bounds toView:nil]), children);
}

static NSMutableArray<NSString *> *gALB23NativeAttemptNotes;
static BOOL ALB23ReadNativeBool(id target, NSString *name, BOOL *result) {
    if (!target || !result) return NO;
    SEL selector = NSSelectorFromString(name);
    Method method = class_getInstanceMethod(object_getClass(target), selector);
    ALB23NativeBoolABI abi;
    if (!method || !ALB23ParseNativeBoolABI(method_getTypeEncoding(method),
        method_getNumberOfArguments(method), false, &abi)) return NO;
    @try {
        if (abi.result == 'B') *result = ((bool (*)(id,SEL))(void (*)(void))objc_msgSend)(target,selector) ? YES : NO;
        else *result = ((signed char (*)(id,SEL))(void (*)(void))objc_msgSend)(target,selector) ? YES : NO;
        return YES;
    } @catch (__unused NSException *exception) { return NO; }
}
static BOOL AWEInvokeAlbumMorphBoolAnimatedSelector(id target,NSString *name,BOOL value,BOOL animated) {
    if (!target) return NO;
    SEL selector = NSSelectorFromString(name);
    Method method = class_getInstanceMethod(object_getClass(target), selector);
    if (!method) return NO;
    const char *types = method_getTypeEncoding(method);
    ALB23NativeBoolABI abi;
    if (!ALB23ParseNativeBoolABI(types,method_getNumberOfArguments(method),true,&abi)) {
        if (gALB23NativeAttemptNotes.count < 16)
            [gALB23NativeAttemptNotes addObject:[NSString stringWithFormat:@"%@ %@：ABI拒绝 [%s]",
                NSStringFromClass(object_getClass(target)),name,types ?: "?"]];
        return NO;
    }
    @try {
        // Match the exact B/c ABI, including mixed encodings on legacy helpers.
        // No guessed NSInteger/block/object signatures and no NSInvocation.
        if (abi.arguments == 3) {
            if (abi.value == 'B') ((void (*)(id,SEL,bool))(void (*)(void))objc_msgSend)(target,selector,value != NO);
            else ((void (*)(id,SEL,signed char))(void (*)(void))objc_msgSend)(target,selector,(signed char)(value != NO));
        } else if (abi.value == 'B' && abi.animated == 'B') {
            ((void (*)(id,SEL,bool,bool))(void (*)(void))objc_msgSend)(target,selector,value != NO,animated != NO);
        } else if (abi.value == 'c' && abi.animated == 'c') {
            ((void (*)(id,SEL,signed char,signed char))(void (*)(void))objc_msgSend)(target,selector,(signed char)(value != NO),(signed char)(animated != NO));
        } else if (abi.value == 'B') {
            ((void (*)(id,SEL,bool,signed char))(void (*)(void))objc_msgSend)(target,selector,value != NO,(signed char)(animated != NO));
        } else {
            ((void (*)(id,SEL,signed char,bool))(void (*)(void))objc_msgSend)(target,selector,(signed char)(value != NO),animated != NO);
        }
        AWEAlbumMorphProbeWrite(@"NATIVE_REQUEST_API selector=%@ target=%@ encoding=%s requested=%d accepted=1 observed=separate animated=%d",
            name,NSStringFromClass(object_getClass(target)),types ?: "?",value,animated);
        return YES;
    } @catch (NSException *exception) {
        if (gALB23NativeAttemptNotes.count < 16)
            [gALB23NativeAttemptNotes addObject:[NSString stringWithFormat:@"%@ %@：调用异常 %@ %@",
                NSStringFromClass(object_getClass(target)),name,exception.name,exception.reason ?: @""]];
        AWEAlbumMorphProbeWrite(@"NATIVE_REQUEST_EXCEPTION selector=%@ name=%@ reason=%@",name,exception.name,exception.reason);
        return NO;
    }
}
int32_t AWEAlbumMorphRequestNativeMinimized(UIViewController *controller,int32_t value,int32_t animation) {
    if (!NSThread.isMainThread || ![controller isKindOfClass:UITabBarController.class] ||
        !controller.viewIfLoaded.window) return 0;
    UITabBarController *owner=(UITabBarController *)controller;
    if (!AWEIsAlbumMorphSystemBar(owner.tabBar)) return 0;
    static BOOL requestInProgress = NO;
    if (requestInProgress) return 0;
    requestInProgress = YES;
    gALB23NativeAttemptNotes = [NSMutableArray array];
    @try {
        NSArray<NSString *> *selectors=@[@"_setMinimized:animated:",@"_setTabBarMinimized:animated:",
            @"setTabBarMinimized:animated:",@"setMinimized:animated:",
            @"_setTabBarMinimized:",@"setTabBarMinimized:",@"_setMinimized:",@"setMinimized:"];
        NSArray *targets = ALB22OwnedMinimizeTargets(owner);
        for (NSString *selector in selectors) for (id target in targets) {
            if (AWEInvokeAlbumMorphBoolAnimatedSelector(target,selector,value!=0,animation!=0)) {
                ALB22RememberNativeEndpoint(owner,target,selector,value!=0);
                return 1;
            }
        }
        objc_setAssociatedObject(owner, &kALB22NativeEndpointKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        gALB22NativeRequestStatus = [NSString stringWithFormat:@"请求=%@；未成功派发；具体拒绝=%@；%@",
            value ? @"收缩" : @"展开",gALB23NativeAttemptNotes.count ? [gALB23NativeAttemptNotes componentsJoinedByString:@" | "] : @"未找到签名匹配的方法",
            ALB22DescribeMinimizeCapabilities(targets)];
        AWEAlbumMorphProbeWrite(@"NATIVE_REQUEST_UNSUPPORTED controller=%@ os=%@ fallback=NONE detail=%@",
            NSStringFromClass(owner.class),UIDevice.currentDevice.systemVersion,gALB22NativeRequestStatus);
        return 0;
    } @finally {
        requestInProgress = NO;
        gALB23NativeAttemptNotes = nil;
    }
}
FOUNDATION_EXPORT int32_t ALBNativeCarrierMinimizedState(UITabBar *bar);
int32_t ALB15NativeMinimizedState(UIViewController *controller) {
    if (!NSThread.isMainThread || ![controller isKindOfClass:UITabBarController.class]) return -1;
    UITabBarController *owner=(UITabBarController *)controller;
    // READBACK (device-confirmed): _isMinimized is unavailable on iOS 26.6 and
    // the old fallbacks read "expanded" during the ~0.8 s native carrier
    // overlap, which re-issued _setMinimized:YES mid-animation (the collapse
    // overshoots, then springs back). Resident carrier visibility is
    // authoritative when both carriers are found (read-only).
    int32_t carrierState=ALBNativeCarrierMinimizedState(owner.tabBar);
    if (carrierState>=0) return carrierState;
    BOOL result=NO;
    if (ALB23ReadNativeBool(owner.tabBar,@"_isMinimized",&result)) return result ? 1 : 0;
    for (id target in ALB22NativeReadbackTargets(owner))
        for (NSString *name in @[@"isTabBarMinimized",@"_isTabBarMinimized",@"isMinimized",@"_isMinimized",@"minimized"])
            if (ALB23ReadNativeBool(target,name,&result)) return result ? 1 : 0;
    return -1;
}

static void AWEApplyAlbumMorphOriginalSuppression(UIView *originalBar,
                                                    BOOL suppress) {
    UIView *previous = gAWEAlbumMorphSuppressedOriginalBar;
    if (previous && previous != originalBar) {
        NSNumber *opacity = objc_getAssociatedObject(
            previous, &kAWEAlbumMorphOriginalOpacityKey);
        NSNumber *interaction = objc_getAssociatedObject(
            previous, &kAWEAlbumMorphOriginalInteractionKey);
        if (opacity) previous.layer.opacity = opacity.floatValue;
        if (interaction) {
            previous.userInteractionEnabled = interaction.boolValue;
        }
        objc_setAssociatedObject(previous,
                                 &kAWEAlbumMorphOriginalOpacityKey,
                                 nil,
                                 OBJC_ASSOCIATION_ASSIGN);
        objc_setAssociatedObject(previous,
                                 &kAWEAlbumMorphOriginalInteractionKey,
                                 nil,
                                 OBJC_ASSOCIATION_ASSIGN);
    }

    if (!originalBar) {
        gAWEAlbumMorphSuppressedOriginalBar = nil;
        return;
    }

    if (suppress) {
        if (!objc_getAssociatedObject(
                originalBar, &kAWEAlbumMorphOriginalOpacityKey)) {
            objc_setAssociatedObject(
                originalBar,
                &kAWEAlbumMorphOriginalOpacityKey,
                @(originalBar.layer.opacity),
                OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }
        if (!objc_getAssociatedObject(
                originalBar, &kAWEAlbumMorphOriginalInteractionKey)) {
            objc_setAssociatedObject(
                originalBar,
                &kAWEAlbumMorphOriginalInteractionKey,
                @(originalBar.userInteractionEnabled),
                OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }
        originalBar.layer.opacity = 0.0f;
        originalBar.userInteractionEnabled = NO;


        gAWEAlbumMorphSuppressedOriginalBar = originalBar;
    } else {
        NSNumber *opacity = objc_getAssociatedObject(
            originalBar, &kAWEAlbumMorphOriginalOpacityKey);
        NSNumber *interaction = objc_getAssociatedObject(
            originalBar, &kAWEAlbumMorphOriginalInteractionKey);
        if (opacity) originalBar.layer.opacity = opacity.floatValue;
        if (interaction) {
            originalBar.userInteractionEnabled = interaction.boolValue;
        }
        objc_setAssociatedObject(originalBar,
                                 &kAWEAlbumMorphOriginalOpacityKey,
                                 nil,
                                 OBJC_ASSOCIATION_ASSIGN);
        objc_setAssociatedObject(originalBar,
                                 &kAWEAlbumMorphOriginalInteractionKey,
                                 nil,
                                 OBJC_ASSOCIATION_ASSIGN);
        if (gAWEAlbumMorphSuppressedOriginalBar == originalBar) {
            gAWEAlbumMorphSuppressedOriginalBar = nil;
        }
    }
}

static void AWEAlignAlbumMorphOverlayToOriginalBar(
    UIView *originalBar,
    UIWindow *sourceWindow,
    UIWindow *overlayWindow) {
    (void)originalBar;
    if (!sourceWindow || !overlayWindow || !gAWEAlbumMorphController.tabBar) {
        return;
    }

    if (AWEAlbumMorphUsesSameWindowHost()) {
        if (!AWEIOS27EnsureNativeSameWindowHost(sourceWindow)) return;
        // EnsureNativeSameWindowHost already reconciles the unscaled host
        // bounds and center. Repeating those writes invalidates the managed
        // tab controller's layout on every visibility/alignment callback.
        CGFloat savedOffset = AWEStoredVerticalOffset();
        [gAWEAlbumMorphController setVerticalOffset:savedOffset];
        gAWEAlbumMorphLastAlignedFrame = sourceWindow.bounds;
        gAWEAlbumMorphLastAlignedSourceWindow = sourceWindow;
        return;
    }

    /* Keep the overlay window permanently coincident with the host window.
       Moving the whole UIWindow caused UIKit to repeatedly recompute the
       managed UITabBar geometry during navigation and route recovery. The
       user offset now belongs only to the tab bar inside its controller. */
    CGRect targetFrame = sourceWindow.bounds;
    BOOL changed =
        gAWEAlbumMorphLastAlignedSourceWindow != sourceWindow ||
        fabs(CGRectGetMinX(overlayWindow.frame) - CGRectGetMinX(targetFrame)) > 0.25 ||
        fabs(CGRectGetMinY(overlayWindow.frame) - CGRectGetMinY(targetFrame)) > 0.25 ||
        fabs(CGRectGetWidth(overlayWindow.frame) - CGRectGetWidth(targetFrame)) > 0.25 ||
        fabs(CGRectGetHeight(overlayWindow.frame) - CGRectGetHeight(targetFrame)) > 0.25;

    if (changed) {
        [CATransaction begin];
        [CATransaction setDisableActions:YES];
        overlayWindow.transform = CGAffineTransformIdentity;
        overlayWindow.frame = targetFrame;
        [CATransaction commit];
        gAWEAlbumMorphLastAlignedFrame = targetFrame;
        gAWEAlbumMorphLastAlignedSourceWindow = sourceWindow;
    }

    CGFloat savedOffset = AWEStoredVerticalOffset();
    static CGFloat lastAppliedOffset = CGFLOAT_MAX;
    static __weak id lastOffsetController = nil;
    BOOL offsetChanged = lastOffsetController != gAWEAlbumMorphController ||
        fabs(lastAppliedOffset - savedOffset) > 0.01;
    if (offsetChanged) {
        [gAWEAlbumMorphController setVerticalOffset:savedOffset];
        lastAppliedOffset = savedOffset;
        lastOffsetController = gAWEAlbumMorphController;
    }
    if (changed || offsetChanged) {
        AWEAlbumMorphProbeWrite(
            @"HEIGHT_SYNC_FIXED saved=%.2f overlay=%@ tabBar=%@",
            savedOffset,
            NSStringFromCGRect(overlayWindow.frame),
            NSStringFromCGRect(gAWEAlbumMorphController.tabBar.frame));
    }
}


/* 3.2: what 2.5.3's appearance pass told the right column's material:
   whether the target page is a video feed (Clear modes draw Clear only
   there), the stable Light/Dark of the Home chrome (2.5.3's resolved style:
   Dark on the video feed, the app's style elsewhere), and the bottom bar's
   own realized glass, which 2.5.3's right buttons copy ("bar-material").
   The bottom bar itself is untouched. */
static void ALB32NoteRightColumnAppearance(UIWindow *sourceWindow, NSInteger originalIndex,
                                           AWEBottomRouteKind route) {
    if (AWEOperatingSystemMajorVersion() < 26) return;
    UIWindow *window = sourceWindow ?: AWEActiveMainWindow();
    BOOL videoRoute = route != AWEBottomRouteShop && route != AWEBottomRouteGrid;
    BOOL video = videoRoute && (originalIndex == 0 || (originalIndex == 1 && !AWESecondTabIsShop()));
    ALB25MaterialNoteVideoContext(video);
    // 2.5.3's AWEAlbumMorphResolvedInterfaceStyle: feed protection, then the
    // chosen appearance of the material.
    UIUserInterfaceStyle style;
    if (ALB25MaterialEnabled())
        style = video ? UIUserInterfaceStyleDark : ALB25MaterialStyle(window, NO);
    else
        style = video ? UIUserInterfaceStyleDark : AWEAppResolvedAppearanceStyle(window);
    if ((style == UIUserInterfaceStyleLight || style == UIUserInterfaceStyleDark) &&
        gAWEHomeChromeLastStableStyle != style &&
        AWEOriginalBarSteadyWantsVisible((UIView *)gAWELastTabBar)) {
        gAWEHomeChromeLastStableStyle = style;
        AWERefreshRegisteredAdaptiveGlassButtons();
    }
    UITabBar *bar = gAWEAlbumMorphController.tabBar;
    ALB25MaterialCaptureBarGlass(bar);
    // UIKit realizes the platter glass on its next layout (one pending read).
    static BOOL captureScheduled;
    if (captureScheduled) return;
    captureScheduled = YES;
    __weak UITabBar *weakBar = bar;
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.35 * NSEC_PER_SEC)),
                   dispatch_get_main_queue(), ^{ captureScheduled = NO; ALB25MaterialCaptureBarGlass(weakBar); });
}

/* 3.4: the page's own Light/Dark, read from what the page draws. Douyin's
   dark theme is its own, so neither the scene's nor the window's trait is
   reliable (3.3 read the window's and got Light on a dark page). The
   deepest full-width view under the screen's lower middle with an opaque
   background decides; every answer is kept per tab, and Douyin's theme is
   one for all pages, so the last answer seeds a tab not seen yet. */
static CFTimeInterval gALB34TabTapUntil;
static UIUserInterfaceStyle gALB34PageStyleByTab[5];
static UIUserInterfaceStyle gALB34LastPageStyle;
/* The deepest tall (60 % of the screen), full-width, opaque fill under the
   point, in the frontmost branch that has one: the page's own background,
   not a black ancestor behind it and not a short coloured banner on it.
   A transparent layer in front that holds none is looked behind. */
static UIColor *ALB34PageFillIn(UIView *view, CGPoint point, UIWindow *window,
                                NSUInteger depth, NSUInteger *budget) {
    if (depth > 40) return nil;
    CGFloat width = CGRectGetWidth(window.bounds), height = CGRectGetHeight(window.bounds);
    for (UIView *child in view.subviews.reverseObjectEnumerator) {
        if (*budget == 0) return nil;
        (*budget)--;
        if (child.hidden || child.alpha < 0.05 || ALBIsOwnedView(child)) continue;
        CGRect frame = [child convertRect:child.bounds toView:window];
        if (!CGRectContainsPoint(frame, point)) continue;
        UIColor *own = nil;
        UIColor *color = child.backgroundColor;
        if (color && CGRectGetWidth(frame) >= width * 0.8 && CGRectGetHeight(frame) >= height * 0.6) {
            UIColor *resolved = [color resolvedColorWithTraitCollection:child.traitCollection];
            CGFloat r = 0, g = 0, b = 0, a = 0;
            if ([resolved getRed:&r green:&g blue:&b alpha:&a] && a >= 0.6) own = resolved;
        }
        UIColor *inner = ALB34PageFillIn(child, point, window, depth + 1, budget);
        if (inner) return inner;
        if (own) return own;
    }
    return nil;
}
static UIUserInterfaceStyle ALB34DetectVisiblePageStyle(UIWindow *window) {
    if (!window) return UIUserInterfaceStyleUnspecified;
    CGPoint point = CGPointMake(CGRectGetWidth(window.bounds) * 0.5, CGRectGetHeight(window.bounds) * 0.6);
    NSUInteger budget = 500;
    UIColor *found = ALB34PageFillIn(window, point, window, 0, &budget);
    if (!found) return UIUserInterfaceStyleUnspecified;
    CGFloat r = 0, g = 0, b = 0, a = 0;
    [found getRed:&r green:&g blue:&b alpha:&a];
    CGFloat luma = 0.299 * r + 0.587 * g + 0.114 * b;
    if (luma < 0.42) return UIUserInterfaceStyleDark;
    if (luma > 0.58) return UIUserInterfaceStyleLight;
    return UIUserInterfaceStyleUnspecified;
}
static UIUserInterfaceStyle ALB33PageAppearanceStyle(UIWindow *window, NSInteger index) {
    BOOL known = index >= 0 && index < 5;
    // Right after a tab tap the old page is still on screen: use what is known.
    CFTimeInterval now = CACurrentMediaTime();
    if (now >= gALB34TabTapUntil) {
        // This runs from every native bar layout: one walk per 0.25 s.
        static CFTimeInterval detectedAt;
        static NSInteger detectedIndex = -1;
        static UIUserInterfaceStyle detectedStyle;
        if (detectedIndex != index || now - detectedAt > 0.25) {
            detectedStyle = ALB34DetectVisiblePageStyle(window);
            detectedIndex = index;
            detectedAt = now;
        }
        UIUserInterfaceStyle detected = detectedStyle;
        if (detected == UIUserInterfaceStyleLight || detected == UIUserInterfaceStyleDark) {
            if (known) gALB34PageStyleByTab[index] = detected;
            gALB34LastPageStyle = detected;
            return detected;
        }
    }
    if (known && (gALB34PageStyleByTab[index] == UIUserInterfaceStyleLight ||
                  gALB34PageStyleByTab[index] == UIUserInterfaceStyleDark)) return gALB34PageStyleByTab[index];
    if (gALB34LastPageStyle == UIUserInterfaceStyleLight || gALB34LastPageStyle == UIUserInterfaceStyleDark)
        return gALB34LastPageStyle;
    return AWEAppResolvedAppearanceStyle(window);
}

static void AWEApplyAlbumMorphResolvedAppearance(
    UIWindow *sourceWindow,
    NSInteger originalIndex) {
    if (!gAWEAlbumMorphController) return;
    /* 3.3: Dark only on the video feeds (Home, Friends; not a Home channel
       without video). Every other page takes the app's appearance at once.
       3.0-3.2 kept the bar Dark everywhere, so on a light page UIKit only
       re-adapted the glass to the content after a delay. */
    UIWindow *styleWindow = sourceWindow ?: AWEActiveMainWindow();
    // The route walk is the heaviest part and this runs from every native bar
    // layout: reuse a result younger than 0.1 s for the same window.
    static __weak UIWindow *routeWindow;
    static CFTimeInterval routeTime;
    static AWEBottomRouteKind cachedRoute;
    CFTimeInterval routeNow = CACurrentMediaTime();
    if (routeWindow != styleWindow || routeNow - routeTime > 0.1) {
        cachedRoute = AWEBottomRouteForWindow(styleWindow);
        routeWindow = styleWindow;
        routeTime = routeNow;
    }
    AWEBottomRouteKind styleRoute = cachedRoute;
    BOOL styleVideoRoute = styleRoute != AWEBottomRouteShop && styleRoute != AWEBottomRouteGrid;
    BOOL videoFeed = styleVideoRoute && ((originalIndex == 0 && ALB33HomeChannelIsVideo()) ||
        (originalIndex == 1 && !AWESecondTabIsShop()));
    UIUserInterfaceStyle style = videoFeed ? UIUserInterfaceStyleDark : ALB33PageAppearanceStyle(styleWindow, originalIndex);
    if (style != UIUserInterfaceStyleLight && style != UIUserInterfaceStyleDark) style = UIUserInterfaceStyleDark;
    gAWEAlbumMorphLastAppliedStyle = style;
    if (gAWEAlbumMorphController.overrideUserInterfaceStyle != style ||
        gAWEAlbumMorphController.tabBar.overrideUserInterfaceStyle != style) {
        [UIView performWithoutAnimation:^{
            gAWEAlbumMorphController.overrideUserInterfaceStyle = style;
            gAWEAlbumMorphController.view.overrideUserInterfaceStyle = style;
            gAWEAlbumMorphController.tabBar.overrideUserInterfaceStyle = style;
        }];
    }
    ALB32NoteRightColumnAppearance(sourceWindow, originalIndex, styleRoute);
    ALB5ApplySharedBottomSurface(gAWEAlbumMorphController.tabBar);
    if (originalIndex == 4) {
        UIWindow *ownWindow = sourceWindow ?: AWEActiveMainWindow();
        // Only descend into the selected Me controller, never other cached tabs.
        UIViewController *ownController = (UIViewController *)gAWELastController;
        @try {
            id selected = [ownController valueForKey:@"selectedViewController"];
            if ([selected isKindOfClass:UIViewController.class]) ownController = selected;
        } @catch (__unused NSException *e) {}
        if (ALB8CaptureOwnProfileController(ownController)) ALB5CaptureOwnAvatar(ownWindow);
    }
    if (!AWEIsIOS27OrLater() && gAWEAlbumMorphOverlayWindow &&
        gAWEAlbumMorphOverlayWindow.overrideUserInterfaceStyle != style) {
        [UIView performWithoutAnimation:^{
            gAWEAlbumMorphOverlayWindow.overrideUserInterfaceStyle = style;
        }];
    }
}
#pragma mark - Photos-style native four-tab controller

@interface AWEAlbumMorphCoordinator : NSObject
@end

@implementation AWEAlbumMorphCoordinator

- (void)albumMorphDidRequestOriginalIndex:(NSInteger)index {
    gALB34TabTapUntil = CACurrentMediaTime() + 0.15;
    /* 3.11.45: "bottom.homeReselectColumns" (default off) lets the second tap on 首页 through, the way the
       three-part dock does, so Douyin toggles single / double column (the top-left menu's 单列 / 双列 uses it too). */
    if (index==0 && AWECurrentOriginalMainTabIndex()==0 && !ALB5Bool(@"bottom.homeReselectColumns", NO)) {
        AWEAlbumMorphProbeWrite(@"HOME_RESELECT_BLOCKED native grid toggle not forwarded");
        return;
    }

    AWENormalModeTabBar *originalBar = gAWELastTabBar;
    if (!originalBar && gAWELastController) {
        /* Fresh installs can materialize the transplanted native bar before
           the weak original-bar cache has been populated. Re-acquire the
           source bar from the controller instead of silently dropping taps. */
        originalBar = AWEPrepareBarForController(gAWELastController, NO);
        if (originalBar) gAWELastTabBar = originalBar;
    }

    AWEAlbumMorphOverlayWindow *overlay =
        (AWEAlbumMorphOverlayWindow *)gAWEAlbumMorphOverlayWindow;
    AWEInteractionDiagnosticWrite(
        @"ALBUM_MORPH_TAP_BEGIN index=%ld original=%@ controller=%@ native=%@ overlay=%@ content=%d",
        (long)index,
        AWEInteractionObjectSummary(originalBar),
        AWEInteractionObjectSummary(gAWELastController),
        AWEInteractionObjectSummary(gAWEAlbumMorphController ? gAWEAlbumMorphController.tabBar : nil),
        AWEInteractionObjectSummary(overlay),
        overlay ? overlay.contentVisible : 0);

    if (!originalBar) {
        AWEInteractionDiagnosticWrite(
            @"ALBUM_MORPH_TAP_END index=%ld result=NO reason=no-original-bar",
            (long)index);
        return;
    }

    UIWindow *sourceWindow = originalBar.window ?: AWEActiveMainWindow();
    AWEUpdateFriendsTabLatch(index);
    AWEApplyAlbumMorphResolvedAppearance(sourceWindow, index);

    if (index == 1 && !AWESecondTabIsShop()) {
        /* Preserve the native bar's layout footprint before Friends performs
           its first content layout. The bar stays visually suppressed by our
           layer-opacity path, but captions no longer initially fall under the
           replacement bar. */
        [UIView performWithoutAnimation:^{
            originalBar.hidden = NO;
            originalBar.alpha = 1.0;
        }];
        AWEApplyAlbumMorphOriginalSuppression((UIView *)originalBar, YES);
        [originalBar.superview setNeedsLayout];
        [originalBar.superview layoutIfNeeded];
    }

    if (index == 2) {
        gAWEAlbumMorphPublishLaunchSuppressionUntil =
            CACurrentMediaTime() + 300.0;
        gAWEAlbumMorphPublishSourceController =
            AWETopViewControllerFrom(sourceWindow.rootViewController);
        AWERestoreAlbumMorphSearchGesture();
        /* Restore the proven pre-1.0.46 publish isolation.  The overlay stays
           allocated/warm, but the UIWindow itself is hidden so it cannot own
           any hit-testing or transition snapshot while Douyin's creation flow
           is being presented/dismissed. */
        AWEHardSuspendAlbumMorphOverlay(@"publish.prehide");
        AWEAlbumMorphProbeWrite(@"PUBLISH_PREHIDE hard=1");
    }

    BOOL forwarded = AWEForwardToOriginalButton((UIView *)originalBar, index);
    if (!forwarded && gAWELastController) {
        AWENormalModeTabBar *fresh =
            AWEPrepareBarForController(gAWELastController, NO);
        if (fresh) {
            forwarded = AWEForwardToOriginalButton((UIView *)fresh, index);
        }
    }

    AWEInteractionDiagnosticWrite(
        @"ALBUM_MORPH_FORWARD index=%ld result=%d original=%@ controller=%@",
        (long)index, forwarded,
        AWEInteractionObjectSummary(originalBar),
        AWEInteractionObjectSummary(gAWELastController));

    if (index == 2 && !forwarded) {
        gAWEAlbumMorphPublishLaunchSuppressionUntil = 0.0;
        gAWEAlbumMorphPublishSourceController = nil;
        AWEForceAlbumMorphRouteRecovery(@"publish.forward.failed");
    }

    __weak UIWindow *weakSourceWindow = sourceWindow;
    for (NSNumber *delay in @[@0.0, @0.06, @0.18, @0.45]) {
        dispatch_after(dispatch_time(
            DISPATCH_TIME_NOW,
            (int64_t)(delay.doubleValue * NSEC_PER_SEC)),
            dispatch_get_main_queue(), ^{
                UIWindow *window = weakSourceWindow ?: AWEActiveMainWindow();
                if (gAWEAlbumMorphController.currentOriginalIndex == index) {
                    AWEApplyAlbumMorphResolvedAppearance(window, index);
                }
            });
    }
}

- (void)albumMorphDidRequestSearch {
    /* The UISearchTab delegate callback is NOT used as a synthetic business
       trigger in v18. By the time UIKit reaches this callback, hit-testing has
       already leased Douyin's real AWEAlphaTapGesture onto this search item,
       so that recognizer receives the same physical touch and ends normally. */
    UIGestureRecognizer *gesture = gAWESharedSearchGesture;
    UIView *barRoot = gAWEAlbumMorphController.viewIfLoaded;
    BOOL leasedToBar = gesture.view && barRoot && [gesture.view isDescendantOfView:barRoot];
    AWEInteractionDiagnosticWrite(
        @"ALBUM_MORPH_SEARCH_REAL_TOUCH recognizer=%@ view=%@ state=%ld leasedToBar=%d",
        gesture ? NSStringFromClass(gesture.class) : @"nil",
        AWEInteractionObjectSummary(gesture.view), (long)gesture.state, leasedToBar);
    if (leasedToBar) return;
    /* 3.0.1: UIKit identified the UISearchTab itself (identity, not geometry)
       but no real recognizer rides on its button, e.g. Search is drawn inline
       instead of in the separate capsule. Forward once to Douyin's search. */
    dispatch_async(dispatch_get_main_queue(), ^{
        if (gAWESharedSearchGesture)
            AWERestoreSharedSearchGestureToOriginal(@"bottom.search.identity-forward");
        UIWindow *window = gAWEIOS27NativeHostWindow ?: AWEActiveMainWindow();
        UIView *owner = AWEAlbumMorphSearchOwner(window);
        BOOL sent = owner ? AWEForwardTopActionOwner(owner, AWEHomeTopActionKindSearch) : NO;
        AWEInteractionDiagnosticWrite(@"ALBUM_MORPH_SEARCH_IDENTITY_FORWARD owner=%@ result=%d",
            AWEInteractionObjectSummary(owner), sent);
    });
}

@end

// The window owns an untransformed root. UIKit may assign that root's frame
// after foreground/scene changes; those assignments cannot change bar bounds.
@implementation ALB33BottomOverlayController
- (void)loadView {
    self.view=[[AWEIOS27NativeBarHostView alloc] initWithFrame:CGRectZero];
}
- (void)viewDidLoad {
    [super viewDidLoad];
    UIViewController *chrome=gAWEAlbumMorphController;
    [chrome loadViewIfNeeded];
    if (chrome.parentViewController && chrome.parentViewController!=self) {
        [chrome willMoveToParentViewController:nil];
        [chrome.view removeFromSuperview];
        [chrome removeFromParentViewController];
    }
    [self addChildViewController:chrome];
    chrome.view.transform=CGAffineTransformIdentity;
    chrome.view.autoresizingMask=UIViewAutoresizingNone;
    [((AWEIOS27NativeBarHostView *)self.view).scaleCanvas addSubview:chrome.view];
    [chrome didMoveToParentViewController:self];
}
@end

@implementation AWEIOS27NativeBarHostView

- (instancetype)initWithFrame:(CGRect)frame {
    if ((self=[super initWithFrame:frame])) {
        self.backgroundColor=UIColor.clearColor; self.opaque=NO; self.clipsToBounds=NO;
        self.scaleCanvas=[[UIView alloc] initWithFrame:self.bounds];
        self.scaleCanvas.backgroundColor=UIColor.clearColor;
        self.scaleCanvas.opaque=NO; self.scaleCanvas.clipsToBounds=NO;
        self.scaleCanvas.autoresizingMask=UIViewAutoresizingNone;
        self.scaleCanvas.accessibilityIdentifier=@"AwemeLiquidBar.BottomScaleCanvas";
        [self addSubview:self.scaleCanvas];
    }
    return self;
}
- (void)layoutSubviews {
    [super layoutSubviews];
    // Always derive model geometry from the unscaled owner, including restart,
    // rotation and scene resize. Never set frame on the transformed canvas.
    UIView *canvas=self.scaleCanvas;
    if (!CGRectEqualToRect(canvas.bounds,self.bounds)) canvas.bounds=self.bounds;
    CGPoint center=CGPointMake(CGRectGetMidX(self.bounds),CGRectGetMidY(self.bounds));
    if (!CGPointEqualToPoint(canvas.center,center)) canvas.center=center;
    UIView *chrome=gAWEAlbumMorphController.viewIfLoaded;
    if (chrome.superview==canvas) {
        if (!CGRectEqualToRect(chrome.bounds,self.bounds)) chrome.bounds=self.bounds;
        if (!CGPointEqualToPoint(chrome.center,center)) chrome.center=center;
    }
}

/* Same-window host is visually full-screen so UIKit can compose the managed
   UITabBar normally, but it only participates in hit-testing when the touch
   actually lands inside the real native UITabBar hierarchy. Everything else
   passes straight through to Douyin. */
- (UIView *)hitTest:(CGPoint)point withEvent:(UIEvent *)event {
    if (self.hidden || self.alpha <= 0.01 || !self.userInteractionEnabled ||
        !gAWEAlbumMorphController || !gAWEAlbumMorphController.tabBar) {
        return nil;
    }
    UITabBar *tabBar = gAWEAlbumMorphController.tabBar;
    if (!tabBar.window || tabBar.hidden || tabBar.alpha <= 0.01 ||
        !tabBar.userInteractionEnabled) return nil;
    CGPoint inBar = [self convertPoint:point toView:tabBar];
    UIView *nativeHit=ALB15NativeBottomHitView(tabBar,inBar,event);
    if (!nativeHit) return nil;
    if ([gAWEAlbumMorphController isNativeAvatarCompact]) {
        AWERestoreSharedSearchGestureToOriginal(@"native-avatar-press");
        return nativeHit; // Real UIKit hit, including press/lens deformation.
    }

    if ([AWEAlbumMorphVisibleItemIdentifiers() containsObject:@"search"]) {
        UIView *searchButton = AWEAlbumMorphSeparateSearchButton(tabBar);
        if (searchButton && ([nativeHit isDescendantOfView:searchButton] || [searchButton isDescendantOfView:nativeHit])) {
            CGRect searchFrame = [searchButton convertRect:searchButton.bounds
                                                     toView:tabBar];
            if (CGRectContainsPoint(CGRectInset(searchFrame, -2.0, -2.0), inBar)) {
                UIWindow *sourceWindow = gAWEIOS27NativeHostWindow ?: AWEActiveMainWindow();
                UIView *owner = gAWESharedSearchOwner;
                if (!owner || !owner.window) owner = AWEAlbumMorphSearchOwner(sourceWindow);
                AWELeaseSharedSearchGestureToView(
                    searchButton, owner, @"bottom.ios27.hit-test");
            }
        }
    }
    return nativeHit;
}

@end

@implementation AWEAlbumMorphOverlayWindow

/* The resident LiquidBar window is visual/touch chrome only. It must never
   become the app key window; allowing a higher-level overlay window to own key
   status can make Douyin's feed lifecycle treat the real player window as
   inactive, especially after foreground restore. */
- (BOOL)canBecomeKeyWindow {
    return NO;
}

- (UIView *)hitTest:(CGPoint)point withEvent:(UIEvent *)event {
    if (gAWEStableCleanScreenEnabled) return nil;
    AWEExternalBridgeMenuSlotView *downloadSlot = gAWEDownloadMenuSlot;
    if (downloadSlot && downloadSlot.window == self &&
        !downloadSlot.hidden && downloadSlot.alpha > 0.01 &&
        downloadSlot.userInteractionEnabled) {
        CGPoint pointInDownload = [self convertPoint:point toView:downloadSlot];
        if ([downloadSlot pointInside:pointInDownload withEvent:event]) {
            UIView *downloadHit = [downloadSlot hitTest:pointInDownload withEvent:event]
                ?: downloadSlot.menuButton ?: downloadSlot;
            if (AWEInteractionDiagnosticsEnabled() && event.type == UIEventTypeTouches) {
                AWEInteractionDiagnosticWrite(@"DOWNLOAD_BUTTON_HIT point=(%.1f,%.1f) hit=%@",
                    point.x, point.y, AWEInteractionObjectSummary(downloadHit));
            }
            return downloadHit;
        }
    }
    /* 3.8: the top chrome lifted into this window (ALB37GlassLayer.h). */
    UIView *liftedHit = ALB37HitTest(self, point, event);
    if (liftedHit) return liftedHit;
    /* Bottom-bar hidden mode is true touch passthrough. The overlay UIWindow
       remains resident for other independent plugin controls, but the entire
       former tab/search footprint contributes no hit target, so controls from
       Douyin or another tweak underneath remain clickable. */
    if (!AWEBottomBarDisplayEnabled()) return nil;
    if (!self.contentVisible) return nil;
    UIView *searchProxy = self.searchTouchProxy;
    if (searchProxy && !searchProxy.hidden &&
        searchProxy.userInteractionEnabled && searchProxy.alpha > 0.01) {
        CGPoint pointInProxy = [self convertPoint:point toView:searchProxy];
        if ([searchProxy pointInside:pointInProxy withEvent:event]) {
            UIView *searchHit = [searchProxy hitTest:pointInProxy withEvent:event]
                ?: searchProxy;
            if (AWEInteractionDiagnosticsEnabled() && event.type == UIEventTypeTouches) {
                AWEInteractionDiagnosticWrite(
                    @"ALBUM_HIT_SEARCH point=(%.1f,%.1f) proxy=%@ hit=%@",
                    point.x, point.y, AWEInteractionObjectSummary(searchProxy),
                    AWEInteractionObjectSummary(searchHit));
            }
            return searchHit;
        }
    }

    UITabBar *tabBar = self.managedTabBar;
    if (!tabBar || tabBar.hidden || tabBar.alpha <= 0.01) return nil;

    CGPoint pointInBar = [self convertPoint:point toView:tabBar];
    UIView *nativeHit=ALB15NativeBottomHitView(tabBar,pointInBar,event);
    if (!nativeHit) return nil;
    if ([gAWEAlbumMorphController isNativeAvatarCompact]) {
        AWERestoreSharedSearchGestureToOriginal(@"native-avatar-press");
        return nativeHit;
    }

    if ([AWEAlbumMorphVisibleItemIdentifiers() containsObject:@"search"]) {
        UIView *searchButton = AWEAlbumMorphSeparateSearchButton(tabBar);
        if (searchButton && ([nativeHit isDescendantOfView:searchButton] || [searchButton isDescendantOfView:nativeHit])) {
            CGRect searchFrame = [searchButton convertRect:searchButton.bounds
                                                     toView:tabBar];
            if (CGRectContainsPoint(CGRectInset(searchFrame, -2.0, -2.0),
                                    pointInBar)) {
                UIWindow *sourceWindow = AWEActiveMainWindow();
                UIView *owner = gAWESharedSearchOwner;
                if (!owner || !owner.window) owner = AWEAlbumMorphSearchOwner(sourceWindow);
                AWELeaseSharedSearchGestureToView(
                    searchButton, owner, @"bottom.overlay.hit-test");
            }
        }
    }

    UIView *resolved = nativeHit;
    if (AWEInteractionDiagnosticsEnabled() && event.type == UIEventTypeTouches) {
        CFTimeInterval now = CACurrentMediaTime();
        if (now - gAWELastBottomHitDiagnosticTime >= 0.10) {
            gAWELastBottomHitDiagnosticTime = now;
            AWEInteractionDiagnosticWrite(
                @"ALBUM_HIT_TAB point=(%.1f,%.1f) barPoint=(%.1f,%.1f) content=%d barHidden=%d barAlpha=%.3f barUI=%d selected=%ld hit=%@",
                point.x, point.y, pointInBar.x, pointInBar.y, self.contentVisible,
                tabBar.hidden, tabBar.alpha, tabBar.userInteractionEnabled,
                (long)gAWEAlbumMorphController.selectedIndex,
                AWEInteractionObjectSummary(resolved));
        }
    }
    return resolved;
}

@end

static void AWEIOS27DetachNativeSameWindowHost(void) {
    BOOL detachedAppearance = gAWEAlbumMorphController.viewIfLoaded.window != nil &&
        !gAWEAlbumMorphController.parentViewController;
    if (detachedAppearance) [gAWEAlbumMorphController beginAppearanceTransition:NO animated:NO];
    if (gAWEAlbumMorphController.parentViewController) {
        [gAWEAlbumMorphController willMoveToParentViewController:nil];
        [gAWEAlbumMorphController.view removeFromSuperview];
        [gAWEAlbumMorphController removeFromParentViewController];
    } else {
        [gAWEAlbumMorphController.view removeFromSuperview];
    }
    [gAWEIOS27NativeHostView removeFromSuperview];
    gAWEIOS27NativeHostView = nil;
    gAWEIOS27NativeHostWindow = nil;
    gAWEIOS27NativeHostParent = nil;
    if (detachedAppearance) [gAWEAlbumMorphController endAppearanceTransition];
}

static BOOL AWEIOS27EnsureNativeSameWindowHost(UIWindow *sourceWindow) {
    if (!AWEAlbumMorphUsesSameWindowHost() || !sourceWindow ||
        !sourceWindow.rootViewController || !gAWEAlbumMorphController) {
        return NO;
    }
    UIViewController *parent = sourceWindow.rootViewController;
    UIView *root = parent.view;
    if (!root) return NO;

    BOOL needsRehost = gAWEIOS27NativeHostWindow != sourceWindow ||
        gAWEIOS27NativeHostParent != parent || !gAWEIOS27NativeHostView ||
        gAWEIOS27NativeHostView.superview != root ||
        gAWEAlbumMorphController.view.superview != ((AWEIOS27NativeBarHostView *)gAWEIOS27NativeHostView).scaleCanvas;
    if (needsRehost) {
        AWEIOS27DetachNativeSameWindowHost();

        /* Detach the controller from the old independent overlay first. */
        if (gAWEAlbumMorphOverlayWindow.rootViewController ==
            gAWEAlbumMorphController) {
            gAWEAlbumMorphOverlayWindow.rootViewController = nil;
        }

        AWEIOS27NativeBarHostView *host =
            [[AWEIOS27NativeBarHostView alloc] initWithFrame:root.bounds];
        host.autoresizingMask = UIViewAutoresizingFlexibleWidth |
            UIViewAutoresizingFlexibleHeight;
        host.backgroundColor = UIColor.clearColor;
        host.opaque = NO;
        host.clipsToBounds = NO;
        host.userInteractionEnabled = YES;
        host.accessibilityIdentifier =
            @"AwemeLiquidBar.SameWindowNativeHost";
        [root addSubview:host];

        // Same detached, strongly retained mounting used by the working 1.6m lab.
        // Nested tab controllers add the host's tab safe area and interfere
        // with UIKit's scroll observation. No parent containment here.
        [gAWEAlbumMorphController beginAppearanceTransition:YES animated:NO];
        gAWEAlbumMorphController.view.transform = CGAffineTransformIdentity;
        gAWEAlbumMorphController.view.bounds = host.bounds;
        gAWEAlbumMorphController.view.center = CGPointMake(
            CGRectGetMidX(host.bounds), CGRectGetMidY(host.bounds));
        // Our owner synchronizes bounds/center below. Frame-based autoresizing
        // of a transformed child computes a different bounds size and fights
        // the next owner layout when the offset canvas moves.
        gAWEAlbumMorphController.view.autoresizingMask = UIViewAutoresizingNone;
        [host.scaleCanvas addSubview:gAWEAlbumMorphController.view];
        [host setNeedsLayout];
        [gAWEAlbumMorphController endAppearanceTransition];

        gAWEIOS27NativeHostView = host;
        gAWEIOS27NativeHostWindow = sourceWindow;
        gAWEIOS27NativeHostParent = parent;
        AWEAlbumMorphProbeWrite(
            @"SAME_WINDOW_DETACHED_ATTACH host=%@ root=%@ tab=%@",
            AWEInteractionObjectSummary(host), AWEInteractionObjectSummary(root),
            AWEInteractionObjectSummary(gAWEAlbumMorphController.tabBar));
    }

    if (gAWEIOS27NativeHostView) {
        UIView *host = gAWEIOS27NativeHostView;
        UIView *chrome = gAWEAlbumMorphController.view;
        if (!AWEFrameEqualEnough(host.frame, root.bounds)) host.frame = root.bounds;
        if (!AWEFrameEqualEnough(chrome.bounds, host.bounds)) chrome.bounds = host.bounds;
        CGPoint center = CGPointMake(CGRectGetMidX(host.bounds), CGRectGetMidY(host.bounds));
        if (fabs(chrome.center.x-center.x) > 0.01 || fabs(chrome.center.y-center.y) > 0.01)
            chrome.center = center;
        if (host.hidden) host.hidden = NO;
        if (fabs(host.alpha-1.0) > 0.001) host.alpha = 1.0;
        if (root.subviews.lastObject != host) [root bringSubviewToFront:host];
    }
    /* The old UIWindow is retained only as a tiny state carrier for existing
       route/visibility bookkeeping; it must never render on iOS 26 or later. */
    if (gAWEAlbumMorphOverlayWindow) {
        if (!gAWEAlbumMorphOverlayWindow.hidden) gAWEAlbumMorphOverlayWindow.hidden = YES;
        if (gAWEAlbumMorphOverlayWindow.alpha != 0.0) gAWEAlbumMorphOverlayWindow.alpha = 0.0;
    }
    return gAWEAlbumMorphController.tabBar.window == sourceWindow;
}

static void AWEPrepareAlbumMorphOverlayTransparency(void) {
    UIWindow *overlay = gAWEAlbumMorphOverlayWindow;
    if (!overlay) return;
    [UIView performWithoutAnimation:^{
        overlay.backgroundColor = UIColor.clearColor;
        overlay.opaque = NO;
        overlay.layer.backgroundColor = UIColor.clearColor.CGColor;
        UIViewController *root = overlay.rootViewController;
        root.view.backgroundColor = UIColor.clearColor;
        root.view.opaque = NO;
        root.view.layer.backgroundColor = UIColor.clearColor.CGColor;
        if (gAWEAlbumMorphController.tabBar) {
            gAWEAlbumMorphController.tabBar.backgroundColor = UIColor.clearColor;
            gAWEAlbumMorphController.tabBar.opaque = NO;
            gAWEAlbumMorphController.tabBar.layer.backgroundColor =
                UIColor.clearColor.CGColor;
        }
    }];
}

static UIView *AWEAlbumMorphSearchOwner(UIWindow *window) {
    if (!window) return nil;
    UIView *topContainer = AWEFindViewByExactRuntimeClass(
        window, @"AWEFeedTopBarContainer", 0);
    UIView *owner = topContainer
        ? AWEFindTopOwnerCandidate(topContainer, YES)
        : nil;
    if (!owner) {
        owner = AWEFindViewByExactRuntimeClass(
            window, @"AWEHPDiscoverFeedEntranceView", 0);
    }
    if (!owner) {
        owner = AWEFindViewByExactRuntimeClass(
            window, @"AWEHPSearchBubbleEntranceView", 0);
    }
    return owner;
}

static UIGestureRecognizer *AWEAlbumMorphFindSearchGesture(UIView *root) {
    if (!root) return nil;
    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:root];
    UIGestureRecognizer *fallback = nil;
    NSUInteger visited = 0;
    while (queue.count > 0 && visited < 96) {
        UIView *view = queue.firstObject;
        [queue removeObjectAtIndex:0];
        visited++;
        for (UIGestureRecognizer *recognizer in view.gestureRecognizers) {
            if (!recognizer.enabled) continue;
            NSString *name = NSStringFromClass(recognizer.class).lowercaseString;
            if ([name containsString:@"alphatap"] ||
                [name containsString:@"searchtap"] ||
                [name containsString:@"clickgesture"]) return recognizer;
            if (!fallback &&
                ([recognizer isKindOfClass:UITapGestureRecognizer.class] ||
                 [name containsString:@"tap"] ||
                 [name containsString:@"click"])) fallback = recognizer;
        }
        for (UIView *child in view.subviews) [queue addObject:child];
    }
    return fallback;
}

static void AWEResetSharedSearchGestureBookkeeping(void) {
    gAWESharedSearchGesture = nil;
    gAWESharedSearchGestureOriginalView = nil;
    gAWESharedSearchOwner = nil;
    gAWESharedSearchOriginalCancelsTouches = YES;
    gAWESharedSearchBottomLeaseUntil = 0.0;
}

static void AWERestoreSharedSearchGestureToOriginal(NSString *reason) {
    UIGestureRecognizer *gesture = gAWESharedSearchGesture;
    UIView *original = gAWESharedSearchGestureOriginalView;
    if (!gesture) return;
    UIView *from = gesture.view;
    if (original && gesture.view != original) {
        [original addGestureRecognizer:gesture];
    }
    gesture.cancelsTouchesInView = gAWESharedSearchOriginalCancelsTouches;
    AWEInteractionDiagnosticWrite(
        @"SEARCH_REAL_GESTURE_RESTORE reason=%@ recognizer=%@ from=%@ to=%@ state=%ld",
        reason ?: @"unknown", NSStringFromClass(gesture.class),
        AWEInteractionObjectSummary(from), AWEInteractionObjectSummary(original),
        (long)gesture.state);
    AWEResetSharedSearchGestureBookkeeping();
}

static BOOL AWELeaseSharedSearchGestureToView(UIView *destination,
                                               UIView *owner,
                                               NSString *reason) {
    if (!destination || !owner || !owner.window) return NO;

    NSString *leaseReason = reason ?: @"unknown";
    CFTimeInterval now = CACurrentMediaTime();
    if ([leaseReason hasPrefix:@"bottom."]) {
        /* Protect the bottom control's real touch sequence from the very noisy
           top-bar maintenance/layout passes seen in the v17 device log. */
        gAWESharedSearchBottomLeaseUntil = now + 0.80;
    } else if ([leaseReason isEqualToString:@"top.hit-test"]) {
        gAWESharedSearchBottomLeaseUntil = 0.0;
    } else if ([leaseReason isEqualToString:@"top.bind"] &&
               now < gAWESharedSearchBottomLeaseUntil &&
               gAWESharedSearchGesture &&
               gAWESharedSearchGesture.view != destination) {
        return NO;
    }

    if (gAWESharedSearchGesture && gAWESharedSearchOwner &&
        gAWESharedSearchOwner != owner) {
        AWERestoreSharedSearchGestureToOriginal(@"owner-changed");
    }

    UIGestureRecognizer *gesture = gAWESharedSearchGesture;
    if (!gesture) {
        gesture = AWEAlbumMorphFindSearchGesture(owner);
        if (!gesture) {
            AWEInteractionDiagnosticWrite(
                @"SEARCH_REAL_GESTURE_LEASE reason=%@ result=no-source owner=%@ destination=%@",
                reason ?: @"unknown", AWEInteractionObjectSummary(owner),
                AWEInteractionObjectSummary(destination));
            return NO;
        }
        gAWESharedSearchGesture = gesture;
        gAWESharedSearchGestureOriginalView = gesture.view ?: owner;
        gAWESharedSearchOwner = owner;
        gAWESharedSearchOriginalCancelsTouches = gesture.cancelsTouchesInView;
    }

    if (!gesture.enabled) gesture.enabled = YES;
    UIView *from = gesture.view;
    if (from != destination) {
        [destination addGestureRecognizer:gesture];
    }
    /* The destination UIButton/UITabBar item must keep its own native glass
       press animation. The real search recognizer observes the same touch but
       does not cancel the control's visual tracking. */
    gesture.cancelsTouchesInView = NO;
    BOOL bound = gesture.view == destination;
    if (from != destination || !bound) {
        AWEInteractionDiagnosticWrite(
            @"SEARCH_REAL_GESTURE_LEASE reason=%@ result=%d recognizer=%@ from=%@ to=%@ state=%ld",
            reason ?: @"unknown", bound, NSStringFromClass(gesture.class),
            AWEInteractionObjectSummary(from), AWEInteractionObjectSummary(destination),
            (long)gesture.state);
    }
    return bound;
}

static UIView *AWEAlbumMorphRightmostTabButton(UITabBar *tabBar) {
    if (!tabBar) return nil;
    UIView *root=ALB5NativeSurfaceRoot(tabBar) ?: tabBar;
    NSMutableArray<UIView *> *queue=[NSMutableArray arrayWithArray:root.subviews];
    UIView *best=nil; CGFloat bestX=-CGFLOAT_MAX; BOOL foundAuxiliary=NO;
    CGRect band=CGRectInset([tabBar convertRect:tabBar.bounds toView:root],-64,-36);
    for (NSUInteger i=0;i<queue.count && i<192;i++) {
        UIView *view=queue[i];
        if (view.hidden || view.alpha<=.01 || [view isKindOfClass:UIScrollView.class]) continue;
        NSString *name=NSStringFromClass(view.class);
        BOOL buttonLike=[view isKindOfClass:UIControl.class] || [name containsString:@"TabButton"] ||
            [name containsString:@"TabBarButton"] || [name containsString:@"TabBarItemView"];
        CGRect frame=[view convertRect:view.bounds toView:root];
        if (buttonLike && view.bounds.size.width>=30 && view.bounds.size.height>=30 && CGRectIntersectsRect(band,frame)) {
            BOOL auxiliary=NO;
            for (UIView *a=view;a && a!=root;a=a.superview)
                if ([NSStringFromClass(a.class) containsString:@"TabBarAuxiliaryView"]) { auxiliary=YES; break; }
            CGFloat x=CGRectGetMidX(frame);
            if ((auxiliary && !foundAuxiliary) || (auxiliary==foundAuxiliary && x>bestX)) {
                best=view; bestX=x; foundAuxiliary=auxiliary;
            }
        }
        [queue addObjectsFromArray:view.subviews];
    }
    return best;
}

/* 3.0.1: the real Search recognizer may only ride on UIKit's separate search
   capsule (the UISearchTab's _UITabBarAuxiliaryView, primary or minimized
   button). The rightmost-button fallback above picked the selected-tab ball
   whenever no auxiliary was visible (six root tabs, minimized), so that ball
   opened Search while the real search did nothing. Regular tab carriers are
   never descended, so neither the tab count nor their position matters; an
   absent capsule returns nil and Search is resolved by UITab identity in
   -albumMorphDidRequestSearch instead. */
static UIView *AWEAlbumMorphSeparateSearchButton(UITabBar *tabBar) {
    if (!tabBar) return nil;
    UIView *root=ALB5NativeSurfaceRoot(tabBar) ?: tabBar;
    // Bottom row only: the capsule may sit beside the bar's own bounds.
    CGRect barRect=[tabBar convertRect:tabBar.bounds toView:root];
    NSMutableArray<UIView *> *queue=[NSMutableArray arrayWithArray:root.subviews];
    UIView *best=nil; CGFloat bestX=-CGFLOAT_MAX;
    for (NSUInteger i=0;i<queue.count && i<192;i++) {
        UIView *view=queue[i];
        if (view.hidden || view.alpha<=.01 || [view isKindOfClass:UIScrollView.class]) continue;
        NSString *name=NSStringFromClass(view.class);
        if ([name containsString:@"TabBarAuxiliaryView"]) {
            NSMutableArray<UIView *> *inner=[NSMutableArray arrayWithArray:view.subviews];
            for (NSUInteger j=0;j<inner.count && j<64;j++) {
                UIView *candidate=inner[j];
                if (candidate.hidden || candidate.alpha<=.01) continue;
                NSString *candidateName=NSStringFromClass(candidate.class);
                BOOL buttonLike=[candidate isKindOfClass:UIControl.class] ||
                    [candidateName containsString:@"TabButton"] || [candidateName containsString:@"TabBarButton"] ||
                    [candidateName containsString:@"TabBarItemView"];
                CGRect frame=[candidate convertRect:candidate.bounds toView:root];
                if (buttonLike && candidate.bounds.size.width>=30 && candidate.bounds.size.height>=30 &&
                    CGRectGetMaxY(frame)>=CGRectGetMinY(barRect)-64 &&
                    CGRectGetMinY(frame)<=CGRectGetMaxY(barRect)+64 && CGRectGetMidX(frame)>bestX) {
                    best=candidate; bestX=CGRectGetMidX(frame);
                }
                [inner addObjectsFromArray:candidate.subviews];
            }
            continue;
        }
        // Expanded/minimized carriers of the regular tabs: never the search.
        if ([name containsString:@"TabBarPlatterView"]) continue;
        [queue addObjectsFromArray:view.subviews];
    }
    return best;
}

static void AWERestoreAlbumMorphSearchGesture(void) {
    UIGestureRecognizer *gesture = gAWEAlbumMorphSearchGesture;
    UIView *originalView = gAWEAlbumMorphSearchGestureOriginalView;
    if (gesture && originalView && gesture.view != originalView) {
        [originalView addGestureRecognizer:gesture];
    } else if (gesture && gesture.view == gAWEAlbumMorphSearchTouchProxy) {
        [gAWEAlbumMorphSearchTouchProxy removeGestureRecognizer:gesture];
    }
    gAWEAlbumMorphSearchGesture = nil;
    gAWEAlbumMorphSearchGestureOriginalView = nil;
    [gAWEAlbumMorphSearchTouchProxy removeFromSuperview];
    gAWEAlbumMorphSearchTouchProxy = nil;
}

static void AWEConfigureAlbumMorphSearchTouchProxy(
    AWEAlbumMorphOverlayWindow *overlay,
    UIWindow *sourceWindow) {
    if (!overlay || !sourceWindow || !gAWEAlbumMorphController.tabBar) return;

    /* v9: iOS 26 and 27 both let the real UISearchTab receive the complete
       touch sequence. Reparenting Douyin's search gesture to an overlay proxy
       removed UIKit's native Liquid Glass press/stretch feedback on iOS 26. */
    if (AWEOperatingSystemMajorVersion() >= 26) {
        AWERestoreAlbumMorphSearchGesture();
        overlay.searchTouchProxy = nil;
        static BOOL loggedNativeSearch = NO;
        if (!loggedNativeSearch) {
            loggedNativeSearch = YES;
            AWEInteractionDiagnosticWrite(
                @"ALBUM_NATIVE_SEARCH_DIRECT_V9 enabled=1 os=%ld tab=%@",
                (long)AWEOperatingSystemMajorVersion(),
                AWEInteractionObjectSummary(gAWEAlbumMorphController.tabBar));
        }
        return;
    }

    if (![AWEAlbumMorphVisibleItemIdentifiers() containsObject:@"search"]) {
        AWERestoreAlbumMorphSearchGesture();
        overlay.searchTouchProxy = nil;
        return;
    }

    UIView *tabButton = AWEAlbumMorphRightmostTabButton(
        gAWEAlbumMorphController.tabBar);
    CGRect targetFrame = CGRectZero;
    if (tabButton) {
        @try {
            targetFrame = [tabButton convertRect:tabButton.bounds toView:overlay];
        } @catch (__unused NSException *exception) {
            targetFrame = CGRectZero;
        }
    }
    if (CGRectIsEmpty(targetFrame)) {
        CGRect barFrame = [gAWEAlbumMorphController.tabBar
            convertRect:gAWEAlbumMorphController.tabBar.bounds
                  toView:overlay];
        CGFloat side = MIN(MAX(CGRectGetHeight(barFrame), 52.0), 78.0);
        targetFrame = CGRectMake(
            CGRectGetMaxX(barFrame) - side,
            CGRectGetMidY(barFrame) - side * 0.5,
            side,
            side);
    }
    targetFrame = CGRectInset(targetFrame, -3.0, -3.0);

    UIView *proxy = gAWEAlbumMorphSearchTouchProxy;
    if (!proxy) {
        proxy = [[UIView alloc] initWithFrame:targetFrame];
        proxy.backgroundColor = UIColor.clearColor;
        proxy.opaque = NO;
        proxy.userInteractionEnabled = YES;
        proxy.accessibilityIdentifier =
            @"AwemeLiquidBar.AlbumMorph.RealSearchTouchProxy";
        [overlay addSubview:proxy];
        gAWEAlbumMorphSearchTouchProxy = proxy;
    }
    proxy.frame = targetFrame;
    proxy.hidden = NO;
    overlay.searchTouchProxy = proxy;
    [overlay bringSubviewToFront:proxy];

    if (gAWEAlbumMorphSearchGesture &&
        gAWEAlbumMorphSearchGesture.view == proxy) return;

    UIView *owner = AWEAlbumMorphSearchOwner(sourceWindow);
    UIGestureRecognizer *gesture = AWEAlbumMorphFindSearchGesture(owner);
    if (!gesture) {
        proxy.hidden = YES;
        overlay.searchTouchProxy = nil;
        AWEInteractionDiagnosticWrite(
            @"ALBUM_MORPH_SEARCH_PROXY_FAILED owner=%@",
            AWEInteractionObjectSummary(owner));
        return;
    }

    gAWEAlbumMorphSearchGesture = gesture;
    gAWEAlbumMorphSearchGestureOriginalView = gesture.view;
    [proxy addGestureRecognizer:gesture];
    proxy.hidden = NO;
    AWEInteractionDiagnosticWrite(
        @"ALBUM_MORPH_SEARCH_PROXY_BOUND owner=%@ recognizer=%@ frame=%@",
        AWEInteractionObjectSummary(owner),
        NSStringFromClass(gesture.class),
        NSStringFromCGRect(targetFrame));
}

static void AWEUninstallAlbumMorphBar(void) {
    ALBRemoveRootPanObservers();
    AWERestoreSharedSearchGestureToOriginal(@"album-uninstall");
    AWERestoreAlbumMorphSearchGesture();
    if (AWEAlbumMorphUsesSameWindowHost()) AWEIOS27DetachNativeSameWindowHost();
    AWEApplyAlbumMorphOriginalSuppression(
        gAWEAlbumMorphSuppressedOriginalBar, NO);
    gAWEAlbumMorphOverlayWindow.transform = CGAffineTransformIdentity;
    gAWEAlbumMorphOverlayWindow.hidden = YES;
    gAWEAlbumMorphOverlayWindow.rootViewController = nil;
    gAWEAlbumMorphOverlayWindow = nil;
    gAWEAlbumMorphController = nil;
    gAWEAlbumMorphCoordinator = nil;
    gAWEAlbumMorphVisible = NO;
    gAWEAlbumMorphLastAlignedFrame = CGRectZero;
    gAWEAlbumMorphLastAlignedSourceWindow = nil;
}

static BOOL AWEEnsureAlbumMorphController(void) {
    if (gAWEAlbumMorphController) return YES;

    void *rawController = AWEAlbumMorphCreateController();
    if (!rawController) {
        AWEInteractionDiagnosticWrite(@"ALBUM_MORPH_FACTORY_FAILED");
        return NO;
    }

    gAWEAlbumMorphController =
        (__bridge_transfer AWEAlbumMorphTabController *)rawController;
    gAWEAlbumMorphCoordinator = [AWEAlbumMorphCoordinator new];
    gAWEAlbumMorphController.actionSink = gAWEAlbumMorphCoordinator;
    [gAWEAlbumMorphController loadViewIfNeeded];
    return gAWEAlbumMorphController.tabBar != nil;
}

static BOOL AWEEnsureAlbumMorphOverlayWindow(UIWindow *sourceWindow) {
    if (!sourceWindow || !sourceWindow.windowScene ||
        !AWEEnsureAlbumMorphController()) {
        return NO;
    }

    AWEAlbumMorphOverlayWindow *overlay =
        (AWEAlbumMorphOverlayWindow *)gAWEAlbumMorphOverlayWindow;
    BOOL created = !overlay || overlay.windowScene != sourceWindow.windowScene;
    if (created) {
        overlay.hidden = YES;
        overlay.rootViewController = nil;

        [gAWEAlbumMorphController loadViewIfNeeded];
        gAWEAlbumMorphController.view.backgroundColor = UIColor.clearColor;
        gAWEAlbumMorphController.view.opaque = NO;
        gAWEAlbumMorphController.tabBar.backgroundColor = UIColor.clearColor;
        gAWEAlbumMorphController.tabBar.opaque = NO;

        overlay = [[AWEAlbumMorphOverlayWindow alloc]
            initWithWindowScene:sourceWindow.windowScene];
        overlay.backgroundColor = UIColor.clearColor;
        overlay.opaque = NO;
        overlay.windowLevel = sourceWindow.windowLevel + 1.0;
        overlay.frame = sourceWindow.bounds;
        overlay.contentVisible = NO;
        gAWEAlbumMorphOverlayWindow = overlay;
        if (!AWEAlbumMorphUsesSameWindowHost()) {
            overlay.rootViewController = [ALB33BottomOverlayController new];
        }
        overlay.managedTabBar = gAWEAlbumMorphController.tabBar;
        [overlay layoutIfNeeded];
        if (!AWEAlbumMorphUsesSameWindowHost()) AWEPrepareAlbumMorphOverlayTransparency();
        gAWEAlbumMorphController.tabBar.alpha = 1.0;
        gAWEAlbumMorphController.tabBar.userInteractionEnabled = NO;
        [gAWEAlbumMorphController setVisibleFraction:0.0 animated:NO];
        /* State carrier only. The real bar and source feed share one window. */
        overlay.hidden = AWEAlbumMorphUsesSameWindowHost() ? YES : NO;
        gAWEAlbumMorphLastAlignedFrame = CGRectZero;
        gAWEAlbumMorphLastAlignedSourceWindow = sourceWindow;
    } else {
        CGRect frame = sourceWindow.bounds;
        if (fabs(CGRectGetMinX(overlay.frame) - CGRectGetMinX(frame)) > 0.25 ||
            fabs(CGRectGetMinY(overlay.frame) - CGRectGetMinY(frame)) > 0.25 ||
            fabs(CGRectGetWidth(overlay.frame) - CGRectGetWidth(frame)) > 0.5 ||
            fabs(CGRectGetHeight(overlay.frame) - CGRectGetHeight(frame)) > 0.5) {
            [CATransaction begin];
            [CATransaction setDisableActions:YES];
            overlay.transform = CGAffineTransformIdentity;
            overlay.frame = frame;
            [CATransaction commit];
        }
        if (!AWEAlbumMorphUsesSameWindowHost() &&
            ![overlay.rootViewController isKindOfClass:ALB33BottomOverlayController.class]) {
            overlay.rootViewController = [ALB33BottomOverlayController new];
        }
    }

    overlay.managedTabBar = gAWEAlbumMorphController.tabBar;
    if (gAWEStableCleanScreenEnabled) {
        AWEStableCleanEnforceBottomBarSuppression();
        return YES;
    }
    overlay.userInteractionEnabled = YES;
    if (AWEAlbumMorphUsesSameWindowHost()) {
        /* v6: keep the historical overlay object only for state bookkeeping;
           the actual UITabBarController lives inside Douyin's source window. */
        overlay.alpha = 0.0;
        overlay.hidden = YES;
        if (!AWEIOS27EnsureNativeSameWindowHost(sourceWindow)) return NO;
    } else {
        overlay.alpha = 1.0;
        overlay.hidden = NO;
        AWEPrepareAlbumMorphOverlayTransparency();
    }
    return YES;
}

#include "ALB5RightLayout.h"

// 3.2: the 3.1 top chrome replaces 2.5.3's top group; its selected channel
// keeps the same non-video exclusions.
static BOOL ALB9ResolveVideoInkContext(void) {
    if(!AWEIndexUsesHomeVisualPolicy(AWECurrentMainTabIndex()) || AWECurrentRouteSuppressesBar())return NO;
    UIView *container=gALB32InkTopContainer;
    if(container.window) {
        NSArray<NSDictionary<NSString *, id> *> *definitions=ALB3TopDefinitions(container);
        NSInteger selected=ALB3SelectedTopIndex(container,definitions);
        if(selected!=NSNotFound && selected>=0 && selected<(NSInteger)definitions.count) {
            NSString *title=definitions[selected][@"title"];
            if([title isKindOfClass:NSString.class] && [@[@"商城",@"经验",@"团购",@"购物"] containsObject:title])return NO;
        }
    }
    UIView *rail=AWEFindCurrentRightActionStackAcrossWindows();
    return ALB8ContrastSurfaceVisible(rail,AWEActiveMainWindow());
}
static BOOL ALB9VideoInkContext(void) {
    static CFTimeInterval sampled;static BOOL result;
    CFTimeInterval now=CACurrentMediaTime();
    if(now-sampled>.12){sampled=now;result=ALB9ResolveVideoInkContext();}
    return result;
}
static BOOL ALB9RefreshLocalButtonInk(UIButton *button) {
    // 2.5: a carried top button draws nothing; its carrier takes the middle
    // group's ink in ALB9RefreshVideoInk.
    if (ALB25MaterialButtonIsCarried(button)) return YES;
    // 2.5.1: frozen while UIKit morphs it into its menu and back.
    if (ALB25MaterialButtonInMenuSession(button)) return YES;
    NSString *key=objc_getAssociatedObject(button,&kALB9IconIdentityKey);
    if(!key.length || AWEStoredSymbolColorMode(key)!=AWEConfiguredIconColorModeAutomatic ||
       !ALB9VideoInkContext() || !AWEAdaptiveButtonIsEffectivelyVisible(button))return NO;
    // Preserve source images / avatar artwork; only template automatic icons.
    if(![objc_getAssociatedObject(button,&kAWEAdaptiveGlassAutomaticContrastKey) boolValue] && ![key hasPrefix:@"top."])return NO;
    NSNumber *old=objc_getAssociatedObject(button,&kAWEAdaptiveGlassForegroundLightKey);
    UIWindow *window=button.window;
    BOOL light=ALB8ContrastLightInk(button,window,ALB8ContrastSnapshot(window),YES,old!=nil,old?old.boolValue:YES);
    if([key hasPrefix:@"top."]) {
        // Existing configuration handlers must use the same sampled ink,
        // otherwise their native-color reapply races our display sampling.
        objc_setAssociatedObject(button,&kAWEAdaptiveGlassExplicitForegroundKey,
            light?UIColor.whiteColor:UIColor.blackColor,OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    AWEApplyAutomaticContrastForeground(button,light);
    return YES;
}

static void ALB9RefreshVideoInk(void) {
    if(!AWEPluginFeaturesEnabled() || gAWESettingsVisible || UIApplication.sharedApplication.applicationState!=UIApplicationStateActive)return;
    // Only template icons with automatic contrast are re-inked (Clear modes);
    // without one on screen there is nothing to sample.
    NSMutableArray<UIButton *> *automatic=[NSMutableArray array];
    for(UIButton *button in AWEAdaptiveGlassButtonRegistry().allObjects)
        if(button.window && [objc_getAssociatedObject(button,&kAWEAdaptiveGlassAutomaticContrastKey) boolValue])[automatic addObject:button];
    if(!automatic.count || !ALB9VideoInkContext())return;
    for(UIButton *button in automatic) ALB9RefreshLocalButtonInk(button);
}
__attribute__((constructor)) static void ALB9StartVideoInk(void) {
    dispatch_async(dispatch_get_main_queue(),^{
        NSTimer *timer=[NSTimer timerWithTimeInterval:.16 repeats:YES block:^(__unused NSTimer *t){ ALB9RefreshVideoInk(); }];
        timer.tolerance=.025;[NSRunLoop.mainRunLoop addTimer:timer forMode:NSRunLoopCommonModes];
    });
}

static BOOL AWEInstallOrUpdateAlbumMorphBar(UIView *originalBar,
                                             BOOL forceVisible) {
    /* 1.0.56c16: when the visual bottom bar is disabled, LiquidBar no longer
       owns the native tab-bar host at all. Fully tear down our resident
       UITabBar/overlay and restore the original AWENormalModeTabBar so another
       tweak can attach to the same native host. This is deliberately stronger
       than alpha/hidden: there is no LiquidBar tab view left in the hierarchy. */
    if (!AWEBottomBarDisplayEnabled()) {
        AWEUninstallAlbumMorphBar();
        return NO;
    }

    if (!AWEPluginFeaturesEnabled() ||
        AWEOperatingSystemMajorVersion() < 26) {
        AWEUninstallAlbumMorphBar();
        return NO;
    }

    UIWindow *sourceWindow = originalBar.window ?: AWEActiveMainWindow();
    if (!AWEEnsureAlbumMorphOverlayWindow(sourceWindow)) {
        AWEInteractionDiagnosticWrite(
            @"ALBUM_MORPH_INSTALL_FAILED sourceWindow=%@ scene=%@ controller=%@",
            AWEInteractionObjectSummary(sourceWindow),
            AWEInteractionObjectSummary(sourceWindow.windowScene),
            AWEInteractionObjectSummary(gAWEAlbumMorphController));
        return NO;
    }

    AWEAlbumMorphOverlayWindow *overlay =
        (AWEAlbumMorphOverlayWindow *)gAWEAlbumMorphOverlayWindow;
    if (AWEAlbumMorphUsesSameWindowHost()) {
        overlay.hidden = YES;
        overlay.alpha = 0.0;
        AWEIOS27EnsureNativeSameWindowHost(sourceWindow);
    } else {
        overlay.windowLevel = sourceWindow.windowLevel + 1.0;
    }
    overlay.managedTabBar = gAWEAlbumMorphController.tabBar;

    [gAWEAlbumMorphController configureSecondTabAsShop:AWESecondTabIsShop()];
    [gAWEAlbumMorphController
        configureVisibleItemIdentifiers:AWEAlbumMorphVisibleItemIdentifiers()];
    [gAWEAlbumMorphController updateAccentColor:AWEStoredAccentColor()];
    AWEUpdateAlbumMorphMessageBadge();

    AWEApplyAlbumMorphOriginalSuppression(originalBar, YES);
    AWEAlignAlbumMorphOverlayToOriginalBar(
        originalBar, sourceWindow, overlay);
    AWEConfigureAlbumMorphSearchTouchProxy(overlay, sourceWindow);

    NSInteger selected = [gAWEAlbumMorphController currentOriginalIndex];
    NSInteger originalSelected = AWECurrentOriginalMainTabIndex();
    AWEUpdateFriendsTabLatch(originalSelected);
    if (selected == NSNotFound &&
        (originalSelected == 0 || originalSelected == 1 ||
         originalSelected == 3 || originalSelected == 4)) {
        selected = originalSelected;
        [gAWEAlbumMorphController syncSelectedOriginalIndex:selected];
    }
    if (selected == NSNotFound) selected = 0;
    AWEApplyAlbumMorphResolvedAppearance(sourceWindow, selected);

    BOOL settledOriginalVisible =
        originalBar && AWEAlbumMorphSteadyWantsVisible(originalBar);
    BOOL routeSuppresses = AWECurrentRouteSuppressesBar();
    (void)forceVisible;

    /*
     Keep the real tab bar and its glass renderer alive permanently.  The
     visible area is driven exclusively by the 1.0.10b-style mask, including
     interactive return progress.  Never toggle alpha/hidden here: doing so
     forces the compositor to recreate the glass surface and causes the white
     flash/disappear-reappear cycle.
    */
    AWEPrepareAlbumMorphOverlayTransparency();
    if (gAWEStableCleanScreenEnabled) {
        AWEApplyAlbumMorphVisibleFraction(0.0, @"install.clean-guard", NO);
        return YES;
    }
    [UIView performWithoutAnimation:^{
        if (AWEAlbumMorphUsesSameWindowHost()) {
            overlay.hidden = YES;
            overlay.alpha = 0.0;
            gAWEIOS27NativeHostView.hidden = NO;
            gAWEIOS27NativeHostView.alpha = 1.0;
        } else {
            overlay.hidden = NO;
            overlay.alpha = 1.0;
        }
        gAWEAlbumMorphController.view.hidden = NO;
        gAWEAlbumMorphController.view.alpha = 1.0;
        gAWEAlbumMorphController.tabBar.hidden = NO;
        gAWEAlbumMorphController.tabBar.alpha = 1.0;
    }];
    AWEUpdateAlbumMorphVisibility(originalBar, @"install.original-state");
    AWEInstallAlbumMorphCollapseGesture(sourceWindow);
    [gAWEAlbumMorphController setNativeMinimizeEnabled:AWEAlbumMorphCollapseEnabled()];

    BOOL visible = gAWEBarLastVisibleFraction > 0.001;

    static NSString *lastOverlayDiagnosticSignature = nil;
    NSString *routeReason = AWECurrentRouteSuppressionReason();
    UIViewController *diagnosticTop = AWETopViewControllerFrom(
        AWEActiveMainWindow().rootViewController);
    NSString *diagnosticTopClass = diagnosticTop
        ? NSStringFromClass(diagnosticTop.class) : @"<nil>";
    NSInteger diagnosticTab = AWECurrentOriginalMainTabIndex();
    NSString *overlayDiagnosticSignature = [NSString stringWithFormat:
        @"%d|%d|%d|%d|%d|%ld|%@|%@|%@|%@",
        forceVisible, settledOriginalVisible, routeSuppresses,
        gAWESettingsVisible, visible, (long)diagnosticTab,
        routeReason, diagnosticTopClass,
        AWEInteractionObjectSummary(overlay),
        AWEInteractionObjectSummary(gAWEAlbumMorphController.tabBar)];
    if (![lastOverlayDiagnosticSignature isEqualToString:overlayDiagnosticSignature]) {
        lastOverlayDiagnosticSignature = [overlayDiagnosticSignature copy];
        AWEInteractionDiagnosticWrite(
            @"ALBUM_MORPH_OVERLAY requestedForce=%d originalLive=%d routeSuppress=%d reason=%@ tab=%ld top=%@ settings=%d result=%d window=%@ tabBar=%@",
            forceVisible,
            settledOriginalVisible,
            routeSuppresses,
            routeReason,
            (long)diagnosticTab,
            diagnosticTopClass,
            gAWESettingsVisible,
            visible,
            AWEInteractionObjectSummary(overlay),
            AWEInteractionObjectSummary(gAWEAlbumMorphController.tabBar));
    }
    return YES;
}

/* TEST17: source-window gestures request native minimization only.
   No translation/scaling fallback competes with UIKit's collapse animation. */

static void AWECollectVisibleHomeActionStacks(UIView *root,
                                               NSMutableArray<UIView *> *result,
                                               NSUInteger depth) {
    if (!root || !result || depth > 18) return;
    if ([NSStringFromClass(root.class) containsString:@"AWEElementStackView"]) {
        [result addObject:root];
    }
    for (UIView *child in root.subviews) {
        if ([child isKindOfClass:AWEHomeActionSlotView.class]) continue;
        AWECollectVisibleHomeActionStacks(child, result, depth + 1);
    }
}

static void AWERefreshHomeActionStacksInView(UIView *root) {
    if (!AWEPluginFeaturesEnabled() || !root) return;
    NSMutableArray<UIView *> *stacks = [NSMutableArray array];
    AWECollectVisibleHomeActionStacks(root, stacks, 0);
    for (UIView *stack in stacks) AWEScheduleHomeActionStackRefresh(stack);
}

static void AWEScheduleHomeActionStacksInView(UIView *root) {
    if (!AWEPluginFeaturesEnabled() || !root) return;
    NSInteger generation =
        [objc_getAssociatedObject(root, &kAWEHomeActionRetryGenerationKey)
            integerValue] + 1;
    objc_setAssociatedObject(root, &kAWEHomeActionRetryGenerationKey,
                             @(generation), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    NSArray<NSNumber *> *delays = @[@0.0, @0.12, @0.42];
    __weak UIView *weakRoot = root;
    for (NSNumber *delay in delays) {
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW,
                                     (int64_t)(delay.doubleValue * NSEC_PER_SEC)),
                       dispatch_get_main_queue(), ^{
            UIView *strongRoot = weakRoot;
            if (!strongRoot) return;
            NSInteger current = [objc_getAssociatedObject(
                strongRoot, &kAWEHomeActionRetryGenerationKey) integerValue];
            if (current != generation) return;
            AWERefreshHomeActionStacksInView(strongRoot);
        });
    }
}


static void AWERefreshHomeChromeInWindow(UIWindow *window) {
    if (!window) window = AWEActiveMainWindow();
    if (!window) return;
    UIView *top = AWEFindViewByExactRuntimeClass(
        window, @"AWEFeedTopBarContainer", 0);
    if (top) ALB3RefreshTopChrome(top);
    AWERefreshHomeActionStacksInView(window);
}

static BOOL AWEClassNameIsCommentInputOnlyForRightRecovery(NSString *className) {
    if (className.length == 0) return NO;
    NSString *lower = className.lowercaseString;
    return [lower containsString:@"comment"] &&
           [lower containsString:@"input"];
}

static BOOL AWEClassNameIsCommentPanelForRightRecovery(NSString *className) {
    if (className.length == 0) return NO;
    NSString *lower = className.lowercaseString;
    if (![lower containsString:@"comment"] ||
        AWEClassNameIsCommentInputOnlyForRightRecovery(className)) {
        return NO;
    }
    return [lower containsString:@"controller"] ||
           [lower containsString:@"container"] ||
           [lower containsString:@"panel"] ||
           [lower containsString:@"list"];
}

static BOOL AWEAnyVisibleCommentPanelForRightRecovery(void) {
    for (UIViewController *controller in AWESensitiveVisibleControllers()) {
        if (!controller) continue;
        NSString *className = NSStringFromClass(controller.class);
        if (!AWEClassNameIsCommentPanelForRightRecovery(className)) continue;
        UIView *view = controller.viewIfLoaded;
        if (view.window || controller.isBeingPresented ||
            controller.isMovingToParentViewController) {
            return YES;
        }
    }
    return NO;
}

static BOOL AWEAnyBlockingSensitiveDestinationForRightRecovery(void) {
    for (UIViewController *controller in AWESensitiveVisibleControllers()) {
        if (!controller) continue;
        UIView *view = controller.viewIfLoaded;
        BOOL live = view.window || controller.isBeingPresented ||
                    controller.isMovingToParentViewController;
        if (!live) continue;
        NSString *className = NSStringFromClass(controller.class);
        /* AWECommentInputViewController commonly remains attached for several
           seconds after the visible comment sheet has already disappeared.
           It must not keep the feed-side action column suppressed. */
        if (AWEClassNameIsCommentInputOnlyForRightRecovery(className)) continue;
        return YES;
    }
    return NO;
}

static NSArray<UIWindow *> *AWEForegroundNormalWindowsForHomeChrome(void) {
    NSMutableArray<UIWindow *> *windows = [NSMutableArray array];
    UIApplication *application = UIApplication.sharedApplication;
    if (@available(iOS 13.0, *)) {
        for (UIScene *scene in application.connectedScenes) {
            if (![scene isKindOfClass:UIWindowScene.class]) continue;
            if (scene.activationState != UISceneActivationStateForegroundActive &&
                scene.activationState != UISceneActivationStateForegroundInactive) {
                continue;
            }
            for (UIWindow *window in ((UIWindowScene *)scene).windows) {
                if (!window || window.hidden || window.alpha <= 0.01 ||
                    window.windowLevel != UIWindowLevelNormal) {
                    continue;
                }
                if (window == (UIWindow *)gAWEAlbumMorphOverlayWindow ||
                    [NSStringFromClass(window.class) containsString:@"AWEAlbumMorphOverlayWindow"]) {
                    continue;
                }
                [windows addObject:window];
            }
        }
    }
    UIWindow *active = AWEActiveMainWindow();
    if (active && ![windows containsObject:active]) [windows insertObject:active atIndex:0];
    return windows;
}

static BOOL AWEFrameLooksLikeCurrentRightActionStack(UIView *stack) {
    UIWindow *window = stack.window;
    if (!stack || !window) return NO;
    CGRect frame = [stack convertRect:stack.bounds toView:window];
    CGFloat screenW = CGRectGetWidth(window.bounds);
    CGFloat width = CGRectGetWidth(frame);
    CGFloat height = CGRectGetHeight(frame);
    if (screenW < 200.0 || width < 44.0 || width > 140.0 ||
        height < 180.0 || height > 620.0) {
        return NO;
    }
    if (CGRectGetMidX(frame) < screenW * 0.74 ||
        CGRectGetMaxX(frame) < screenW * 0.86) {
        return NO;
    }
    CGRect visible = CGRectIntersection(frame, window.bounds);
    if (CGRectIsNull(visible) || CGRectIsEmpty(visible) ||
        CGRectGetHeight(visible) < 100.0) {
        return NO;
    }
    /* An offscreen/recycled feed cell can remain in the same window. Reject it
       when one of its ancestors is actually removed/hidden; ignore only the
       stack's own alpha because Douyin deliberately fades that to zero while
       the comment sheet is open. */
    for (UIView *ancestor = stack.superview;
         ancestor && ancestor != window;
         ancestor = ancestor.superview) {
        if (ancestor.hidden || ancestor.alpha < 0.01 ||
            ancestor.layer.opacity < 0.01f) {
            return NO;
        }
    }
    return YES;
}

static CGFloat AWECurrentRightStackVisibilityScore(UIView *stack, UIWindow *window) {
    if (!stack || !window) return -CGFLOAT_MAX;
    CGRect frame = [stack convertRect:stack.bounds toView:window];
    CGRect visible = CGRectIntersection(frame, window.bounds);
    if (CGRectIsNull(visible) || CGRectIsEmpty(visible)) return -CGFLOAT_MAX;

    CGFloat visibleRatio = CGRectGetHeight(visible) / MAX(CGRectGetHeight(frame), 1.0);
    CGFloat centerPenalty = fabs(CGRectGetMidY(frame) - CGRectGetMidY(window.bounds));
    CGFloat score = visibleRatio * 4000.0 - centerPenalty * 0.8;
    if (AWEFindViewByExactRuntimeClass(
            stack, @"AWEPlayInteractionUserProfilePictureView", 0) ||
        AWEFindViewByExactRuntimeClass(
            stack, @"AWEPlayInteractionUserProfileContainerView", 0)) {
        score += 700.0;
    }
    /* The pre-comment stack is only a tie-breaker now. Returning it outright
       made a covered/stale profile feed win over the newly visible cell. */
    if (stack == gAWECommentRightStackBefore) score += 80.0;
    return score;
}

static UIView *AWEFindCurrentRightActionStackAcrossWindows(void) {
    UIView *best = nil;
    CGFloat bestScore = -CGFLOAT_MAX;
    for (UIWindow *window in AWEForegroundNormalWindowsForHomeChrome()) {
        NSMutableArray<UIView *> *stacks = [NSMutableArray array];
        AWECollectVisibleHomeActionStacks(window, stacks, 0);
        for (UIView *stack in stacks) {
            if (!AWEFrameLooksLikeCurrentRightActionStack(stack)) continue;
            CGFloat score = AWECurrentRightStackVisibilityScore(stack, window);
            if (score > bestScore) {
                bestScore = score;
                best = stack;
            }
        }
    }
    return best;
}

static BOOL AWEControllerTreeContainsPlayableFeed(UIViewController *controller,
                                                   NSUInteger depth) {
    if (!controller || depth > 12) return NO;
    if (AWEClassNameLooksLikePlayableFeedController(
            NSStringFromClass(controller.class))) return YES;
    UIViewController *presented = controller.presentedViewController;
    if (presented && !presented.isBeingDismissed &&
        AWEControllerTreeContainsPlayableFeed(presented, depth + 1)) return YES;
    for (UIViewController *child in controller.childViewControllers) {
        if (!child.viewIfLoaded.window) continue;
        if (AWEControllerTreeContainsPlayableFeed(child, depth + 1)) return YES;
    }
    return NO;
}

static BOOL AWECurrentRouteHasPlayableFeedController(void) {
    for (UIWindow *window in AWEForegroundNormalWindowsForHomeChrome()) {
        UIViewController *top = AWETopViewControllerFrom(window.rootViewController);
        if (top && AWEControllerTreeContainsPlayableFeed(top, 0)) return YES;
    }
    return NO;
}

static BOOL AWEShouldProtectRightStackFromFullscreenTweak(UIView *stack) {
    if (!stack || !stack.window) return NO;
    if (AWEAnyVisibleCommentPanelForRightRecovery() ||
        AWEAnyBlockingSensitiveDestinationForRightRecovery()) return NO;
    if (!AWEShouldSuppressBarForUserDetailRoute()) return NO;
    if (!AWECurrentRouteHasPlayableFeedController()) return NO;
    return AWEFrameLooksLikeCurrentRightActionStack(stack);
}

static void AWEScheduleFullscreenStackVisibilityProtection(UIView *stack,
                                                            NSString *reason) {
    if (!stack) return;
    __weak UIView *weakStack = stack;
    for (NSNumber *delay in @[@0.08, @0.35]) {
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW,
            (int64_t)(delay.doubleValue * NSEC_PER_SEC)),
            dispatch_get_main_queue(), ^{
            UIView *strongStack = weakStack;
            if (!strongStack || !AWEShouldProtectRightStackFromFullscreenTweak(strongStack)) return;
            BOOL restored = AWEForceRestoreRightActionStackAfterComment(strongStack);
            AWERefreshExternalBridgeMenu(strongStack);
            AWEInteractionDiagnosticWrite(
                @"RIGHT_FULLSCREEN_VISIBILITY_GUARD reason=%@ delay=%.2f restored=%d stack=%@",
                reason ?: @"unknown", delay.doubleValue, restored,
                AWEInteractionObjectSummary(strongStack));
        });
    }
}

static BOOL AWEProfileFullscreenRightProtectionActiveForStack(UIView *stack) {
    if (!stack || CACurrentMediaTime() >= gAWEProfileFullscreenRightProtectUntil) {
        return NO;
    }
    if (AWEAnyVisibleCommentPanelForRightRecovery() ||
        AWEAnyBlockingSensitiveDestinationForRightRecovery()) {
        return NO;
    }
    if (!AWEShouldSuppressBarForUserDetailRoute() ||
        !AWECurrentRouteHasPlayableFeedController()) {
        return NO;
    }
    if (gAWEProfileFullscreenProtectedRightStack &&
        stack != gAWEProfileFullscreenProtectedRightStack) {
        return NO;
    }
    return AWEFrameLooksLikeCurrentRightActionStack(stack);
}

static NSUInteger AWECountHomeActionStacksAcrossForegroundWindows(void) {
    NSUInteger count = 0;
    for (UIWindow *window in AWEForegroundNormalWindowsForHomeChrome()) {
        NSMutableArray<UIView *> *stacks = [NSMutableArray array];
        AWECollectVisibleHomeActionStacks(window, stacks, 0);
        count += stacks.count;
    }
    return count;
}

static BOOL AWEForceRestoreRightActionStackAfterComment(UIView *stack) {
    if (!stack || !stack.window || !AWEFrameLooksLikeCurrentRightActionStack(stack)) {
        return NO;
    }
    BOOL changed = NO;
    [CATransaction begin];
    [CATransaction setDisableActions:YES];
    if (stack.hidden) {
        stack.hidden = NO;
        changed = YES;
    }
    if (stack.alpha < 0.99) {
        stack.alpha = 1.0;
        changed = YES;
    }
    if (stack.layer.opacity < 0.99f) {
        stack.layer.opacity = 1.0f;
        changed = YES;
    }
    [CATransaction commit];

    AWERefreshHomeActionStack(stack);
    AWELayoutBoundHomeActionSlots(stack);
    return changed || !stack.hidden;
}

static NSString *AWECurrentRightActionStackSummary(void) {
    UIWindow *window = AWEActiveMainWindow();
    if (!window) return @"window=nil";
    NSMutableArray<UIView *> *stacks = [NSMutableArray array];
    AWECollectVisibleHomeActionStacks(window, stacks, 0);
    NSMutableArray<NSString *> *parts = [NSMutableArray array];
    for (UIView *stack in stacks) {
        CGRect frame = stack.window
            ? [stack convertRect:stack.bounds toView:stack.window]
            : CGRectZero;
        NSArray<UIView *> *buttons = AWESortedVisibleHomeActionButtons(stack);
        [parts addObject:[NSString stringWithFormat:
            @"%p/%@ frame=%@ window=%d hidden=%d alpha=%.2f buttons=%lu",
            stack, NSStringFromClass(stack.class), NSStringFromCGRect(frame),
            stack.window != nil, stack.hidden, stack.alpha,
            (unsigned long)buttons.count]];
    }
    return parts.count ? [parts componentsJoinedByString:@" || "] : @"none";
}

static void AWESchedulePostCommentRightRebind(NSString *reason) {
    if (!AWEPluginFeaturesEnabled()) return;
    AWESchedulePostCommentBottomTransparencyRecovery(reason ?: @"comment.dismiss");
    BOOL profileFullscreenRecovery =
        AWEShouldSuppressBarForUserDetailRoute() &&
        AWECurrentRouteHasPlayableFeedController();
    NSUInteger generation = ++gAWECommentRightRebindGeneration;
    NSString *before = gAWECommentRightHostBefore ?: @"unknown";
    UIView *captured = gAWECommentRightStackBefore;
    if (profileFullscreenRecovery) {
        gAWEProfileFullscreenRightProtectUntil = CACurrentMediaTime() + 2.40;
        gAWEProfileFullscreenProtectedRightStack = captured;
        AWEInteractionDiagnosticWrite(
            @"RIGHT_FULLSCREEN_COMMENT_PROTECT until=%.2f captured=%@",
            gAWEProfileFullscreenRightProtectUntil,
            AWEInteractionObjectSummary(captured));
    }
    AWEInteractionDiagnosticWrite(
        @"RIGHT_REBIND_SCHEDULE generation=%lu reason=%@ captured=%@ before=%@",
        (unsigned long)generation, reason ?: @"comment.dismiss",
        AWEInteractionObjectSummary(captured), before);

    /* Important: AWECommentInputViewController can remain attached for 4-8 s
       after the visible panel is gone. 1.0.49c waited for it, so the user saw
       an empty right column immediately after closing comments and some profile
       feeds never reached the rebind at all. Rebind as soon as the last visible
       comment panel disappears. Use a handful of bounded passes rather than a
       display link/timer, and search every foreground normal-level app window
       because the key window can temporarily be a transition/input host. */
    NSArray<NSNumber *> *delays = profileFullscreenRecovery
        ? @[@0.0, @0.08, @0.20, @0.45, @0.80, @1.20, @1.75, @2.25]
        : @[@0.0, @0.08, @0.20, @0.45, @0.80, @1.20];
    for (NSNumber *delay in delays) {
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW,
            (int64_t)(delay.doubleValue * NSEC_PER_SEC)),
            dispatch_get_main_queue(), ^{
            if (generation != gAWECommentRightRebindGeneration) return;
            if (AWEAnyVisibleCommentPanelForRightRecovery() ||
                AWEAnyBlockingSensitiveDestinationForRightRecovery()) {
                AWEInteractionDiagnosticWrite(
                    @"RIGHT_REBIND_PASS generation=%lu delay=%.2f blocked=1",
                    (unsigned long)generation, delay.doubleValue);
                return;
            }

            UIView *target = nil;
            if (captured && AWEFrameLooksLikeCurrentRightActionStack(captured)) {
                target = captured;
            }
            if (!target) target = AWEFindCurrentRightActionStackAcrossWindows();

            BOOL restored = AWEForceRestoreRightActionStackAfterComment(target);
            NSUInteger stacks = AWECountHomeActionStacksAcrossForegroundWindows();
            NSString *after = target
                ? [NSString stringWithFormat:@"%@ alpha=%.2f hidden=%d",
                    AWEInteractionObjectSummary(target), target.alpha, target.hidden]
                : @"none";
            AWEInteractionDiagnosticWrite(
                @"RIGHT_REBIND_PASS generation=%lu delay=%.2f stacks=%lu target=%@ restored=%d",
                (unsigned long)generation, delay.doubleValue,
                (unsigned long)stacks, after, restored);

            if (delay == delays.lastObject &&
                generation == gAWECommentRightRebindGeneration) {
                gAWECommentRightStackBefore = nil;
                gAWECommentRightHostBefore = nil;
            }
        });
    }
}

@interface AWEHomeChromeRecoveryTicker : NSObject
- (void)alb_tick:(CADisplayLink *)displayLink;
@end

static CADisplayLink *gAWEHomeChromeRecoveryDisplayLink = nil;
static AWEHomeChromeRecoveryTicker *gAWEHomeChromeRecoveryTicker = nil;
static CFTimeInterval gAWEHomeChromeRecoveryDeadline = 0.0;

static void AWERefreshHomeChromeImmediately(UIWindow *window) {
    if (!window) window = AWEActiveMainWindow();
    if (!window) return;
    UIView *top = AWEFindViewByExactRuntimeClass(
        window, @"AWEFeedTopBarContainer", 0);
    if (top) ALB3RefreshTopChrome(top);
    NSMutableArray<UIView *> *stacks = [NSMutableArray array];
    AWECollectVisibleHomeActionStacks(window, stacks, 0);
    for (UIView *stack in stacks) AWERefreshHomeActionStack(stack);
}

@implementation AWEHomeChromeRecoveryTicker
- (void)alb_tick:(CADisplayLink *)displayLink {
    if (CACurrentMediaTime() > gAWEHomeChromeRecoveryDeadline) {
        [displayLink invalidate];
        gAWEHomeChromeRecoveryDisplayLink = nil;
        gAWEHomeChromeRecoveryTicker = nil;
        return;
    }
    AWERefreshHomeChromeImmediately(AWEActiveMainWindow());
}
@end

static void AWEStartHomeChromeRecoverySampler(void) {
    /* 1.0.48a: no continuous CADisplayLink. Lifecycle hooks and three bounded
       reconciliation passes are sufficient and avoid the major heat source. */
}

static BOOL AWEHomeChromeRecoveryContextEligible(void) {
    if (AWECurrentOriginalMainTabIndex() != 0) return NO;
    if (AWECurrentRouteSuppressesBar()) return NO;
    return AWECurrentHomeFeedSurfaceVisible();
}

static void AWEScheduleHomeChromeRecovery(UIWindow *window) {
    if (!AWEPluginFeaturesEnabled() || !AWEHomeChromeRecoveryContextEligible()) return;
    AWEStartHomeChromeRecoverySampler();
    __weak UIWindow *weakWindow = window ?: AWEActiveMainWindow();
    for (NSNumber *delay in @[@0.0, @0.12, @0.42]) {
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW,
                                     (int64_t)(delay.doubleValue * NSEC_PER_SEC)),
                       dispatch_get_main_queue(), ^{
            if (!AWEHomeChromeRecoveryContextEligible()) return;
            UIWindow *strongWindow = weakWindow ?: AWEActiveMainWindow();
            AWERefreshHomeChromeInWindow(strongWindow);
        });
    }
}

static AWENormalModeTabBar *AWEPrepareBarForController(id controller,
                                                       BOOL forceVisible) {
    if (!AWEPluginFeaturesEnabled()) return nil;
    NSArray *buttons = AWEControllerButtons(controller);
    BOOL secondRoleChanged = AWEUpdateSecondTabRoleFromButtons(buttons);
    AWENormalModeTabBar *tabBar = AWETabBarFromButtons(buttons);
    if (!tabBar) return nil;

    objc_setAssociatedObject(tabBar, &kAWEControllerKey, controller,
                             OBJC_ASSOCIATION_ASSIGN);

    gAWELastTabBar = tabBar;
    if ([controller isKindOfClass:NSClassFromString(@"AWENormalModeTabBarController")]) {
        gAWELastController = controller;
    }

    AWEAttachNativeBarWithForce(tabBar, forceVisible);
    (void)secondRoleChanged;
    [gAWEAlbumMorphController configureSecondTabAsShop:AWESecondTabIsShop()];
    return tabBar;
}


static void AWEScheduleTransitionRecovery(void) {
    if (!AWEPluginFeaturesEnabled()) return;
    /*
     Reconcile once on the next main-run-loop turn.  The old 0/16/80/220 ms
     retry queue is intentionally removed; it was one source of post-return
     disappear/reappear cycles.
    */
    NSUInteger generation = ++gAWERecoveryGeneration;
    dispatch_async(dispatch_get_main_queue(), ^{
        if (generation != gAWERecoveryGeneration) return;
        AWENormalModeTabBar *tabBar = gAWELastTabBar;
        if (!tabBar && gAWELastController) {
            tabBar = AWEPrepareBarForController(gAWELastController, NO);
        }
        if (!tabBar) return;
        AWEAttachNativeBarWithForce((UIView *)tabBar, NO);
        if (gAWEAlbumMorphController) {
            AWEUpdateAlbumMorphVisibility((UIView *)tabBar,
                                          @"next-run-loop.recovery");
            AWEStartBarVisibilityDriver();
        }
    });
}


static void AWEForceAlbumMorphRouteRecovery(NSString *reason) {
    if (!AWEPluginFeaturesEnabled()) return;

    NSUInteger generation = ++gAWEAlbumMorphRouteRecoveryGeneration;
    AWEAlbumMorphProbeWrite(@"RECOVERY_SCHEDULE generation=%lu reason=%@",
        (unsigned long)generation, reason ?: @"unknown");

    /* One next-run-loop reconciliation only.  Repeated delayed installs were
       rebuilding/reconfiguring the overlay around the transition boundary and
       are intentionally removed, matching the stable 1.0.10b architecture. */
    dispatch_async(dispatch_get_main_queue(), ^{
        if (generation != gAWEAlbumMorphRouteRecoveryGeneration) return;
        AWENormalModeTabBar *tabBar = gAWELastTabBar;
        if (!tabBar && gAWELastController) {
            tabBar = AWEPrepareBarForController(gAWELastController, NO);
        }
        BOOL result = NO;
        if (tabBar) {
            result = AWEInstallOrUpdateAlbumMorphBar((UIView *)tabBar, NO);
            AWEUpdateAlbumMorphVisibility((UIView *)tabBar,
                reason ?: @"route.recovery");
        }
        AWEStartBarVisibilityDriver();
        AWEAlbumMorphProbeWrite(
            @"RECOVERY_ONCE generation=%lu reason=%@ tab=%d result=%d fraction=%.3f",
            (unsigned long)generation, reason ?: @"unknown",
            tabBar != nil, result, gAWEBarLastVisibleFraction);
    });
}

#pragma mark - Settings

static void AWEApplyStoredAccentToCurrentBar(void) {
    [gAWEAlbumMorphController updateAccentColor:AWEStoredAccentColor()];
}
static void AWERefreshCurrentBarLayout(void) {
    if (!AWEPluginFeaturesEnabled()) return;
    AWENormalModeTabBar *tabBar = gAWELastTabBar;
    if (!tabBar) return;

    AWEInstallOrUpdateAlbumMorphBar((UIView *)tabBar, NO);
}

static UIViewController *AWETopViewControllerFrom(UIViewController *controller) {
    if (!controller) return nil;

    UIViewController *current = controller;

    while (current.presentedViewController &&
           !current.presentedViewController.isBeingDismissed) {
        current = current.presentedViewController;
    }

    if ([current isKindOfClass:[UINavigationController class]]) {
        UIViewController *visible =
            ((UINavigationController *)current).visibleViewController;
        if (visible && visible != current) {
            return AWETopViewControllerFrom(visible);
        }
    }

    if ([current isKindOfClass:[UITabBarController class]]) {
        UIViewController *selected =
            ((UITabBarController *)current).selectedViewController;
        if (selected && selected != current) {
            return AWETopViewControllerFrom(selected);
        }
    }

    for (UIViewController *child in
         current.childViewControllers.reverseObjectEnumerator) {
        if (child.viewIfLoaded.window) {
            UIViewController *candidate = AWETopViewControllerFrom(child);
            if (candidate) return candidate;
        }
    }

    return current;
}

static UIWindow *AWEActiveMainWindow(void) {
    UIApplication *application = UIApplication.sharedApplication;
    UIWindow *fallbackWindow = nil;

    if (@available(iOS 13.0, *)) {
        NSArray<UIScene *> *scenes = application.connectedScenes.allObjects;

        /* Prefer an active foreground scene, but also accept foreground-inactive
           while a system sheet or transition is taking focus. */
        for (NSNumber *wantedState in @[
                 @(UISceneActivationStateForegroundActive),
                 @(UISceneActivationStateForegroundInactive)]) {
            for (UIScene *scene in scenes) {
                if (![scene isKindOfClass:[UIWindowScene class]]) continue;
                if (scene.activationState != wantedState.integerValue) continue;

                UIWindowScene *windowScene = (UIWindowScene *)scene;
                NSArray<UIWindow *> *windows = windowScene.windows;

                for (UIWindow *window in windows.reverseObjectEnumerator) {
                    if (window.windowLevel != UIWindowLevelNormal ||
                        window.hidden ||
                        window.alpha <= 0.01) {
                        continue;
                    }

                    if (window.isKeyWindow) return window;
                    if (!fallbackWindow) fallbackWindow = window;
                }
            }
        }
    }

    /* This tweak targets scene-based iOS versions. Avoid UIApplication.windows
       and UIApplication.keyWindow because the project treats deprecations as
       build errors. */
    return fallbackWindow;
}

static UIButtonConfiguration *AWECreateSystemGlassButtonConfiguration(BOOL prominent) {
    Class configurationClass = NSClassFromString(@"UIButtonConfiguration");
    SEL selector = NSSelectorFromString(prominent
        ? @"prominentGlassButtonConfiguration"
        : @"glassButtonConfiguration");

    if (configurationClass &&
        [configurationClass respondsToSelector:selector]) {
        return ((id (*)(id, SEL))objc_msgSend)(configurationClass, selector);
    }

    /* Build-time fallback for an older SDK. The target iOS 26 runtime uses
       the branch above and receives the actual Liquid Glass material. */
    return prominent
        ? [UIButtonConfiguration filledButtonConfiguration]
        : [UIButtonConfiguration tintedButtonConfiguration];
}

static void AWEConfigureGlassTextButton(UIButton *button,
                                         NSString *title,
                                         UIColor *tintColor,
                                         BOOL prominent) {
    if (!button) return;
    if (!tintColor) tintColor = UIColor.systemBlueColor;

    UIButtonConfiguration *configuration =
        AWECreateSystemGlassButtonConfiguration(prominent);
    configuration.title = title;
    configuration.baseBackgroundColor = tintColor;

    UIColor *buttonForeground = UIColor.labelColor;
    if (prominent) {
        UIColor *resolvedTint = tintColor;
        if (@available(iOS 13.0, *)) {
            resolvedTint = [tintColor resolvedColorWithTraitCollection:
                [UITraitCollection traitCollectionWithUserInterfaceStyle:
                    UIUserInterfaceStyleLight]];
        }
        CGFloat red = 0.0, green = 0.0, blue = 0.0, alpha = 0.0;
        CGFloat luminance = 0.0;
        BOOL readable = [resolvedTint getRed:&red green:&green blue:&blue alpha:&alpha];
        if (!readable) {
            CGFloat white = 0.0;
            readable = [resolvedTint getWhite:&white alpha:&alpha];
            red = green = blue = white;
        }
        if (readable) {
            luminance = 0.2126 * red + 0.7152 * green + 0.0722 * blue;
        }
        buttonForeground = (readable && luminance >= 0.68)
            ? UIColor.blackColor
            : UIColor.whiteColor;
    }
    configuration.baseForegroundColor = buttonForeground;
    configuration.cornerStyle = UIButtonConfigurationCornerStyleCapsule;
    configuration.contentInsets = NSDirectionalEdgeInsetsMake(0.0, 12.0,
                                                               0.0, 12.0);

    configuration.titleLineBreakMode = NSLineBreakByClipping;
    configuration.titleTextAttributesTransformer = ^NSDictionary *(NSDictionary *attributes) {
        NSMutableDictionary *result = [attributes mutableCopy];
        result[NSFontAttributeName] = [UIFont systemFontOfSize:14.0 weight:UIFontWeightMedium];
        return result;
    };
    button.configuration = configuration;
    button.opaque = NO;
    button.backgroundColor = UIColor.clearColor;
    button.titleLabel.numberOfLines = 1;
    button.titleLabel.adjustsFontSizeToFitWidth = YES;
    button.titleLabel.minimumScaleFactor = 0.78;
    button.tintColor = tintColor;
}

static UIButton *AWECreateGlassTextButton(NSString *title,
                                           UIColor *tintColor,
                                           BOOL prominent) {
    UIButton *button = [UIButton buttonWithType:UIButtonTypeSystem];
    button.translatesAutoresizingMaskIntoConstraints = NO;
    AWEConfigureGlassTextButton(button, title, tintColor, prominent);

    [button.heightAnchor constraintEqualToConstant:40.0].active = YES;
    return button;
}

static UIUserInterfaceStyle AWESystemInterfaceStyle(void) {
    if (@available(iOS 13.0, *)) {
        /* Generic fallback for non-settings presentation helpers. Settings
           themselves inherit Douyin's app/window appearance via
           AWEAppResolvedAppearanceStyle or an unspecified native push trait. */
        UIUserInterfaceStyle screenStyle =
            UIScreen.mainScreen.traitCollection.userInterfaceStyle;
        if (screenStyle != UIUserInterfaceStyleUnspecified) return screenStyle;

        for (UIScene *scene in UIApplication.sharedApplication.connectedScenes) {
            if (![scene isKindOfClass:UIWindowScene.class]) continue;
            if (scene.activationState != UISceneActivationStateForegroundActive &&
                scene.activationState != UISceneActivationStateForegroundInactive) {
                continue;
            }
            UIWindowScene *windowScene = (UIWindowScene *)scene;
            for (UIWindow *window in windowScene.windows) {
                UIUserInterfaceStyle style =
                    window.traitCollection.userInterfaceStyle;
                if (style != UIUserInterfaceStyleUnspecified) return style;
            }
        }
    }

    return UIUserInterfaceStyleLight;
}


#include "ALBSettingsGlass.h"

#pragma mark - Fixed icon refresh

/* 3.11.33: the three-part dock wears the liquid bar's symbols (the icon
   center's "newbar.*" entries, the same lookup AwemeAlbumMorphBar.swift uses)
   and its accent colour for the selected tab (ALBDock.m). */
NSString *ALBDockHostConfiguredSymbol(NSString *key, NSString *fallback) {
    NSString *name = AWEConfiguredSymbolName(key ?: @"", fallback ?: @"questionmark");
    return name.length ? name : (fallback ?: @"questionmark");
}
UIColor *ALBDockHostAccentColor(void) { return AWEStoredAccentColor(); }

static void AWERefreshAllConfiguredIcons(void) {
    if (!AWEPluginFeaturesEnabled()) return;
    gAWEConfiguredIconGeneration++;
    if (gAWEConfiguredIconGeneration == 0) gAWEConfiguredIconGeneration = 1;
    [NSNotificationCenter.defaultCenter postNotificationName:@"ALBDock.IconsChanged" object:nil];
    if (gAWEAlbumMorphController) {
        [gAWEAlbumMorphController configureSecondTabAsShop:AWESecondTabIsShop()];
        [gAWEAlbumMorphController
            configureVisibleItemIdentifiers:AWEAlbumMorphVisibleItemIdentifiers()];
        [gAWEAlbumMorphController reloadConfiguredImages];
        [gAWEAlbumMorphController updateAccentColor:AWEStoredAccentColor()];
    }
    UIWindow *window = AWEActiveMainWindow();
    if (!window) return;
    UIView *top = AWEFindViewByExactRuntimeClass(window, @"AWEFeedTopBarContainer", 0);
    if (top) ALB3RefreshTopChrome(top);
    AWERefreshHomeActionStacksInView(window);
}


