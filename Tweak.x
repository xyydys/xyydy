@implementation AWELiquidSettingsController

- (void)viewDidLoad {
    [super viewDidLoad];
    self.title = @"LiquidBar · 2.3";
    self.pendingAccentColor = AWEStoredAccentColor();

    BOOL nativeSettingsPush =
        [objc_getAssociatedObject(self, &kAWELiquidSettingsNativePushKey) boolValue];
    self.view.opaque = NO;
    self.view.backgroundColor = UIColor.clearColor;
    if (!nativeSettingsPush) {
        self.navigationItem.rightBarButtonItem = [[UIBarButtonItem alloc]
            initWithBarButtonSystemItem:UIBarButtonSystemItemDone target:self action:@selector(closeSettings)];
    }
    ALBInstallSettingsGlass(self);

    UIColor *accent = self.pendingAccentColor ?: AWEStoredAccentColor();

    /* Personal card: one avatar, compact identity/accent controls, master switch. */
    UISwitch *masterSwitch = [UISwitch new];
    masterSwitch.on = AWEAuthorizationValid() && AWEMasterEnabledStored();
    masterSwitch.onTintColor = accent;
    [masterSwitch addTarget:self action:@selector(masterSwitchChanged:) forControlEvents:UIControlEventValueChanged];
    self.masterSwitch = masterSwitch;
    UIButton *avatarButton=[UIButton buttonWithType:UIButtonTypeCustom];
    avatarButton.translatesAutoresizingMaskIntoConstraints=NO;
    avatarButton.accessibilityLabel=@"调整自己头像的圆角";
    [avatarButton addTarget:self action:@selector(editProfileAvatarRadius:) forControlEvents:UIControlEventTouchUpInside];
    self.profileAvatarButton=avatarButton;
    UIImageView *avatar=[UIImageView new];avatar.translatesAutoresizingMaskIntoConstraints=NO;
    avatar.contentMode=UIViewContentModeScaleAspectFill;avatar.clipsToBounds=YES;
    avatar.layer.cornerCurve=kCACornerCurveContinuous;avatar.backgroundColor=UIColor.tertiarySystemFillColor;
    [avatarButton addSubview:avatar];self.profileAvatar=avatar;
    [NSLayoutConstraint activateConstraints:@[
        [avatarButton.widthAnchor constraintEqualToConstant:78], [avatarButton.heightAnchor constraintEqualToConstant:78],
        [avatar.leadingAnchor constraintEqualToAnchor:avatarButton.leadingAnchor], [avatar.trailingAnchor constraintEqualToAnchor:avatarButton.trailingAnchor],
        [avatar.topAnchor constraintEqualToAnchor:avatarButton.topAnchor], [avatar.bottomAnchor constraintEqualToAnchor:avatarButton.bottomAnchor]]];
    UILabel *name=[UILabel new];name.font=[UIFont systemFontOfSize:17 weight:UIFontWeightSemibold];
    name.textColor=UIColor.labelColor;name.numberOfLines=1;name.adjustsFontSizeToFitWidth=YES;name.minimumScaleFactor=.72;
    [name setContentCompressionResistancePriority:UILayoutPriorityDefaultLow forAxis:UILayoutConstraintAxisHorizontal];self.profileNameLabel=name;
    UIButton *signature=[UIButton buttonWithType:UIButtonTypeSystem];signature.contentHorizontalAlignment=UIControlContentHorizontalAlignmentLeft;
    signature.titleLabel.font=[UIFont systemFontOfSize:12];signature.titleLabel.lineBreakMode=NSLineBreakByTruncatingTail;
    [signature setTitleColor:UIColor.secondaryLabelColor forState:UIControlStateNormal];
    [signature setContentCompressionResistancePriority:UILayoutPriorityDefaultLow forAxis:UILayoutConstraintAxisHorizontal];
    [signature addTarget:self action:@selector(editProfileSignature:) forControlEvents:UIControlEventTouchUpInside];self.profileSignatureButton=signature;
    UIStackView *identity=[[UIStackView alloc]initWithArrangedSubviews:@[name,signature]];identity.axis=UILayoutConstraintAxisVertical;identity.spacing=1;
    UIButton *palette=AWECreateGlassTextButton(@"",accent,NO);self.profilePaletteButton=palette;
    UIButtonConfiguration *paletteConfig=palette.configuration;paletteConfig.image=[UIImage systemImageNamed:@"paintpalette.fill"];paletteConfig.title=nil;
    paletteConfig.contentInsets=NSDirectionalEdgeInsetsZero;palette.configuration=paletteConfig;palette.accessibilityLabel=@"全局强调色";
    [palette.widthAnchor constraintEqualToConstant:40].active=YES;
    [palette addTarget:self action:@selector(openAccentPicker:) forControlEvents:UIControlEventTouchUpInside];
    UIStackView *identityRow=[[UIStackView alloc]initWithArrangedSubviews:@[identity,palette]];identityRow.axis=UILayoutConstraintAxisHorizontal;identityRow.alignment=UIStackViewAlignmentCenter;identityRow.spacing=4;
