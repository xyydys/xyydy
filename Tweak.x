// TEST35: no process-wide contentOffset hook for background refresh. It was
// removed by the earlier Favorites no-jump repair and had been reintroduced.

%hook AWEProfileBaseContainerViewController
- (void)viewDidAppear:(BOOL)animated {
    %orig(animated);
