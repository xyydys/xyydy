static BOOL gAWETapModeNativeLikeFallback = NO;

static BOOL AWEInteractionControllerLikeSelected(AWEPlayInteractionViewController *controller,
                                                  BOOL *knownOut) {
    if (knownOut) *knownOut = NO;
    if (!controller.view) return NO;
    NSMutableArray<UIView *> *buttons = [NSMutableArray array];
    AWECollectFeedActionButtons(controller.view, buttons, 0);
    for (UIView *button in buttons) {
        if (AWEHomeActionKindForButton(button, buttons) != AWEHomeActionKindLike) continue;
        UIImageView *source = objc_getAssociatedObject(
            button, &kAWEHomeActionOriginalImageViewKey);
        if (knownOut) *knownOut = YES;
        return AWEHomeActionIsSelected(button, AWEHomeActionKindLike, source);
    }
    return NO;
}

#include "ALBSidePalette.h"

%hook AWEPlayInteractionViewController
- (void)viewWillDisappear:(BOOL)animated {
    ALB8PaletteControllerDisappearing(self);
    %orig(animated);
}

%new
- (void)alb_installOrRefreshTripleTapMode {
    UITapGestureRecognizer *triple = objc_getAssociatedObject(
        self, &kAWETapModeTripleRecognizerKey);
    if (!triple) {
        triple = [[UITapGestureRecognizer alloc]
            initWithTarget:self action:@selector(alb_handleTripleTapLike:)];
        triple.numberOfTapsRequired = 3;
        triple.numberOfTouchesRequired = 1;
        triple.cancelsTouchesInView = NO;
        triple.delaysTouchesBegan = NO;
        triple.delaysTouchesEnded = NO;
        [self.view addGestureRecognizer:triple];
        objc_setAssociatedObject(self, &kAWETapModeTripleRecognizerKey, triple,
                                 OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    triple.enabled = AWEPluginFeaturesEnabled() && AWEStoredTapGestureMode() == 2;
}

%new
- (void)alb_handleTripleTapLike:(UITapGestureRecognizer *)recognizer {
    if (recognizer.state != UIGestureRecognizerStateRecognized ||
        !AWEPluginFeaturesEnabled() || AWEStoredTapGestureMode() != 2) return;

    NSUInteger generation = [objc_getAssociatedObject(
        self, &kAWETapModeDoubleGenerationKey) unsignedIntegerValue] + 1;
    objc_setAssociatedObject(self, &kAWETapModeDoubleGenerationKey, @(generation),
                             OBJC_ASSOCIATION_RETAIN_NONATOMIC);

    /* Douyin exposes a dedicated interaction-controller action for the heart.
       Use that instead of fabricating a right-rail touch or re-entering the
       double-tap recognizer.  It follows the same toggle path as the native
       like button, so a later triple-tap can remove an existing like. */
    BOOL knownBefore = NO;
    BOOL selectedBefore = AWEInteractionControllerLikeSelected(self, &knownBefore);
    BOOL invoked = NO;
    if ([self respondsToSelector:@selector(performLikeAction)]) {
        [self performLikeAction];
        invoked = YES;
    } else {
        /* Compatibility fallback for an older/newer Aweme build that removes
           performLikeAction.  Re-enter the native double-tap implementation
           through a tiny guard so this fallback is not converted to comment. */
        gAWETapModeNativeLikeFallback = YES;
        [self onVideoPlayerViewDoubleClicked:recognizer];
        gAWETapModeNativeLikeFallback = NO;
        invoked = YES;
    }
    AWEInteractionDiagnosticWrite(
        @"TAP_MODE triple_like generation=%lu invoked=%d selectedBefore=%@",
        (unsigned long)generation, invoked,
        knownBefore ? (selectedBefore ? @"1" : @"0") : @"unknown");

    __weak AWEPlayInteractionViewController *weakSelf = self;
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.14 * NSEC_PER_SEC)),
                   dispatch_get_main_queue(), ^{
        AWEPlayInteractionViewController *strongSelf = weakSelf;
        if (!strongSelf) return;
        BOOL knownAfter = NO;
        BOOL selectedAfter = AWEInteractionControllerLikeSelected(strongSelf, &knownAfter);
        AWEInteractionDiagnosticWrite(
            @"TAP_MODE triple_like_result generation=%lu selectedAfter=%@ toggled=%@",
            (unsigned long)generation,
            knownAfter ? (selectedAfter ? @"1" : @"0") : @"unknown",
            (knownBefore && knownAfter) ? ((selectedBefore != selectedAfter) ? @"1" : @"0") : @"unknown");
    });
}

- (void)viewDidAppear:(BOOL)animated {
    %orig(animated);
    AWEScheduleHomeActionStacksInView(self.view);
    AWERefreshVisibleSameStyleAnchors(self.view);
    [self alb_installOrRefreshTripleTapMode];
    ALB8PaletteControllerAppeared(self);
}

- (void)viewDidLayoutSubviews {
    %orig;
    AWEInternalFSLayoutInteractionController((UIViewController *)self);
    AWEScheduleHomeActionStacksInView(self.view);
    AWERefreshVisibleSameStyleAnchors(self.view);
    [self alb_installOrRefreshTripleTapMode];
    if (gAWEStableCleanScreenEnabled) {
        AWEScheduleCleanScreenReapply(@"interaction.layout");
    }
}

- (void)viewWillAppear:(BOOL)animated {
    %orig(animated);
    AWEScheduleHomeActionStacksInView(self.view);
    [self alb_installOrRefreshTripleTapMode];
}

- (void)onVideoPlayerViewDoubleClicked:(id)sender {
    if (gAWETapModeNativeLikeFallback) {
        %orig(sender);
        return;
    }
    if (!AWEPluginFeaturesEnabled()) {
        %orig(sender);
        return;
    }

    NSInteger mode = AWEStoredTapGestureMode();
    if (mode == 3) {
        BOOL commentShowing = NO;
        @try { commentShowing = [[self valueForKey:@"isCommentVCShowing"] boolValue]; }
        @catch (__unused NSException *exception) {}
        if (!commentShowing && ALBPresentSidePalette(self, sender)) return;
        %orig(sender);
        return;
    }
    if (mode == 0) {
        %orig(sender);
        return;
    }

    if (mode == 2) {
        /* Delay double-tap comment just long enough to distinguish a third tap.
           The third tap increments the generation and cancels this work item,
           then routes to Douyin's original like/unlike implementation. */
        NSUInteger generation = [objc_getAssociatedObject(
            self, &kAWETapModeDoubleGenerationKey) unsignedIntegerValue] + 1;
        objc_setAssociatedObject(self, &kAWETapModeDoubleGenerationKey,
                                 @(generation), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        __weak AWEPlayInteractionViewController *weakSelf = self;
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW,
            (int64_t)(0.30 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            AWEPlayInteractionViewController *strongSelf = weakSelf;
            if (!strongSelf || !AWEPluginFeaturesEnabled() ||
                AWEStoredTapGestureMode() != 2) return;
            NSUInteger current = [objc_getAssociatedObject(
                strongSelf, &kAWETapModeDoubleGenerationKey) unsignedIntegerValue];
            if (current != generation) return;
            BOOL commentShowing = NO;
            @try {
                commentShowing = [[strongSelf valueForKey:@"isCommentVCShowing"] boolValue];
            } @catch (__unused NSException *exception) {}
            if (!commentShowing &&
                [strongSelf respondsToSelector:@selector(performCommentAction)]) {
                [strongSelf performCommentAction];
                AWEInteractionDiagnosticWrite(@"TAP_MODE double_comment generation=%lu",
                    (unsigned long)generation);
            }
        });
        return;
    }

    /* Mode 1: retain the proven split-double-tap behavior. */
    CGPoint location = CGPointZero;
    UIView *coordinateView = nil;
    if (!AWEGetDoubleTapLocation(sender, self.view, &location, &coordinateView) ||
        !coordinateView) {
        %orig(sender);
        return;
    }
    CGFloat splitY = CGRectGetMinY(coordinateView.bounds) +
        CGRectGetHeight(coordinateView.bounds) * AWEStoredDoubleTapLikeFraction();
    if (location.y < splitY) {
        %orig(sender);
        return;
    }
    BOOL commentShowing = NO;
    @try {
        commentShowing = [[self valueForKey:@"isCommentVCShowing"] boolValue];
    } @catch (__unused NSException *exception) {}
    if (!commentShowing && [self respondsToSelector:@selector(performCommentAction)]) {
        [self performCommentAction];
        return;
    }
    if (![self respondsToSelector:@selector(performCommentAction)]) %orig(sender);
}

%end

