        [scroll.topAnchor constraintEqualToAnchor:self.view.topAnchor],
        [scroll.bottomAnchor constraintEqualToAnchor:self.view.bottomAnchor],
        [stack.leadingAnchor constraintEqualToAnchor:scroll.contentLayoutGuide.leadingAnchor constant:18.0],
        [stack.trailingAnchor constraintEqualToAnchor:scroll.contentLayoutGuide.trailingAnchor constant:-18.0],
        [stack.topAnchor constraintEqualToAnchor:scroll.contentLayoutGuide.topAnchor constant:18.0],
        [stack.bottomAnchor constraintEqualToAnchor:scroll.contentLayoutGuide.bottomAnchor constant:-18.0],
        [stack.widthAnchor constraintEqualToAnchor:scroll.frameLayoutGuide.widthAnchor constant:-36.0]
    ]];

    [[NSNotificationCenter defaultCenter] addObserver:self
        selector:@selector(authorizationStateChanged:)
        name:AWEAuthorizationNotificationName() object:nil];
    [self updateVerticalOffsetLabel];
    [self updateTopControlLabels];
    [self updateDoubleTapSplitLabel];
    [self updateTapGestureModeUI];
    self.messageTopBlurDistanceValueLabel.text = [NSString stringWithFormat:@"%.0f pt", AWEMessageTopEdgeBlurDistance()];
    self.messageBottomBlurDistanceValueLabel.text = [NSString stringWithFormat:@"%.0f pt", AWEMessageBottomEdgeBlurDistance()];
    self.messageButtonInsetValueLabel.text = [NSString stringWithFormat:@"%.0f pt", ALB5Number(@"message.buttonInset", 0, 0, 32)];
    self.commentGlassCornerValueLabel.text = [NSString stringWithFormat:@"%.0f pt", AWECommentGlassCornerRadiusSetting()];
    [self refreshAuthorizationUI];
    [self applyCurrentTheme];
}

- (void)viewDidLayoutSubviews {
    [super viewDidLayoutSubviews];
    ALBSettingsUpdateScrollVisibility(self.settingsScrollView);
    CGFloat width = CGRectGetWidth(self.view.safeAreaLayoutGuide.layoutFrame);
    if (width <= 1.0) width = CGRectGetWidth(self.view.bounds);
    if (fabs(width - self.lastResponsiveWidth) <= 0.5) return;
    self.lastResponsiveWidth = width;
    AWEApplyResponsiveSettingsTypography(self.view, AWESettingsResponsiveScaleForWidth(width));
}

- (void)viewDidAppear:(BOOL)animated {
    [super viewDidAppear:animated];
}

- (void)viewWillAppear:(BOOL)animated {
    [super viewWillAppear:animated];
    gAWESettingsVisible = YES;
    AWETrySilentAuthorization(self);
    [self refreshAuthorizationUI];
    [self updateVerticalOffsetLabel];
    [self updateTopControlLabels];
    [self updateTapGestureModeUI];
    [self applyCurrentTheme];
}

- (void)viewWillDisappear:(BOOL)animated {
    /* Restore the invisible native bar's layout footprint before the settings
       dismissal snapshot. Without this, the Home feed can perform one layout
       pass with a zero bottom reserve and its caption briefly touches the
       screen edge underneath the resident LiquidBar. */
    BOOL nativeSettingsPush =
        [objc_getAssociatedObject(self, &kAWELiquidSettingsNativePushKey) boolValue];
    if (!nativeSettingsPush && AWEAlbumMorphStyleEnabled() && gAWELastTabBar) {
        UIView *bar = (UIView *)gAWELastTabBar;
        AWESetApplying(bar, YES);
        [UIView performWithoutAnimation:^{
            bar.hidden = NO;
            bar.alpha = 1.0;
        }];
        AWESetApplying(bar, NO);
        AWEApplyAlbumMorphOriginalSuppression(bar, YES);
        [bar.superview setNeedsLayout];
        [bar.superview layoutIfNeeded];
    }
    [super viewWillDisappear:animated];
    BOOL floating = [objc_getAssociatedObject(self.navigationController, &kALBSettingsFloatingKey) boolValue];
    if (!floating || self.navigationController.parentViewController.isBeingDismissed)
        gAWESettingsVisible = NO;

    dispatch_async(dispatch_get_main_queue(), ^{
        AWERefreshAllConfiguredIcons();
        if (AWEAlbumMorphStyleEnabled() && gAWELastTabBar) {
            AWEInstallOrUpdateAlbumMorphBar((UIView *)gAWELastTabBar, NO);
        }
    });
}

- (void)traitCollectionDidChange:(UITraitCollection *)previousTraitCollection {
    [super traitCollectionDidChange:previousTraitCollection];
    if (@available(iOS 13.0, *)) {
        if ([self.traitCollection hasDifferentColorAppearanceComparedToTraitCollection:previousTraitCollection]) {
            [self applyCurrentTheme];
        }
    }
}

- (void)applyCurrentTheme {
    ALBInstallSettingsGlass(self);
    self.settingsScrollView.opaque = NO;
    self.settingsScrollView.backgroundColor = UIColor.clearColor;
    self.settingsScrollView.layer.backgroundColor = UIColor.clearColor.CGColor;
    UIColor *card = ALBSettingsSectionColor();
    AWEApplySettingsCardBackground(self.view, card);
    UIColor *accent = self.pendingAccentColor ?: AWEStoredAccentColor();
    self.previewView.backgroundColor = accent;
    self.settingsGestureMineOnlySwitch.onTintColor = accent;
    self.verticalOffsetSlider.minimumTrackTintColor = accent;
    self.doubleTapSplitSlider.minimumTrackTintColor = accent;
    self.wanToWSwitch.onTintColor = accent;
    self.customPNGModeSwitch.onTintColor = accent;
    self.topGlassSwitch.onTintColor = accent;
    self.hideTopLeftButtonSwitch.onTintColor = accent;
    self.hideTopSearchButtonSwitch.onTintColor = accent;
    self.topCategoryGroupSwitch.onTintColor = accent;
    self.topMenuMorphSwitch.onTintColor = accent;
    self.topLeftScaleSlider.minimumTrackTintColor = accent;
    self.topRightScaleSlider.minimumTrackTintColor = accent;
    self.topLeftMarginSlider.minimumTrackTintColor = accent;
    self.topRightMarginSlider.minimumTrackTintColor = accent;
    self.messageTopBlurDistanceSlider.minimumTrackTintColor = accent;
    self.messageButtonInsetSlider.minimumTrackTintColor = accent;
    self.messageBottomBlurDistanceSlider.minimumTrackTintColor = accent;
    self.commentGlassCornerSlider.minimumTrackTintColor = accent;
    self.transparentGlassSwitch.onTintColor = accent;
    self.hideBottomTitlesSwitch.onTintColor = accent;
    self.messageBadgeSwitch.onTintColor = accent;
    self.avatarMenuDownloadSwitch.onTintColor = accent;
    self.forceDarkBottomBarSwitch.onTintColor = accent;
    self.bottomBarDisplaySwitch.onTintColor = accent;
    self.internalFullscreenSwitch.onTintColor = accent;
    self.masterSwitch.onTintColor = accent;
    self.interactionDiagnosticSwitch.onTintColor = accent;
    self.commentGlassSwitch.onTintColor = accent;
    [self updateApplyButtonTint:accent];
}

- (void)updateApplyButtonTint:(UIColor *)colour {
    self.profilePaletteButton.tintColor=colour ?: AWEStoredAccentColor();
    UIButtonConfiguration *configuration=self.profilePaletteButton.configuration;
    configuration.baseForegroundColor=colour ?: AWEStoredAccentColor();self.profilePaletteButton.configuration=configuration;
}

- (void)manualAuthorizationCheck:(UIButton *)sender {
    sender.enabled = NO;
    self.authorizationFooter.text = @"正在检测授权…";

    UIViewController *sourceController = self.presentingViewController ?: self;
    BOOL authorized = AWEAttemptAuthorizationFromVisiblePage(sourceController);

    if (!authorized) {
        UIWindow *window = AWEActiveMainWindow();
        UIViewController *top = AWETopViewControllerFrom(window.rootViewController);
        authorized = AWEAttemptAuthorizationFromVisiblePage(top ?: sourceController);
    }

    [self refreshAuthorizationUI];
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.35 * NSEC_PER_SEC)),
                   dispatch_get_main_queue(), ^{
        sender.enabled = YES;
        [self refreshAuthorizationUI];
    });
}

- (void)authorizationStateChanged:(NSNotification *)notification {
    (void)notification;
    [self refreshAuthorizationUI];
}

- (void)refreshAuthorizationUI {
    BOOL authorized = AWEAuthorizationValid();
    self.masterSwitch.enabled = authorized;
    self.masterSwitch.on = authorized && AWEMasterEnabledStored();
    self.authorizationFooter.text = authorized ? @"● 已授权" : @"○ 未授权";
}

- (void)masterSwitchChanged:(UISwitch *)sender {
    BOOL authorized = AWEAuthorizationValid();
    if (!authorized) {
        sender.on = NO;
        sender.enabled = NO;
        return;
    }
    [NSUserDefaults.standardUserDefaults setBool:sender.isOn
        forKey:AWEAuthorizationDefaultsKey(3)];
    [NSUserDefaults.standardUserDefaults synchronize];
    [self refreshAuthorizationUI];
}

- (void)dealloc {
    [[NSNotificationCenter defaultCenter] removeObserver:self];
}

- (void)closeSettings {
    BOOL nativeSettingsPush =
        [objc_getAssociatedObject(self, &kAWELiquidSettingsNativePushKey) boolValue];
    if (nativeSettingsPush && self.navigationController &&
        self.navigationController.topViewController == self) {
        [self.navigationController popViewControllerAnimated:YES];
        return;
    }
    [self dismissViewControllerAnimated:YES completion:nil];
}

- (void)openAccentPicker:(UIButton *)sender {
    (void)sender;
    UIColorPickerViewController *picker = [UIColorPickerViewController new];
    picker.delegate = self;
    picker.supportsAlpha = NO;
    picker.selectedColor = self.pendingAccentColor ?: AWEStoredAccentColor();
    picker.title = @"选择强调色";
    [self presentViewController:picker animated:YES completion:nil];
}

- (void)colorPickerViewControllerDidSelectColor:(UIColorPickerViewController *)viewController {
    self.pendingAccentColor = viewController.selectedColor ?: AWEStoredAccentColor();
    self.previewView.backgroundColor = self.pendingAccentColor;
    [self updateApplyButtonTint:self.pendingAccentColor];
    [self confirmAccentColor:nil];
}

- (void)colorPickerViewControllerDidFinish:(UIColorPickerViewController *)viewController {
    self.pendingAccentColor = viewController.selectedColor ?: self.pendingAccentColor;
    self.previewView.backgroundColor = self.pendingAccentColor;
    [self updateApplyButtonTint:self.pendingAccentColor];
    [self confirmAccentColor:nil];
}

- (void)confirmAccentColor:(UIButton *)sender {
    (void)sender;
    UIColor *colour = self.pendingAccentColor ?: AWEStoredAccentColor();
    CGFloat r=0,g=0,b=0,a=1;
    UIColor *resolved = colour;
    if (@available(iOS 13.0, *)) resolved = [colour resolvedColorWithTraitCollection:[UITraitCollection traitCollectionWithUserInterfaceStyle:UIUserInterfaceStyleLight]];
    if (![resolved getRed:&r green:&g blue:&b alpha:&a]) return;
    NSString *hex = [NSString stringWithFormat:@"#%02X%02X%02X", (int)lround(r*255.0), (int)lround(g*255.0), (int)lround(b*255.0)];
    [NSUserDefaults.standardUserDefaults setObject:hex forKey:kAWEAccentHexDefaultsKey];
    [NSUserDefaults.standardUserDefaults synchronize];
    AWEApplyStoredAccentToCurrentBar();
    AWERefreshAllConfiguredIcons();
    [self applyCurrentTheme];
}

- (void)updateVerticalOffsetLabel {
    CGFloat value = self.verticalOffsetSlider.value;
    if (fabs(value) < 0.01) {
        self.verticalOffsetValueLabel.text = @"默认位置";
    } else if (value < 0.0) {
        self.verticalOffsetValueLabel.text =
            [NSString stringWithFormat:@"向上 %.1f pt", fabs(value)];
    } else {
        self.verticalOffsetValueLabel.text =
            [NSString stringWithFormat:@"向下 %.1f pt", value];
    }
}

- (void)updateTopControlLabels {
    self.topLeftScaleValueLabel.text = [NSString stringWithFormat:@"%ld%%",
        (long)lround(self.topLeftScaleSlider.value * 100.0)];
    self.topRightScaleValueLabel.text = [NSString stringWithFormat:@"%ld%%",
        (long)lround(self.topRightScaleSlider.value * 100.0)];
    self.topLeftMarginValueLabel.text = [NSString stringWithFormat:@"%.1f pt",
        self.topLeftMarginSlider.value];
    self.topRightMarginValueLabel.text = [NSString stringWithFormat:@"%.1f pt",
        self.topRightMarginSlider.value];
}

- (void)updateDoubleTapSplitLabel {
    NSInteger likePercent =
        (NSInteger)lround(self.doubleTapSplitSlider.value * 100.0);
    NSInteger commentPercent = 100 - likePercent;
    self.doubleTapSplitValueLabel.text =
        [NSString stringWithFormat:@"点赞区域 %ld%% · 评论区域 %ld%%",
                                   (long)likePercent,
                                   (long)commentPercent];
}

- (void)updateTapGestureModeUI {
    NSInteger mode = self.tapGestureModeControl ? self.tapGestureModeControl.selectedSegmentIndex
                                                 : AWEStoredTapGestureMode();
    BOOL split = mode == 1;
    self.doubleTapSplitSlider.enabled = split;
    self.doubleTapSplitSlider.hidden = !split;
    self.doubleTapSplitValueLabel.hidden = !split;
}

- (void)tapGestureModeChanged:(UISegmentedControl *)sender {
    NSInteger mode = MIN(3, MAX(0, sender.selectedSegmentIndex));
    [NSUserDefaults.standardUserDefaults setBool:mode == 3 forKey:@"AwemeLiquidBarNativePaletteTapModeV1"];
    [NSUserDefaults.standardUserDefaults setInteger:mode forKey:kAWETapGestureModeDefaultsKey];
    /* Keep the legacy boolean coherent for downgrade/migration only. */
    [NSUserDefaults.standardUserDefaults setBool:(mode == 1) forKey:kAWELowerHalfDoubleTapCommentDefaultsKey];
    [NSUserDefaults.standardUserDefaults synchronize];
    [self updateTapGestureModeUI];
    [[[UISelectionFeedbackGenerator alloc] init] selectionChanged];
}

- (void)openMaterialOptions:(id)sender {
    [self.navigationController pushViewController:[ALBMaterialSettingsController new] animated:YES];
}
- (void)alb5OpenOptions:(id)sender {
    NSIndexSet *sections=[NSIndexSet indexSetWithIndex:0];
    [self.navigationController pushViewController:[[ALB5OptionsController alloc]initWithSections:sections title:@"底栏与收缩"] animated:YES];
}
- (void)openTopOptions:(id)sender { [self.navigationController pushViewController:[[ALB5OptionsController alloc]initWithSections:[NSIndexSet indexSetWithIndex:1] title:@"顶栏"] animated:YES]; }
- (void)openPaletteOptions:(id)sender { [self.navigationController pushViewController:[[ALB5OptionsController alloc]initWithSections:[NSIndexSet indexSetWithIndex:2] title:@"双击面板"] animated:YES]; }
- (void)openPaletteActions:(id)sender { [self.navigationController pushViewController:[ALBPaletteActionsController new] animated:YES]; }
- (void)extraOptionChanged:(UISwitch *)sender {
    [NSUserDefaults.standardUserDefaults setBool:sender.on forKey:ALB5Key(sender.accessibilityIdentifier)];
    if ([sender.accessibilityIdentifier isEqualToString:@"settings.halfSheet"]) return;
    [NSNotificationCenter.defaultCenter postNotificationName:@"ALB5.OptionsChanged" object:nil];
    UIWindow *window = AWEActiveMainWindow();
    if ([sender.accessibilityIdentifier isEqualToString:@"bottom.clearMode"]) {
        if (gAWEAlbumMorphController.tabBar.window)
            AWEApplyIOS27UntintedClearPlatter(gAWEAlbumMorphController.tabBar);
        for (UIView *container in gALB5TopContainers.allObjects) {
            AWETopLiquidGroupView *group = objc_getAssociatedObject(container, &kAWETopLiquidGroupViewKey);
            if (group.nativeGroup.nativeBar.window)
                ALB50ApplyTopSharedBottomMaterial(group.nativeGroup.nativeBar);
            [group setNeedsLayout];
            [group.nativeGroup setNeedsLayout];
        }
        if (window) AWEScheduleHomeChromeRecovery(window);
    }
    if (window) AWEScheduleHomeActionStacksInView(window);
}
- (void)openRightOptions:(id)sender { [self.navigationController pushViewController:[[ALB5OptionsController alloc]initWithSections:[NSIndexSet indexSetWithIndex:3] title:@"右侧按钮"] animated:YES]; }
- (void)nowPlayingChanged:(UISwitch *)sender {
    [NSUserDefaults.standardUserDefaults setBool:sender.on forKey:ALB5Key(@"playback.hideNowPlaying")];
    if(sender.on) ALB9ClearNowPlaying();
}
- (void)refreshOwnProfileCard {
    self.profileAvatar.image=ALB8OwnAvatar() ?: [UIImage systemImageNamed:@"person.crop.square.fill"];
    self.profileAvatar.layer.cornerRadius=78*ALB5Number(@"profile.avatarRadius",.26,0,.5);
    self.profileNameLabel.text=ALB8OwnName();
    NSString *signature=[NSUserDefaults.standardUserDefaults stringForKey:ALB5Key(@"profile.signature")];
    [self.profileSignatureButton setTitle:signature.length?signature:@"点击编辑签名" forState:UIControlStateNormal];
}
- (void)editProfileAvatarRadius:(UIButton *)sender {
    UIAlertController *sheet=[UIAlertController alertControllerWithTitle:@"头像圆角" message:nil preferredStyle:UIAlertControllerStyleActionSheet];
    NSArray *values=@[@0,@.15,@.26,@.38,@.5],*titles=@[@"方形",@"小圆角",@"圆角",@"大圆角",@"圆形"];
    for(NSUInteger i=0;i<values.count;i++)[sheet addAction:[UIAlertAction actionWithTitle:titles[i] style:UIAlertActionStyleDefault handler:^(__unused UIAlertAction *action) {
        [NSUserDefaults.standardUserDefaults setObject:values[i] forKey:ALB5Key(@"profile.avatarRadius")];[self refreshOwnProfileCard];
    }]];
    [sheet addAction:[UIAlertAction actionWithTitle:@"取消" style:UIAlertActionStyleCancel handler:nil]];
    sheet.popoverPresentationController.sourceView=sender;sheet.popoverPresentationController.sourceRect=sender.bounds;
    [self presentViewController:sheet animated:YES completion:nil];
}
- (void)editProfileSignature:(id)sender {
    UIAlertController *alert=[UIAlertController alertControllerWithTitle:@"个人签名" message:@"仅显示在 LiquidBar 设置页" preferredStyle:UIAlertControllerStyleAlert];
    [alert addTextFieldWithConfigurationHandler:^(UITextField *field) { field.placeholder=@"写下一句签名";field.text=[NSUserDefaults.standardUserDefaults stringForKey:ALB5Key(@"profile.signature")]; }];
    __weak typeof(self) weakSelf=self;
    [alert addAction:[UIAlertAction actionWithTitle:@"保存" style:UIAlertActionStyleDefault handler:^(__unused UIAlertAction *action) {
        NSString *text=alert.textFields.firstObject.text?:@"";if(text.length>80)text=[text substringWithRange:[text rangeOfComposedCharacterSequencesForRange:NSMakeRange(0,80)]];
        [NSUserDefaults.standardUserDefaults setObject:text forKey:ALB5Key(@"profile.signature")];[weakSelf refreshOwnProfileCard];
    }]];
    [alert addAction:[UIAlertAction actionWithTitle:@"取消" style:UIAlertActionStyleCancel handler:nil]];[self presentViewController:alert animated:YES completion:nil];
}
- (void)nativeMinimizeChanged:(UISwitch *)sender {
    [NSUserDefaults.standardUserDefaults setBool:sender.on forKey:kAWEAlbumMorphCollapseEnabledDefaultsKey];
    AWEInstallAlbumMorphCollapseGesture(AWEActiveMainWindow());
    [gAWEAlbumMorphController setNativeMinimizeEnabled:sender.on];
}

- (void)verticalOffsetSliderChanged:(UISlider *)sender {
    CGFloat snapped = round(sender.value * 2.0) / 2.0;
    sender.value = snapped;

    [[NSUserDefaults standardUserDefaults]
        setDouble:snapped
           forKey:kAWEVerticalOffsetDefaultsKey];
    [[NSUserDefaults standardUserDefaults] synchronize];
    [self updateVerticalOffsetLabel];

    if (AWEAlbumMorphStyleEnabled() && gAWEAlbumMorphController) {
        [gAWEAlbumMorphController setVerticalOffset:snapped];
        AWEAlbumMorphProbeWrite(
            @"HEIGHT_SLIDER_FIXED value=%.2f tabBar=%@",
            snapped,
            NSStringFromCGRect(gAWEAlbumMorphController.tabBar.frame));
        return;
    }

    /* The original five-button style keeps its existing carrier-frame path. */
    AWERefreshCurrentBarLayout();
}

- (void)doubleTapSplitSliderChanged:(UISlider *)sender {
    [[NSUserDefaults standardUserDefaults]
        setDouble:sender.value
           forKey:kAWEDoubleTapLikeFractionDefaultsKey];
    [self updateDoubleTapSplitLabel];
}

- (void)settingsGestureMineOnlySwitchChanged:(UISwitch *)sender {
    [NSUserDefaults.standardUserDefaults setBool:sender.isOn
        forKey:kAWESettingsGestureMineOnlyDefaultsKey];
    [NSUserDefaults.standardUserDefaults synchronize];
}

- (void)messageBadgeSwitchChanged:(UISwitch *)sender {
    [NSUserDefaults.standardUserDefaults setBool:sender.isOn
        forKey:kAWEMessageBadgeEnabledDefaultsKey];
    [NSUserDefaults.standardUserDefaults synchronize];
    AWEUpdateAlbumMorphMessageBadge();
}

- (void)avatarMenuDownloadSwitchChanged:(UISwitch *)sender {
    [NSUserDefaults.standardUserDefaults setBool:sender.isOn
        forKey:kAWEAvatarMenuDownloadEnabledDefaultsKey];
    [NSUserDefaults.standardUserDefaults synchronize];
    UIWindow *window = AWEActiveMainWindow();
    if (window) AWEScheduleHomeActionStacksInView(window);
}

- (void)forceDarkBottomBarSwitchChanged:(UISwitch *)sender {
    if (!AWEIsIOS27OrLater()) { sender.on = NO; return; }
    [NSUserDefaults.standardUserDefaults setBool:sender.isOn
        forKey:kAWEIOS27ClearBottomGlassDefaultsKey];
    [NSUserDefaults.standardUserDefaults synchronize];
    if (gAWEAlbumMorphController.tabBar) {
        AWEApplyIOS27UntintedClearPlatter(gAWEAlbumMorphController.tabBar);
        [gAWEAlbumMorphController.tabBar setNeedsLayout];
        AWEScheduleIOS27ClearPlatterReapply();
    }
    if (gAWELastTabBar) {
        UITabBar *native = objc_getAssociatedObject((UIView *)gAWELastTabBar, &kAWENativeBarKey);
        if (native) {
            AWEApplyIOS27UntintedClearPlatter(native);
            [native setNeedsLayout];
        }
    }
    [[[UISelectionFeedbackGenerator alloc] init] selectionChanged];
}

- (void)bottomBarDisplaySwitchChanged:(UISwitch *)sender {
    if (!AWECustomBottomBarReleaseAllowed()) {
        sender.on = YES;
        [NSUserDefaults.standardUserDefaults setBool:YES
            forKey:kAWEBottomBarDisplayEnabledDefaultsKey];
        [NSUserDefaults.standardUserDefaults synchronize];
        return;
    }
    [NSUserDefaults.standardUserDefaults setBool:sender.isOn
        forKey:kAWEBottomBarDisplayEnabledDefaultsKey];
    [NSUserDefaults.standardUserDefaults synchronize];

    if (!sender.isOn) {
        /* Release mode: physically remove our UITabBar/overlay and restore the
           original Douyin tab-bar host. Do not leave a transparent controller
           or hit region behind. Top/right/avatar/clean/fullscreen features live
           outside this overlay and continue to work. */
        AWEUninstallAlbumMorphBar();
        AWEBarVisibilityDisplayDriver *driver = [AWEBarVisibilityDisplayDriver sharedDriver];
        [driver.displayLink invalidate];
        driver.displayLink = nil;
        AWERestoreBottomNativeVisualStates();
        if (gAWELastTabBar) {
            AWEApplyAlbumMorphOriginalSuppression((UIView *)gAWELastTabBar, NO);
            AWERestoreOriginalTabBarContents((UIView *)gAWELastTabBar);
            AWEExtendRouteContentBehindBottomBar(gAWELastTabBar.window, @"bottom.release");
            [gAWELastTabBar setNeedsLayout];
            [gAWELastTabBar.superview setNeedsLayout];
        }
    } else if (gAWELastTabBar) {
        /* Recreate LiquidBar from the native host only when the user explicitly
           enables it again. */
        AWEAttachNativeBarWithForce((UIView *)gAWELastTabBar, YES);
    }

    [[[UISelectionFeedbackGenerator alloc] init] selectionChanged];
}

- (void)internalFullscreenSwitchChanged:(UISwitch *)sender {
    [NSUserDefaults.standardUserDefaults setBool:sender.isOn
        forKey:kAWEInternalFullscreenDefaultsKey];
    [NSUserDefaults.standardUserDefaults synchronize];

    /* The fullscreen module only owns forward geometry. When disabling, request
       a relayout immediately; a cold app restart is recommended to fully rebuild
       Douyin-owned tab backgrounds that were hidden while fullscreen was active. */
    UIWindow *window = AWEActiveMainWindow();
    [window setNeedsLayout];
    [window layoutIfNeeded];
    if (gAWELastTabBar) {
        [(UIView *)gAWELastTabBar setNeedsLayout];
        [(UIView *)gAWELastTabBar layoutIfNeeded];
    }
    [[[UISelectionFeedbackGenerator alloc] init] selectionChanged];
}

- (void)hideBottomTitlesSwitchChanged:(UISwitch *)sender {
    [NSUserDefaults.standardUserDefaults setBool:sender.isOn
        forKey:kAWEHideBottomTitlesDefaultsKey];
    [NSUserDefaults.standardUserDefaults synchronize];
    AWERefreshAllConfiguredIcons();
    [[[UISelectionFeedbackGenerator alloc] init] selectionChanged];
}

- (void)albumMorphStyleSwitchChanged:(UISwitch *)sender {
    [NSUserDefaults.standardUserDefaults setBool:sender.isOn
        forKey:kAWEAlbumMorphStyleDefaultsKey];
    [NSUserDefaults.standardUserDefaults synchronize];

    if (sender.isOn) {
        if (gAWELastTabBar) {
            AWEInstallOrUpdateAlbumMorphBar((UIView *)gAWELastTabBar, NO);
            dispatch_async(dispatch_get_main_queue(), ^{
                if (AWEAlbumMorphStyleEnabled() && gAWELastTabBar) {
                    AWEInstallOrUpdateAlbumMorphBar(
                        (UIView *)gAWELastTabBar, NO);
                }
            });
        }
    } else {
        AWEUninstallAlbumMorphBar();
        if (gAWELastTabBar) {
            AWEAttachNativeBarWithForce((UIView *)gAWELastTabBar, YES);
            UITabBar *nativeBar = objc_getAssociatedObject(
                (UIView *)gAWELastTabBar, &kAWENativeBarKey);
            if (nativeBar) {
                [UIView performWithoutAnimation:^{
                    AWEConfigureNativeBarAppearance(
                        nativeBar, AWEStoredAccentColor());
                    [nativeBar setNeedsLayout];
                    [nativeBar layoutIfNeeded];
                    [nativeBar setNeedsDisplay];
                }];
            }
        }
    }
    [[[UISelectionFeedbackGenerator alloc] init] selectionChanged];
}

- (void)commentGlassSwitchChanged:(UISwitch *)sender {
    [NSUserDefaults.standardUserDefaults setBool:sender.isOn
        forKey:kAWECommentGlassEnabledDefaultsKey];
    [NSUserDefaults.standardUserDefaults synchronize];
    self.commentGlassModeControl.enabled = sender.isOn;
    self.commentGlassCornerSlider.enabled = sender.isOn;
    [[[UISelectionFeedbackGenerator alloc] init] selectionChanged];
}

- (void)commentGlassModeChanged:(UISegmentedControl *)sender {
    NSInteger mode = MIN(2, MAX(0, sender.selectedSegmentIndex));
    [NSUserDefaults.standardUserDefaults setInteger:mode
        forKey:kAWECommentGlassModeDefaultsKey];
    [NSUserDefaults.standardUserDefaults synchronize];
    [[[UISelectionFeedbackGenerator alloc] init] selectionChanged];
}

- (void)commentGlassCornerRadiusChanged:(UISlider *)sender {
    CGFloat value = round(MIN(40.0, MAX(16.0, sender.value)));
    sender.value = value;
    self.commentGlassCornerValueLabel.text = [NSString stringWithFormat:@"%.0f pt", value];
    [NSUserDefaults.standardUserDefaults setDouble:value
        forKey:kAWECommentGlassCornerRadiusDefaultsKey];
    [NSUserDefaults.standardUserDefaults synchronize];
}

- (void)topControlSliderChanged:(UISlider *)sender {
    NSString *key = nil;
    CGFloat value = sender.value;
    if (sender == self.topLeftScaleSlider) {
        key = kAWETopLeftScaleDefaultsKey;
        value = round(value * 100.0) / 100.0;
    } else if (sender == self.topRightScaleSlider) {
        key = kAWETopRightScaleDefaultsKey;
        value = round(value * 100.0) / 100.0;
    } else if (sender == self.topLeftMarginSlider) {
        key = kAWETopLeftMarginDefaultsKey;
        value = round(value * 2.0) / 2.0;
    } else if (sender == self.topRightMarginSlider) {
        key = kAWETopRightMarginDefaultsKey;
        value = round(value * 2.0) / 2.0;
    }
    if (!key) return;
    sender.value = value;
    [NSUserDefaults.standardUserDefaults setDouble:value forKey:key];
    [NSUserDefaults.standardUserDefaults synchronize];
    [self updateTopControlLabels];
    AWEScheduleHomeChromeRecovery(AWEActiveMainWindow());
}

