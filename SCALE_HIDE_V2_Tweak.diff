+static void AWEApplyRightLabelScaleRecursive(UIView *root, CGFloat scale,
+                                              NSUInteger depth) {
+    if (!root || depth > 8) return;
+    if ([root isKindOfClass:UILabel.class]) {
+        NSValue *stored = objc_getAssociatedObject(root, &kAWEHomeActionLabelBaseTransformKey);
+        if (!stored) {
+            stored = [NSValue valueWithCGAffineTransform:root.transform];
+            objc_setAssociatedObject(root, &kAWEHomeActionLabelBaseTransformKey,
+                                     stored, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        }
+        root.transform = CGAffineTransformScale(stored.CGAffineTransformValue,
+                                                scale, scale);
+    }
+    for (UIView *child in root.subviews) {
+        AWEApplyRightLabelScaleRecursive(child, scale, depth + 1);
+    }
+}
