+static void AWEStoreAndRestoreRightOwnerBase(UIView *owner) {
+    if (!owner || !owner.superview) return;
+    NSValue *baseCenter = objc_getAssociatedObject(owner, &kAWEHomeActionOwnerBaseCenterKey);
+    if (!baseCenter) {
+        baseCenter = [NSValue valueWithCGPoint:owner.center];
+        objc_setAssociatedObject(owner, &kAWEHomeActionOwnerBaseCenterKey,
+                                 baseCenter, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    } else {
+        owner.center = baseCenter.CGPointValue;
+    }
+    if (!objc_getAssociatedObject(owner, &kAWEHomeActionOwnerOriginalLayerOpacityKey)) {
+        objc_setAssociatedObject(owner, &kAWEHomeActionOwnerOriginalLayerOpacityKey,
+                                 @(owner.layer.opacity), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        objc_setAssociatedObject(owner, &kAWEHomeActionOwnerOriginalInteractionKey,
+                                 @(owner.userInteractionEnabled), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    }
+}
+
+static void AWEApplyRightOwnerHiddenState(UIView *owner, BOOL hidden) {
+    if (!owner) return;
+    NSNumber *opacity = objc_getAssociatedObject(owner,
+        &kAWEHomeActionOwnerOriginalLayerOpacityKey);
+    NSNumber *interaction = objc_getAssociatedObject(owner,
+        &kAWEHomeActionOwnerOriginalInteractionKey);
+    owner.layer.opacity = hidden ? 0.0f : (opacity ? opacity.floatValue : 1.0f);
+    owner.userInteractionEnabled = hidden ? NO :
+        (interaction ? interaction.boolValue : YES);
+}
+
+/* Packs the five configurable right-side roles into the original native slot
+   geometry. Hidden roles leave no visual/touch owner; roles above a removed
+   slot fall downward into the next available lower slot. The actual Douyin
+   buttons are moved, not replaced, so existing recognizers/routes remain real. */
+static void AWEApplyRightRailUserLayout(UIView *stack) {
+    if (!stack) return;
+    NSMutableArray<UIView *> *allButtons = [NSMutableArray array];
+    AWECollectFeedActionButtons(stack, allButtons, 0);
+    for (UIView *owner in allButtons) {
+        AWEStoreAndRestoreRightOwnerBase(owner);
+        AWEApplyRightOwnerHiddenState(owner, NO);
+        AWEApplyRightLabelScaleRecursive(owner, AWERightFontScale(), 0);
+    }
+
+    UIView *sameStyle = AWESameStyleBottomSlotForStackV20(stack);
+    if (sameStyle) {
+        NSValue *baseCenter = objc_getAssociatedObject(sameStyle, &kAWESameStyleBaseCenterKey);
+        if (!baseCenter) {
+            baseCenter = [NSValue valueWithCGPoint:sameStyle.center];
+            objc_setAssociatedObject(sameStyle, &kAWESameStyleBaseCenterKey,
+                                     baseCenter, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        } else {
+            sameStyle.center = baseCenter.CGPointValue;
+        }
+    }
+
+    NSArray<UIView *> *ordered = AWESortedVisibleHomeActionButtons(stack);
+    NSMutableDictionary<NSNumber *, UIView *> *owners = [NSMutableDictionary dictionary];
+    for (UIView *owner in ordered) {
+        AWEHomeActionKind kind = AWEHomeActionKindForButton(owner, ordered);
+        if (kind >= AWEHomeActionKindLike && kind <= AWEHomeActionKindShare &&
+            !owners[@(kind)]) {
+            owners[@(kind)] = owner;
+        }
+    }
+
+    NSMutableArray<NSDictionary *> *roles = [NSMutableArray array];
+    for (NSInteger raw = AWEHomeActionKindLike; raw <= AWEHomeActionKindShare; raw++) {
+        UIView *owner = owners[@(raw)];
+        if (!owner) continue;
+        CGRect r = [owner convertRect:owner.bounds toView:stack];
+        [roles addObject:@{@"kind": @(raw), @"owner": owner,
+                           @"y": @(CGRectGetMidY(r)), @"same": @NO}];
+    }
+    if (sameStyle) {
+        CGRect r = [sameStyle convertRect:sameStyle.bounds toView:stack];
+        CGFloat visualY = CGRectGetMidY(r) - 2.0;
+        [roles addObject:@{@"kind": @0, @"owner": sameStyle,
+                           @"y": @(visualY), @"same": @YES}];
+    }
+    if (roles.count < 2) return;
+
+    [roles sortUsingComparator:^NSComparisonResult(NSDictionary *lhs, NSDictionary *rhs) {
+        return [lhs[@"y"] doubleValue] < [rhs[@"y"] doubleValue]
+            ? NSOrderedAscending : ([lhs[@"y"] doubleValue] > [rhs[@"y"] doubleValue]
+                ? NSOrderedDescending : NSOrderedSame);
+    }];
+
+    CGFloat bottomY = [roles.lastObject[@"y"] doubleValue];
+    CGFloat spacingScale = AWERightSpacingScale();
+    CGFloat verticalOffset = AWERightVerticalOffset();
+    NSMutableArray<NSNumber *> *targetYs = [NSMutableArray arrayWithCapacity:roles.count];
+    for (NSDictionary *role in roles) {
+        CGFloat baseY = [role[@"y"] doubleValue];
+        [targetYs addObject:@(bottomY - (bottomY - baseY) * spacingScale + verticalOffset)];
+    }
+
+    NSMutableArray<NSDictionary *> *visibleRoles = [NSMutableArray array];
+    for (NSDictionary *role in roles) {
+        BOOL same = [role[@"same"] boolValue];
+        NSInteger raw = [role[@"kind"] integerValue];
+        BOOL hidden = same ? AWEHideRightSameStyleEnabled()
+                           : AWEHomeActionKindHiddenByUser((AWEHomeActionKind)raw);
+        UIView *owner = role[@"owner"];
+        if (same) {
+            if (!objc_getAssociatedObject(owner, &kAWESameStyleOriginalLayerOpacityKey)) {
+                objc_setAssociatedObject(owner, &kAWESameStyleOriginalLayerOpacityKey,
+                                         @(owner.layer.opacity), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+                objc_setAssociatedObject(owner, &kAWESameStyleOriginalInteractionKey,
+                                         @(owner.userInteractionEnabled), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+            }
+            NSNumber *opacity = objc_getAssociatedObject(owner, &kAWESameStyleOriginalLayerOpacityKey);
+            NSNumber *interaction = objc_getAssociatedObject(owner, &kAWESameStyleOriginalInteractionKey);
+            owner.layer.opacity = hidden ? 0.0f : (opacity ? opacity.floatValue : 1.0f);
+            owner.userInteractionEnabled = hidden ? NO :
+                (interaction ? interaction.boolValue : YES);
+        } else {
+            AWEApplyRightOwnerHiddenState(owner, hidden);
+        }
+        if (!hidden) [visibleRoles addObject:role];
+    }
+
+    NSInteger start = MAX(0, (NSInteger)targetYs.count - (NSInteger)visibleRoles.count);
+    for (NSInteger index = 0; index < (NSInteger)visibleRoles.count; index++) {
+        NSDictionary *role = visibleRoles[(NSUInteger)index];
+        UIView *owner = role[@"owner"];
+        CGFloat baseY = [role[@"y"] doubleValue];
+        CGFloat targetY = [targetYs[(NSUInteger)(start + index)] doubleValue];
+        CGFloat deltaY = targetY - baseY;
+        if (fabs(deltaY) < 0.01 || !owner.superview) continue;
+        CGPoint baseCenter = owner.center;
+        CGPoint targetInStack = [owner.superview convertPoint:baseCenter toView:stack];
+        targetInStack.y += deltaY;
+        CGPoint moved = [stack convertPoint:targetInStack toView:owner.superview];
+        if (isfinite(moved.x) && isfinite(moved.y)) owner.center = moved;
+    }
+}
