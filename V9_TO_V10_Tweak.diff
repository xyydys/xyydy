+static UIImage *AWEProfileCircularAvatarImage(UIImage *source, CGFloat side) {
+    if (!source || side <= 1.0) return source;
+    CGSize size = CGSizeMake(side, side);
+    UIGraphicsImageRenderer *renderer = [[UIGraphicsImageRenderer alloc] initWithSize:size];
+    return [renderer imageWithActions:^(UIGraphicsImageRendererContext * _Nonnull context) {
+        CGContextRef cg = context.CGContext;
+        CGContextAddEllipseInRect(cg, CGRectMake(0.0, 0.0, side, side));
+        CGContextClip(cg);
+        CGSize src = source.size;
+        if (src.width <= 0.0 || src.height <= 0.0) return;
+        CGFloat scale = MAX(side / src.width, side / src.height);
+        CGSize drawSize = CGSizeMake(src.width * scale, src.height * scale);
+        CGRect rect = CGRectMake((side - drawSize.width) * 0.5,
+                                 (side - drawSize.height) * 0.5,
+                                 drawSize.width, drawSize.height);
+        [source drawInRect:rect];
+    }];
+}
