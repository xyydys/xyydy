+/* DYKiller's key finding is that the floating UITabBar provider ignores
+   UITabBarAppearance.backgroundEffect: the actual material is owned by
+   _UITabBarItemPlatterView.glassEffect. v10 applies the same narrow patch to
+   our already-native UITabBar, preserving UIKit's current interactive flag so
+   press/lens/selection behavior stays native. Failure is silent and leaves the
+   system material intact. */
+static void AWEApplyIOS27UntintedClearPlatter(UITabBar *nativeBar) {
+    if (!nativeBar || !AWEIsIOS27OrLater() ||
+        (!AWEIsOurNativeBar(nativeBar) && !AWEIsAlbumMorphSystemBar(nativeBar))) return;
+    NSMutableArray<UIView *> *queue = [NSMutableArray arrayWithObject:nativeBar];
+    NSUInteger index = 0;
+    while (index < queue.count && index < 180) {
+        UIView *view = queue[index++];
+        for (UIView *child in view.subviews) [queue addObject:child];
+        NSString *name = NSStringFromClass(view.class);
+        if ([name rangeOfString:@"UITabBarItemPlatterView"
+                         options:NSCaseInsensitiveSearch].location == NSNotFound) {
+            continue;
+        }
+
+        id current = nil;
+        @try { current = [view valueForKey:@"glassEffect"]; }
+        @catch (__unused NSException *exception) { continue; }
+
+        id installed = objc_getAssociatedObject(view, &kAWEIOS27PlatterInstalledGlassKey);
+        if (current && installed && current == installed) continue;
+
+        if (!objc_getAssociatedObject(view, &kAWEIOS27PlatterOriginalGlassKey)) {
+            objc_setAssociatedObject(view, &kAWEIOS27PlatterOriginalGlassKey,
+                                     current ?: NSNull.null,
+                                     OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        }
+
+        BOOL interactive = YES;
+        @try {
+            id value = current ? [current valueForKey:@"interactive"] : nil;
+            if ([value respondsToSelector:@selector(boolValue)]) interactive = [value boolValue];
+        } @catch (__unused NSException *exception) {}
+
+        id clear = AWEIOS27MakeUntintedClearGlassEffect(interactive);
+        if (!clear) continue;
+        @try {
+            [view setValue:clear forKey:@"glassEffect"];
+            id readback = [view valueForKey:@"glassEffect"];
+            objc_setAssociatedObject(view, &kAWEIOS27PlatterInstalledGlassKey,
+                                     readback, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+            [view setNeedsLayout];
+        } @catch (__unused NSException *exception) {
+            objc_setAssociatedObject(view, &kAWEIOS27PlatterInstalledGlassKey,
+                                     nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        }
+    }
+}
