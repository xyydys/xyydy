+static UIImageView *AWESameStyleBestContentImageView(UIView *root) {
+    if (!root) return nil;
+    NSMutableArray<UIImageView *> *images = [NSMutableArray array];
+    AWECollectImageViews(root, images, 0);
+    UIImageView *best = nil;
+    CGFloat bestScore = -CGFLOAT_MAX;
+    for (UIImageView *imageView in images) {
+        if (!imageView.image || imageView.hidden || imageView.alpha <= 0.01) continue;
+        CGRect r = [imageView convertRect:imageView.bounds toView:root];
+        CGFloat w = CGRectGetWidth(r), h = CGRectGetHeight(r);
+        if (w < 18.0 || h < 18.0 || w > 68.0 || h > 68.0) continue;
+        CGFloat score = MIN(w, h) * 8.0 - fabs(w - h) * 5.0;
+        score -= fabs(CGRectGetMidX(r) - CGRectGetMidX(root.bounds)) * 0.35;
+        score -= fabs(CGRectGetMidY(r) - CGRectGetMidY(root.bounds)) * 0.20;
+        if (imageView.userInteractionEnabled) score += 12.0;
+        if (score > bestScore) { bestScore = score; best = imageView; }
+    }
+    return best;
+}
+
+static void AWESameStyleBindIconSource(AWESameStyleGlassForwarder *forwarder,
+                                       UIImageView *source) {
+    if (!forwarder) return;
+    UIImageView *old = forwarder.iconSource;
+    if (old && old != source) AWESameStyleRestoreIconSource(old);
+    forwarder.iconSource = source;
+    if (!source) return;
+    if (!objc_getAssociatedObject(source, &kAWESameStyleSourceHiddenKey)) {
+        objc_setAssociatedObject(source, &kAWESameStyleSourceHiddenKey,
+                                 @(source.hidden), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+        objc_setAssociatedObject(source, &kAWESameStyleSourceAlphaKey,
+                                 @(source.alpha), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    }
+    source.hidden = YES;
+    source.alpha = 0.0;
+    source.layer.opacity = 0.0f;
+}
