+    /* Prefer the same lower/centre hit paths a real tap on Douyin's count/icon
+       uses. v9's generic subtree BFS could stop at an unrelated control and
+       report success even though the visible action did not open. */
+    NSArray<NSValue *> *points = @[
+        [NSValue valueWithCGPoint:CGPointMake(CGRectGetMidX(owner.bounds),
+                                               CGRectGetMidY(owner.bounds))],
+        [NSValue valueWithCGPoint:CGPointMake(CGRectGetMidX(owner.bounds),
+                                               CGRectGetMaxY(owner.bounds) - 8.0)],
+        [NSValue valueWithCGPoint:CGPointMake(CGRectGetMidX(owner.bounds),
+                                               CGRectGetHeight(owner.bounds) * 0.72)]
+    ];
+    for (NSValue *value in points) {
+        CGPoint p = value.CGPointValue;
+        if (!CGRectContainsPoint(owner.bounds, p)) continue;
+        UIView *hit = [owner hitTest:p withEvent:nil];
+        for (UIView *cursor = hit; cursor; cursor = cursor.superview) {
+            if (AWETriggerDirectInteractiveView(cursor)) return YES;
+            if (cursor == owner) break;
+        }
+    }
+
+    if (AWETriggerDirectInteractiveView(owner)) return YES;
+    for (UIView *cursor = owner.superview; cursor && cursor != owner.window;
+         cursor = cursor.superview) {
+        NSString *name = NSStringFromClass(cursor.class);
+        if ([name containsString:@"AWEElementStackView"]) break;
+        if (AWETriggerDirectInteractiveView(cursor)) return YES;
+    }
