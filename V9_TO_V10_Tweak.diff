+static id AWEIOS27MakeUntintedClearGlassEffect(BOOL interactive) {
+    if (!AWEIsIOS27OrLater()) return nil;
+    Class glassClass = NSClassFromString(@"UIGlassEffect");
+    SEL maker = NSSelectorFromString(@"effectWithStyle:");
+    if (!glassClass || ![glassClass respondsToSelector:maker]) return nil;
+    /* UIGlassEffectStyleClear == 1 on the iOS 26/27 SDK. Keep this runtime-
+       resolved so older SDK headers are not required by this translation unit. */
+    id effect = ((id (*)(id, SEL, NSInteger))objc_msgSend)(glassClass, maker, 1);
+    if (!effect) return nil;
+    SEL setInteractive = NSSelectorFromString(@"setInteractive:");
+    if ([effect respondsToSelector:setInteractive]) {
+        ((void (*)(id, SEL, BOOL))objc_msgSend)(effect, setInteractive, interactive);
+    }
+    SEL setTintColor = NSSelectorFromString(@"setTintColor:");
+    if ([effect respondsToSelector:setTintColor]) {
+        ((void (*)(id, SEL, id))objc_msgSend)(effect, setTintColor, nil);
+    }
+    return effect;
+}
