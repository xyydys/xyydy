+    if (AWETriggerQuickMenuDestinationView(owner)) return YES;
+
+    BOOL activated = NO;
+    @try { activated = [owner accessibilityActivate]; }
+    @catch (__unused NSException *exception) { activated = NO; }
+    return activated;
