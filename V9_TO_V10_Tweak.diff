+static void AWESameStyleRestoreIconSource(UIImageView *source) {
+    if (!source) return;
+    NSNumber *hidden = objc_getAssociatedObject(source, &kAWESameStyleSourceHiddenKey);
+    NSNumber *alpha = objc_getAssociatedObject(source, &kAWESameStyleSourceAlphaKey);
+    if (hidden) source.hidden = hidden.boolValue;
+    if (alpha) {
+        source.alpha = alpha.doubleValue;
+        source.layer.opacity = (float)alpha.doubleValue;
+    }
+    objc_setAssociatedObject(source, &kAWESameStyleSourceHiddenKey, nil,
+                             OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    objc_setAssociatedObject(source, &kAWESameStyleSourceAlphaKey, nil,
+                             OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+}
